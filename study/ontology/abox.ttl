<https://w3id.org/tiago-ons/data/template/ena_diario_por_subsistema/pattern_ena_bruta_mensal_gwh>
    a ons:QueryTemplate ;
    skos:prefLabel "ena_bruta_mensal_gwh" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(ena_data AS DATE)) AS mes,\n  id_subsistema,\n  SUM(TRY_CAST(ena_bruta_regiao_mwmed AS DOUBLE) * 24.0) / 1000 AS ena_bruta_gwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(ena_data AS DATE)) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2\n" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ena_diario_por_subsistema/ena_bruta_regiao_mwmed> .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_subsistema/pattern_ena_armazenavel_pct_mlt_serie>
    a ons:QueryTemplate ;
    skos:prefLabel "ena_armazenavel_pct_mlt_serie" ;
    ons:sqlTemplate "SELECT\n  TRY_CAST(ena_data AS DATE) AS data,\n  id_subsistema,\n  AVG(TRY_CAST(ena_armazenavel_regiao_percentualmlt AS DOUBLE)) AS ena_arm_pct_mlt\nFROM {source}\nWHERE id_subsistema = '{subsistema}'\n  AND TRY_CAST(ena_data AS DATE) BETWEEN '{data_inicio}' AND '{data_fim}'\nGROUP BY 1, 2\nORDER BY 1\n" ;
    ons:outputUnitLabel "%MLT" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ena_diario_por_subsistema/ena_armazenavel_regiao_percentualmlt> .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_subsistema/pattern_subsistemas_abaixo_mlt>
    a ons:QueryTemplate ;
    skos:prefLabel "subsistemas_abaixo_mlt" ;
    ons:sqlTemplate "SELECT\n  id_subsistema,\n  AVG(TRY_CAST(ena_armazenavel_regiao_percentualmlt AS DOUBLE)) AS media_pct_mlt\nFROM {source}\nWHERE TRY_CAST(ena_data AS DATE) BETWEEN '{data_inicio}' AND '{data_fim}'\n  AND TRY_CAST(ena_armazenavel_regiao_percentualmlt AS DOUBLE) < 50\nGROUP BY 1\nORDER BY 2 ASC\n" ;
    ons:outputUnitLabel "%MLT" .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_subsistema/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT TRY_CAST(ena_data AS DATE) AS ena_data_date, id_subsistema, nom_subsistema, ena_bruta_regiao_mwmed, ena_bruta_regiao_percentualmlt, ena_armazenavel_regiao_mwmed, ena_armazenavel_regiao_percentualmlt FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ena_subsistema_di/*.parquet') WHERE TRY_CAST(ena_data AS DATE) >= ( SELECT MAX(TRY_CAST(ena_data AS DATE)) - INTERVAL '30' DAY FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ena_subsistema_di/*.parquet') ) ORDER BY ena_data_date DESC, id_subsistema;" ;
    ons:exampleQuestion "Qual foi a ENA Bruta e Armazenável de cada subsistema nos últimos 30 dias disponíveis?"@pt .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_subsistema/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT date_trunc('month', TRY_CAST(ena_data AS DATE)) AS mes_referencia, id_subsistema, nom_subsistema, ROUND(AVG(ena_armazenavel_regiao_mwmed), 2) AS media_ena_armazenavel_mwmed, ROUND(AVG(ena_armazenavel_regiao_percentualmlt), 2) AS media_ena_armazenavel_pct_mlt, ROUND(AVG(ena_bruta_regiao_mwmed), 2) AS media_ena_bruta_mwmed FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ena_subsistema_di/*.parquet') WHERE TRY_CAST(ena_data AS DATE) >= '2024-01-01' AND TRY_CAST(ena_data AS DATE) < '2025-01-01' GROUP BY date_trunc('month', TRY_CAST(ena_data AS DATE)), id_subsistema, nom_subsistema ORDER BY mes_referencia, id_subsistema;" ;
    ons:exampleQuestion "Qual foi a média mensal de ENA Armazenável por subsistema ao longo de 2024?"@pt .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_subsistema/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT\n    TRY_CAST(ena_data AS DATE) AS ena_data_date,\n    id_subsistema,\n    nom_subsistema,\n    TRY_CAST(ena_armazenavel_regiao_mwmed AS DOUBLE) AS ena_armazenavel_regiao_mwmed,\n    TRY_CAST(ena_armazenavel_regiao_percentualmlt AS DOUBLE) AS ena_armazenavel_regiao_percentualmlt,\n    TRY_CAST(ena_bruta_regiao_percentualmlt AS DOUBLE) AS ena_bruta_regiao_percentualmlt\nFROM read_parquet('s3://ons-aws-prod-opendata/dataset/ena_subsistema_di/*.parquet', union_by_name=true)\nWHERE TRY_CAST(ena_armazenavel_regiao_percentualmlt AS DOUBLE) < 50.0\n  AND TRY_CAST(ena_armazenavel_regiao_percentualmlt AS DOUBLE) >= 0.0\nORDER BY TRY_CAST(ena_armazenavel_regiao_percentualmlt AS DOUBLE) ASC, ena_data_date DESC\nLIMIT 100;" ;
    ons:exampleQuestion "Quais subsistemas apresentaram condições hidrológicas críticas (ENA Armazenável abaixo de 50% da MLT) e em quais períodos?"@pt .

<https://w3id.org/tiago-ons/data/dataset/energia_vertida_turbinavel>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:energia-vertida-turbinavel" ;
    dct:title "energia-vertida-turbinavel" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/hidrologia> ;
    dcat:keyword "EVT"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "aproveitamento-hidrico"@pt ;
    dcat:keyword "energia turbinável perdida"@pt ;
    dcat:keyword "energia vertida aproveitável"@pt ;
    dcat:keyword "energia vertida turbinável"@pt ;
    dcat:keyword "energia-vertida-turbinavel"@pt ;
    dcat:keyword "geracao-hidraulica"@pt ;
    dcat:keyword "hidrologia"@pt ;
    dcat:keyword "horario"@pt ;
    dcat:keyword "perda hidráulica turbinável"@pt ;
    dcat:keyword "usinas-hidreletricas"@pt ;
    dcat:keyword "vazao-vertida"@pt ;
    dcat:keyword "vertimento turbinável"@pt ;
    dcat:keyword "vertimento-turbinavel"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Monitorar, em periodicidade horária e por usina hidrelétrica, os volumes de energia vertida turbinável e vazões associadas, permitindo que operadores do ONS, planejadores energéticos e agentes do setor elétrico identifiquem perdas de geração por vertimento turbinável, avaliem o aproveitamento hidráulico das usinas, subsidiem decisões de despacho e otimização do uso dos recursos hídricos, e apoiem análises de eficiência operacional e conformidade regulatória perante ANEEL e CCEE."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver perdas de geração por vertimento hidráulico, aproveitamento de vazões turináveis, eficiência operacional de usinas hidrelétricas ou análise de oportunidades de geração não aproveitadas."@pt ;
    ons:limitation "Valor máximo de 6609. Valor máximo de 222890. Valor máximo de 204."@pt ;
    dct:source <https://dados.ons.org.br/dataset/energia-vertida-turbinavel> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/energia_vertida_turbinavel_ho/*.parquet" ;
    skos:altLabel "quanta energia foi desperdicada"@pt ;
    skos:altLabel "agua vertida que daria energia"@pt ;
    skos:altLabel "perda por vertimento"@pt ;
    skos:altLabel "geracao perdida na hidraulica"@pt ;
    ons:exampleQuestion "Quais usinas tiveram maior energia vertida turbinável no verão de 2024?"@pt ;
    ons:exampleQuestion "Qual foi a perda acumulada de geração por vertimento turbinável no subsistema Sudeste em 2023?"@pt ;
    ons:exampleQuestion "Em quais horas do dia ocorrem mais eventos de vertimento turbinável na bacia do Paraná?"@pt ;
    ons:exampleQuestion "Qual a relação entre afluência e energia vertida turbinável em Itaipu nos últimos 5 anos?"@pt ;
    ons:exampleQuestion "Quais usinas apresentam maior produtividade específica média e ainda assim registram vertimento turbinável?"@pt ;
    ons:exampleQuestion "Quais usinas desperdisaram mais agua em vertimento na bacia do Paraná?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver perdas de geração por vertimento hidráulico, aproveitamento de vazões turináveis, eficiência operacional de usinas hidrelétricas ou análise de oportunidades de geração não aproveitadas. Também relevante para perguntas sobre balanço hídrico horário por usina, produtividade específica e correlação entre vertimento e despacho no SIN."@pt ;
    ons:agentInstruction "- [val_energiavertidaturbinavel] Valor máximo de 6.609,19 MWmed é extremamente elevado para uma única usina em um intervalo horário. Pode representar grandes usinas como Itaipu em situações excepcionais de cheia, mas merece validação para identificar possíveis erros de consolidação.\n\n- [val_vazaoturbinada] Valor máximo de 222.890 m³/s é excepcionalmente alto. A vazão turbinada máxima de Itaipu é ~17.000 m³/s; valores acima de 50.000 m³/s merecem investigação para descartar erros de escala ou unidade no dataset energia-vertida-turbinavel.\n\n- [val_produtividade] Valor máximo de 204,63 MW/(m³/s) é muito superior ao esperado para usinas hidrelétricas brasileiras (tipicamente 0,5–1,5 MW/(m³/s)). Pode indicar erro de unidade, divisão por vazão próxima de zero ou problema de consolidação no dataset energia-vertida-turbinavel.\n\n- [val_vazaovertidanaoturbinavel] Máximo de 1.506 m³/s é muito inferior ao máximo de val_vazaovertida (41.498 m³/s), confirmando que a maior parte do vertimento é turbinável. Verificar se registros com val_vazaovertidanaoturbinavel > 0 e val_vazaovertidaturbinavel = 0 são consistentes no dataset energia-vertida-turbinavel.\n\n- [din_instante] Dataset cobre 11+ anos com atualização diária. Possíveis lacunas horárias por falhas de telemetria ou reprocessamento. A partir de 2024 os arquivos são mensais (MES-ANO), o que pode gerar descontinuidades na transição de arquivos anuais para mensais no dataset energia-vertida-turbinavel.\n\n- [val_geracao] Valor máximo de 14.147,78 MWmed próximo à capacidade instalada de Itaipu (~14.000 MW). Verificar se existem registros com val_geracao > val_disponibilidade no dataset energia-vertida-turbinavel, pois indicariam inconsistência lógica.\n\n- [val_energiavertida] Verificar consistência entre val_energiavertida (total) e val_energiavertidaturbinavel (parcela). Registros onde val_energiavertida < val_energiavertidaturbinavel indicam inconsistência lógica no dataset energia-vertida-turbinavel (total menor que parcela turbinável).\n\n- [val_folgadegeracao] Valor máximo de 8.688,58 MWmed é muito elevado. Verificar se registros com val_folgadegeracao > val_disponibilidade existem no dataset energia-vertida-turbinavel, pois indicariam folga maior que a própria disponibilidade — inconsistência lógica.\n\n- [cod_usina] A chave primária natural é (cod_usina, din_instante). Verificar se existem registros duplicados para a mesma usina no mesmo instante horário no dataset energia-vertida-turbinavel, o que indicaria problema no processo de consolidação ou ingestão dos arquivos parquet.\n"@pt ;
    dct:accrualPeriodicity "horária" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/energia_vertida_turbinavel_ho/*.parquet', union_by_name=true)" ;
