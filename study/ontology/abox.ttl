<https://w3id.org/tiago-ons/data/metric/fator_capacidade_2/geracaoprogramada>
    a ons:Metric ;
    skos:prefLabel "Geracaoprogramada"@pt ;
    skos:altLabel "geração programada"@pt ;
    skos:altLabel "programação geração"@pt ;
    skos:altLabel "geração prevista"@pt ;
    skos:altLabel "programa geração"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/fator_capacidade_2/val_geracaoprogramada> ;
    ons:expression "TRY_CAST(val_geracaoprogramada AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "1.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(val_geracaoprogramada AS DOUBLE)) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_geracaoprogramada AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_geracaoprogramada AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_geracaoprogramada AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(val_geracaoprogramada AS DOUBLE)) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_geracaoprogramada AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

