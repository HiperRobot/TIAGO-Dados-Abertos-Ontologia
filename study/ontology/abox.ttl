<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_ft_conversor/pattern_dispftconv_serie_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "dispftconv_serie_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(dat_referencia AS TIMESTAMP)) AS mes,\n  cod_caracteristica,\n  AVG(val_dispftconv) AS disponibilidade_media_pct\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(dat_referencia AS TIMESTAMP)) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_ft_conversor/dispftconv> .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_ft_conversor/pattern_dispftconv_por_caracteristica>
    a ons:QueryTemplate ;
    skos:prefLabel "dispftconv_por_caracteristica" ;
    ons:sqlTemplate "SELECT cod_caracteristica,\n  AVG(val_dispftconv) AS disponibilidade_media_pct,\n  MIN(val_dispftconv) AS disponibilidade_minima_pct,\n  MAX(val_dispftconv) AS disponibilidade_maxima_pct\nFROM {source}\nWHERE dat_referencia BETWEEN {start_date} AND {end_date}\nGROUP BY 1\nORDER BY 2 ASC" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_ft_conversor/dispftconv> .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_ft_conversor/pattern_dispftconv_indisponibilidade_total>
    a ons:QueryTemplate ;
    skos:prefLabel "dispftconv_indisponibilidade_total" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(dat_referencia AS TIMESTAMP)) AS mes,\n  cod_caracteristica,\n  val_dispftconv AS disponibilidade_pct\nFROM {source}\nWHERE val_dispftconv = 0\nORDER BY 1, 2" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_ft_conversor/dispftconv> .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_ft_conversor/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT cod_caracteristica, DATE_TRUNC('month', TRY_CAST(dat_referencia AS TIMESTAMP)) AS mes_referencia, val_dispftconv FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_disponibilidade_ft_conversor_me/*.parquet') ORDER BY cod_caracteristica, mes_referencia;" ;
    ons:exampleQuestion "Como evoluiu mensalmente o indicador de disponibilidade dos conversores por característica técnica entre 2023 e 2026?"@pt .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_ft_conversor/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT cod_caracteristica, YEAR(dat_referencia) AS ano, ROUND(AVG(val_dispftconv), 2) AS media_disponibilidade_pct, MIN(val_dispftconv) AS min_disponibilidade_pct, MAX(val_dispftconv) AS max_disponibilidade_pct, COUNT(*) AS qtd_meses FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_disponibilidade_ft_conversor_me/*.parquet') GROUP BY cod_caracteristica, YEAR(dat_referencia) ORDER BY cod_caracteristica, ano;" ;
    ons:exampleQuestion "Qual foi a disponibilidade média anual dos conversores por característica técnica em cada ano?"@pt .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_ft_conversor/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT cod_caracteristica, dat_referencia, val_dispftconv, ROUND(100.0 - val_dispftconv, 2) AS indisponibilidade_pct FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_disponibilidade_ft_conversor_me/*.parquet') WHERE val_dispftconv < 95.0 ORDER BY val_dispftconv ASC, dat_referencia;" ;
    ons:exampleQuestion "Quais meses apresentaram disponibilidade de conversores abaixo de 95%?"@pt .

<https://w3id.org/tiago-ons/data/dataset/ind_disponibilidade_ft_reativo>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:ind_disponibilidade_ft_reativo" ;
    dct:title "ind_disponibilidade_ft_reativo" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/transmissao> ;
    dcat:keyword "DISP"@pt ;
    dcat:keyword "DISP reativo"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "Submódulo-9.2"@pt ;
    dcat:keyword "controle-de-reativo"@pt ;
    dcat:keyword "disponibilidade"@pt ;
    dcat:keyword "disponibilidade FT reativo"@pt ;
    dcat:keyword "disponibilidade equipamentos controle reativo transmissão"@pt ;
    dcat:keyword "disponibilidade equipamentos reativos ONS"@pt ;
    dcat:keyword "equipamentos-reativos"@pt ;
    dcat:keyword "função-transmissão"@pt ;
    dcat:keyword "ind_disp_ft_reativo"@pt ;
    dcat:keyword "indicador disponibilidade reativo"@pt ;
    dcat:keyword "indicadores-operacionais"@pt ;
    dcat:keyword "mensal"@pt ;
    dcat:keyword "transmissão"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Subsidiar agentes de transmissão, reguladores (ANEEL) e o próprio ONS no monitoramento do desempenho operacional mensal dos equipamentos de controle de reativo da rede básica brasileira, permitindo identificar categorias com baixa disponibilidade, fundamentar decisões de manutenção preventiva e corretiva, calcular penalidades contratuais previstas no Submódulo 9.2 dos Procedimentos de Rede, e apoiar o planejamento da expansão e modernização da infraestrutura de transmissão de energia elétrica."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver indicadores de disponibilidade (DISP) de equipamentos de controle de reativo (reatores, capacitores, compensadores estáticos) da rede de transmissão brasileira em base mensal."@pt ;
    ons:limitation "A coluna é do tipo TIMESTAMP, porém os dados têm granularidade mensal e as datas correspondem sempre ao primeiro dia do mês (ex: 2023-01-01 00:00:00). O valor mínimo de val_dispf é 0. Não há dicionário de dados publicado no CKAN para este dataset."@pt ;
    dct:source <https://dados.ons.org.br/dataset/ind_disponibilidade_ft_reativo> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/ind_disponibilidade_ft_reativo_me/*.parquet" ;
    skos:altLabel "disponibilidade dos equipamentos de reativo"@pt ;
    skos:altLabel "capacitores e reatores disponiveis"@pt ;
    ons:exampleQuestion "Qual foi a disponibilidade média dos equipamentos de controle de reativo por característica nos últimos 12 meses?"@pt ;
    ons:exampleQuestion "Quais características de equipamentos reativos apresentaram disponibilidade abaixo de 90% em algum mês?"@pt ;
    ons:exampleQuestion "Como evoluiu o indicador DISP dos equipamentos reativos de 500 kV ao longo do tempo?"@pt ;
    ons:exampleQuestion "Quais meses registraram indisponibilidade total (val_dispf = 0) para alguma categoria de equipamento reativo?"@pt ;
    ons:exampleQuestion "Como comparar a disponibilidade de equipamentos reativos com a disponibilidade de transformadores no mesmo período?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver indicadores de disponibilidade (DISP) de equipamentos de controle de reativo (reatores, capacitores, compensadores estáticos) da rede de transmissão brasileira em base mensal. Também relevante quando a análise requer comparação de desempenho entre categorias técnicas de equipamentos reativos por nível de tensão, cálculo de penalidades contratuais do Submódulo 9.2, ou monitoramento de metas de disponibilidade de Funções Transmissão para equipamentos reativos."@pt ;
    ons:agentInstruction "- [val_dispf] O valor mínimo registrado é 0.0, indicando indisponibilidade total de alguma característica de equipamento de reativo em determinado mês. Embora tecnicamente válido, valores iguais a 0.0 podem representar ausência de equipamentos daquela característica no período ou falha de reporte.\n\n- [dat_referencia] Verificar se há meses faltantes na série temporal a partir de 2023-01-01 para cada cod_caracteristica. Com 774 linhas e aproximadamente 19 características, a cobertura média é de 40 meses por característica, mas pode haver lacunas para características específicas introduzidas ou descontinuadas ao longo do período.\n\n- [cod_caracteristica] Verificar a existência de variações de grafia, espaços extras ou inconsistências de capitalização nos valores de cod_caracteristica, que poderiam gerar duplicatas lógicas na chave primária composta e distorcer análises de séries temporais por tipo de equipamento.\n"@pt ;
    dct:accrualPeriodicity "horária" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/ind_disponibilidade_ft_reativo_me/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2023-01-01/" ;
    ons:spatialGrain ons:SIN ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_reativo/cod_caracteristica> ;
    ons:rowKey <https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_reativo/cod_caracteristica> ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_reativo/dat_referencia> ;
    ons:rowKey <https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_reativo/dat_referencia> ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_reativo/val_dispf> ;
    ons:hasPerspective <https://w3id.org/tiago-ons/data/perspective/verificado> ;
    ons:inFamily <https://w3id.org/tiago-ons/data/family/ind_disponibilidade_ft> ;
