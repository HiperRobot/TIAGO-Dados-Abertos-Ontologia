<https://w3id.org/tiago-ons/data/column/ena_diario_por_subsistema/id_subsistema>
    a ons:Column ;
    dct:title "id_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificador alfanumérico do subsistema elétrico do SIN (Sistema Interligado Nacional). Representa a sigla do subsistema (SE, S, NE, N). Utilizado como chave de join com outros datasets do ONS que referenciam subsistemas."@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "sigla_subsistema"@pt ;
    skos:altLabel "cod_subsistema"@pt ;
    skos:altLabel "regiao"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "N" ;
    ons:allowedValue "NE" ;
    ons:allowedValue "S" ;
    ons:allowedValue "SE" .

<https://w3id.org/tiago-ons/data/column/ena_diario_por_subsistema/nom_subsistema>
    a ons:Column ;
    dct:title "nom_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome completo do subsistema elétrico correspondente ao id_subsistema. Identifica a região geográfica do SIN à qual os dados de ENA se referem."@pt ;
    skos:altLabel "nome_subsistema"@pt ;
    skos:altLabel "nome_regiao"@pt ;
    skos:altLabel "regiao"@pt ;
    skos:altLabel "subsistema"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "NORDESTE" ;
    ons:allowedValue "NORTE" ;
    ons:allowedValue "SUDESTE" ;
    ons:allowedValue "SUL" .

<https://w3id.org/tiago-ons/data/column/ena_diario_por_subsistema/ena_data>
    a ons:Column ;
    dct:title "ena_data" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Data de referência da medição da Energia Natural Afluente. Tipada como VARCHAR no schema físico Parquet, mas representa datas no formato ISO 8601 (YYYY-MM-DD). Requer CAST explícito para DATE em queries que envolvam ordenação temporal, filtros por intervalo de datas, funções de data (date_trunc, YEAR, MONTH) ou joins temporais com outros datasets."@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "data_ena"@pt ;
    skos:altLabel "data_referencia"@pt ;
    skos:altLabel "dt_referencia"@pt ;
    skos:altLabel "din_referencia"@pt ;
    ons:semanticRole "DIMENSION" .

<https://w3id.org/tiago-ons/data/column/ena_diario_por_subsistema/ena_bruta_regiao_mwmed>
    a ons:Column ;
    dct:title "ena_bruta_regiao_mwmed" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Energia Natural Afluente Bruta do subsistema expressa em MWmed (megawatts médios). Calculada pelo produto das vazões naturais afluentes aos reservatórios pelas produtividades a 65% dos volumes úteis das usinas hidrelétricas da região. Representa o potencial energético total das afluências, sem desconto de vertimentos. Não deve assumir valores negativos — valores negativos indicam possível erro de dados."@pt ;
    ons:castExpression "TRY_CAST(ena_bruta_regiao_mwmed AS DOUBLE)" ;
    skos:altLabel "ena_bruta"@pt ;
    skos:altLabel "ena_bruta_mwmed"@pt ;
    skos:altLabel "energia_natural_afluente_bruta"@pt ;
    skos:altLabel "ena_bruta_regiao"@pt ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/ena_diario_por_subsistema/ena_bruta_regiao_percentualmlt>
    a ons:Column ;
    dct:title "ena_bruta_regiao_percentualmlt" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Energia Natural Afluente Bruta do subsistema expressa como percentual da Média de Longo Termo (MLT). Indica o desvio relativo da afluência bruta em relação à média histórica de longo prazo para aquele subsistema e período do ano. Valores acima de 100% indicam afluência acima da média histórica."@pt ;
    ons:castExpression "TRY_CAST(ena_bruta_regiao_percentualmlt AS DOUBLE)" ;
    skos:altLabel "ena_bruta_percentual_mlt"@pt ;
    skos:altLabel "ena_bruta_pct_mlt"@pt ;
    skos:altLabel "percentual_mlt_bruta"@pt ;
    skos:altLabel "ena_bruta_mlt"@pt ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent_mlt> .

<https://w3id.org/tiago-ons/data/column/ena_diario_por_subsistema/ena_armazenavel_regiao_mwmed>
    a ons:Column ;
    dct:title "ena_armazenavel_regiao_mwmed" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Energia Natural Afluente Armazenável do subsistema expressa em MWmed (megawatts médios). Calculada a partir das vazões naturais descontadas das vazões vertidas nos reservatórios, representando a parcela da afluência que efetivamente pode ser armazenada e convertida em energia futura. Pode assumir valores negativos em situações de vertimento intenso, mas valores muito negativos devem ser investigados."@pt ;
    ons:castExpression "TRY_CAST(ena_armazenavel_regiao_mwmed AS DOUBLE)" ;
    skos:altLabel "ena_armazenavel"@pt ;
    skos:altLabel "ena_armazenavel_mwmed"@pt ;
    skos:altLabel "energia_armazenavel"@pt ;
    skos:altLabel "ena_arm_mwmed"@pt ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/ena_diario_por_subsistema/ena_armazenavel_regiao_percentualmlt>
    a ons:Column ;
    dct:title "ena_armazenavel_regiao_percentualmlt" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Energia Natural Afluente Armazenável do subsistema expressa como percentual da Média de Longo Termo (MLT). Indica o desvio relativo da afluência armazenável em relação à média histórica de longo prazo. É o indicador mais relevante para avaliação das condições de armazenamento dos reservatórios e projeção do CMO."@pt ;
    ons:castExpression "TRY_CAST(ena_armazenavel_regiao_percentualmlt AS DOUBLE)" ;
    skos:altLabel "ena_armazenavel_percentual_mlt"@pt ;
    skos:altLabel "ena_armazenavel_pct_mlt"@pt ;
    skos:altLabel "percentual_mlt_armazenavel"@pt ;
    skos:altLabel "ena_arm_mlt"@pt ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent_mlt> .

<https://w3id.org/tiago-ons/data/dimension/ena_diario_por_subsistema/subsistema>
    a ons:Dimension ;
    skos:prefLabel "subsistema" ;
    ons:onColumn <https://w3id.org/tiago-ons/data/column/ena_diario_por_subsistema/id_subsistema> ;
    ons:refersTo ons:Subsistema .

<https://w3id.org/tiago-ons/data/metric/ena_diario_por_subsistema/ena_bruta_regiao_mwmed>
    a ons:Metric ;
    skos:prefLabel "ENA Bruta por Subsistema (MWmed)"@pt ;
    skos:altLabel "ena_bruta"@pt ;
    skos:altLabel "ena_bruta_mwmed"@pt ;
    skos:altLabel "energia_natural_afluente_bruta"@pt ;
    skos:altLabel "ena_bruta_regiao"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ena_diario_por_subsistema/ena_bruta_regiao_mwmed> ;
    ons:expression "ena_bruta_regiao_mwmed" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(ena_bruta_regiao_mwmed AS DOUBLE)) * 24.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_regiao_mwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(ena_bruta_regiao_mwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_regiao_mwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(ena_bruta_regiao_mwmed AS DOUBLE)) * 24.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_regiao_mwmed AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

<https://w3id.org/tiago-ons/data/metric/ena_diario_por_subsistema/ena_bruta_regiao_percentualmlt>
    a ons:Metric ;
    skos:prefLabel "ENA Bruta % MLT por Subsistema"@pt ;
    skos:altLabel "ena_bruta_percentual_mlt"@pt ;
    skos:altLabel "ena_bruta_pct_mlt"@pt ;
    skos:altLabel "percentual_mlt_bruta"@pt ;
    skos:altLabel "ena_bruta_mlt"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ena_diario_por_subsistema/ena_bruta_regiao_percentualmlt> ;
    ons:expression "ena_bruta_regiao_percentualmlt" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/ratio> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/avg> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_regiao_percentualmlt AS DOUBLE))\", \"unit\": \"%MLT\"}, \"maximum\": {\"sql\": \"MAX(TRY_CAST(ena_bruta_regiao_percentualmlt AS DOUBLE))\", \"unit\": \"%MLT\"}, \"minimum\": {\"sql\": \"MIN(TRY_CAST(ena_bruta_regiao_percentualmlt AS DOUBLE))\", \"unit\": \"%MLT\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_regiao_percentualmlt AS DOUBLE))\", \"unit\": \"%MLT\"}, \"ranking\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_regiao_percentualmlt AS DOUBLE))\", \"unit\": \"%MLT\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_regiao_percentualmlt AS DOUBLE))\", \"unit\": \"%MLT\"}}" .

