<https://w3id.org/tiago-ons/data/template/ear_diario_por_ree_reservatorio_equivalente_de_energia/pattern_ear_verif_ree_mwmes_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "ear_verif_ree_mwmes_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(ear_data AS DATE)) AS mes,\n  nom_ree,\n  AVG(TRY_CAST(ear_verif_ree_mwmes AS DOUBLE)) AS ear_media_mwmes\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(ear_data AS DATE)) = 2024\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "MWmes" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_verif_ree_mwmes> .

<https://w3id.org/tiago-ons/data/template/ear_diario_por_ree_reservatorio_equivalente_de_energia/pattern_ear_percentual_serie_diaria>
    a ons:QueryTemplate ;
    skos:prefLabel "ear_percentual_serie_diaria" ;
    ons:sqlTemplate "SELECT TRY_CAST(ear_data AS DATE) AS data,\n  nom_ree,\n  ear_verif_ree_percentual\nFROM {source}\nWHERE nom_ree = '{nom_ree}'\n  AND TRY_CAST(ear_data AS DATE) BETWEEN '{data_inicio}' AND '{data_fim}'\nORDER BY 1\n" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_verif_ree_percentual> .

<https://w3id.org/tiago-ons/data/template/ear_diario_por_ree_reservatorio_equivalente_de_energia/pattern_ear_abaixo_threshold>
    a ons:QueryTemplate ;
    skos:prefLabel "ear_abaixo_threshold" ;
    ons:sqlTemplate "SELECT nom_ree,\n  TRY_CAST(ear_data AS DATE) AS data,\n  TRY_CAST(ear_verif_ree_percentual AS DOUBLE) AS ear_percentual\nFROM {source}\nWHERE TRY_CAST(ear_data AS DATE) >= CURRENT_DATE - INTERVAL '7 days'\n  AND TRY_CAST(ear_verif_ree_percentual AS DOUBLE) < 50\nORDER BY ear_percentual ASC" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_verif_ree_percentual> .

<https://w3id.org/tiago-ons/data/template/ear_diario_por_ree_reservatorio_equivalente_de_energia/pattern_ear_percentual_calculado_auditoria>
    a ons:QueryTemplate ;
    skos:prefLabel "ear_percentual_calculado_auditoria" ;
    ons:sqlTemplate "SELECT TRY_CAST(ear_data AS DATE) AS data,\n  nom_ree,\n  TRY_CAST(ear_verif_ree_percentual AS DOUBLE) AS percentual_publicado,\n  TRY_CAST(ear_verif_ree_mwmes AS DOUBLE) / NULLIF(TRY_CAST(ear_max_ree AS DOUBLE), 0) * 100 AS percentual_calculado\nFROM {source}\nWHERE TRY_CAST(ear_data AS DATE) >= CURRENT_DATE - INTERVAL '30 days'\nORDER BY data DESC" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_percentual_calculado> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_verif_ree_percentual> .

<https://w3id.org/tiago-ons/data/template/ear_diario_por_ree_reservatorio_equivalente_de_energia/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT nom_ree, TRY_CAST(ear_data AS DATE) AS ear_data_date, ear_verif_ree_percentual FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ear_ree_di/*.parquet') WHERE TRY_CAST(ear_data AS DATE) >= DATE '2024-01-01' AND TRY_CAST(ear_data AS DATE) <= DATE '2024-12-31' AND ear_verif_ree_percentual >= 0 ORDER BY nom_ree, ear_data_date LIMIT 2000" ;
    ons:exampleQuestion "Como evoluiu o percentual de armazenamento de cada REE ao longo de 2024?"@pt .

<https://w3id.org/tiago-ons/data/template/ear_diario_por_ree_reservatorio_equivalente_de_energia/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "WITH ranked AS ( SELECT nom_ree, TRY_CAST(ear_data AS DATE) AS ear_data_date, ear_verif_ree_mwmes, ear_verif_ree_percentual, ROW_NUMBER() OVER ( PARTITION BY nom_ree ORDER BY ear_verif_ree_percentual ASC ) AS rn FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ear_ree_di/*.parquet') WHERE ear_verif_ree_percentual >= 0 ) SELECT nom_ree, ear_data_date, ear_verif_ree_mwmes, ear_verif_ree_percentual FROM ranked WHERE rn <= 10 ORDER BY nom_ree, ear_verif_ree_percentual ASC" ;
    ons:exampleQuestion "Quais foram os 10 dias com menor percentual de armazenamento em cada REE desde 2016?"@pt .

<https://w3id.org/tiago-ons/data/template/ear_diario_por_ree_reservatorio_equivalente_de_energia/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT nom_ree, DATE_TRUNC('month', TRY_CAST(ear_data AS DATE)) AS mes_referencia, ROUND(AVG(TRY_CAST(ear_verif_ree_mwmes AS DOUBLE)), 2) AS ear_media_mwmes, ROUND(AVG(ear_verif_ree_percentual), 2) AS ear_media_percentual, ROUND(MIN(ear_verif_ree_percentual), 2) AS ear_min_percentual, ROUND(MAX(ear_verif_ree_percentual), 2) AS ear_max_percentual FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ear_ree_di/*.parquet') WHERE TRY_CAST(ear_data AS DATE) IS NOT NULL AND ear_verif_ree_mwmes >= 0 GROUP BY nom_ree, DATE_TRUNC('month', TRY_CAST(ear_data AS DATE)) ORDER BY nom_ree, mes_referencia" ;
    ons:exampleQuestion "Qual é a média mensal de armazenamento em MWmês por REE para identificar padrões sazonais?"@pt .

<https://w3id.org/tiago-ons/data/dataset/ear_diario_por_reservatorio>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:ear-diario-por-reservatorio" ;
    dct:title "ear-diario-por-reservatorio" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/reservatorio> ;
    dcat:keyword "EAR"@pt ;
    dcat:keyword "EAR diario"@pt ;
    dcat:keyword "EAR por usina"@pt ;
    dcat:keyword "EAR reservatorio diario"@pt ;
    dcat:keyword "MWmes"@pt ;
    dcat:keyword "REE"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "armazenamento hidreletrico"@pt ;
    dcat:keyword "bacia-hidrografica"@pt ;
    dcat:keyword "diario"@pt ;
    dcat:keyword "energia armazenada reservatorio"@pt ;
    dcat:keyword "energia-armazenada"@pt ;
    dcat:keyword "hidreletrica"@pt ;
    dcat:keyword "nivel reservatorio"@pt ;
    dcat:keyword "reservatorio"@pt ;
    dcat:keyword "subsistema"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Prover a série histórica diária de energia armazenada por reservatório hidrelétrico para uso de geradores, comercializadores, agentes do mercado de energia e pesquisadores do setor elétrico brasileiro. Suporta estudos energéticos, projeção do Custo Marginal de Operação (CMO), acompanhamento da segurança energética do SIN, análise de risco hidrológico, planejamento da operação hidrotérmica e validação de modelos como NEWAVE e DECOMP. Decisões de despacho, contratação de energia e gestão de reservatórios dependem diretamente desta série."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver energia armazenada, nível de reservatório, percentual de armazenamento ou capacidade hídrica de usinas hidrelétricas individuais em base diária."@pt ;
    ons:limitation "Coluna de data tipada como VARCHAR no schema físico DuckDB, devendo ser DATE. cod_resplanejamento apresenta poucos nulos. ear_reservatorio_subsistema_proprio_mwmes apresenta nulos em parte das linhas, possivelmente reservatórios sem dados históricos completos no início da série (próximo a 2000-01-01)."@pt ;
    dct:source <https://dados.ons.org.br/dataset/ear-diario-por-reservatorio> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/ear_reservatorio_di/*.parquet" ;
    skos:altLabel "nivel do reservatorio da usina"@pt ;
    skos:altLabel "armazenamento de cada usina"@pt ;
    skos:altLabel "quanto cada represa tem armazenado"@pt ;
    ons:exampleQuestion "Qual foi o percentual de armazenamento do reservatório de Furnas nos últimos 30 dias?"@pt ;
    ons:exampleQuestion "Quais reservatórios do subsistema Sudeste estavam abaixo de 30% de capacidade em janeiro de 2021?"@pt ;
    ons:exampleQuestion "Como evoluiu a EAR total dos reservatórios da bacia do Paraná entre 2015 e 2020?"@pt ;
    ons:exampleQuestion "Quais são os 10 reservatórios com maior contribuição para a EAR do SIN hoje?"@pt ;
    ons:exampleQuestion "Qual a diferença entre a EAR do subsistema próprio e à jusante para reservatórios de cascata inter-subsistemas?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver energia armazenada, nível de reservatório, percentual de armazenamento ou capacidade hídrica de usinas hidrelétricas individuais em base diária. Também relevante para análises de cascata, contribuição de reservatórios para subsistemas ou SIN, e correlação entre armazenamento e risco hidrológico. Preferir sobre ear-diario-por-subsistema quando a granularidade espacial requerida for o reservatório individual, não o subsistema agregado."@pt ;
    ons:agentInstruction "- [ear_data] Coluna de data tipada como VARCHAR no schema físico DuckDB, devendo ser DATE. Filtros e ordenações temporais diretas podem falhar ou produzir resultados incorretos sem conversão explícita.\n\n- [cod_resplanejamento] Código de planejamento apresenta poucos nulos. Reservatórios sem código não podem ser utilizados em joins com modelos de planejamento (NEWAVE/DECOMP) que referenciam este identificador.\n\n- [ear_reservatorio_subsistema_proprio_mwmes] Apresenta nulos em parte das linhas, possivelmente reservatórios sem dados históricos completos no início da série (próximo a 2000-01-01). Agregações de EAR por subsistema podem subestimar valores em datas antigas.\n\n- [ear_reservatorio_subsistema_jusante_mwmes] Apresenta nulos em boa parte das linhas — esperado para reservatórios cujo subsistema à jusante é idêntico ao próprio (id_subsistema = id_subsistema_jusante). Deve ser tratado como ausência de contribuição inter-subsistema, não como dado faltante.\n\n- [earmax_reservatorio_subsistema_proprio_mwmes] Apresenta nulos em parte das linhas, coincidindo com ear_reservatorio_subsistema_proprio_mwmes. Indica que os mesmos reservatórios sem EAR também não possuem EARmax, comprometendo o cálculo de percentual de armazenamento.\n\n- [earmax_reservatorio_subsistema_jusante_mwmes] Apresenta nulos em boa parte das linhas, espelhando ear_reservatorio_subsistema_jusante_mwmes. Reservatórios sem subsistema à jusante distinto não possuem capacidade máxima para esse componente.\n\n- [ear_reservatorio_percentual] Apresenta nulos em parte das linhas, coincidindo com as colunas de EAR e EARmax do subsistema próprio. Percentual não pode ser calculado quando EARmax é nulo ou zero.\n\n- [ear_reservatorio_percentual] Percentual de armazenamento pode ultrapassar 100% em situações de vertimento ou revisões de EARmax, ou apresentar valores negativos por inconsistências de consistência recorrente mencionada nos metadados CKAN.\n\n- [ear_total_mwmes] Energia armazenada total não deveria ser negativa. Valores negativos indicariam inconsistência no processo de consistência recorrente descrito nos metadados CKAN.\n\n- [nom_reservatorio] A chave primária natural é (nom_reservatorio, ear_data). Duplicatas nessa combinação indicariam registros redundantes ou erro de carga, comprometendo agregações e joins temporais.\n\n- [ear_data] Série diária de 26 anos pode conter lacunas temporais por reservatório. Dias faltantes afetam análises de tendência, médias móveis e modelos de previsão que assumem continuidade da série.\n\n- [tipos] As colunas `ear_maxima_total_mwmes`, `ear_reservatorio_percentual`, `ear_reservatorio_subsistema_jusante_mwmes`, `ear_reservatorio_subsistema_proprio_mwmes`, `ear_total_mwmes`, `earmax_reservatorio_subsistema_jusante_mwmes`, `earmax_reservatorio_subsistema_proprio_mwmes`, `val_contribearbacia`, `val_contribearmaxbacia`, `val_contribearmaxsin`, `val_contribearmaxsubsistema`, `val_contribearmaxsubsistemajusante`, `val_contribearsin`, `val_contribearsubsistema`, `val_contribearsubsistemajusante` mudam de tipo entre arquivos anuais (texto em uns, número em outros); cada uma traz `castExpression` no schema: use-o em toda agregação e comparação. As colunas de código `cod_resplanejamento` variam entre inteiro e decimal entre arquivos; compare-as como número, não como texto.\n"@pt ;
    dct:accrualPeriodicity "diária" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/ear_reservatorio_di/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2000-01-01/" ;
