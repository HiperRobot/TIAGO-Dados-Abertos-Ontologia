<https://w3id.org/tiago-ons/data/column/ind_providencia_ecpa_pcpa/val_ecpa>
    a ons:Column ;
    dct:title "val_ecpa" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Indicador de Evolução do Cumprimento às Providências (ECPA), calculado conforme o Submódulo 9.5 dos Procedimentos de Rede do ONS. Representa a razão entre o número de providências concluídas (num_nprc_concluidas) e o número de providências programadas (num_nprp_programadas). Varia entre 0.0 e 1.0, onde 1.0 indica cumprimento integral de todas as providências programadas."@pt ;
    skos:altLabel "ecpa"@pt ;
    skos:altLabel "evolucao do cumprimento"@pt ;
    skos:altLabel "indice ecpa"@pt ;
    skos:altLabel "cumprimento de providencias"@pt ;
    skos:altLabel "taxa de cumprimento"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/indice_normalizado_0_1> .

<https://w3id.org/tiago-ons/data/unit/indice_normalizado_0_1>
    a ons:Unit ;
    skos:prefLabel "indice_normalizado_0_1" ;
    skos:altLabel "índice normalizado [0,1]" ;
    skos:altLabel "indice normalizado [0,1]" .

<https://w3id.org/tiago-ons/data/column/ind_providencia_ecpa_pcpa/val_pcpa>
    a ons:Column ;
