<https://w3id.org/tiago-ons/data/metric/geracao_termica_despacho_2/proggeracao>
    a ons:Metric ;
    skos:prefLabel "Proggeracao"@pt ;
    skos:altLabel "geracao_programada"@pt ;
    skos:altLabel "prog_geracao"@pt ;
    skos:altLabel "geracao_prog"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/geracao_termica_despacho_2/val_proggeracao> ;
    ons:expression "TRY_CAST(val_proggeracao AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "1.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(val_proggeracao AS DOUBLE)) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_proggeracao AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_proggeracao AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_proggeracao AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(val_proggeracao AS DOUBLE)) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_proggeracao AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

