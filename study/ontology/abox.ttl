    ons:unit <https://w3id.org/tiago-ons/data/unit/min> .

<https://w3id.org/tiago-ons/data/column/ind_qualid_dfp_regime/num_desvio_dist_sobre>
    a ons:Column ;
    dct:title "num_desvio_dist_sobre" ;
    dct:type "integer" ;
    ons:physicalType "BIGINT" ;
    dct:description "Número de minutos em que a frequência do sistema ficou acima do limite superior da faixa de distúrbio (banda mais larga), conforme Submódulo 9.7 dos Procedimentos de Rede do ONS. Representa eventos de sobrefrequência severa (distúrbio) no período de referência. Valores tipicamente muito baixos (máximo histórico: 2 minutos), indicando raridade desses eventos."@pt ;
    skos:altLabel "desvio distúrbio acima"@pt ;
    skos:altLabel "sobrefrequência distúrbio"@pt ;
    skos:altLabel "minutos acima do limite de distúrbio superior"@pt ;
    skos:altLabel "desvio dist sobre"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/min> ;
    ons:allowedValue "0" ;
    ons:allowedValue "1" ;
    ons:allowedValue "2" .

<https://w3id.org/tiago-ons/data/column/ind_qualid_dfp_regime/num_desvio_dist_sub>
    a ons:Column ;
    dct:title "num_desvio_dist_sub" ;
