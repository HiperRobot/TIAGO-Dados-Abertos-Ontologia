    ons:onColumn <https://w3id.org/tiago-ons/data/column/geracao_usina_2/cod_modalidadeoperacao> ;
    skos:altLabel "tipo iii"@pt ;
    skos:altLabel "tipo 3"@pt ;
    skos:altLabel "pequenas usinas sem relacionamento ONS"@pt ;
    ons:filter "cod_modalidadeoperacao = 'TIPO III'" .

