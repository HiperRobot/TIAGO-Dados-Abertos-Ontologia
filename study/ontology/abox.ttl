<https://w3id.org/tiago-ons/data/template/taxa_teif_teip/pattern_taxa_media_mensal_por_usina>
    a ons:QueryTemplate ;
    skos:prefLabel "taxa_media_mensal_por_usina" ;
    ons:sqlTemplate "WITH dados AS (\n  SELECT * FROM {source}\n)\nSELECT nom_usina, \n       EXTRACT(YEAR FROM TRY_CAST(din_referencia AS DATE)) AS ano,\n       EXTRACT(MONTH FROM TRY_CAST(din_referencia AS DATE)) AS mes,\n       AVG(TRY_CAST(val_taxa AS DOUBLE)) AS taxa_media\nFROM dados\nWHERE din_referencia IS NOT NULL\nGROUP BY nom_usina, ano, mes\nORDER BY nom_usina, ano, mes" ;
    ons:outputUnitLabel "proporcao_0_1" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/taxa_teif_teip/taxa> .

<https://w3id.org/tiago-ons/data/template/taxa_teif_teip/pattern_ranking_usinas_teifa>
    a ons:QueryTemplate ;
    skos:prefLabel "ranking_usinas_teifa" ;
    ons:sqlTemplate "SELECT nom_usina,\n  AVG(TRY_CAST(val_taxa AS DOUBLE)) AS teifa_media\nFROM {source}\nWHERE val_taxa IS NOT NULL\nGROUP BY nom_usina\nORDER BY teifa_media DESC\nLIMIT 20" ;
    ons:outputUnitLabel "proporcao_0_1" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/taxa_teif_teip/taxa> .

<https://w3id.org/tiago-ons/data/template/taxa_teif_teip/pattern_comparacao_teifa_teip>
    a ons:QueryTemplate ;
    skos:prefLabel "comparacao_teifa_teip" ;
    ons:sqlTemplate "WITH dados AS (\n  SELECT * FROM {source}\n)\nSELECT nom_usina,\n       AVG(TRY_CAST(val_taxa AS DOUBLE)) AS taxa_media\nFROM dados\nGROUP BY nom_usina\nORDER BY taxa_media DESC" ;
    ons:outputUnitLabel "proporcao_0_1" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/taxa_teif_teip/taxa> .

<https://w3id.org/tiago-ons/data/template/taxa_teif_teip/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "WITH versao_max AS (\n  SELECT nom_usina, din_mes, nom_taxa, MAX(num_versao) AS max_versao\n  FROM read_parquet('s3://ons-aws-prod-opendata/dataset/taxa_teif_teip/*.parquet')\n  GROUP BY nom_usina, din_mes, nom_taxa\n),\ndados_recentes AS (\n  SELECT t.nom_usina, t.tip_usina, t.din_mes, t.val_taxa\n  FROM read_parquet('s3://ons-aws-prod-opendata/dataset/taxa_teif_teip/*.parquet') AS t\n  INNER JOIN versao_max AS v\n    ON t.nom_usina = v.nom_usina\n    AND t.din_mes = v.din_mes\n    AND t.nom_taxa = v.nom_taxa\n    AND t.num_versao = v.max_versao\n  WHERE t.nom_taxa = 'TEIFa'\n    AND t.din_mes >= (CURRENT_DATE - INTERVAL '12 months')\n)\nSELECT nom_usina,\n       tip_usina,\n       ROUND(AVG(val_taxa) * 100, 2) AS teifa_media_pct,\n       COUNT(*) AS meses_com_dado\nFROM dados_recentes\nGROUP BY nom_usina, tip_usina\nORDER BY teifa_media_pct DESC\nLIMIT 20;" ;
    ons:exampleQuestion "Quais usinas tiveram a maior taxa média de indisponibilidade forçada (TEIFa) nos últimos 12 meses?"@pt .

<https://w3id.org/tiago-ons/data/template/taxa_teif_teip/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "WITH versao_max AS (\n  SELECT nom_usina, din_mes, nom_taxa, MAX(num_versao) AS max_versao\n  FROM read_parquet('s3://ons-aws-prod-opendata/dataset/taxa_teif_teip/*.parquet')\n  GROUP BY nom_usina, din_mes, nom_taxa\n)\nSELECT t.tip_usina,\n       t.din_mes,\n       ROUND(AVG(t.val_taxa) * 100, 2) AS teip_media_pct,\n       COUNT(DISTINCT t.nom_usina) AS qtd_usinas\nFROM read_parquet('s3://ons-aws-prod-opendata/dataset/taxa_teif_teip/*.parquet') AS t\nINNER JOIN versao_max AS v\n  ON t.nom_usina = v.nom_usina\n  AND t.din_mes = v.din_mes\n  AND t.nom_taxa = v.nom_taxa\n  AND t.num_versao = v.max_versao\nWHERE t.nom_taxa = 'TEIP'\n  AND t.din_mes >= (CURRENT_DATE - INTERVAL '24 months')\nGROUP BY t.tip_usina, t.din_mes\nORDER BY t.din_mes ASC, t.tip_usina ASC;" ;
    ons:exampleQuestion "Como evoluiu a taxa de indisponibilidade programada (TEIP) média por tipo de usina ao longo dos últimos 24 meses?"@pt .

<https://w3id.org/tiago-ons/data/template/taxa_teif_teip/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "WITH versao_max AS (\n  SELECT nom_usina, din_mes, nom_taxa, MAX(num_versao) AS max_versao\n  FROM read_parquet('s3://ons-aws-prod-opendata/dataset/taxa_teif_teip/*.parquet')\n  GROUP BY nom_usina, din_mes, nom_taxa\n)\nSELECT t.nom_usina,\n       t.din_mes,\n       t.nom_taxa,\n       ROUND(t.val_taxa * 100, 2) AS taxa_pct\nFROM read_parquet('s3://ons-aws-prod-opendata/dataset/taxa_teif_teip/*.parquet') AS t\nINNER JOIN versao_max AS v\n  ON t.nom_usina = v.nom_usina\n  AND t.din_mes = v.din_mes\n  AND t.nom_taxa = v.nom_taxa\n  AND t.num_versao = v.max_versao\nWHERE t.tip_usina = 'UTN'\nORDER BY t.nom_usina ASC, t.din_mes ASC, t.nom_taxa ASC;" ;
    ons:exampleQuestion "Qual é a comparação entre TEIFa e TEIP das usinas nucleares (UTN) mês a mês?"@pt .

<https://w3id.org/tiago-ons/data/dataset/taxa_teif_teip_oper>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:taxa_teif_teip_oper" ;
    dct:title "taxa_teif_teip_oper" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/geracao> ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "TEIFa"@pt ;
    dcat:keyword "TEIFa_Oper"@pt ;
    dcat:keyword "TEIP_Oper"@pt ;
    dcat:keyword "confiabilidade"@pt ;
    dcat:keyword "desempenho operativo"@pt ;
    dcat:keyword "despacho centralizado"@pt ;
    dcat:keyword "disponibilidade"@pt ;
    dcat:keyword "geração"@pt ;
    dcat:keyword "indisponibilidade"@pt ;
    dcat:keyword "taxa de indisponibilidade forçada operativa"@pt ;
    dcat:keyword "taxa de indisponibilidade programada operativa"@pt ;
    dcat:keyword "usinas geradoras"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Subsidiar analistas de confiabilidade, planejadores da operação e gestores de desempenho de geração no monitoramento da disponibilidade operativa das usinas despachadas centralizadamente pelo ONS, permitindo avaliar o cumprimento de requisitos regulatórios de desempenho, identificar usinas com elevada indisponibilidade forçada ou programada, e suportar decisões de despacho centralizado e planejamento da operação do Sistema Interligado Nacional."@pt ;
    ons:usage "Recuperar este dataset quando o analista perguntar sobre indisponibilidade operativa, confiabilidade ou desempenho de usinas geradoras despachadas pelo ONS, especialmente quando mencionar TEIFa, TEIP, taxa de indisponibilidade forçada ou programada, ou quando buscar indicadores mensais de disponibilidade por usina para fins de monitoramento regulatório ou planejamento da operação."@pt ;
    ons:limitation "Poucos registros possuem cod_ceg nulo, indicando usinas sem Código de Empreendimento de Geração cadastrado no sistema ONS/ANEEL. O campo num_versao varia de 1 a 21, indicando múltiplas revisões para a mesma combinação usina/mês/taxa. O valor máximo de val_taxa é ~0."@pt ;
    dct:source <https://dados.ons.org.br/dataset/taxa_teif_teip_oper> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/taxa_teif_teip_oper/*.parquet" ;
    skos:altLabel "indisponibilidade operativa da usina"@pt ;
    skos:altLabel "desempenho operativo das usinas"@pt ;
    ons:exampleQuestion "Quais usinas tiveram maior TEIFa_Oper nos últimos 12 meses?"@pt ;
    ons:exampleQuestion "Qual a evolução mensal da TEIP_Oper das usinas hidrelétricas no subsistema Sudeste?"@pt ;
    ons:exampleQuestion "Quais usinas termelétricas apresentaram indisponibilidade forçada acima de 30% em algum mês de 2024?"@pt ;
    ons:exampleQuestion "Como comparar a TEIFa_Oper média por tipo de usina (UHE, UTE, EOL) no ano de 2023?"@pt ;
    ons:exampleQuestion "Qual a versão mais recente disponível para cada usina no mês de março de 2025?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando o analista perguntar sobre indisponibilidade operativa, confiabilidade ou desempenho de usinas geradoras despachadas pelo ONS, especialmente quando mencionar TEIFa, TEIP, taxa de indisponibilidade forçada ou programada, ou quando buscar indicadores mensais de disponibilidade por usina para fins de monitoramento regulatório ou planejamento da operação. Termos relacionados: TEIFa_Oper, TEIP_Oper, desempenho operativo, despacho centralizado."@pt ;
    ons:agentInstruction "- [cod_ceg] Poucos registros possuem cod_ceg nulo, indicando usinas sem código CEG cadastrado. Isso pode impedir joins com datasets de cadastro de empreendimentos ANEEL/ONS. Nesses casos, nom_usina deve ser usada como chave alternativa de join.\n\n- [num_versao] O campo num_versao indica múltiplas revisões (1 a 21) para o mesmo par (nom_usina, din_mes, nom_taxa). Consultas que não filtram pela versão máxima retornarão linhas duplicadas para o mesmo período/usina/taxa, inflando agregações como SUM e AVG.\n\n- [val_taxa] val_taxa atinge valor máximo de ~0.8195 (81,95%), representando indisponibilidade muito elevada para uma usina em determinado mês. Embora tecnicamente possível (usina em manutenção prolongada), valores acima de 0,5 merecem verificação para distinguir eventos reais de possíveis erros de consistência em versões intermediárias.\n\n- [din_mes] Verificar se todos os meses do período a partir de 2021-05 estão presentes para cada usina, pois ausências podem indicar usinas que entraram ou saíram do despacho centralizado, ou falhas no processo de consistência para determinados períodos.\n\n- [tip_usina] Valores com trailing spaces detectados em 'tip_usina'. Use TRIM() em filtros WHERE para evitar perda de registros."@pt ;
    dct:accrualPeriodicity "anual" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/taxa_teif_teip_oper/*.parquet', union_by_name=true)" ;
