<https://w3id.org/tiago-ons/data/column/carga_energia/id_subsistema>
    a ons:Column ;
    dct:title "id_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificador alfanumérico do subsistema elétrico do SIN. Valores típicos: SE (Sudeste/Centro-Oeste), S (Sul), NE (Nordeste), N (Norte) e SIN (Sistema Interligado Nacional — agregado total)."@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "id subsistema"@pt ;
    skos:altLabel "código subsistema"@pt ;
    skos:altLabel "sigla subsistema"@pt ;
    skos:altLabel "região elétrica"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "N" ;
    ons:allowedValue "NE" ;
    ons:allowedValue "S" ;
    ons:allowedValue "SE" .

<https://w3id.org/tiago-ons/data/column/carga_energia/nom_subsistema>
    a ons:Column ;
    dct:title "nom_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome completo do subsistema elétrico correspondente ao id_subsistema. Exemplos: \"Sudeste / Centro-Oeste\", \"Sul\", \"Nordeste\", \"Norte\", \"Sistema Interligado Nacional\"."@pt ;
    skos:altLabel "nome subsistema"@pt ;
    skos:altLabel "subsistema nome"@pt ;
    skos:altLabel "região"@pt ;
    skos:altLabel "nome região elétrica"@pt ;
