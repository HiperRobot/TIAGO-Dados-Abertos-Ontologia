    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM(val_geracaoreferencia * num_minutos_rel / 60.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(val_geracaoreferencia)\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(val_geracaoreferencia)\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(val_geracaoreferencia)\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM(val_geracaoreferencia * num_minutos_rel / 60.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(val_geracaoreferencia)\", \"unit\": \"MWmed\"}}" .

