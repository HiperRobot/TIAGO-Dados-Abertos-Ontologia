<https://w3id.org/tiago-ons/data/template/subestacao/pattern_list_by_tensao>
    a ons:QueryTemplate ;
    skos:prefLabel "list_by_tensao" ;
    ons:sqlTemplate "SELECT nom_subestacao, nom_subsistema, nom_estado, nom_agente_principal, TRY_CAST(val_niveltensao AS DOUBLE) AS tensao_kv FROM {source} WHERE TRY_CAST(val_niveltensao AS DOUBLE) = {tensao} ORDER BY nom_subestacao" .

<https://w3id.org/tiago-ons/data/template/subestacao/pattern_count_by_agente>
    a ons:QueryTemplate ;
    skos:prefLabel "count_by_agente" ;
    ons:sqlTemplate "SELECT nom_agente_principal, COUNT(*) AS qtd_subestacoes FROM {source} GROUP BY nom_agente_principal ORDER BY qtd_subestacoes DESC" .

<https://w3id.org/tiago-ons/data/template/subestacao/pattern_list_by_estado>
    a ons:QueryTemplate ;
    skos:prefLabel "list_by_estado" ;
    ons:sqlTemplate "SELECT nom_subestacao, nom_subsistema, nom_agente_principal, TRY_CAST(val_niveltensao AS DOUBLE) AS tensao_kv FROM {source} WHERE id_estado = '{uf}' ORDER BY nom_subestacao" .

<https://w3id.org/tiago-ons/data/template/subestacao/pattern_distribuicao_por_tensao>
    a ons:QueryTemplate ;
    skos:prefLabel "distribuicao_por_tensao" ;
    ons:sqlTemplate "SELECT TRY_CAST(val_niveltensao AS DOUBLE) AS tensao_kv, COUNT(*) AS qtd_subestacoes FROM {source} GROUP BY tensao_kv ORDER BY tensao_kv" .

<https://w3id.org/tiago-ons/data/template/subestacao/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_subsistema, val_niveltensao, COUNT(*) AS qtd_subestacoes FROM read_parquet('s3://ons-aws-prod-opendata/dataset/subestacao/*.parquet') GROUP BY id_subsistema, nom_subsistema, val_niveltensao ORDER BY id_subsistema, val_niveltensao DESC;" ;
    ons:exampleQuestion "Qual a distribuição de subestações por subsistema elétrico e nível de tensão base?"@pt .

<https://w3id.org/tiago-ons/data/template/subestacao/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT nom_agente_principal, id_subsistema, nom_subsistema, COUNT(*) AS qtd_subestacoes, MIN(val_niveltensao) AS tensao_min_kv, MAX(val_niveltensao) AS tensao_max_kv FROM read_parquet('s3://ons-aws-prod-opendata/dataset/subestacao/*.parquet') GROUP BY nom_agente_principal, id_subsistema, nom_subsistema ORDER BY qtd_subestacoes DESC;" ;
    ons:exampleQuestion "Quantas subestações cada agente de transmissão opera e em quais subsistemas?"@pt .

<https://w3id.org/tiago-ons/data/template/subestacao/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT id_subestacao, nom_subestacao, nom_agente_principal, id_estado, nom_estado, id_subsistema, val_niveltensao, TRY_CAST(val_latitude AS DOUBLE) AS lat, TRY_CAST(val_longitude AS DOUBLE) AS lon FROM read_parquet('s3://ons-aws-prod-opendata/dataset/subestacao/*.parquet') WHERE val_niveltensao >= 500 AND TRY_CAST(val_latitude AS DOUBLE) BETWEEN -33.75 AND 5.27 AND TRY_CAST(val_longitude AS DOUBLE) BETWEEN -73.99 AND -34.79 ORDER BY val_niveltensao DESC, nom_subestacao;" ;
    ons:exampleQuestion "Quais são as coordenadas geográficas das subestações de 500 kV ou superior?"@pt .

<https://w3id.org/tiago-ons/data/dataset/taxa_teif_teip>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:taxa_teif_teip" ;
    dct:title "taxa_teif_teip" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/geracao> ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "TEIFa"@pt ;
    dcat:keyword "TEIFa TEIP indisponibilidade usinas geradoras ONS"@pt ;
    dcat:keyword "TEIP"@pt ;
    dcat:keyword "confiabilidade"@pt ;
    dcat:keyword "despacho centralizado"@pt ;
    dcat:keyword "indisponibilidade"@pt ;
    dcat:keyword "indisponibilidade de usinas"@pt ;
    dcat:keyword "indisponibilidade forçada"@pt ;
    dcat:keyword "manutenção programada"@pt ;
    dcat:keyword "qualidade operacional"@pt ;
    dcat:keyword "taxa de indisponibilidade forçada"@pt ;
    dcat:keyword "taxa de indisponibilidade programada"@pt ;
    dcat:keyword "usinas geradoras"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Subsidiar analistas de confiabilidade, planejadores do sistema elétrico e operadores do ONS no monitoramento do desempenho operacional das usinas geradoras despachadas centralizadamente, permitindo avaliar riscos de indisponibilidade forçada e programada, apoiar decisões de manutenção, identificar usinas com histórico crítico de falhas e compor indicadores de confiabilidade do parque gerador brasileiro para o planejamento da operação e expansão do sistema elétrico."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver confiabilidade, indisponibilidade forçada ou programada, desempenho operacional ou taxas TEIFa/TEIP de usinas geradoras despachadas centralizadamente pelo ONS."@pt ;
    ons:limitation "Poucos registros possuem cod_ceg nulo, possivelmente referentes a usinas sem CÉG cadastrado na ANEEL ou em processo de regularização. Para um mesmo conjunto (nom_usina, din_mes, nom_taxa) podem existir múltiplas versões (1 a 19), representando revisões sucessivas do processo de consistência. val_taxa deve estar estritamente entre 0,0 e 1,0 (proporção de indisponibilidade)."@pt ;
    dct:source <https://dados.ons.org.br/dataset/taxa_teif_teip> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/taxa_teif_teip/*.parquet" ;
    skos:altLabel "taxa de indisponibilidade da usina"@pt ;
    skos:altLabel "quanto a usina falhou"@pt ;
    skos:altLabel "indisponibilidade forcada das usinas"@pt ;
    skos:altLabel "confiabilidade das usinas"@pt ;
    ons:exampleQuestion "Quais usinas tiveram maior TEIFa média nos últimos 12 meses?"@pt ;
    ons:exampleQuestion "Como evoluiu a taxa de indisponibilidade programada (TEIP) da usina Angra 1 ao longo dos últimos 5 anos?"@pt ;
    ons:exampleQuestion "Qual o ranking de usinas Tipo I com maior indisponibilidade forçada acumulada em 2024?"@pt ;
    ons:exampleQuestion "Qual a diferença entre TEIFa e TEIP para usinas hidrelétricas versus termelétricas no último ano?"@pt ;
    ons:exampleQuestion "Quais usinas apresentaram TEIFa acima de 20% em pelo menos 3 meses consecutivos?"@pt ;
    ons:exampleQuestion "Quais usinas tiveram TEIFa acima de 20% por mais de um mês em 2024?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver confiabilidade, indisponibilidade forçada ou programada, desempenho operacional ou taxas TEIFa/TEIP de usinas geradoras despachadas centralizadamente pelo ONS. Também relevante para perguntas sobre manutenção programada, risco de indisponibilidade no despacho ou histórico de falhas de usinas específicas nos últimos 60 meses."@pt ;
    ons:agentInstruction "- [cod_ceg] Poucos registros possuem cod_ceg nulo, possivelmente correspondendo a usinas sem CEG cadastrado na ANEEL ou em processo de regularização. Joins com cadastros externos baseados em cod_ceg perderão esses registros silenciosamente.\n\n- [num_versao] Múltiplas versões (1 a 19) existem para a mesma combinação nom_usina+din_mes+nom_taxa, resultado do processo de consistência recorrente do ONS. Análises que não filtrem pela versão mais recente produzirão duplicatas e distorções em agregações.\n\n- [val_taxa] O valor máximo de val_taxa é 1.0 (100% de indisponibilidade), tecnicamente possível mas representando indisponibilidade total da usina no mês. Registros com val_taxa = 1.0 merecem verificação para distinguir indisponibilidade real de erro de preenchimento ou usina em comissionamento/desativação.\n\n- [din_calculo] din_calculo registra o momento de publicação/cálculo e pode apresentar concentração em horários específicos (12h e 19h conforme frequência declarada). Verificar se há lacunas de publicação que indiquem períodos sem atualização dos dados.\n\n- [tip_usina] Valores com trailing spaces detectados em 'tip_usina'. Use TRIM() em filtros WHERE para evitar perda de registros."@pt ;
    dct:accrualPeriodicity "anual" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/taxa_teif_teip/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2021-06-01/" ;
