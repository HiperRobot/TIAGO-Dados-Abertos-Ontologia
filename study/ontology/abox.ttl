    dct:description "Indicador percentual de Indisponibilidade Programada (INDISPPF) da Função Transmissão no mês de referência. Representa a fração do tempo em que o equipamento esteve indisponível por manutenção programada, conforme Submódulo 9.2 dos Procedimentos de Rede do ONS. Valores observados entre 0% e 11,17%."@pt ;
    skos:altLabel "indisponibilidade programada"@pt ;
    skos:altLabel "INDISPPF"@pt ;
    skos:altLabel "indisponibilidade forçada programada"@pt ;
    skos:altLabel "manutenção programada"@pt ;
    skos:altLabel "indisponibilidade planejada"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent> .

<https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_trlt/val_indispff>
    a ons:Column ;
    dct:title "val_indispff" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Indicador percentual de Indisponibilidade Forçada (INDISPFF) da Função Transmissão no mês de referência. Representa a fração do tempo em que o equipamento esteve indisponível por falha não programada (forçada), conforme Submódulo 9.2 dos Procedimentos de Rede do ONS. Valores observados entre 0% e 11,31%."@pt ;
    skos:altLabel "indisponibilidade forçada"@pt ;
