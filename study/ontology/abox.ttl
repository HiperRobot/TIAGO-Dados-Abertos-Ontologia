    ons:hasColumn <https://w3id.org/tiago-ons/data/column/intercambio_internacional/val_intercambiomwmed> ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/intercambio_internacional/val_intercambioprogmwmed> ;
    ons:hasPerspective <https://w3id.org/tiago-ons/data/perspective/verificado> ;
    ons:inFamily <https://w3id.org/tiago-ons/data/family/intercambio> ;
    skos:hiddenLabel "intercambio"@pt ;
