<https://w3id.org/tiago-ons/data/column/ind_confiarb_energianaosuprida/val_ens>
    a ons:Column ;
    dct:title "val_ens" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Valor da Energia Não Suprida (ENS) para a entidade geográfica e período de referência indicados. Representa a energia que deixou de ser fornecida aos consumidores em decorrência de falhas ou indisponibilidades na Rede Básica, conforme Submódulo 9.1 dos Procedimentos de Rede do ONS. Valor mínimo observado: 0.0; valor máximo observado: 36.4693 MWh. Ausência de valores nulos."@pt ;
    skos:altLabel "energia não suprida"@pt ;
    skos:altLabel "ENS"@pt ;
    skos:altLabel "energia não fornecida"@pt ;
    skos:altLabel "déficit de energia"@pt ;
    skos:altLabel "corte de carga"@pt ;
    skos:altLabel "valor ENS"@pt ;
