<https://w3id.org/tiago-ons/data/metric/balanco_dessem_detalhe/geracao_total>
    a ons:Metric ;
    skos:prefLabel "Geração Total"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_dessem_detalhe/val_ger_hidraulica> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_dessem_detalhe/val_ger_pch> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_dessem_detalhe/val_ger_termica> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_dessem_detalhe/val_ger_pct> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_dessem_detalhe/val_ger_eolica> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_dessem_detalhe/val_ger_fotovoltaica> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_dessem_detalhe/val_ger_mmgd> ;
    ons:expression "TRY_CAST(val_ger_hidraulica AS DOUBLE) + TRY_CAST(val_ger_pch AS DOUBLE) + TRY_CAST(val_ger_termica AS DOUBLE) + TRY_CAST(val_ger_pct AS DOUBLE) + TRY_CAST(val_ger_eolica AS DOUBLE) + TRY_CAST(val_ger_fotovoltaica AS DOUBLE) + TRY_CAST(val_ger_mmgd AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(val_ger_hidraulica AS DOUBLE) + TRY_CAST(val_ger_pch AS DOUBLE) + TRY_CAST(val_ger_termica AS DOUBLE) + TRY_CAST(val_ger_pct AS DOUBLE) + TRY_CAST(val_ger_eolica AS DOUBLE) + TRY_CAST(val_ger_fotovoltaica AS DOUBLE) + TRY_CAST(val_ger_mmgd AS DOUBLE)) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_ger_hidraulica AS DOUBLE) + TRY_CAST(val_ger_pch AS DOUBLE) + TRY_CAST(val_ger_termica AS DOUBLE) + TRY_CAST(val_ger_pct AS DOUBLE) + TRY_CAST(val_ger_eolica AS DOUBLE) + TRY_CAST(val_ger_fotovoltaica AS DOUBLE) + TRY_CAST(val_ger_mmgd AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_ger_hidraulica AS DOUBLE) + TRY_CAST(val_ger_pch AS DOUBLE) + TRY_CAST(val_ger_termica AS DOUBLE) + TRY_CAST(val_ger_pct AS DOUBLE) + TRY_CAST(val_ger_eolica AS DOUBLE) + TRY_CAST(val_ger_fotovoltaica AS DOUBLE) + TRY_CAST(val_ger_mmgd AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_ger_hidraulica AS DOUBLE) + TRY_CAST(val_ger_pch AS DOUBLE) + TRY_CAST(val_ger_termica AS DOUBLE) + TRY_CAST(val_ger_pct AS DOUBLE) + TRY_CAST(val_ger_eolica AS DOUBLE) + TRY_CAST(val_ger_fotovoltaica AS DOUBLE) + TRY_CAST(val_ger_mmgd AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(val_ger_hidraulica AS DOUBLE) + TRY_CAST(val_ger_pch AS DOUBLE) + TRY_CAST(val_ger_termica AS DOUBLE) + TRY_CAST(val_ger_pct AS DOUBLE) + TRY_CAST(val_ger_eolica AS DOUBLE) + TRY_CAST(val_ger_fotovoltaica AS DOUBLE) + TRY_CAST(val_ger_mmgd AS DOUBLE)) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_ger_hidraulica AS DOUBLE) + TRY_CAST(val_ger_pch AS DOUBLE) + TRY_CAST(val_ger_termica AS DOUBLE) + TRY_CAST(val_ger_pct AS DOUBLE) + TRY_CAST(val_ger_eolica AS DOUBLE) + TRY_CAST(val_ger_fotovoltaica AS DOUBLE) + TRY_CAST(val_ger_mmgd AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

<https://w3id.org/tiago-ons/data/metric/balanco_dessem_detalhe/demanda>
    a ons:Metric ;
    skos:prefLabel "Demanda"@pt ;
    skos:altLabel "demanda"@pt ;
    skos:altLabel "carga"@pt ;
    skos:altLabel "consumo"@pt ;
    skos:altLabel "demanda prevista"@pt ;
    skos:altLabel "val_carga"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_dessem_detalhe/val_demanda> ;
    ons:expression "TRY_CAST(val_demanda AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(val_demanda AS DOUBLE)) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_demanda AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_demanda AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_demanda AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(val_demanda AS DOUBLE)) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_demanda AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

