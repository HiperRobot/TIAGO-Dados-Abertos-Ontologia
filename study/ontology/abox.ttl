    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "8760.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total\": {\"sql\": \"SUM(val_ens)\", \"unit\": \"MWh\"}, \"average\": {\"sql\": \"AVG(val_ens)\", \"unit\": \"MWh\"}, \"maximum\": {\"sql\": \"MAX(val_ens)\", \"unit\": \"MWh\"}, \"time_series\": {\"sql\": \"SUM(val_ens)\", \"unit\": \"MWh\"}, \"ranking\": {\"sql\": \"SUM(val_ens)\", \"unit\": \"MWh\"}, \"comparison\": {\"sql\": \"SUM(val_ens)\", \"unit\": \"MWh\"}}" .

