<https://w3id.org/tiago-ons/data/column/ind_qualid_dfp_regime/id_periodicidade>
    a ons:Column ;
    dct:title "id_periodicidade" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificador da periodicidade do registro. Indica se o registro representa um agregado diário, mensal ou anual do indicador DFP. Permite filtrar a granularidade temporal desejada na tabela unificada. Valores possíveis: 'diario', 'mensal', 'anual'."@pt ;
    skos:altLabel "periodicidade"@pt ;
    skos:altLabel "granularidade"@pt ;
    skos:altLabel "frequência de agregação"@pt ;
    skos:altLabel "tipo de período"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "AN" ;
    ons:allowedValue "DI" ;
    ons:allowedValue "ME" .

<https://w3id.org/tiago-ons/data/column/ind_qualid_dfp_regime/din_referencia>
    a ons:Column ;
    dct:title "din_referencia" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data e hora de referência do registro. Para registros diários representa o dia de apuração; para mensais, o primeiro dia do mês; para anuais, o primeiro dia do ano. Coluna temporal principal para filtragem e ordenação cronológica da série."@pt ;
    skos:altLabel "data de referência"@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "data do indicador"@pt ;
    skos:altLabel "período de referência"@pt ;
    skos:altLabel "din_referencia"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/ind_qualid_dfp_regime/num_desvio_perm_sobre>
    a ons:Column ;
    dct:title "num_desvio_perm_sobre" ;
    dct:type "integer" ;
    ons:physicalType "BIGINT" ;
    dct:description "Número de minutos em que a frequência do sistema ficou acima do limite superior da faixa de regime permanente, conforme definido no Submódulo 9.7 dos Procedimentos de Rede do ONS. Representa desvios positivos (sobrefrequência) em regime permanente no período de referência."@pt ;
    skos:altLabel "desvio permanente acima"@pt ;
    skos:altLabel "sobrefrequência permanente"@pt ;
    skos:altLabel "minutos acima do limite superior"@pt ;
    skos:altLabel "desvio perm sobre"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/min> .

<https://w3id.org/tiago-ons/data/column/ind_qualid_dfp_regime/num_desvio_perm_sub>
    a ons:Column ;
    dct:title "num_desvio_perm_sub" ;
    dct:type "integer" ;
    ons:physicalType "BIGINT" ;
    dct:description "Número de minutos em que a frequência do sistema ficou abaixo do limite inferior da faixa de regime permanente, conforme definido no Submódulo 9.7 dos Procedimentos de Rede do ONS. Representa desvios negativos (subfrequência) em regime permanente no período de referência."@pt ;
    skos:altLabel "desvio permanente abaixo"@pt ;
    skos:altLabel "subfrequência permanente"@pt ;
