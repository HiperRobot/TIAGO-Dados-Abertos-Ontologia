<https://w3id.org/tiago-ons/data/metric/cvu_usitermica/cvu>
    a ons:Metric ;
    skos:prefLabel "CVU"@pt ;
    skos:altLabel "cvu"@pt ;
    skos:altLabel "custo variavel unitario"@pt ;
    skos:altLabel "custo variável unitário"@pt ;
    skos:altLabel "custo variavel"@pt ;
    skos:altLabel "custo marginal"@pt ;
    skos:altLabel "valor cvu"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/cvu_usitermica/val_cvu> ;
    ons:expression "val_cvu" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/price> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/brl_per_mwh> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/avg> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:intervalHours "168.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(val_cvu)\", \"unit\": \"R$/MWh\"}, \"maximum\": {\"sql\": \"MAX(val_cvu)\", \"unit\": \"R$/MWh\"}, \"minimum\": {\"sql\": \"MIN(val_cvu)\", \"unit\": \"R$/MWh\"}, \"time_series\": {\"sql\": \"AVG(val_cvu)\", \"unit\": \"R$/MWh\"}, \"ranking\": {\"sql\": \"AVG(val_cvu)\", \"unit\": \"R$/MWh\"}, \"comparison\": {\"sql\": \"AVG(val_cvu)\", \"unit\": \"R$/MWh\"}}" .

