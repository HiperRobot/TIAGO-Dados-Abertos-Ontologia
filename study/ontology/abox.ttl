    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(dat_mesreferencia AS TIMESTAMP)) AS mes, id_subsistema,\n  SUM(val_dmdff) AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM dat_mesreferencia) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
