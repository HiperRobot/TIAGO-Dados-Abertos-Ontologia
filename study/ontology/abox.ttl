    ons:hasMetric <https://w3id.org/tiago-ons/data/metric/cmo_semanal/cmomediasemanal> ;
    ons:hasMetric <https://w3id.org/tiago-ons/data/metric/cmo_semanal/cmoleve> ;
    ons:hasMetric <https://w3id.org/tiago-ons/data/metric/cmo_semanal/cmomedia> ;
