    dct:title "id_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Código identificador do subsistema elétrico ao qual a usina pertence. Valores típicos: SE (Sudeste/Centro-Oeste), S (Sul), NE (Nordeste), N (Norte). Usado para agregações por subsistema e joins com datasets de carga e intercâmbio."@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "cod_subsistema"@pt ;
    skos:altLabel "sigla_subsistema"@pt ;
    skos:altLabel "regiao"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "N" ;
    ons:allowedValue "NE" ;
    ons:allowedValue "S" ;
    ons:allowedValue "SE" .

