<https://w3id.org/tiago-ons/data/column/balanco_dessem_geral/cod_subsistema>
    a ons:Column ;
    dct:title "cod_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Código identificador do subsistema elétrico do SIN ao qual o balanço de energia se refere. Valores típicos incluem SE (Sudeste/Centro-Oeste), S (Sul), NE (Nordeste), N (Norte) e SIN (Sistema Interligado Nacional — agregado)."@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "região elétrica"@pt ;
    skos:altLabel "sistema"@pt ;
    skos:altLabel "cod_sis"@pt ;
    skos:altLabel "submercado"@pt ;
