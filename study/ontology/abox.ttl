<https://w3id.org/tiago-ons/data/template/ena_diario_por_bacia/pattern_ena_bruta_bacia_mwmed_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "ena_bruta_bacia_mwmed_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(ena_data AS DATE)) AS mes,\n  SUM((TRY_CAST(ena_bruta_bacia_mwmed AS DOUBLE)) * 24.0) / 1000 AS valor_gwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(ena_data AS DATE)) = {year}\n  AND nom_bacia = '{bacia}'\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ena_diario_por_bacia/ena_bruta_bacia_mwmed> .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_bacia/pattern_ena_abaixo_limiar_mlt>
    a ons:QueryTemplate ;
    skos:prefLabel "ena_abaixo_limiar_mlt" ;
    ons:sqlTemplate "SELECT nom_bacia, TRY_CAST(ena_data AS DATE) AS data,\n  TRY_CAST(ena_armazenavel_bacia_percentualmlt AS DOUBLE) AS pct_mlt\nFROM {source}\nWHERE TRY_CAST(ena_data AS DATE) = (SELECT MAX(TRY_CAST(ena_data AS DATE)) FROM {source})\n  AND TRY_CAST(ena_armazenavel_bacia_percentualmlt AS DOUBLE) < {limiar}\nORDER BY pct_mlt ASC" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ena_diario_por_bacia/ena_armazenavel_bacia_percentualmlt> .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_bacia/pattern_serie_temporal_bacia>
    a ons:QueryTemplate ;
    skos:prefLabel "serie_temporal_bacia" ;
    ons:sqlTemplate "SELECT TRY_CAST(ena_data AS DATE) AS data,\n  AVG(TRY_CAST(ena_armazenavel_bacia_mwmed AS DOUBLE)) AS ena_armazenavel_mwmed,\n  AVG(TRY_CAST(ena_bruta_bacia_mwmed AS DOUBLE)) AS ena_bruta_mwmed\nFROM {source}\nWHERE nom_bacia = '{bacia}'\n  AND TRY_CAST(ena_data AS DATE) BETWEEN '{data_inicio}' AND '{data_fim}'\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ena_diario_por_bacia/ena_armazenavel_bacia_mwmed> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ena_diario_por_bacia/ena_bruta_bacia_mwmed> .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_bacia/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT nom_bacia, COUNT(*) AS dias_abaixo_50pct_mlt, ROUND(AVG(TRY_CAST(ena_armazenavel_bacia_percentualmlt AS DOUBLE)), 2) AS media_percentual_mlt, ROUND(MIN(ena_armazenavel_bacia_percentualmlt), 2) AS minimo_percentual_mlt FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ena_bacia_di/*.parquet') WHERE TRY_CAST(ena_data AS DATE) >= (DATE '2026-06-13' - INTERVAL '365 days') AND ena_armazenavel_bacia_percentualmlt < 50 GROUP BY nom_bacia ORDER BY dias_abaixo_50pct_mlt DESC LIMIT 20" ;
    ons:exampleQuestion "Quais bacias apresentaram ENA armazenável abaixo de 50% da MLT com maior frequência nos últimos 12 meses?"@pt .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_bacia/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT nom_bacia, DATE_TRUNC('month', TRY_CAST(ena_data AS DATE)) AS mes_referencia, ROUND(AVG(TRY_CAST(ena_bruta_bacia_mwmed AS DOUBLE)), 2) AS media_ena_bruta_mwmed, ROUND(AVG(ena_bruta_bacia_percentualmlt), 2) AS media_ena_bruta_pct_mlt, COUNT(*) AS dias_com_dado FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ena_bacia_di/*.parquet') WHERE TRY_CAST(ena_data AS DATE) BETWEEN DATE '2024-01-01' AND DATE '2024-12-31' GROUP BY nom_bacia, DATE_TRUNC('month', TRY_CAST(ena_data AS DATE)) ORDER BY nom_bacia, mes_referencia" ;
    ons:exampleQuestion "Qual foi a média mensal de ENA bruta em MWmed para cada bacia em 2024?"@pt .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_bacia/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT nom_bacia, ena_data, ROUND(TRY_CAST(ena_armazenavel_bacia_percentualmlt AS DOUBLE), 2) AS ena_arm_pct_mlt, ROUND(TRY_CAST(ena_armazenavel_bacia_mwmed AS DOUBLE), 2) AS ena_arm_mwmed, ROUND(TRY_CAST(ena_bruta_bacia_percentualmlt AS DOUBLE), 2) AS ena_bruta_pct_mlt FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ena_bacia_di/*.parquet', union_by_name=true) WHERE TRY_CAST(ena_armazenavel_bacia_percentualmlt AS DOUBLE) > 300 ORDER BY TRY_CAST(ena_armazenavel_bacia_percentualmlt AS DOUBLE) DESC LIMIT 100" ;
    ons:exampleQuestion "Em quais datas e bacias ocorreram eventos de ENA armazenável acima de 300% da MLT?"@pt .

<https://w3id.org/tiago-ons/data/dataset/ena_diario_por_ree_reservatorio_equivalente_de_energia>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:ena-diario-por-ree-reservatorio-equivalente-de-energia" ;
    dct:title "ena-diario-por-ree-reservatorio-equivalente-de-energia" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/hidrologia> ;
    dcat:keyword "ENA"@pt ;
    dcat:keyword "ENA bruta diária"@pt ;
    dcat:keyword "ENA diária REE"@pt ;
    dcat:keyword "ENA por reservatório equivalente"@pt ;
    dcat:keyword "MLT"@pt ;
    dcat:keyword "REE"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "afluência"@pt ;
    dcat:keyword "afluência diária por REE"@pt ;
    dcat:keyword "diário"@pt ;
    dcat:keyword "energia natural afluente"@pt ;
    dcat:keyword "energia natural afluente diária"@pt ;
    dcat:keyword "hidrologia"@pt ;
    dcat:keyword "média de longo termo"@pt ;
    dcat:keyword "reservatório equivalente de energia"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Prover séries históricas diárias de Energia Natural Afluente por Reservatório Equivalente de Energia para uso por geradores, comercializadores, agentes do mercado de energia e pesquisadores do setor elétrico brasileiro. Suporta estudos energéticos, projeção do Custo Marginal de Operação (CMO), acompanhamento das condições hidrológicas do SIN, análise de risco hidrológico, planejamento de despacho hidrotérmico e monitoramento operativo das condições de afluência nos subsistemas do sistema elétrico nacional."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver Energia Natural Afluente (ENA) diária desagregada por Reservatório Equivalente de Energia (REE) ou subsistema hidrológico do SIN, incluindo análises de condições hidrológicas, comparação com a MLT, risco de seca, ou correlação entre afluência e Custo Marginal de Operação em granularidade diária."@pt ;
    ons:limitation "Coluna armazenada como VARCHAR no Parquet, embora represente datas no formato YYYY-MM-DD. Valores percentuais de ENA bruta variam de 12,56% a 408,62%, refletindo extremos hidrológicos reais (seca severa a cheia excepcional). Valores percentuais de ENA armazenável variam de 9,37% a 398,77%, com mínimo absoluto inferior ao da ENA bruta, indicando situações de estresse hídrico severo."@pt ;
    dct:source <https://dados.ons.org.br/dataset/ena-diario-por-ree-reservatorio-equivalente-de-energia> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/ena_ree_di/*.parquet" ;
    skos:altLabel "afluencia por ree"@pt ;
    skos:altLabel "ena do reservatorio equivalente"@pt ;
    ons:exampleQuestion "Qual foi a ENA bruta do subsistema Sudeste/Centro-Oeste nos últimos 30 dias?"@pt ;
    ons:exampleQuestion "Em quais datas a ENA armazenável do Nordeste ficou abaixo de 30% da MLT em 2023?"@pt ;
    ons:exampleQuestion "Como a ENA bruta do Sul se compara à média histórica (MLT) no primeiro semestre de 2024?"@pt ;
    ons:exampleQuestion "Qual REE apresentou maior variação percentual de ENA bruta em relação à MLT no ano de 2022?"@pt ;
    ons:exampleQuestion "Quais foram os períodos de seca mais severa (ENA < 50% MLT) por subsistema desde 2021?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver Energia Natural Afluente (ENA) diária desagregada por Reservatório Equivalente de Energia (REE) ou subsistema hidrológico do SIN, incluindo análises de condições hidrológicas, comparação com a MLT, risco de seca, ou correlação entre afluência e Custo Marginal de Operação em granularidade diária. Preferir este dataset sobre o semanal quando a análise exigir resolução temporal diária, e sobre o dataset por subsistema quando a granularidade espacial de REE for necessária."@pt ;
    ons:agentInstruction "- [ena_data] Coluna ena_data representa datas no formato YYYY-MM-DD mas está tipada como VARCHAR no schema físico DuckDB, caracterizando inconsistência de formato (pandas object→UTF8). Filtros temporais e ordenações sem cast explícito produzirão resultados incorretos (ordenação lexicográfica em vez de cronológica).\n\n- [ena_bruta_ree_mwmed] Valor máximo de 43355.64 MWmed representa pico hidrológico extremo. Embora fisicamente plausível para o REE Sudeste em períodos de cheia, recomenda-se verificar se valores acima do percentil 99 correspondem a eventos reais ou a artefatos do processo de consistência recorrente do ONS.\n\n- [ena_bruta_ree_percentualmlt] Valor máximo de 408.62% da MLT indica condição hidrológica extremamente acima da média histórica. Valores acima de 300% merecem atenção especial para verificar se representam eventos reais (cheias excepcionais) ou inconsistências no processo de cálculo da MLT de referência.\n\n- [ena_armazenavel_ree_percentualmlt] Valor mínimo de 9.37% da MLT para ENA armazenável indica condição de seca severa. Valores abaixo de 20% da MLT são críticos para o planejamento da operação e devem ser monitorados em conjunto com o nível dos reservatórios (EAR).\n\n- [nom_reservatorioee] Verificação de duplicatas na chave primária composta (nom_reservatorioee, ena_data). Dado que os dados passam por processo de consistência recorrente com possibilidade de reprocessamento, podem existir registros duplicados para o mesmo REE e data em versões distintas dos arquivos Parquet.\n\n- [ena_armazenavel_ree_mwmed] Conceitualmente, a ENA armazenável não deveria assumir valores negativos, pois representa energia passível de armazenamento. O mínimo observado (132.08 MWmed) é positivo, mas recomenda-se monitorar se futuras atualizações introduzem valores negativos, o que indicaria inconsistência no desconto de vazões vertidas.\n\n- [ena_bruta_ree_mwmed] Os metadados CKAN registram ultima atualizacao em 2024-01-02, porem a serie no S3 continua sendo publicada bem depois disso, entao os metadados CKAN estao desatualizados e nao servem para decidir a cobertura. Recomenda-se verificar se há lacunas temporais (dias sem registro) na série para cada REE, o que poderia indicar falhas no pipeline de ingestão diária.\n"@pt ;
    dct:accrualPeriodicity "diária" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/ena_ree_di/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2021-01-01/" ;
