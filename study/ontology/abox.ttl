<https://w3id.org/tiago-ons/data/column/demanda_maxima_di/id_subsistema>
    a ons:Column ;
    dct:title "id_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificador alfanumérico do subsistema elétrico do SIN. Valores possíveis: SE (Sudeste/Centro-Oeste), S (Sul), NE (Nordeste), N (Norte) e SIN (agregado nacional)."@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "id subsistema"@pt ;
    skos:altLabel "código subsistema"@pt ;
    skos:altLabel "sigla subsistema"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "N" ;
    ons:allowedValue "NE" ;
    ons:allowedValue "S" ;
    ons:allowedValue "SE" .

<https://w3id.org/tiago-ons/data/column/demanda_maxima_di/nom_subsistema>
    a ons:Column ;
    dct:title "nom_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome completo do subsistema elétrico do SIN correspondente ao id_subsistema. Exemplos: Sudeste/Centro-Oeste, Sul, Nordeste, Norte, Sistema Interligado Nacional."@pt ;
    skos:altLabel "nome subsistema"@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "região"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "NORDESTE" ;
    ons:allowedValue "NORTE" ;
    ons:allowedValue "SUDESTE" ;
    ons:allowedValue "SUL" .

<https://w3id.org/tiago-ons/data/column/demanda_maxima_di/dat_referencia>
    a ons:Column ;
    dct:title "dat_referencia" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data de referência do registro, representando o dia ao qual a demanda máxima diária se refere. Apesar do tipo TIMESTAMP, a variação intradiária é nula — o campo funciona como DATE com granularidade diária."@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "data de referência"@pt ;
    skos:altLabel "dia"@pt ;
    skos:altLabel "data referência"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/demanda_maxima_di/din_demandaintegralizada>
    a ons:Column ;
    dct:title "din_demandaintegralizada" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Instante exato (data e hora) em que ocorreu a demanda máxima integralizada (MW médio) no dia de referência para o subsistema. Representa o intervalo de integração de maior carga média do dia."@pt ;
    skos:altLabel "horário pico integralizado"@pt ;
    skos:altLabel "instante demanda integralizada"@pt ;
    skos:altLabel "timestamp demanda integralizada"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/demanda_maxima_di/val_demandaintegralizada>
    a ons:Column ;
    dct:title "val_demandaintegralizada" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Valor da demanda máxima integralizada diária em MW médio para o subsistema na data de referência. Representa a maior carga média integralizada no intervalo de medição do dia, incluindo estimativa de micro e minigeração distribuída (MMGD)."@pt ;
    skos:altLabel "demanda integralizada"@pt ;
    skos:altLabel "carga integralizada"@pt ;
    skos:altLabel "demanda média máxima"@pt ;
    skos:altLabel "val demanda integralizada"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> .

<https://w3id.org/tiago-ons/data/column/demanda_maxima_di/din_demandainstantanea>
    a ons:Column ;
    dct:title "din_demandainstantanea" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Instante exato (data e hora) em que ocorreu o pico de demanda instantânea (MW) no dia de referência para o subsistema. Representa o momento de maior carga instantânea registrada no dia."@pt ;
    skos:altLabel "horário pico instantâneo"@pt ;
    skos:altLabel "instante demanda instantânea"@pt ;
    skos:altLabel "timestamp pico"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/demanda_maxima_di/val_demandainstantanea>
    a ons:Column ;
    dct:title "val_demandainstantanea" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Valor da demanda máxima instantânea diária em MW para o subsistema na data de referência. Representa o maior valor de carga instantânea registrado no dia, incluindo estimativa de micro e minigeração distribuída (MMGD). Tipicamente ligeiramente superior ao val_demandaintegralizada."@pt ;
    skos:altLabel "demanda instantânea"@pt ;
    skos:altLabel "pico de carga"@pt ;
    skos:altLabel "carga instantânea máxima"@pt ;
    skos:altLabel "val demanda instantânea"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> .

<https://w3id.org/tiago-ons/data/dimension/demanda_maxima_di/subsistema>
    a ons:Dimension ;
    skos:prefLabel "subsistema" ;
    ons:onColumn <https://w3id.org/tiago-ons/data/column/demanda_maxima_di/id_subsistema> ;
    ons:refersTo ons:Subsistema .

<https://w3id.org/tiago-ons/data/metric/demanda_maxima_di/demandaintegralizada>
    a ons:Metric ;
    skos:prefLabel "Demanda Integralizada"@pt ;
    skos:altLabel "demanda integralizada"@pt ;
    skos:altLabel "carga integralizada"@pt ;
    skos:altLabel "demanda media maxima"@pt ;
    skos:altLabel "val demanda integralizada"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/demanda_maxima_di/val_demandaintegralizada> ;
    ons:expression "val_demandaintegralizada" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((val_demandaintegralizada) * 24.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(val_demandaintegralizada)\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(val_demandaintegralizada)\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(val_demandaintegralizada)\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((val_demandaintegralizada) * 24.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(val_demandaintegralizada)\", \"unit\": \"MWmed\"}}" .

<https://w3id.org/tiago-ons/data/metric/demanda_maxima_di/demandainstantanea>
    a ons:Metric ;
    skos:prefLabel "Demanda Instantanea"@pt ;
    skos:altLabel "demanda instantanea"@pt ;
    skos:altLabel "pico de carga"@pt ;
    skos:altLabel "carga instantanea maxima"@pt ;
    skos:altLabel "val demanda instantanea"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/demanda_maxima_di/val_demandainstantanea> ;
    ons:expression "val_demandainstantanea" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((val_demandainstantanea) * 24.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(val_demandainstantanea)\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(val_demandainstantanea)\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(val_demandainstantanea)\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((val_demandainstantanea) * 24.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(val_demandainstantanea)\", \"unit\": \"MWmed\"}}" .

