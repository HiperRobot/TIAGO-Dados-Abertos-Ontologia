<https://w3id.org/tiago-ons/data/column/carga_mensal/id_subsistema>
    a ons:Column ;
    dct:title "id_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificador alfanumérico do subsistema elétrico do SIN (Sistema Interligado Nacional). Valores típicos: SE, S, NE, N (e eventualmente SIN para agregado nacional)."@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "id subsistema"@pt ;
    skos:altLabel "código do subsistema"@pt ;
    skos:altLabel "sigla subsistema"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "N" ;
    ons:allowedValue "NE" ;
    ons:allowedValue "S" ;
    ons:allowedValue "SE" .

<https://w3id.org/tiago-ons/data/column/carga_mensal/nom_subsistema>
