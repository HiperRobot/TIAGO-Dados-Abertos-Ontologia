<https://w3id.org/tiago-ons/data/metric/geracao_usina_2/geracao>
    a ons:Metric ;
    skos:prefLabel "Geracao"@pt ;
    skos:altLabel "geracao"@pt ;
    skos:altLabel "potencia_gerada"@pt ;
    skos:altLabel "geracao_verificada"@pt ;
    skos:altLabel "geracao_mw"@pt ;
    skos:altLabel "potencia_mw"@pt ;
    skos:altLabel "medicao"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/geracao_usina_2/val_geracao> ;
    ons:expression "TRY_CAST(val_geracao AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "1.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(val_geracao AS DOUBLE)) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_geracao AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_geracao AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_geracao AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(val_geracao AS DOUBLE)) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_geracao AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

