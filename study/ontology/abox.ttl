<https://w3id.org/tiago-ons/data/template/classificacao_evt/pattern_evt_verificado_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "evt_verificado_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  SUM(TRY_CAST(val_evt_verificado AS DOUBLE)) * 1.0 AS energia_mwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "MWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/classificacao_evt/evt_verificado> .

<https://w3id.org/tiago-ons/data/template/classificacao_evt/pattern_evt_classificacao_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "evt_classificacao_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  SUM(TRY_CAST(val_evt_razaoeletrica AS DOUBLE)) * 1.0 AS evt_eletrico_mwh,\n  SUM(TRY_CAST(val_evt_razaoenergetica AS DOUBLE)) * 1.0 AS evt_energetico_mwh,\n  SUM(TRY_CAST(val_evt_verificado AS DOUBLE)) * 1.0 AS evt_total_mwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "MWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/classificacao_evt/evt_razaoeletrica> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/classificacao_evt/evt_razaoenergetica> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/classificacao_evt/evt_verificado> .

<https://w3id.org/tiago-ons/data/template/classificacao_evt/pattern_evt_pico_horario>
    a ons:QueryTemplate ;
    skos:prefLabel "evt_pico_horario" ;
    ons:sqlTemplate "SELECT TRY_CAST(din_instante AS TIMESTAMP) AS instante,\n  TRY_CAST(val_evt_verificado AS DOUBLE) AS evt_mwmed\nFROM {source}\nORDER BY TRY_CAST(val_evt_verificado AS DOUBLE) DESC\nLIMIT 10" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/classificacao_evt/evt_verificado> .

<https://w3id.org/tiago-ons/data/template/classificacao_evt/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes_referencia, SUM((TRY_CAST(val_evt_verificado AS DOUBLE)) * 1.0) AS evt_verificado_total_mwmed, COUNT(*) AS horas_com_registro FROM read_parquet('s3://ons-aws-prod-opendata/dataset/classificacao_evt/*.parquet') WHERE TRY_CAST(din_instante AS TIMESTAMP) >= TIMESTAMP '2024-01-01' AND TRY_CAST(din_instante AS TIMESTAMP) < TIMESTAMP '2025-01-01' GROUP BY DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) ORDER BY mes_referencia" ;
    ons:exampleQuestion "Qual foi o volume mensal de energia vertida turbinável verificada no SIN em 2024?"@pt .

<https://w3id.org/tiago-ons/data/template/classificacao_evt/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes_referencia, AVG(TRY_CAST(val_evt_razaoenergetica AS DOUBLE)) AS media_razao_energetica, AVG(TRY_CAST(val_evt_razaoeletrica AS DOUBLE)) AS media_razao_eletrica, AVG( TRY_CAST(val_evt_razaoenergetica AS DOUBLE) + TRY_CAST(val_evt_razaoeletrica AS DOUBLE) ) AS media_soma_razoes FROM read_parquet('s3://ons-aws-prod-opendata/dataset/classificacao_evt/*.parquet') WHERE TRY_CAST(din_instante AS TIMESTAMP) IS NOT NULL GROUP BY DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) ORDER BY mes_referencia" ;
    ons:exampleQuestion "Qual a proporção média entre razão energética e razão elétrica do EVT ao longo do período coberto?"@pt .

<https://w3id.org/tiago-ons/data/template/classificacao_evt/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT EXTRACT(hour FROM TRY_CAST(din_instante AS TIMESTAMP)) AS hora_do_dia, AVG(TRY_CAST(val_evt_verificado AS DOUBLE)) AS evt_medio_mwmed, SUM(TRY_CAST(val_evt_verificado AS DOUBLE)) AS evt_total_mwmed, COUNT(*) AS num_registros FROM read_parquet('s3://ons-aws-prod-opendata/dataset/classificacao_evt/*.parquet') WHERE TRY_CAST(din_instante AS TIMESTAMP) IS NOT NULL AND TRY_CAST(val_evt_verificado AS DOUBLE) IS NOT NULL GROUP BY EXTRACT(hour FROM TRY_CAST(din_instante AS TIMESTAMP)) ORDER BY hora_do_dia" ;
    ons:exampleQuestion "Em quais horas do dia ocorre maior concentração de vertimento turbinável no SIN?"@pt .

<https://w3id.org/tiago-ons/data/dataset/cmo_semanal>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:cmo-semanal" ;
    dct:title "cmo-semanal" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/preco> ;
    dcat:keyword "CMO"@pt ;
    dcat:keyword "CMO DECOMP"@pt ;
    dcat:keyword "DECOMP"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "PLD"@pt ;
    dcat:keyword "cmo semanal"@pt ;
    dcat:keyword "custo marginal"@pt ;
    dcat:keyword "custo marginal de operação"@pt ;
    dcat:keyword "mercado de curto prazo"@pt ;
    dcat:keyword "patamar de carga"@pt ;
    dcat:keyword "preço de energia"@pt ;
    dcat:keyword "semana operativa"@pt ;
    dcat:keyword "subsistema"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Fornecer aos agentes do mercado de energia elétrica, ao ONS, à ANEEL e à CCEE o Custo Marginal de Operação semanal estimado pelo DECOMP por subsistema e patamar de carga, suportando decisões de precificação no mercado de curto prazo (PLD), planejamento da operação hidrotérmica, análise de risco hidrológico, despacho de geração e estudos regulatórios sobre formação de preços no setor elétrico brasileiro."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver custo marginal de operação (CMO), formação do PLD, precificação no mercado de curto prazo, análise de patamares de carga (leve, média, pesada) ou comparação de custos de operação entre subsistemas do SIN."@pt ;
    ons:limitation "O dataset cobre de 2005-01-07 em diante, com 4 subsistemas, e o volume publicado e pequeno para o periodo, entao trate a serie como subconjunto. Valores de CMO médio semanal fora do intervalo histórico plausível [0, 10000] R$/MWh devem ser investigados como possíveis erros de exportação ou revisões do DECOMP ainda não consolidadas. O CMO no patamar leve pode teoricamente assumir valores negativos em cenários de excesso de geração renovável não despachável, porém valores negativos neste dataset devem ser verificados pois podem indicar inconsistência no modelo DECOMP ou erro de exportação."@pt ;
    dct:source <https://dados.ons.org.br/dataset/cmo-semanal> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/cmo_se/*.parquet" ;
    skos:altLabel "preco da energia por semana"@pt ;
    skos:altLabel "custo marginal semanal"@pt ;
    skos:altLabel "pld semanal"@pt ;
    skos:altLabel "preco por patamar de carga"@pt ;
    skos:altLabel "quanto custou a energia na semana"@pt ;
    ons:exampleQuestion "Qual foi o CMO médio semanal do subsistema Sudeste no último trimestre?"@pt ;
    ons:exampleQuestion "Como o CMO variou entre os patamares leve, média e pesada no subsistema Sul em 2023?"@pt ;
    ons:exampleQuestion "Qual subsistema apresentou o maior CMO médio semanal nos últimos 12 meses?"@pt ;
    ons:exampleQuestion "Qual a diferença histórica entre o CMO no patamar pesado e leve por subsistema?"@pt ;
    ons:exampleQuestion "Em quais semanas o CMO do Nordeste superou R$ 500/MWh?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver custo marginal de operação (CMO), formação do PLD, precificação no mercado de curto prazo, análise de patamares de carga (leve, média, pesada) ou comparação de custos de operação entre subsistemas do SIN. Também relevante para perguntas sobre impacto hidrológico nos preços de energia e planejamento da operação hidrotérmica semanal pelo DECOMP."@pt ;
    ons:agentInstruction "- [val_cmomediasemanal] Valores de CMO médio semanal negativos ou acima de R$ 10.000/MWh são fisicamente implausíveis. Valores extremos podem indicar erros de processamento do DECOMP ou períodos de crise energética severa (ex: 2001, 2021). O teto regulatório do PLD variou historicamente entre R$ 500/MWh e R$ 9.999/MWh conforme resoluções ANEEL.\n\n- [val_cmoleve] O CMO do patamar leve deve ser menor ou igual ao CMO dos patamares médio e pesado na mesma semana e subsistema. Inversões podem indicar inconsistência no modelo DECOMP ou erro de exportação dos dados do dataset cmo-semanal.\n\n- [val_cmopesada] O CMO do patamar pesado deve ser maior ou igual ao CMO dos patamares médio e leve na mesma semana e subsistema. Inversões (pesada menor que média ou leve) indicam inconsistência no modelo DECOMP ou erro de exportação do dataset cmo-semanal.\n\n- [din_instante] Verificar se há semanas operativas faltantes na série temporal para cada subsistema do dataset cmo-semanal. Gaps superiores a 14 dias entre semanas consecutivas indicam descontinuidade. O volume publicado fica bem abaixo do que 21 anos x 52 semanas x 4 subsistemas fariam esperar: trate a serie como subconjunto, nao como historico completo.\n\n- [id_subsistema] Verificar duplicatas na chave primária composta (din_instante, id_subsistema) do dataset cmo-semanal. Atualizações recorrentes do DECOMP podem gerar múltiplas versões do CMO para a mesma semana e subsistema nos arquivos parquet, comprometendo agregações.\n\n- [tipos] As colunas `val_cmoleve`, `val_cmomedia`, `val_cmomediasemanal`, `val_cmopesada` mudam de tipo entre arquivos anuais (texto em uns, número em outros); cada uma traz `castExpression` no schema: use-o em toda agregação e comparação.\n"@pt ;
    dct:accrualPeriodicity "semanal" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/cmo_se/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2005-01-07/" ;
    ons:spatialGrain ons:Subsistema ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/cmo_semanal/id_subsistema> ;
