<https://w3id.org/tiago-ons/data/template/importacaoenergia_comercial_2/pattern_importacaoprogramada_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "importacaoprogramada_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  SUM(val_importacaoprogramada) AS total_mwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1\n" ;
    ons:outputUnitLabel "MWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/importacaoenergia_comercial_2/importacaoprogramada> .

<https://w3id.org/tiago-ons/data/template/importacaoenergia_comercial_2/pattern_importacao_por_pais_ano>
    a ons:QueryTemplate ;
    skos:prefLabel "importacao_por_pais_ano" ;
    ons:sqlTemplate "SELECT nom_pais,\n  EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) AS ano,\n  SUM(val_importacaodespachada) AS total_despachada_mwh,\n  SUM(val_importacaoprogramada) AS total_programada_mwh\nFROM {source}\nGROUP BY 1, 2\nORDER BY 2, 3 DESC\n" ;
    ons:outputUnitLabel "MWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/importacaoenergia_comercial_2/importacaodespachada> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/importacaoenergia_comercial_2/importacaoprogramada> .

<https://w3id.org/tiago-ons/data/template/importacaoenergia_comercial_2/pattern_preco_medio_por_pais_ano>
    a ons:QueryTemplate ;
    skos:prefLabel "preco_medio_por_pais_ano" ;
    ons:sqlTemplate "SELECT nom_pais,\n  EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) AS ano,\n  AVG(val_preco) AS preco_medio_rs_mwh,\n  MIN(val_preco) AS preco_min_rs_mwh,\n  MAX(val_preco) AS preco_max_rs_mwh\nFROM {source}\nWHERE val_preco IS NOT NULL\nGROUP BY 1, 2\nORDER BY 2, 1\n" ;
    ons:outputUnitLabel "R$/MWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/importacaoenergia_comercial_2/preco> .

<https://w3id.org/tiago-ons/data/template/importacaoenergia_comercial_2/pattern_diferenca_programada_despachada>
    a ons:QueryTemplate ;
    skos:prefLabel "diferenca_programada_despachada" ;
    ons:sqlTemplate "SELECT nom_pais,\n  AVG(val_importacaodespachada - val_importacaoprogramada) AS diferenca_media_mwmed,\n  SUM(val_importacaodespachada - val_importacaoprogramada) AS diferenca_total_mwh\nFROM {source}\nGROUP BY 1\nORDER BY 2 DESC\n" ;
    ons:outputUnitLabel "MWmed / MWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/importacaoenergia_comercial_2/importacaodespachada> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/importacaoenergia_comercial_2/importacaoprogramada> .

<https://w3id.org/tiago-ons/data/template/importacaoenergia_comercial_2/pattern_importacao_verificada_com_nulos>
    a ons:QueryTemplate ;
    skos:prefLabel "importacao_verificada_com_nulos" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  SUM(val_importacaoverificada) AS total_verificada_mwh,\n  COUNT(*) AS total_registros,\n  COUNT(val_importacaoverificada) AS registros_com_valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1\n" ;
    ons:outputUnitLabel "MWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/importacaoenergia_comercial_2/importacaoverificada> .

<https://w3id.org/tiago-ons/data/template/importacaoenergia_comercial_2/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, nom_pais, SUM(val_importacaoprogramada) AS total_programado_mwmed, SUM(val_importacaodespachada) AS total_despachado_mwmed, ROUND(100.0 * SUM(val_importacaodespachada) / NULLIF(SUM(val_importacaoprogramada), 0), 2) AS pct_despacho_vs_programado FROM read_parquet('s3://ons-aws-prod-opendata/dataset/importacaoenergia-comercial-2-ho/*.parquet') WHERE val_importacaoprogramada IS NOT NULL GROUP BY DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)), nom_pais ORDER BY mes DESC, total_despachado_mwmed DESC" ;
    ons:exampleQuestion "Qual foi o volume total de energia importada programada e despachada por país em cada mês?"@pt .

<https://w3id.org/tiago-ons/data/template/importacaoenergia_comercial_2/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT nom_agente, nom_pais, COUNT(DISTINCT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP))) AS meses_ativos, SUM(val_importacaodespachada) AS total_despachado_mwmed, ROUND(AVG(val_preco), 2) AS preco_medio_rs_mwh, MIN(val_preco) AS preco_min_rs_mwh, MAX(val_preco) AS preco_max_rs_mwh FROM read_parquet('s3://ons-aws-prod-opendata/dataset/importacaoenergia-comercial-2-ho/*.parquet') WHERE val_importacaodespachada > 0 GROUP BY nom_agente, nom_pais ORDER BY total_despachado_mwmed DESC LIMIT 20" ;
    ons:exampleQuestion "Quais agentes comercializadores mais importaram energia no período e qual o preço médio ofertado?"@pt .

<https://w3id.org/tiago-ons/data/template/importacaoenergia_comercial_2/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT nom_bloco, nom_pais, COUNT(*) AS total_registros, ROUND(AVG(val_importacaodespachada - val_importacaoprogramada), 4) AS desvio_medio_mwmed, ROUND(SUM(ABS(val_importacaodespachada - val_importacaoprogramada)), 2) AS desvio_absoluto_total, COUNT(*) FILTER (WHERE val_importacaodespachada > val_importacaoprogramada) AS registros_acima_programado, COUNT(*) FILTER (WHERE val_importacaodespachada < val_importacaoprogramada) AS registros_abaixo_programado FROM read_parquet('s3://ons-aws-prod-opendata/dataset/importacaoenergia-comercial-2-ho/*.parquet') WHERE val_importacaoprogramada IS NOT NULL AND val_importacaodespachada IS NOT NULL GROUP BY nom_bloco, nom_pais ORDER BY desvio_absoluto_total DESC" ;
    ons:exampleQuestion "Em quais blocos horários do PMO ocorrem os maiores desvios entre energia programada e despachada?"@pt .

<https://w3id.org/tiago-ons/data/dataset/ind_disponibilidade_geracao_sin>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:ind-disponibilidade-geracao-sin" ;
    dct:title "ind-disponibilidade-geracao-sin" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/geracao> ;
    dcat:keyword "DISPF"@pt ;
    dcat:keyword "DISPF SIN"@pt ;
    dcat:keyword "INDISPFF"@pt ;
    dcat:keyword "INDISPFF SIN"@pt ;
    dcat:keyword "INDISPPF"@pt ;
    dcat:keyword "INDISPPF SIN"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "Submódulo 9.2"@pt ;
    dcat:keyword "confiabilidade"@pt ;
    dcat:keyword "disponibilidade"@pt ;
    dcat:keyword "disponibilidade geração SIN"@pt ;
    dcat:keyword "disponibilidade geração nacional"@pt ;
    dcat:keyword "geração"@pt ;
    dcat:keyword "indicadores de desempenho de geração SIN"@pt ;
    dcat:keyword "indisponibilidade"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Fornecer aos analistas de confiabilidade, planejadores do sistema elétrico e reguladores os indicadores mensais consolidados de desempenho do parque gerador nacional, permitindo monitorar tendências de disponibilidade e indisponibilidade do SIN ao longo do tempo, suportar decisões de planejamento da expansão da geração, avaliar o cumprimento de metas regulatórias estabelecidas pelo ONS e pela ANEEL, e subsidiar estudos de confiabilidade do sistema elétrico brasileiro."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver indicadores mensais de disponibilidade, indisponibilidade programada ou indisponibilidade forçada das funções geração agregados para o Sistema Interligado Nacional como um todo."@pt ;
    ons:limitation "A coluna dat_referencia está armazenada como VARCHAR no Parquet em vez de DATE. Verificar se a soma dos três indicadores (DISPF + INDISPPF + INDISPFF) é aproximadamente 100% para cada registro. O valor máximo de INDISPPF observado é 12,67%, consideravelmente acima da mediana esperada para indisponibilidade programada."@pt ;
    dct:source <https://dados.ons.org.br/dataset/ind-disponibilidade-geracao-sin> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/ind-disponibilidade-geracao-sin/*.parquet" ;
    skos:altLabel "disponibilidade do parque gerador do sin"@pt ;
    skos:altLabel "indisponibilidade agregada da geracao"@pt ;
    skos:altLabel "quanto da geracao ficou indisponivel"@pt ;
    ons:exampleQuestion "Qual foi a disponibilidade média das funções geração do SIN em 2024?"@pt ;
    ons:exampleQuestion "Em quais meses a indisponibilidade forçada do SIN superou 3%?"@pt ;
    ons:exampleQuestion "Como evoluiu a indisponibilidade programada do parque gerador nacional ao longo de 2023?"@pt ;
    ons:exampleQuestion "Qual o mês com menor disponibilidade de geração do SIN desde 2023?"@pt ;
    ons:exampleQuestion "Qual a tendência de DISPF, INDISPPF e INDISPFF do SIN nos últimos 12 meses disponíveis?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver indicadores mensais de disponibilidade, indisponibilidade programada ou indisponibilidade forçada das funções geração agregados para o Sistema Interligado Nacional como um todo. Também recuperar quando o analista precisar de uma visão consolidada nacional de desempenho do parque gerador para comparação com metas regulatórias ou análise de tendência histórica do SIN."@pt ;
    ons:agentInstruction "- [dat_referencia] A coluna dat_referencia está armazenada como VARCHAR no Parquet em vez de DATE. O formato observado é YYYY-MM-DD (ex: '2023-01-01'), sempre com dia 01 representando o primeiro dia do mês de competência. Operações de filtro temporal, ordenação e extração de ano/mês falharão silenciosamente se a coluna for tratada como string sem conversão explícita.\n\n- [val_dispf] O dataset ind-disponibilidade-geracao-sin cobre a partir de 2023-01 com pouquissimos registros, entao a maior parte das competencias mensais esta ausente. Análises de tendência e médias móveis devem considerar as competências faltantes antes de interpretar resultados para val_dispf.\n\n- [val_indispff] A Indisponibilidade Forçada (INDISPFF) no dataset ind-disponibilidade-geracao-sin apresenta variação relativa elevada entre o mínimo (1,45%) e o máximo (3,71%), representando variação de ~156% entre os extremos. Valores acima de 3,5% podem indicar períodos de estresse operativo ou eventos climáticos extremos que impactaram o parque gerador nacional.\n"@pt ;
    dct:accrualPeriodicity "mensal" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/ind-disponibilidade-geracao-sin/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2023-01-01/" ;
