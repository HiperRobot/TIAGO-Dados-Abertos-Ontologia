<https://w3id.org/tiago-ons/data/template/carga_energia/pattern_cargaenergiamwmed_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "cargaenergiamwmed_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, id_subsistema,\n  SUM((TRY_CAST(val_cargaenergiamwmed AS DOUBLE)) * 24.0) / 1000 AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/carga_energia/cargaenergiamwmed> .

<https://w3id.org/tiago-ons/data/template/carga_energia/pattern_cargaenergiamwmed_diaria_subsistema>
    a ons:QueryTemplate ;
    skos:prefLabel "cargaenergiamwmed_diaria_subsistema" ;
    ons:sqlTemplate "SELECT DATE(din_instante) AS dia, id_subsistema,\n  AVG(TRY_CAST(val_cargaenergiamwmed AS DOUBLE)) AS valor\nFROM {source}\nWHERE id_subsistema = '{subsistema}'\n  AND din_instante BETWEEN '{data_inicio}' AND '{data_fim}'\nGROUP BY 1, 2\nORDER BY 1" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/carga_energia/cargaenergiamwmed> .

<https://w3id.org/tiago-ons/data/template/carga_energia/pattern_carga_energia_mensal_gwh>
    a ons:QueryTemplate ;
    skos:prefLabel "carga_energia_mensal_gwh" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_cargaenergiamwmed AS VARCHAR) AS DOUBLE)) * 24.0 / 1000, 1) AS val_cargaenergiamwmed_gwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "GWh" .

<https://w3id.org/tiago-ons/data/template/carga_energia/pattern_carga_energia_mensal_mwmed>
    a ons:QueryTemplate ;
    skos:prefLabel "carga_energia_mensal_mwmed" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_cargaenergiamwmed AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS val_cargaenergiamwmed_mwmed\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "MWmed" .

<https://w3id.org/tiago-ons/data/template/carga_energia/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_subsistema, YEAR(din_instante) AS ano, AVG(TRY_CAST(val_cargaenergiamwmed AS DOUBLE)) AS carga_media_mwmed, MIN(val_cargaenergiamwmed) AS carga_minima_mwmed, MAX(val_cargaenergiamwmed) AS carga_maxima_mwmed, COUNT(*) AS qtd_dias FROM read_parquet('s3://ons-aws-prod-opendata/dataset/carga_energia_di/*.parquet') WHERE val_cargaenergiamwmed IS NOT NULL GROUP BY id_subsistema, nom_subsistema, YEAR(din_instante) ORDER BY id_subsistema, ano;" ;
    ons:exampleQuestion "Como evoluiu a carga média anual de energia em cada subsistema do SIN ao longo dos anos?"@pt .

<https://w3id.org/tiago-ons/data/template/carga_energia/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_subsistema, AVG(TRY_CAST(val_cargaenergiamwmed AS DOUBLE)) AS carga_media_mwmed, SUM((TRY_CAST(val_cargaenergiamwmed AS DOUBLE)) * 24.0) / 1000 AS carga_total_mwmed, COUNT(*) AS qtd_dias_apurados FROM read_parquet('s3://ons-aws-prod-opendata/dataset/carga_energia_di/*.parquet') WHERE val_cargaenergiamwmed IS NOT NULL AND din_instante >= ( SELECT MAX(din_instante) - INTERVAL 365 DAY FROM read_parquet('s3://ons-aws-prod-opendata/dataset/carga_energia_di/*.parquet') ) GROUP BY id_subsistema, nom_subsistema ORDER BY carga_media_mwmed DESC;" ;
    ons:exampleQuestion "Qual subsistema teve maior carga média de energia nos últimos 12 meses disponíveis?"@pt .

<https://w3id.org/tiago-ons/data/template/carga_energia/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT id_subsistema, CASE WHEN din_instante < '2021-03-01' THEN '1_ate_fev2021_scada' WHEN din_instante < '2023-04-29' THEN '2_mar2021_abr2023_nao_despachadas' ELSE '3_apos_abr2023_com_mmgd' END AS fase_metodologica, AVG(val_cargaenergiamwmed) AS carga_media_mwmed, COUNT(*) AS qtd_dias FROM read_parquet('s3://ons-aws-prod-opendata/dataset/carga_energia_di/*.parquet') WHERE val_cargaenergiamwmed IS NOT NULL AND id_subsistema = 'SE' GROUP BY id_subsistema, CASE WHEN din_instante < '2021-03-01' THEN '1_ate_fev2021_scada' WHEN din_instante < '2023-04-29' THEN '2_mar2021_abr2023_nao_despachadas' ELSE '3_apos_abr2023_com_mmgd' END ORDER BY fase_metodologica;" ;
    ons:exampleQuestion "Como a carga apurada no subsistema SE mudou antes e depois da inclusão da MMGD em abril/2023?"@pt .

