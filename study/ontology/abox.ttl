    skos:prefLabel "Verifconstrainedoff"@pt ;
    skos:altLabel "verif_constrained_off"@pt ;
    skos:altLabel "constrained_off_verificado"@pt ;
    skos:altLabel "CO_verif"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/geracao_termica_despacho_2/val_verifconstrainedoff> ;
    ons:expression "TRY_CAST(val_verifconstrainedoff AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/flag> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "1.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total\": {\"sql\": \"SUM(TRY_CAST(val_verifconstrainedoff AS DOUBLE))\", \"unit\": \"\"}, \"average\": {\"sql\": \"AVG(TRY_CAST(val_verifconstrainedoff AS DOUBLE))\", \"unit\": \"\"}, \"maximum\": {\"sql\": \"MAX(TRY_CAST(val_verifconstrainedoff AS DOUBLE))\", \"unit\": \"\"}, \"time_series\": {\"sql\": \"SUM(TRY_CAST(val_verifconstrainedoff AS DOUBLE))\", \"unit\": \"\"}, \"ranking\": {\"sql\": \"SUM(TRY_CAST(val_verifconstrainedoff AS DOUBLE))\", \"unit\": \"\"}, \"comparison\": {\"sql\": \"SUM(TRY_CAST(val_verifconstrainedoff AS DOUBLE))\", \"unit\": \"\"}}" .

