<https://w3id.org/tiago-ons/data/template/ind_confiarb_ccal/pattern_ccal_sin_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "ccal_sin_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_referencia AS TIMESTAMP)) AS mes,\n  AVG(val_ccal) AS ccal_medio\nFROM {source}\nWHERE cod_tipoagregacao = 'SIN'\n  AND id_periodicidade = 'ME'\n  AND EXTRACT(YEAR FROM TRY_CAST(din_referencia AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "proporcao_0_1" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_confiarb_ccal/ccal> .

<https://w3id.org/tiago-ons/data/template/ind_confiarb_ccal/pattern_ccal_por_agente_anual>
    a ons:QueryTemplate ;
    skos:prefLabel "ccal_por_agente_anual" ;
    ons:sqlTemplate "SELECT nom_agregacao,\n  AVG(val_ccal) AS ccal_medio,\n  MAX(num_linhasvioladas) AS max_linhas_violadas,\n  MAX(num_linhasoperacao) AS linhas_operacao\nFROM {source}\nWHERE cod_tipoagregacao = 'Agente'\n  AND id_periodicidade = 'AN'\n  AND EXTRACT(YEAR FROM TRY_CAST(din_referencia AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 2 DESC" ;
    ons:outputUnitLabel "proporcao_0_1" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_confiarb_ccal/ccal> .

<https://w3id.org/tiago-ons/data/template/ind_confiarb_ccal/pattern_linhas_violadas_serie>
    a ons:QueryTemplate ;
    skos:prefLabel "linhas_violadas_serie" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_referencia AS TIMESTAMP)) AS mes,\n  MAX(num_linhasvioladas) AS linhas_violadas,\n  MAX(num_linhasoperacao) AS linhas_operacao\nFROM {source}\nWHERE cod_tipoagregacao = 'SIN'\n  AND id_periodicidade = 'ME'\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "linhas" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_confiarb_ccal/num_linhasvioladas> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_confiarb_ccal/num_linhasoperacao> .

<https://w3id.org/tiago-ons/data/template/ind_confiarb_ccal/pattern_ccal_calculado_verificacao>
    a ons:QueryTemplate ;
    skos:prefLabel "ccal_calculado_verificacao" ;
    ons:sqlTemplate "SELECT din_referencia,\n  nom_agregacao,\n  num_linhasvioladas,\n  num_linhasoperacao,\n  val_ccal,\n  CASE WHEN num_linhasoperacao > 0\n    THEN ROUND(CAST(num_linhasvioladas AS DOUBLE) / num_linhasoperacao, 6)\n    ELSE NULL END AS ccal_calculado\nFROM {source}\nWHERE num_linhasoperacao > 0\nORDER BY din_referencia DESC" ;
    ons:outputUnitLabel "proporcao_0_1" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_confiarb_ccal/ccal> .

<https://w3id.org/tiago-ons/data/template/ind_confiarb_ccal/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT din_referencia, val_ccal, num_linhasoperacao, num_linhasvioladas FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_confiarb_ccal/*.parquet') WHERE cod_tipoagregacao = 'SIN' AND nom_agregacao = 'SIN' AND id_periodicidade = 'ME' AND din_referencia >= TIMESTAMP '2020-01-01' ORDER BY din_referencia;" ;
    ons:exampleQuestion "Como evoluiu o indicador CCAL do Sistema Interligado Nacional mês a mês desde 2020?"@pt .

<https://w3id.org/tiago-ons/data/template/ind_confiarb_ccal/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT nom_agregacao, AVG(val_ccal) AS ccal_medio_2024, SUM(num_linhasvioladas) AS total_linhas_violadas, SUM(num_linhasoperacao) AS total_linhas_operacao, COUNT(*) AS meses_apurados FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_confiarb_ccal/*.parquet') WHERE cod_tipoagregacao = 'Agente' AND id_periodicidade = 'ME' AND din_referencia >= TIMESTAMP '2024-01-01' AND din_referencia < TIMESTAMP '2025-01-01' GROUP BY nom_agregacao ORDER BY ccal_medio_2024 DESC LIMIT 20;" ;
    ons:exampleQuestion "Quais agentes de transmissão tiveram o maior indicador CCAL médio em 2024?"@pt .

<https://w3id.org/tiago-ons/data/template/ind_confiarb_ccal/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "WITH sin_ref AS ( SELECT din_referencia, val_ccal AS ccal_sin FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_confiarb_ccal/*.parquet') WHERE cod_tipoagregacao = 'SIN' AND nom_agregacao = 'SIN' AND id_periodicidade = 'ME' ), areas AS ( SELECT din_referencia, nom_agregacao, val_ccal AS ccal_area FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_confiarb_ccal/*.parquet') WHERE cod_tipoagregacao = 'AREA_CONTROLE' AND id_periodicidade = 'ME' ) SELECT a.din_referencia, a.nom_agregacao, a.ccal_area, s.ccal_sin, a.ccal_area - s.ccal_sin AS desvio_do_sin FROM areas AS a LEFT JOIN sin_ref AS s ON a.din_referencia = s.din_referencia ORDER BY a.din_referencia DESC, desvio_do_sin DESC LIMIT 100;" ;
    ons:exampleQuestion "Como o CCAL de cada área de controle se compara com o indicador do SIN no mesmo período?"@pt .

<https://w3id.org/tiago-ons/data/dataset/ind_confiarb_ccat>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:ind_confiarb_ccat" ;
    dct:title "ind_confiarb_ccat" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/qualidade> ;
    dcat:keyword "ANEEL"@pt ;
    dcat:keyword "CCAT"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "Submódulo 9.1"@pt ;
    dcat:keyword "carregamento"@pt ;
    dcat:keyword "confiabilidade"@pt ;
    dcat:keyword "confiabilidade de transformadores"@pt ;
    dcat:keyword "controle de carregamento de transformadores"@pt ;
    dcat:keyword "ind_confiarb_ccat"@pt ;
    dcat:keyword "indicador de carregamento de transformadores"@pt ;
    dcat:keyword "indicador regulatório"@pt ;
    dcat:keyword "rede básica"@pt ;
    dcat:keyword "transformadores"@pt ;
    dcat:keyword "transmissão"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Monitorar o desempenho operacional dos transformadores da rede básica de transmissão, permitindo que agentes de transmissão, ONS e ANEEL avaliem conformidade regulatória com os limites de carregamento estabelecidos no Submódulo 9.1. Suporta decisões de manutenção preventiva, planejamento de reforços na rede de transmissão, avaliação de penalidades por violação de limites operativos e elaboração de relatórios regulatórios de desempenho por agente e área de controle."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver indicadores de confiabilidade ou desempenho operacional de transformadores da rede básica de transmissão, violações de limites de carregamento, avaliação regulatória de agentes de transmissão conforme Submódulo 9."@pt ;
    ons:limitation "O dataset mistura registros mensais e anuais na mesma tabela. Existem registros com val_ccat = 0. O valor máximo de 70 transformadores violados simultaneamente é significativamente elevado e provavelmente corresponde ao nível SIN ou grandes áreas de controle."@pt ;
    dct:source <https://dados.ons.org.br/dataset/ind_confiarb_ccat> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/ind_confiarb_ccat/*.parquet" ;
    skos:altLabel "transformadores sobrecarregados"@pt ;
    skos:altLabel "carregamento dos transformadores"@pt ;
    skos:altLabel "transformadores acima do limite"@pt ;
    ons:exampleQuestion "Qual foi o CCAT médio por agente de transmissão em 2024?"@pt ;
    ons:exampleQuestion "Quais agentes apresentaram mais violações de carregamento de transformadores nos últimos 12 meses?"@pt ;
    ons:exampleQuestion "Como evoluiu o indicador CCAT do SIN entre 2016 e 2025?"@pt ;
    ons:exampleQuestion "Qual área de controle teve o pior desempenho de carregamento de transformadores em 2023?"@pt ;
    ons:exampleQuestion "Quantos transformadores da rede básica estiveram em violação de carregamento no ano de 2022?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver indicadores de confiabilidade ou desempenho operacional de transformadores da rede básica de transmissão, violações de limites de carregamento, avaliação regulatória de agentes de transmissão conforme Submódulo 9.1, ou comparação de desempenho entre agentes, áreas de controle e o SIN em séries temporais mensais ou anuais."@pt ;
    ons:agentInstruction "- [id_periodicidade] O dataset contém registros mensais e anuais coexistentes para a mesma entidade (nom_agregacao) e período (din_referencia). Ao agregar séries temporais sem filtrar id_periodicidade, ocorre dupla contagem: registros anuais somam valores já contabilizados nos mensais. Sempre filtrar id_periodicidade='MENSAL' ou id_periodicidade='ANUAL' antes de qualquer agregação temporal.\n\n- [val_ccat] val_ccat=0.0 indica que 100% dos transformadores da entidade estavam violados no período, o que pode representar dado real de evento crítico ou erro de apuração. Verificar registros com val_ccat=0.0 para validar consistência com num_transformadoresviolados = num_transformadoresoperacao. val_ccat < 0.0 é matematicamente impossível e indica erro de cálculo.\n\n- [num_transformadoresviolados] Verificar se num_transformadoresviolados excede num_transformadoresoperacao em algum registro, o que seria matematicamente inconsistente e resultaria em val_ccat negativo. As estatísticas indicam max=70 violados vs max=1729 em operação, mas a verificação por linha é necessária para garantir integridade.\n\n- [din_referencia] Verificar lacunas temporais na série mensal por entidade. O período cobre a partir de 2016-01, mas entidades individuais (agentes/áreas) podem ter entradas/saídas ao longo do tempo, gerando meses ausentes que não representam erro mas devem ser documentados para análises de séries temporais completas.\n\n- [cod_tipoagregacao] Verificar se existem variações de grafia ou valores inesperados em cod_tipoagregacao além dos três valores esperados (SIN, AREA_CONTROLE, AGENTE). Variações de case ou abreviações alternativas podem causar falhas em filtros e joins com outros datasets de confiabilidade.\n"@pt ;
    dct:accrualPeriodicity "anual" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/ind_confiarb_ccat/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2016-01-01/" ;
