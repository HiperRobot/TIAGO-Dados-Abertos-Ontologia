    ons:computedFrom <https://w3id.org/tiago-ons/data/column/geracao_exportacao_internacional/val_exportacao_uy> ;
    ons:expression "val_exportacao_uy" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "1.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((val_exportacao_uy) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(val_exportacao_uy)\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(val_exportacao_uy)\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(val_exportacao_uy)\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((val_exportacao_uy) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(val_exportacao_uy)\", \"unit\": \"MWmed\"}}" .

<https://w3id.org/tiago-ons/data/value/geracao_exportacao_internacional/fonte/termica>
    a ons:ValueAlias ;
    skos:notation "termica" ;
    skos:altLabel "termica"@pt ;
    skos:altLabel "termeletrica"@pt ;
    skos:altLabel "ute"@pt .

<https://w3id.org/tiago-ons/data/template/geracao_exportacao_internacional/pattern_gerexpevt_ar_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "gerexpevt_ar_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  SUM((val_gerexpevt_ar) * 1.0) / 1000 AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_exportacao_internacional/gerexpevt_ar> .

<https://w3id.org/tiago-ons/data/template/geracao_exportacao_internacional/pattern_exportacao_total_anual>
    a ons:QueryTemplate ;
    skos:prefLabel "exportacao_total_anual" ;
    ons:sqlTemplate "SELECT EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) AS ano,\n  SUM((val_exportacao_ar) * 1.0) / 1000 AS exportacao_ar_gwh,\n  SUM((val_exportacao_uy) * 1.0) / 1000 AS exportacao_uy_gwh,\n  SUM((COALESCE(val_exportacao_ar, 0) + COALESCE(val_exportacao_uy, 0)) * 1.0) / 1000 AS exportacao_total_gwh\nFROM {source}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_exportacao_internacional/exportacao_ar> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_exportacao_internacional/exportacao_uy> .

<https://w3id.org/tiago-ons/data/template/geracao_exportacao_internacional/pattern_reconciliacao_geracao_fluxo>
    a ons:QueryTemplate ;
    skos:prefLabel "reconciliacao_geracao_fluxo" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  SUM((val_gerexptermica) * 1.0) / 1000 AS geracao_termica_exp_gwh,\n  SUM((COALESCE(val_exportacao_ar, 0) + COALESCE(val_exportacao_uy, 0)) * 1.0) / 1000 AS fluxo_total_exportado_gwh\nFROM {source}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_exportacao_internacional/gerexptermica> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_exportacao_internacional/exportacao_ar> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_exportacao_internacional/exportacao_uy> .

<https://w3id.org/tiago-ons/data/template/geracao_exportacao_internacional/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, ROUND(SUM((COALESCE(val_exportacao_ar, 0)) * 1.0) / 1000, 2) AS energia_exportada_ar_mwmed, ROUND(SUM((COALESCE(val_exportacao_uy, 0)) * 1.0) / 1000, 2) AS energia_exportada_uy_mwmed, ROUND(SUM((COALESCE(val_exportacao_ar, 0)) * 1.0) / 1000 + SUM((COALESCE(val_exportacao_uy, 0)) * 1.0) / 1000, 2) AS total_exportado_mwmed FROM read_parquet('s3://ons-aws-prod-opendata/dataset/geracao_exportacao_internacional_ho/*.parquet') WHERE din_instante >= '2024-01-01' AND din_instante < '2025-01-01' GROUP BY DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) ORDER BY mes" ;
    ons:exampleQuestion "Qual foi o volume mensal de energia exportada para Argentina e Uruguai em 2024?"@pt .

<https://w3id.org/tiago-ons/data/template/geracao_exportacao_internacional/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, ROUND(SUM((val_gerexptermica) * 1.0) / 1000, 2) AS geracao_termica_exportacao_mwmed, ROUND(SUM((COALESCE(val_gerexpevt_ar, 0)) * 1.0) / 1000 + SUM((COALESCE(val_gerexpevt_uy, 0)) * 1.0) / 1000, 2) AS geracao_evt_total_mwmed, ROUND( 100.0 * SUM((val_gerexptermica) * 1.0) / 1000 / NULLIF(SUM((val_gerexptermica) * 1.0) / 1000 + SUM((COALESCE(val_gerexpevt_ar, 0)) * 1.0) / 1000 + SUM((COALESCE(val_gerexpevt_uy, 0)) * 1.0) / 1000, 0), 2 ) AS pct_termica FROM read_parquet('s3://ons-aws-prod-opendata/dataset/geracao_exportacao_internacional_ho/*.parquet') GROUP BY DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) ORDER BY mes" ;
    ons:exampleQuestion "Qual a participação percentual da geração térmica no total de energia destinada à exportação internacional por mês?"@pt .

<https://w3id.org/tiago-ons/data/template/geracao_exportacao_internacional/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT din_instante, val_exportacao_ar, val_exportacao_uy, val_gerexptermica FROM read_parquet('s3://ons-aws-prod-opendata/dataset/geracao_exportacao_internacional_ho/*.parquet') WHERE val_exportacao_ar IS NOT NULL ORDER BY val_exportacao_ar DESC LIMIT 10" ;
    ons:exampleQuestion "Quais foram as 10 horas com maior exportação para a Argentina no histórico disponível?"@pt .

<https://w3id.org/tiago-ons/data/dataset/geracao_termica_despacho_2>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:geracao-termica-despacho-2" ;
    dct:title "geracao-termica-despacho-2" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/geracao> ;
    dcat:keyword "constrained-off ONS"@pt ;
    dcat:keyword "despacho térmico"@pt ;
    dcat:keyword "despacho térmico motivo"@pt ;
    dcat:keyword "geração termelétrica por motivo"@pt ;
    dcat:keyword "inflexibilidade térmica"@pt ;
    dcat:keyword "motivo de despacho ONS"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Subsidiar analistas de operação, planejamento e regulação do setor elétrico brasileiro no acompanhamento da conformidade do despacho térmico horário, auditoria de acionamentos fora da ordem de mérito, quantificação de custos de inflexibilidade, análise de constrained-off e avaliação de eficiência do despacho centralizado pelo ONS. Suporta decisões de regulação tarifária, análise de custo marginal de operação e monitoramento de restrições elétricas que motivam despachos não econômicos."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver geração de usinas termelétricas despachadas pelo ONS com desagregação por motivo de despacho (ordem de mérito, inflexibilidade, razão elétrica, GFOM, constrained-off, unit commitment, garantia energética, exportação ou reserva de potencia) em base horaria."@pt ;
    ons:limitation "A coluna val_fdexp apresenta nulos na maior parte das linhas. cod_usinaplanejamento tem poucos nulos. Coluna armazenada como VARCHAR no dataset geracao-termica-despacho-2 devido ao formato de serialização."@pt ;
    dct:source <https://dados.ons.org.br/dataset/geracao-termica-despacho-2> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/geracao_termica_despacho_2_ho/*.parquet" ;
    skos:altLabel "por que a termica foi despachada"@pt ;
    skos:altLabel "motivo do despacho termico"@pt ;
    skos:altLabel "termicas ligadas por inflexibilidade"@pt ;
    skos:altLabel "quais termicas foram acionadas"@pt ;
    skos:altLabel "despacho fora da ordem de merito"@pt ;
    skos:altLabel "razao do acionamento termico"@pt ;
    skos:altLabel "geracao termoeletrica"@pt ;
    skos:altLabel "termoeletricas despachadas"@pt ;
    skos:altLabel "despacho em horario de ponta"@pt ;
    skos:altLabel "geracao termica por patamar"@pt ;
    ons:exampleQuestion "Qual foi a geração térmica total programada e verificada por subsistema em 2023?"@pt ;
    ons:exampleQuestion "Quais usinas termelétricas tiveram maior volume de despacho por inflexibilidade pura no período 2022–2024?"@pt ;
    ons:exampleQuestion "Qual a diferença entre geração programada e verificada (desvio de despacho) por usina no último trimestre?"@pt ;
    ons:exampleQuestion "Quais usinas apresentaram constrained-off e qual o volume total de MW afetados por mês?"@pt ;
    ons:exampleQuestion "Qual a participação percentual de cada motivo de despacho (ordem de mérito, inflexibilidade, razão elétrica, GFOM) na geração térmica total do SIN?"@pt ;
    ons:exampleQuestion "qual o despacho por ordem de merito no SE em janeiro de 2024?"@pt ;
    ons:exampleQuestion "top 5 usinas por geracao total 2023"@pt ;
    ons:exampleQuestion "despacho ordem demerito referencia no S 2022?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver geração de usinas termelétricas despachadas pelo ONS com desagregação por motivo de despacho (ordem de mérito, inflexibilidade, razão elétrica, GFOM, constrained-off, unit commitment, garantia energética, exportação ou reserva de potencia) em base horaria. Também relevante para análises de conformidade de despacho, custo de inflexibilidade, auditoria de despachos fora da ordem de mérito e comparação entre valores programados e verificados por usina."@pt ;
    ons:agentInstruction "- [val_proggeracao] Coluna armazenada como VARCHAR no Parquet devido ao formato de serialização. Contém valores numéricos de geração programada em MWmed que requerem conversão explícita para uso em agregações SQL no dataset geracao-termica-despacho-2.\n\n- [val_verifgeracao] Coluna armazenada como VARCHAR no Parquet devido ao formato de serialização. Contém valores numéricos de geração verificada em MWmed que requerem conversão explícita para uso em agregações SQL no dataset geracao-termica-despacho-2.\n\n- [val_fdexp] Única coluna com ausência relevante de dados no dataset geracao-termica-despacho-2 — nulos na maior parte das linhas. Pode indicar que o fator de disponibilidade para exportação não é calculado para usinas sem contrato de exportação ou em períodos sem demanda de exportação.\n\n- [cod_usinaplanejamento] Apresenta poucos nulos no dataset geracao-termica-despacho-2, possivelmente para usinas recém-cadastradas ou sem código atribuído no sistema de planejamento ONS. Impacta joins que utilizam este campo como chave.\n\n- [val_progordemdemeritoref] Coluna armazenada como VARCHAR no Parquet devido ao formato de serialização no dataset geracao-termica-despacho-2. Verificar se há registros com valores não conversíveis que possam indicar strings inválidas além do comportamento padrão.\n\n- [val_progconstrainedoff] Valores de constrained-off programado podem ser negativos no contexto ONS do dataset geracao-termica-despacho-2, representando constrained-on (despacho forçado acima do mérito). Verificar distribuição de valores negativos para validar consistência operacional.\n\n- [val_verifconstrainedoff] Valores de constrained-off verificado podem ser negativos (constrained-on efetivo) no dataset geracao-termica-despacho-2. Verificar distribuição para validar consistência entre programado e verificado.\n\n- [din_instante] Verificar se há horas faltantes na série temporal do dataset geracao-termica-despacho-2 para usinas com presenca continua na serie, o que poderia indicar falhas de coleta ou processamento dos dados horarios.\n\n- [tip_restricaoeletrica] Coluna INTEGER com valores entre 0 e 1078 no dataset geracao-termica-despacho-2. Valores muito elevados (acima de 500) podem representar códigos de restrições especiais ou erros de codificação. Verificar distribuição para identificar concentração em valores extremos.\n\n- [val_fdexp] Coluna 'val_fdexp' ausente em arquivos históricos (ex: GERACAO_TERMICA_DESPACHO-2_2022_01.parquet). Presente apenas a partir de versões recentes (ex: GERACAO_TERMICA_DESPACHO_2024.parquet). Queries históricas retornarão NULL para esta coluna. Use union_by_name=true ao combinar arquivos de diferentes períodos.\n- [tipos] As colunas de código `cod_usinaplanejamento` variam entre inteiro e decimal entre arquivos; compare-as como número, não como texto.\n"@pt ;
    dct:accrualPeriodicity "horária" ;
    ons:sourceExpression "read_parquet(['s3://ons-aws-prod-opendata/dataset/geracao_termica_despacho_2_ho/GERACAO_TERMICA_DESPACHO_201*.parquet', 's3://ons-aws-prod-opendata/dataset/geracao_termica_despacho_2_ho/GERACAO_TERMICA_DESPACHO_202[01].parquet', 's3://ons-aws-prod-opendata/dataset/geracao_termica_despacho_2_ho/GERACAO_TERMICA_DESPACHO-2_*.parquet'], union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2013-01-01/" ;
