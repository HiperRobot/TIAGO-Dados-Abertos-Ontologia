    ons:intervalHours "8760.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(val_ccat)\", \"unit\": \"indice (0 a 1)\"}, \"maximum\": {\"sql\": \"MAX(val_ccat)\", \"unit\": \"indice (0 a 1)\"}, \"minimum\": {\"sql\": \"MIN(val_ccat)\", \"unit\": \"indice (0 a 1)\"}, \"time_series\": {\"sql\": \"AVG(val_ccat)\", \"unit\": \"indice (0 a 1)\"}, \"ranking\": {\"sql\": \"AVG(val_ccat)\", \"unit\": \"indice (0 a 1)\"}, \"comparison\": {\"sql\": \"AVG(val_ccat)\", \"unit\": \"indice (0 a 1)\"}}" .

