<https://w3id.org/tiago-ons/data/column/interrupcao_carga/nom_agente>
    a ons:Column ;
    dct:title "nom_agente" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome do agente do setor elétrico responsável pelo equipamento ou rede envolvida na perturbação que causou a interrupção de carga. Pode ser transmissora, distribuidora ou geradora conforme o tipo de rede envolvida."@pt ;
    skos:altLabel "agente"@pt ;
    skos:altLabel "nome_agente"@pt ;
    skos:altLabel "empresa"@pt ;
    skos:altLabel "concessionaria"@pt ;
    skos:altLabel "operador"@pt ;
