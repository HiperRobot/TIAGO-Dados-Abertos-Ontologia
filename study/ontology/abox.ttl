<https://w3id.org/tiago-ons/data/column/usina_conjunto/dat_iniciorelacionamento>
    a ons:Column ;
    dct:title "dat_iniciorelacionamento" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Data de início da vigência do relacionamento entre a usina e o conjunto. Armazenada como VARCHAR no Parquet; requer conversão para DATE em consultas temporais. Representa atributo cadastral de vigência, não dimensão de série temporal."@pt ;
    skos:altLabel "data inicio"@pt ;
    skos:altLabel "inicio relacionamento"@pt ;
    skos:altLabel "data inicio vigencia"@pt ;
    skos:altLabel "dat_inicio"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/usina_conjunto/dat_fimrelacionamento>
    a ons:Column ;
    dct:title "dat_fimrelacionamento" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Data de fim da vigência do relacionamento entre a usina e o conjunto. Armazenada como VARCHAR no Parquet; pode conter valor sentinela para registros ativos (ex: '9999-12-31' ou '2999-12-31'). Requer conversão para DATE em consultas temporais."@pt ;
    skos:altLabel "data fim"@pt ;
    skos:altLabel "fim relacionamento"@pt ;
    skos:altLabel "data fim vigencia"@pt ;
    skos:altLabel "dat_fim"@pt ;
    skos:altLabel "data encerramento"@pt ;
    ons:semanticRole "TIMESTAMP" .

