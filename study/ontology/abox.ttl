    a ons:Column ;
    dct:title "val_montante" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Montante de reducao ofertado (MW), VARCHAR com ponto decimal. Metrica principal."@pt ;
    ons:castExpression "TRY_CAST(val_montante AS DOUBLE)" ;
    skos:altLabel "montante"@pt ;
    skos:altLabel "potencia ofertada"@pt ;
    skos:altLabel "reducao ofertada"@pt ;
    skos:altLabel "MW"@pt .

<https://w3id.org/tiago-ons/data/dimension/oferta_resposta_da_demanda/subsistema>
    a ons:Dimension ;
    skos:prefLabel "subsistema" ;
    ons:onColumn <https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/id_subsistema> ;
    ons:refersTo ons:Subsistema .

<https://w3id.org/tiago-ons/data/dimension/oferta_resposta_da_demanda/agente>
    a ons:Dimension ;
    skos:prefLabel "agente" ;
    ons:onColumn <https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/nom_agente> ;
    ons:refersTo ons:Agente .

<https://w3id.org/tiago-ons/data/dimension/oferta_resposta_da_demanda/tipo>
    a ons:Dimension ;
    skos:prefLabel "tipo" ;
    ons:onColumn <https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/tip_oferta> .

<https://w3id.org/tiago-ons/data/metric/oferta_resposta_da_demanda/montante_ofertado>
    a ons:Metric ;
    skos:prefLabel "Montante ofertado (MW)"@pt ;
    dct:description "Montante de reducao de carga ofertado (coluna val_montante). Somar para total ofertado por subsistema/agente/periodo."@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/val_montante> ;
    ons:expression "TRY_CAST(val_montante AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean .

<https://w3id.org/tiago-ons/data/quantitykind/power>
    a ons:QuantityKind ;
    skos:prefLabel "power" ;
    skos:closeMatch <http://qudt.org/vocab/quantitykind/ActivePower> .

<https://w3id.org/tiago-ons/data/metric/oferta_resposta_da_demanda/preco_oferta>
    a ons:Metric ;
    skos:prefLabel "Preco da oferta (R$/MWh)"@pt ;
    dct:description "Preco ofertado pela reducao (coluna val_preco). Media entre ofertas."@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/val_preco> ;
    ons:expression "TRY_CAST(val_preco AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/price> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/brl_per_mwh> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/avg> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean .

<https://w3id.org/tiago-ons/data/metric/oferta_resposta_da_demanda/duracao_oferta>
    a ons:Metric ;
    skos:prefLabel "Duracao da oferta (horas)"@pt ;
    dct:description "Duracao da janela de reducao (coluna val_duracao)."@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/val_duracao> ;
    ons:expression "TRY_CAST(val_duracao AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/duration> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/h> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/avg> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean .

<https://w3id.org/tiago-ons/data/usecase/agregacao_oferta>
    a ons:UseCase ;
    skos:prefLabel "agregacao_oferta" .

<https://w3id.org/tiago-ons/data/template/oferta_resposta_da_demanda/pattern_montante_por_subsistema>
    a ons:QueryTemplate ;
    skos:prefLabel "montante_por_subsistema" ;
    ons:sqlTemplate "SELECT nom_subsistema, COUNT(*) AS qtd_ofertas, SUM(TRY_CAST(val_montante AS DOUBLE)) AS montante_total_mw FROM {source} GROUP BY nom_subsistema ORDER BY montante_total_mw DESC" .

<https://w3id.org/tiago-ons/data/template/oferta_resposta_da_demanda/pattern_montante_por_agente>
    a ons:QueryTemplate ;
    skos:prefLabel "montante_por_agente" ;
    ons:sqlTemplate "SELECT nom_agente, SUM(TRY_CAST(val_montante AS DOUBLE)) AS montante_total_mw FROM {source} GROUP BY nom_agente ORDER BY montante_total_mw DESC" .

<https://w3id.org/tiago-ons/data/template/oferta_resposta_da_demanda/pattern_ofertas_por_ano>
    a ons:QueryTemplate ;
    skos:prefLabel "ofertas_por_ano" ;
    ons:sqlTemplate "SELECT SUBSTR(dat_reducao, 1, 4) AS ano, COUNT(*) AS qtd_ofertas, SUM(TRY_CAST(val_montante AS DOUBLE)) AS montante_total_mw FROM {source} GROUP BY SUBSTR(dat_reducao, 1, 4) ORDER BY ano" .

<https://w3id.org/tiago-ons/data/dataset/ofertapreco_importacao>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:ofertapreco-importacao" ;
    dct:title "ofertapreco-importacao" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/preco> ;
    dcat:keyword "agentes-comercializadores"@pt ;
    dcat:keyword "argentina"@pt ;
    dcat:keyword "ccee"@pt ;
    dcat:keyword "importacao-de-energia"@pt ;
    dcat:keyword "intercambio-internacional"@pt ;
    dcat:keyword "mercado-de-energia"@pt ;
    dcat:keyword "oferta de preço importação"@pt ;
    dcat:keyword "oferta de preço importação energia"@pt ;
    dcat:keyword "oferta importação Argentina"@pt ;
    dcat:keyword "oferta importação Uruguai"@pt ;
    dcat:keyword "oferta-de-preco"@pt ;
    dcat:keyword "ons"@pt ;
    dcat:keyword "preço declarado importação"@pt ;
    dcat:keyword "preço importação energia"@pt ;
    dcat:keyword "sin"@pt ;
    dcat:keyword "uruguai"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Subsidiar operadores do ONS e agentes do mercado de energia elétrico brasileiro nas decisões de despacho e intercâmbio internacional, fornecendo os preços declarados por agentes comercializadores para importação de energia da Argentina e do Uruguai. Suporta análises de competitividade de ofertas, auditoria de transações de importação, liquidação financeira no âmbito da CCEE e estudos de planejamento de curto prazo do SIN."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver preços declarados por agentes para importação de energia elétrica da Argentina ou do Uruguai ao SIN, incluindo análises de competitividade de ofertas, histórico de preços de importação por agente ou bloco, e correlação entre preços declarados e intercâmbio internacional realizado."@pt ;
    ons:limitation "Coluna armazenada como VARCHAR em vez de DATE/TIMESTAMP, impedindo operações temporais nativas (ORDER BY, BETWEEN, MIN/MAX de datas). Coluna armazenada como VARCHAR em vez de DATE/TIMESTAMP, impedindo operações temporais nativas. O valor máximo de 2282."@pt ;
    dct:source <https://dados.ons.org.br/dataset/ofertapreco-importacao> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/ofertapreco-importacao-se/*.parquet" ;
    skos:altLabel "preco ofertado para importar"@pt ;
    skos:altLabel "quanto os agentes pediram para importar"@pt ;
    ons:exampleQuestion "Quais agentes declararam ofertas de preço para importação de energia da Argentina na última semana?"@pt ;
    ons:exampleQuestion "Qual é o preço médio de oferta de importação por país (Argentina vs Uruguai) ao longo do tempo?"@pt ;
    ons:exampleQuestion "Quais blocos de oferta apresentam os maiores preços declarados para importação?"@pt ;
    ons:exampleQuestion "Existe correlação entre os preços declarados de importação e os volumes de intercâmbio internacional realizados?"@pt ;
    ons:exampleQuestion "Quais agentes comercializadores têm histórico de ofertas de preço acima de 500 R$/MWh para importação?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver preços declarados por agentes para importação de energia elétrica da Argentina ou do Uruguai ao SIN, incluindo análises de competitividade de ofertas, histórico de preços de importação por agente ou bloco, e correlação entre preços declarados e intercâmbio internacional realizado. Também relevante para auditorias de liquidação de transações de importação e estudos de despacho com energia importada."@pt ;
    ons:agentInstruction "- [dat_iniciovalidade] A coluna dat_iniciovalidade está armazenada como VARCHAR no schema físico, embora represente uma data. Operações de filtragem temporal, ordenação e cálculo de intervalos requerem conversão explícita para DATE. Risco de ordenação lexicográfica incorreta se o formato não for estritamente ISO (YYYY-MM-DD) em todos os registros.\n\n- [dat_fimvalidade] A coluna dat_fimvalidade está armazenada como VARCHAR no schema físico, embora represente uma data de fim de vigência. Requer conversão explícita para DATE em operações temporais. Deve-se verificar se dat_fimvalidade >= dat_iniciovalidade em todos os registros.\n\n- [val_preco] O valor máximo de val_preco é 2282,36, enquanto o mínimo é 23,61 — amplitude de aproximadamente 97x. Valores muito elevados podem representar ofertas em períodos de escassez extrema ou erros de declaração. Recomenda-se monitorar registros acima de 3 desvios padrão da média.\n\n- [nom_bloco] Não há dicionário de dados disponível para nom_bloco. Recomenda-se inspecionar os valores únicos para verificar padronização de nomenclatura (maiúsculas, acentuação, abreviações) e confirmar se representam patamares de carga (Pesada, Média, Leve) ou blocos horários numerados.\n\n- [nom_agente] Risco de duplicatas na chave primária composta (nom_pais, nom_agente, nom_bloco, dat_iniciovalidade) caso um mesmo agente submeta múltiplas ofertas para o mesmo bloco e período. Deve-se verificar se a combinação dessas quatro colunas é de fato única em todos os registros.\n"@pt ;
    dct:accrualPeriodicity "semanal" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/ofertapreco-importacao-se/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2019-01-01/" ;
