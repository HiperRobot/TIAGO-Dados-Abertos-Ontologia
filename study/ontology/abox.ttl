<https://w3id.org/tiago-ons/data/column/ind_confiarb_dreq_freq/din_referencia>
    a ons:Column ;
    dct:title "din_referencia" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data de referência do indicador, sempre no primeiro dia do mês ou do ano. Para registros mensais, representa o mês de apuração (ex: 2024-01-01 = janeiro/2024). Para registros anuais, representa o ano de apuração (ex: 2024-01-01 = ano 2024). Cobre o período de 2007-01-01 em diante."@pt ;
    skos:altLabel "data de referência"@pt ;
    skos:altLabel "mês de referência"@pt ;
    skos:altLabel "ano de referência"@pt ;
    skos:altLabel "competência"@pt ;
    skos:altLabel "período"@pt ;
    skos:altLabel "dat_referencia"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/ind_confiarb_dreq_freq/val_dreq>
    a ons:Column ;
    dct:title "val_dreq" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Duração Equivalente de Interrupção de Carga (DREQ) da Rede Básica, em horas. Mede o tempo total equivalente de interrupção ponderado pela carga afetada no período de referência, conforme Submódulo 9.1 dos Procedimentos de Rede do ONS. Valores anuais do SIN podem atingir ~15.636 horas (acumulado ponderado). Valor mínimo é 0,0 (sem interrupções no período)."@pt ;
    skos:altLabel "DREQ"@pt ;
    skos:altLabel "duração equivalente de interrupção"@pt ;
    skos:altLabel "duração de interrupção"@pt ;
    skos:altLabel "horas de interrupção"@pt ;
    skos:altLabel "DEC rede básica"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/h> .

<https://w3id.org/tiago-ons/data/column/ind_confiarb_dreq_freq/val_freq>
    a ons:Column ;
    dct:title "val_freq" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Frequência Equivalente de Interrupção de Carga (FREQ) da Rede Básica, em número de interrupções por período. Mede a quantidade equivalente de interrupções ponderada pela carga afetada no período de referência, conforme Submódulo 9.1 dos Procedimentos de Rede do ONS. Valor máximo observado ~11,24. Valor mínimo é 0,0."@pt ;
    skos:altLabel "FREQ"@pt ;
    skos:altLabel "frequência equivalente de interrupção"@pt ;
    skos:altLabel "número de interrupções"@pt ;
    skos:altLabel "FEC rede básica"@pt ;
    skos:altLabel "frequência de interrupção"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/interrupcoes_periodo> .

<https://w3id.org/tiago-ons/data/unit/interrupcoes_periodo>
    a ons:Unit ;
    skos:prefLabel "interrupcoes_periodo" ;
    skos:altLabel "interrupções/período" .

<https://w3id.org/tiago-ons/data/metric/ind_confiarb_dreq_freq/dreq>
    a ons:Metric ;
    skos:prefLabel "Dreq"@pt ;
    skos:altLabel "DREQ"@pt ;
    skos:altLabel "duração equivalente de interrupção"@pt ;
    skos:altLabel "duração de interrupção"@pt ;
    skos:altLabel "horas de interrupção"@pt ;
    skos:altLabel "DEC rede básica"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ind_confiarb_dreq_freq/val_dreq> ;
    ons:expression "val_dreq" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/numeric> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/h> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "8760.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total\": {\"sql\": \"SUM(val_dreq)\", \"unit\": \"horas\"}, \"average\": {\"sql\": \"AVG(val_dreq)\", \"unit\": \"horas\"}, \"maximum\": {\"sql\": \"MAX(val_dreq)\", \"unit\": \"horas\"}, \"time_series\": {\"sql\": \"SUM(val_dreq)\", \"unit\": \"horas\"}, \"ranking\": {\"sql\": \"SUM(val_dreq)\", \"unit\": \"horas\"}, \"comparison\": {\"sql\": \"SUM(val_dreq)\", \"unit\": \"horas\"}}" .

<https://w3id.org/tiago-ons/data/metric/ind_confiarb_dreq_freq/freq>
    a ons:Metric ;
    skos:prefLabel "Freq"@pt ;
    skos:altLabel "FREQ"@pt ;
    skos:altLabel "frequência equivalente de interrupção"@pt ;
    skos:altLabel "número de interrupções"@pt ;
    skos:altLabel "FEC rede básica"@pt ;
    skos:altLabel "frequência de interrupção"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ind_confiarb_dreq_freq/val_freq> ;
    ons:expression "val_freq" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/count> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/interrupcoes_periodo> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "8760.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total\": {\"sql\": \"SUM(val_freq)\", \"unit\": \"interrupções/período\"}, \"average\": {\"sql\": \"AVG(val_freq)\", \"unit\": \"interrupções/período\"}, \"maximum\": {\"sql\": \"MAX(val_freq)\", \"unit\": \"interrupções/período\"}, \"time_series\": {\"sql\": \"SUM(val_freq)\", \"unit\": \"interrupções/período\"}, \"ranking\": {\"sql\": \"SUM(val_freq)\", \"unit\": \"interrupções/período\"}, \"comparison\": {\"sql\": \"SUM(val_freq)\", \"unit\": \"interrupções/período\"}}" .

