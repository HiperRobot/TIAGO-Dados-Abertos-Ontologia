<https://w3id.org/tiago-ons/data/template/cvu_usitermica/pattern_cvu_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "cvu_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(dat_iniciosemana AS TIMESTAMP)) AS mes, id_subsistema,\n  AVG(val_cvu) AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(dat_iniciosemana AS TIMESTAMP)) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "R$/MWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/cvu_usitermica/cvu> .

<https://w3id.org/tiago-ons/data/template/cvu_usitermica/pattern_cvu_ultima_revisao>
    a ons:QueryTemplate ;
    skos:prefLabel "cvu_ultima_revisao" ;
    ons:sqlTemplate "SELECT nom_usina, id_subsistema, AVG(val_cvu) AS cvu_medio\nFROM {source}\nWHERE ano_referencia = {year}\n  AND mes_referencia = {month}\n  AND num_revisao = (\n    SELECT MAX(num_revisao) FROM {source}\n    WHERE ano_referencia = {year} AND mes_referencia = {month}\n  )\nGROUP BY nom_usina, id_subsistema\nORDER BY cvu_medio DESC" ;
    ons:outputUnitLabel "R$/MWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/cvu_usitermica/cvu> .

<https://w3id.org/tiago-ons/data/template/cvu_usitermica/pattern_cvu_comparacao_revisoes>
    a ons:QueryTemplate ;
    skos:prefLabel "cvu_comparacao_revisoes" ;
    ons:sqlTemplate "SELECT num_revisao, AVG(val_cvu) AS cvu_medio\nFROM {source}\nWHERE ano_referencia = {year}\n  AND mes_referencia = {month}\n  AND id_subsistema = '{subsistema}'\nGROUP BY num_revisao\nORDER BY num_revisao" ;
    ons:outputUnitLabel "R$/MWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/cvu_usitermica/cvu> .

<https://w3id.org/tiago-ons/data/template/cvu_usitermica/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "WITH ultima_semana AS ( SELECT MAX(dat_iniciosemana) AS max_semana FROM read_parquet('s3://ons-aws-prod-opendata/dataset/cvu_usitermica_se/*.parquet') ), revisao_maxima AS ( SELECT dat_iniciosemana, cod_usinaplanejamento, MAX(num_revisao) AS max_revisao FROM read_parquet('s3://ons-aws-prod-opendata/dataset/cvu_usitermica_se/*.parquet') WHERE dat_iniciosemana = (SELECT max_semana FROM ultima_semana) GROUP BY dat_iniciosemana, cod_usinaplanejamento ) SELECT c.id_subsistema, c.nom_subsistema, c.nom_semanaoperativa, COUNT(DISTINCT c.cod_usinaplanejamento) AS qtd_usinas, ROUND(AVG(c.val_cvu), 2) AS cvu_medio, ROUND(MIN(c.val_cvu), 2) AS cvu_minimo, ROUND(MAX(c.val_cvu), 2) AS cvu_maximo FROM read_parquet('s3://ons-aws-prod-opendata/dataset/cvu_usitermica_se/*.parquet') AS c INNER JOIN revisao_maxima AS r ON c.dat_iniciosemana = r.dat_iniciosemana AND c.cod_usinaplanejamento = r.cod_usinaplanejamento AND c.num_revisao = r.max_revisao WHERE c.id_subsistema != 'SIN' GROUP BY c.id_subsistema, c.nom_subsistema, c.nom_semanaoperativa ORDER BY cvu_medio DESC" ;
    ons:exampleQuestion "Qual o CVU médio das usinas térmicas por subsistema na semana operativa mais recente disponível?"@pt .

<https://w3id.org/tiago-ons/data/template/cvu_usitermica/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "WITH revisao_maxima AS ( SELECT dat_iniciosemana, cod_usinaplanejamento, MAX(num_revisao) AS max_revisao FROM read_parquet('s3://ons-aws-prod-opendata/dataset/cvu_usitermica_se/*.parquet') GROUP BY dat_iniciosemana, cod_usinaplanejamento ) SELECT c.ano_referencia, c.id_subsistema, c.nom_subsistema, COUNT(DISTINCT c.cod_usinaplanejamento) AS qtd_usinas, ROUND(AVG(c.val_cvu), 2) AS cvu_medio_anual, ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY c.val_cvu), 2) AS cvu_mediana_anual, ROUND(MAX(c.val_cvu), 2) AS cvu_maximo_anual FROM read_parquet('s3://ons-aws-prod-opendata/dataset/cvu_usitermica_se/*.parquet') AS c INNER JOIN revisao_maxima AS r ON c.dat_iniciosemana = r.dat_iniciosemana AND c.cod_usinaplanejamento = r.cod_usinaplanejamento AND c.num_revisao = r.max_revisao WHERE c.id_subsistema != 'SIN' AND c.val_cvu > 0 GROUP BY c.ano_referencia, c.id_subsistema, c.nom_subsistema ORDER BY c.ano_referencia, c.id_subsistema" ;
    ons:exampleQuestion "Como evoluiu o CVU médio das usinas térmicas por subsistema ao longo dos anos?"@pt .

<https://w3id.org/tiago-ons/data/template/cvu_usitermica/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "WITH ultima_semana AS ( SELECT MAX(dat_iniciosemana) AS max_semana FROM read_parquet('s3://ons-aws-prod-opendata/dataset/cvu_usitermica_se/*.parquet') ), revisao_maxima AS ( SELECT dat_iniciosemana, cod_usinaplanejamento, MAX(num_revisao) AS max_revisao FROM read_parquet('s3://ons-aws-prod-opendata/dataset/cvu_usitermica_se/*.parquet') WHERE dat_iniciosemana = (SELECT max_semana FROM ultima_semana) GROUP BY dat_iniciosemana, cod_usinaplanejamento ) SELECT c.cod_usinaplanejamento, c.nom_usina, c.id_subsistema, c.nom_semanaoperativa, c.num_revisao, ROUND(c.val_cvu, 2) AS val_cvu FROM read_parquet('s3://ons-aws-prod-opendata/dataset/cvu_usitermica_se/*.parquet') AS c INNER JOIN revisao_maxima AS r ON c.dat_iniciosemana = r.dat_iniciosemana AND c.cod_usinaplanejamento = r.cod_usinaplanejamento AND c.num_revisao = r.max_revisao ORDER BY c.val_cvu DESC LIMIT 20" ;
    ons:exampleQuestion "Quais são as 20 usinas térmicas com maior CVU na programação mais recente?"@pt .

<https://w3id.org/tiago-ons/data/dataset/dados_hidrologicos_res>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:dados-hidrologicos-res" ;
    dct:title "dados-hidrologicos-res" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/hidrologia> ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "balanço hídrico"@pt ;
    dcat:keyword "dados hidrológicos"@pt ;
    dcat:keyword "dados hidráulicos"@pt ;
    dcat:keyword "despacho hidrotérmico"@pt ;
    dcat:keyword "hidrologia"@pt ;
    dcat:keyword "nível montante"@pt ;
    dcat:keyword "reservatório hidrelétrico"@pt ;
    dcat:keyword "reservatórios"@pt ;
    dcat:keyword "reservatórios ONS"@pt ;
    dcat:keyword "vazão afluente"@pt ;
    dcat:keyword "volume útil"@pt ;
    dcat:keyword "volume útil reservatórios"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Prover aos operadores do ONS, planejadores energéticos, pesquisadores e agentes do mercado elétrico os dados hidráulicos diários consolidados dos reservatórios do SIN, permitindo monitoramento do estado de armazenamento, suporte ao despacho hidrotérmico otimizado, balanço hídrico por bacia e reservatório, estudos de planejamento da operação energética, análise de risco hidrológico e avaliação de disponibilidade hídrica para geração de energia elétrica."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver estado operacional de reservatórios hidrelétricos do SIN, incluindo níveis, volumes de armazenamento, vazões afluentes, turbinadas, vertidas ou defluentes em base diária."@pt ;
    ons:limitation "val_vazaoincrementalbruta tem nulos na maior parte das linhas — dado de preenchimento tardio ou não aplicável à maioria dos reservatórios; não deve ser usado como métrica obrigatória em análises. Valor mínimo de -2174,06 m³/s — fisicamente possível em contextos de transferência hídrica inversa ou evaporação líquida elevada, mas deve ser monitorado como possível erro de consistência. val_vazaoartificial tem nulos na maior parte das linhas — campo não se aplica a reservatórios sem regularização artificial; verificar se reservatórios com transferência hídrica possuem preenchimento adequado."@pt ;
    dct:source <https://dados.ons.org.br/dataset/dados-hidrologicos-res> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/dados_hidrologicos_di/*.parquet" ;
    skos:altLabel "nivel do reservatorio"@pt ;
    skos:altLabel "quanto de agua tem na represa"@pt ;
    skos:altLabel "vazao da usina"@pt ;
    skos:altLabel "volume util do reservatorio"@pt ;
    skos:altLabel "quanto entrou de agua"@pt ;
    skos:altLabel "cota do reservatorio"@pt ;
    skos:altLabel "afluencia da usina"@pt ;
    skos:altLabel "situacao das represas"@pt ;
    ons:exampleQuestion "Qual foi o volume útil médio dos reservatórios do subsistema Sudeste/Centro-Oeste no último mês?"@pt ;
    ons:exampleQuestion "Quais reservatórios apresentaram vertimento acima de 1000 m³/s nos últimos 30 dias?"@pt ;
    ons:exampleQuestion "Como evoluiu a vazão afluente de Itaipu ao longo de 2024?"@pt ;
    ons:exampleQuestion "Quais reservatórios da bacia do Paraná estão com volume útil abaixo de 30%?"@pt ;
    ons:exampleQuestion "Qual a relação entre vazão turbinada e vazão afluente para os reservatórios do subsistema Sul em anos de La Niña?"@pt ;
    ons:exampleQuestion "Qual reservatório tá com maior nível montante agora?"@pt ;
    ons:exampleQuestion "Me mostra ranking de vazão afluente dos reservatórios do NE em setembro"@pt ;
    ons:exampleQuestion "Qual a diferença entre nível montante e jusante de Sobradinho?"@pt ;
    ons:exampleQuestion "Quais reservatórios da bacia do Paraná tiveram maior vazão afluente em agosto?"@pt ;
    ons:exampleQuestion "Qual foi o volume útil mínimo atingido em setembro?"@pt ;
    ons:exampleQuestion "Compara o volume útil: Sul vs Nordeste"@pt ;
    ons:exampleQuestion "Qual a vazão afluente média dos reservatórios do Norte?"@pt ;
    ons:exampleQuestion "Quais reservatórios aumentaram nível essa semana?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver estado operacional de reservatórios hidrelétricos do SIN, incluindo níveis, volumes de armazenamento, vazões afluentes, turbinadas, vertidas ou defluentes em base diária. Também recuperar quando a análise requerer balanço hídrico por reservatório, bacia ou subsistema, monitoramento de armazenamento energético, ou correlação entre hidrologia e geração hidrelétrica."@pt ;
    ons:agentInstruction "- [val_vazaoincrementalbruta] A maior parte dos registros possuem valor nulo. Dado de preenchimento tardio no processo de consistência hidrológica ONS, não disponível para todos os reservatórios e períodos. Não deve ser usado como campo obrigatório em análises operacionais.\n\n- [val_vazaoincrementalbruta] Valores negativos presentes (min=-2174.06 m³/s), fisicamente inconsistentes para vazão incremental bruta. Podem indicar erros de consistência hidrológica ou ajustes de balanço hídrico ainda não finalizados no dataset dados-hidrologicos-res.\n\n- [val_vazaoartificial] Nulos na maior parte das linhas. Coluna aplicável apenas a reservatórios com contribuições artificiais identificadas no dataset dados-hidrologicos-res. Tratar nulos como zero em agregações de balanço hídrico pode introduzir viés sistemático.\n\n- [val_vazaotransferida] Nulos na maior parte das linhas. Aplicável apenas a reservatórios com transposição hídrica entre bacias no dataset dados-hidrologicos-res. Reservatórios sem transposição terão esta coluna sempre nula.\n\n- [val_vazaooutrasestruturas] Nulos na maior parte das linhas no dataset dados-hidrologicos-res. Indica que nem todos os reservatórios possuem estruturas hidráulicas adicionais (comportas de fundo, eclusas). Nulos devem ser tratados como zero no cálculo da defluência total apenas após confirmação cadastral.\n\n- [val_niveljusante] Nulos em boa parte das linhas no dataset dados-hidrologicos-res. Reservatórios do tipo fio d'água ou sem medição de nível a jusante podem não ter este dado disponível sistematicamente.\n\n- [cod_usina] cod_usina com valor mínimo 0 e poucos nulos no dataset dados-hidrologicos-res. Valor 0 pode indicar reservatório sem usina associada ou erro de cadastro. Verificar se cod_usina=0 é código válido ou sentinela de ausência antes de usar em JOINs.\n\n- [nom_ree] Nulos em boa parte das linhas em nom_ree no dataset dados-hidrologicos-res. Reservatórios sem REE associado podem ser de uso múltiplo não pertencentes ao despacho centralizado ONS.\n\n- [din_instante] Possíveis lacunas temporais por reservatório ao longo do período desde 2000 no dataset dados-hidrologicos-res. Reservatórios que entraram em operação após 2000 ou foram desativados terão séries incompletas. Verificar continuidade por reservatório antes de análises de séries temporais.\n\n- [val_vazaoturbinada] Nulos em boa parte das linhas em val_vazaoturbinada no dataset dados-hidrologicos-res. Pode indicar períodos de manutenção, restrições operativas ou reservatórios sem unidades geradoras ativas. Nulos não devem ser tratados como zero sem verificação operacional.\n\n- [id_subsistema] Valores com trailing spaces detectados em 'id_subsistema'. Use TRIM() em filtros WHERE para evitar perda de registros.\n- [nom_bacia] Valores com trailing spaces detectados em 'nom_bacia'. Use TRIM() em filtros WHERE para evitar perda de registros.\n- [nom_ree] Valores com trailing spaces detectados em 'nom_ree'. Use TRIM() em filtros WHERE para evitar perda de registros.\n- [val_vazaoincrementalbruta] Coluna 'val_vazaoincrementalbruta' ausente em arquivos históricos (ex: DADOS_HIDROLOGICOS_RES_2000.parquet). Presente apenas a partir de versões recentes (ex: DADOS_HIDROLOGICOS_RES_2026.parquet). Queries históricas retornarão NULL para esta coluna. Use union_by_name=true ao combinar arquivos de diferentes períodos.\n- [tipos] As colunas `val_niveljusante`, `val_nivelmontante`, `val_vazaoafluente`, `val_vazaoartificial`, `val_vazaodefluente`, `val_vazaoevaporacaoliquida`, `val_vazaoincremental`, `val_vazaonatural`, `val_vazaooutrasestruturas`, `val_vazaotransferida`, `val_vazaoturbinada`, `val_vazaousoconsuntivo`, `val_vazaovertida`, `val_volumeutilcon` mudam de tipo entre arquivos anuais (texto em uns, número em outros); cada uma traz `castExpression` no schema: use-o em toda agregação e comparação.\n"@pt ;
    dct:accrualPeriodicity "diária" ;
