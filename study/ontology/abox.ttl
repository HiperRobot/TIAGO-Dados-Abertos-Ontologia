    skos:altLabel "indisponibilidade não programada"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent> .

<https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_ft_trlt/disp>
