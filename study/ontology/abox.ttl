    ons:allowedValue "3.0" ;
    ons:allowedValue "4.0" ;
    ons:allowedValue "5.0" ;
    ons:allowedValue "8.0" ;
    ons:allowedValue "10.0" .

<https://w3id.org/tiago-ons/data/column/ind_confiarb_ciper/val_ciper3>
