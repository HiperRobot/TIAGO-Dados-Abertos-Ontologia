<https://w3id.org/tiago-ons/data/metric/coff_eolica_usi_intrasemihora/num_minutosrestricao>
    a ons:Metric ;
    skos:prefLabel "Num Minutosrestricao"@pt ;
    skos:altLabel "minutos restrição"@pt ;
    skos:altLabel "duração"@pt ;
    skos:altLabel "tempo restrição"@pt ;
    skos:altLabel "minutos"@pt ;
    skos:altLabel "duração minutos"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/coff_eolica_usi_intrasemihora/num_minutosrestricao> ;
    ons:expression "num_minutosrestricao" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/duration_minutes> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/min> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"total\": {\"sql\": \"SUM(num_minutosrestricao)\", \"unit\": \"minutos\"}, \"average\": {\"sql\": \"AVG(num_minutosrestricao)\", \"unit\": \"minutos\"}, \"maximum\": {\"sql\": \"MAX(num_minutosrestricao)\", \"unit\": \"minutos\"}, \"time_series\": {\"sql\": \"SUM(num_minutosrestricao)\", \"unit\": \"minutos\"}, \"ranking\": {\"sql\": \"SUM(num_minutosrestricao)\", \"unit\": \"minutos\"}, \"comparison\": {\"sql\": \"SUM(num_minutosrestricao)\", \"unit\": \"minutos\"}}" .

<https://w3id.org/tiago-ons/data/quantitykind/duration_minutes>
    a ons:QuantityKind ;
    skos:prefLabel "duration_minutes" ;
    skos:closeMatch <http://qudt.org/vocab/quantitykind/Time> .

<https://w3id.org/tiago-ons/data/metric/coff_eolica_usi_intrasemihora/geracaolimitada>
    a ons:Metric ;
    skos:prefLabel "Geração limitada (limite imposto; total_energy = energia no limite durante o evento, não energia não gerada)"@pt ;
    skos:altLabel "geração limitada"@pt ;
    skos:altLabel "limite geração"@pt ;
    skos:altLabel "curtailment"@pt ;
    skos:altLabel "corte geração"@pt ;
    skos:altLabel "potência limitada"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/coff_eolica_usi_intrasemihora/val_geracaolimitada> ;
    ons:expression "val_geracaolimitada" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM(val_geracaolimitada * num_minutosrestricao / 60.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(val_geracaolimitada)\", \"unit\": \"MW\"}, \"peak_power\": {\"sql\": \"MAX(val_geracaolimitada)\", \"unit\": \"MW\"}, \"time_series\": {\"sql\": \"AVG(val_geracaolimitada)\", \"unit\": \"MW\"}, \"ranking\": {\"sql\": \"SUM(val_geracaolimitada * num_minutosrestricao / 60.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(val_geracaolimitada)\", \"unit\": \"MW\"}}" .

