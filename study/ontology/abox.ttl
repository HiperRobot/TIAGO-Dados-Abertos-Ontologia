    ons:hasTemplate <https://w3id.org/tiago-ons/data/template/cargaglobal_roraima/fewshot_2> .

<https://w3id.org/tiago-ons/data/column/cargaglobal_roraima/din_instante>
    a ons:Column ;
    dct:title "din_instante" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Data e hora do instante de medição da carga global de Roraima, com granularidade de 30 minutos. Armazenado como VARCHAR no Parquet físico devido ao pipeline de exportação ONS; requer CAST para TIMESTAMP em operações temporais."@pt ;
    skos:altLabel "instante"@pt ;
    skos:altLabel "data_hora"@pt ;
    skos:altLabel "timestamp"@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "horario"@pt ;
    skos:altLabel "din_instante"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/cargaglobal_roraima/val_carga_mw>
    a ons:Column ;
    dct:title "val_carga_mw" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Valor da carga global consumida no sistema isolado de Roraima no instante correspondente, expresso em megawatts (MW). Armazenado como VARCHAR no Parquet físico devido ao formato de serialização (dtype object convertido para UTF8); requer TRY_CAST para operações numéricas."@pt ;
    skos:altLabel "carga"@pt ;
    skos:altLabel "carga_mw"@pt ;
    skos:altLabel "demanda"@pt ;
    skos:altLabel "demanda_mw"@pt ;
    skos:altLabel "consumo"@pt ;
    skos:altLabel "valor_carga"@pt ;
    skos:altLabel "potencia"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_carga_mw AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> .

<https://w3id.org/tiago-ons/data/metric/cargaglobal_roraima/carga_mw>
    a ons:Metric ;
    skos:prefLabel "Carga Verificada"@pt ;
    skos:altLabel "carga"@pt ;
    skos:altLabel "carga_mw"@pt ;
    skos:altLabel "demanda"@pt ;
    skos:altLabel "demanda_mw"@pt ;
    skos:altLabel "consumo"@pt ;
    skos:altLabel "valor_carga"@pt ;
    skos:altLabel "potencia"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/cargaglobal_roraima/val_carga_mw> ;
    ons:expression "TRY_CAST(val_carga_mw AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM(TRY_CAST(val_carga_mw AS DOUBLE)) * 0.5\", \"unit\": \"MWh\", \"note\": \"Energia total = SUM(MW) * 0.5h por intervalo de 30 minutos\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_carga_mw AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_carga_mw AS DOUBLE))\", \"unit\": \"MW\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_carga_mw AS DOUBLE))\", \"unit\": \"MWmed\", \"note\": \"Para serie temporal use media; para energia acumulada multiplique por interval_hours\"}, \"ranking\": {\"sql\": \"AVG(TRY_CAST(val_carga_mw AS DOUBLE))\", \"unit\": \"MWmed\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_carga_mw AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

<https://w3id.org/tiago-ons/data/usecase/serie_temporal_carga_roraima>
    a ons:UseCase ;
    skos:prefLabel "serie_temporal_carga_roraima" .

<https://w3id.org/tiago-ons/data/template/cargaglobal_roraima/pattern_carga_media_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "carga_media_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  AVG(TRY_CAST(val_carga_mw AS DOUBLE)) AS carga_media_mwmed,\n  MAX(TRY_CAST(val_carga_mw AS DOUBLE)) AS carga_pico_mw,\n  SUM(TRY_CAST(val_carga_mw AS DOUBLE)) * 0.5 AS energia_total_mwh\nFROM {source}\nWHERE TRY_CAST(din_instante AS TIMESTAMP) IS NOT NULL\n  AND TRY_CAST(val_carga_mw AS DOUBLE) IS NOT NULL\nGROUP BY 1\nORDER BY 1\n" ;
    ons:outputUnitLabel "MWmed / MW / MWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/cargaglobal_roraima/carga_mw> .

<https://w3id.org/tiago-ons/data/template/cargaglobal_roraima/pattern_pico_demanda_com_horario>
    a ons:QueryTemplate ;
    skos:prefLabel "pico_demanda_com_horario" ;
    ons:sqlTemplate "SELECT TRY_CAST(din_instante AS TIMESTAMP) AS instante,\n  TRY_CAST(val_carga_mw AS DOUBLE) AS carga_mw\nFROM {source}\nWHERE TRY_CAST(val_carga_mw AS DOUBLE) IS NOT NULL\n  AND EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nORDER BY TRY_CAST(val_carga_mw AS DOUBLE) DESC\nLIMIT 1\n" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/cargaglobal_roraima/carga_mw> .

<https://w3id.org/tiago-ons/data/template/cargaglobal_roraima/pattern_serie_temporal_diaria>
    a ons:QueryTemplate ;
    skos:prefLabel "serie_temporal_diaria" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('day', TRY_CAST(din_instante AS TIMESTAMP)) AS dia,\n  AVG(TRY_CAST(val_carga_mw AS DOUBLE)) AS carga_media_mwmed,\n  MAX(TRY_CAST(val_carga_mw AS DOUBLE)) AS carga_pico_mw,\n  COUNT(*) AS registros_dia\nFROM {source}\nWHERE TRY_CAST(din_instante AS TIMESTAMP) IS NOT NULL\n  AND TRY_CAST(val_carga_mw AS DOUBLE) IS NOT NULL\nGROUP BY 1\nORDER BY 1\n" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/cargaglobal_roraima/carga_mw> .

<https://w3id.org/tiago-ons/data/template/cargaglobal_roraima/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, MAX(TRY_CAST(val_carga_mw AS DOUBLE)) AS carga_max_mw, MIN(TRY_CAST(val_carga_mw AS DOUBLE)) AS carga_min_mw, AVG(TRY_CAST(val_carga_mw AS DOUBLE)) AS carga_media_mw, COUNT(*) AS num_registros FROM read_parquet('s3://ons-aws-prod-opendata/dataset/cargaglobal_roraima/*.parquet') WHERE TRY_CAST(val_carga_mw AS DOUBLE) IS NOT NULL GROUP BY DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) ORDER BY mes" ;
    ons:exampleQuestion "Qual foi a carga máxima e mínima registrada em cada mês em Roraima?"@pt .

<https://w3id.org/tiago-ons/data/template/cargaglobal_roraima/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT EXTRACT(hour FROM TRY_CAST(din_instante AS TIMESTAMP)) AS hora_do_dia, AVG(TRY_CAST(val_carga_mw AS DOUBLE)) AS carga_media_mw, MAX(TRY_CAST(val_carga_mw AS DOUBLE)) AS carga_max_mw, COUNT(*) AS num_registros FROM read_parquet('s3://ons-aws-prod-opendata/dataset/cargaglobal_roraima/*.parquet') WHERE TRY_CAST(val_carga_mw AS DOUBLE) IS NOT NULL GROUP BY EXTRACT(hour FROM TRY_CAST(din_instante AS TIMESTAMP)) ORDER BY hora_do_dia" ;
    ons:exampleQuestion "Qual é o perfil típico de carga ao longo do dia em Roraima (média por hora do dia)?"@pt .

<https://w3id.org/tiago-ons/data/template/cargaglobal_roraima/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT EXTRACT(year FROM TRY_CAST(din_instante AS TIMESTAMP)) AS ano, AVG(TRY_CAST(val_carga_mw AS DOUBLE)) AS carga_media_mw, MAX(TRY_CAST(val_carga_mw AS DOUBLE)) AS carga_pico_mw, COUNT(*) AS num_registros FROM read_parquet('s3://ons-aws-prod-opendata/dataset/cargaglobal_roraima/*.parquet') WHERE TRY_CAST(val_carga_mw AS DOUBLE) IS NOT NULL GROUP BY EXTRACT(year FROM TRY_CAST(din_instante AS TIMESTAMP)) ORDER BY ano" ;
    ons:exampleQuestion "Como a demanda média de energia em Roraima evoluiu ano a ano entre 2022 e 2025?"@pt .

<https://w3id.org/tiago-ons/data/dataset/classificacao_evt>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:classificacao-evt" ;
    dct:title "classificacao-evt" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/hidrologia> ;
    dcat:keyword "EVT"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "classificacao EVT"@pt ;
    dcat:keyword "energia vertida turbinável"@pt ;
    dcat:keyword "energia vertida turbinável EVT"@pt ;
    dcat:keyword "energia-vertida-turbinavel"@pt ;
    dcat:keyword "hidrologia"@pt ;
    dcat:keyword "horario"@pt ;
    dcat:keyword "operacao-hidraulica"@pt ;
    dcat:keyword "perdas-hidraulicas"@pt ;
    dcat:keyword "razao-eletrica"@pt ;
    dcat:keyword "razao-energetica"@pt ;
    dcat:keyword "vertimento"@pt ;
    dcat:keyword "vertimento energético"@pt ;
    dcat:keyword "vertimento turbinável"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Subsidiar analistas de planejamento energético, operadores do ONS e pesquisadores na avaliação de perdas hidráulicas horárias do SIN, identificando a causa raiz do vertimento turbinável (energética ou elétrica) para suporte a decisões de despacho, gestão de reservatórios, avaliação de restrições de transmissão e estudos de eficiência operativa do sistema hidrelétrico brasileiro."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver vertimento turbinável, EVT, perdas hidráulicas horárias do SIN, classificação de vertimento por razão energética ou elétrica, ou análise de eficiência do aproveitamento hídrico no sistema interligado nacional para o período 2024-2025."@pt ;
    ons:limitation "Coluna armazenada como VARCHAR no Parquet em vez de TIMESTAMP. Coluna numérica armazenada como VARCHAR devido a formato de serialização  (dataset classificacao-evt). Coluna numérica armazenada como VARCHAR devido ao formato de serialização  (dataset classificacao-evt)."@pt ;
    dct:source <https://dados.ons.org.br/dataset/classificacao-evt> ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/classificacao_evt/*.parquet" ;
    skos:altLabel "por que houve vertimento"@pt ;
    skos:altLabel "motivo do vertimento"@pt ;
    skos:altLabel "vertimento por razao energetica"@pt ;
    skos:altLabel "agua desperdicada por motivo"@pt ;
    ons:exampleQuestion "Qual foi o total de energia vertida turbinável verificada no SIN em 2024?"@pt ;
    ons:exampleQuestion "Qual a proporção do EVT causado por razão elétrica versus razão energética em cada mês?"@pt ;
    ons:exampleQuestion "Em quais horas do dia ocorre maior concentração de vertimento turbinável de razão elétrica?"@pt ;
    ons:exampleQuestion "Qual foi o pico horário de EVT verificado no período 2024-2025 e quando ocorreu?"@pt ;
    ons:exampleQuestion "Como evoluiu mensalmente a participação do EVT de razão energética no total vertido?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver vertimento turbinável, EVT, perdas hidráulicas horárias do SIN, classificação de vertimento por razão energética ou elétrica, ou análise de eficiência do aproveitamento hídrico no sistema interligado nacional para o período 2024-2025. Também relevante para perguntas sobre restrições elétricas que causam desperdício de energia hidráulica ou sobre o impacto de reservatórios cheios no vertimento do SIN."@pt ;
    ons:agentInstruction "- [din_instante] Coluna armazenada como VARCHAR no Parquet em vez de TIMESTAMP. Requer conversão explícita para operações temporais (filtros por período, truncamento por hora/dia/mês). Verificar se o formato é consistente ('YYYY-MM-DD HH:MM:SS') ao longo de todo o dataset classificacao-evt.\n\n- [val_evt_verificado] Coluna numérica do dataset classificacao-evt armazenada como VARCHAR devido ao formato de serialização. Qualquer agregação (SUM, AVG, MIN, MAX) sem TRY_CAST retornará erro ou resultado incorreto. Verificar presença de valores não numéricos ou strings vazias que causariam NULL no cast.\n\n- [val_evt_razaoenergetica] Coluna numérica do dataset classificacao-evt armazenada como VARCHAR devido ao formato de serialização. Verificar se os valores após TRY_CAST estão no intervalo esperado [0, 1] ou [0, 100] para uma razão/proporção, e se há valores negativos inesperados.\n\n- [val_evt_razaoeletrica] Coluna numérica do dataset classificacao-evt armazenada como VARCHAR devido ao formato de serialização. Verificar se os valores após TRY_CAST estão no intervalo esperado [0, 1] ou [0, 100] para uma razão/proporção, e se a soma de razão energética + razão elétrica é consistente (esperado ≈ 1.0 ou 100% por instante).\n"@pt ;
    dct:accrualPeriodicity "horária" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/classificacao_evt/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2024-01-01/2025-12-31" ;
    ons:spatialGrain ons:SIN ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/classificacao_evt/din_instante> ;
    ons:rowKey <https://w3id.org/tiago-ons/data/column/classificacao_evt/din_instante> ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/classificacao_evt/val_evt_verificado> ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/classificacao_evt/val_evt_razaoenergetica> ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/classificacao_evt/val_evt_razaoeletrica> ;
    ons:hasPerspective <https://w3id.org/tiago-ons/data/perspective/verificado> ;
