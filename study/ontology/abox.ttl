<https://w3id.org/tiago-ons/data/metric/modalidade_usina/potenciaautorizada>
    a ons:Metric ;
    skos:prefLabel "Potenciaautorizada"@pt ;
    skos:altLabel "potência autorizada"@pt ;
    skos:altLabel "potência instalada"@pt ;
    skos:altLabel "capacidade autorizada"@pt ;
    skos:altLabel "potência"@pt ;
    skos:altLabel "MW autorizado"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/modalidade_usina/val_potenciaautorizada> ;
    ons:expression "TRY_CAST(val_potenciaautorizada AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/capacity> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:aggregationSQL "{\"total\": {\"sql\": \"SUM(TRY_CAST(val_potenciaautorizada AS DOUBLE))\", \"unit\": \"MW\"}, \"maximum\": {\"sql\": \"MAX(TRY_CAST(val_potenciaautorizada AS DOUBLE))\", \"unit\": \"MW\"}, \"time_series\": {\"sql\": \"SUM(TRY_CAST(val_potenciaautorizada AS DOUBLE))\", \"unit\": \"MW\"}, \"ranking\": {\"sql\": \"SUM(TRY_CAST(val_potenciaautorizada AS DOUBLE))\", \"unit\": \"MW\"}, \"comparison\": {\"sql\": \"SUM(TRY_CAST(val_potenciaautorizada AS DOUBLE))\", \"unit\": \"MW\"}}" .

