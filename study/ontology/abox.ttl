<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_fgeracao_uge_mensal/pattern_todas_metricas_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "todas_metricas_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(dat_mesreferencia AS TIMESTAMP)) AS mes,\n  ROUND(SUM(val_potencia), 1) AS potencia,\n  ROUND(AVG(val_dispf), 1) AS dispf,\n  ROUND(AVG(val_indisppf), 1) AS indisppf,\n  ROUND(AVG(val_indispff), 1) AS indispff,\n  ROUND(SUM(val_dmdff), 1) AS dmdff,\n  ROUND(SUM(val_fdff), 1) AS fdff\nFROM {source}\nWHERE EXTRACT(YEAR FROM dat_mesreferencia) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_fgeracao_uge_mensal/potencia> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_fgeracao_uge_mensal/dispf> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_fgeracao_uge_mensal/indisppf> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_fgeracao_uge_mensal/indispff> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_fgeracao_uge_mensal/dmdff> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_fgeracao_uge_mensal/fdff> .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_fgeracao_uge_mensal/pattern_potencia_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "potencia_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(dat_mesreferencia AS TIMESTAMP)) AS mes, id_subsistema,\n  SUM(val_potencia) AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM dat_mesreferencia) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_fgeracao_uge_mensal/potencia> .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_fgeracao_uge_mensal/pattern_dispf_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "dispf_mensal" ;
