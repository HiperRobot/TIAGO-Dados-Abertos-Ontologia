<https://w3id.org/tiago-ons/data/column/ind_confiarb_robustez/cod_indicador>
    a ons:Column ;
    dct:title "cod_indicador" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Código identificador do indicador de robustez. Representa um dos quatro indicadores definidos no Submódulo 9.1 dos Procedimentos de Rede do ONS: RMAL (Robustez da Malha Sistêmica), RMCS (Robustez da Malha Sistêmica para Contingências Simples), RRB (Robustez da Rede Básica) e RRBCS (Robustez da Rede Básica para Contingências Simples)."@pt ;
    skos:altLabel "indicador"@pt ;
    skos:altLabel "tipo de indicador"@pt ;
    skos:altLabel "código do indicador"@pt ;
    skos:altLabel "indicador de robustez"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "RMAL" ;
    ons:allowedValue "RMCS" ;
    ons:allowedValue "RRB" ;
    ons:allowedValue "RRBCS" .

<https://w3id.org/tiago-ons/data/column/ind_confiarb_robustez/dsc_agregacao>
    a ons:Column ;
    dct:title "dsc_agregacao" ;
    dct:type "string" ;
