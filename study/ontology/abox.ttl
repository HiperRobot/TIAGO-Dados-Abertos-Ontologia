    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM(val_itaipu_50hz_br) * 1.0\", \"unit\": \"MWh\"}, \"average_power\": {\"sql\": \"AVG(val_itaipu_50hz_br)\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(val_itaipu_50hz_br)\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(val_itaipu_50hz_br)\", \"unit\": \"MWmed\"}, \"comparison\": {\"sql\": \"AVG(val_itaipu_50hz_br)\", \"unit\": \"MWmed\"}}" .

<https://w3id.org/tiago-ons/data/metric/geracao_itaipu/itaipu_br>
    a ons:Metric ;
    skos:prefLabel "Itaipu Brasil"@pt ;
    skos:altLabel "itaipu brasil"@pt ;
    skos:altLabel "geração itaipu brasil"@pt ;
    skos:altLabel "contribuição itaipu SIN"@pt ;
    skos:altLabel "val_itaipu_br"@pt ;
    skos:altLabel "itaipu destinado ao brasil"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/geracao_itaipu/val_itaipu_br> ;
    ons:expression "val_itaipu_br" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
