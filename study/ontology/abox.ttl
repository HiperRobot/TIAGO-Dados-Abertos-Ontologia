<https://w3id.org/tiago-ons/data/metric/restricao_coff_eolica_detail/ventoverificado>
    a ons:Metric ;
    skos:prefLabel "Velocidade do Vento Verificado"@pt ;
    skos:altLabel "vento"@pt ;
    skos:altLabel "velocidade do vento"@pt ;
    skos:altLabel "vento verificado"@pt ;
    skos:altLabel "velocidade vento medida"@pt ;
    skos:altLabel "vento medio"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/val_ventoverificado> ;
    ons:expression "val_ventoverificado" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/flow> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/m_per_s> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(CASE WHEN flg_dadoventoinvalido = 0.0 THEN val_ventoverificado END)\", \"unit\": \"m/s\"}, \"maximum\": {\"sql\": \"MAX(CASE WHEN flg_dadoventoinvalido = 0.0 THEN val_ventoverificado END)\", \"unit\": \"m/s\"}, \"minimum\": {\"sql\": \"MIN(CASE WHEN flg_dadoventoinvalido = 0.0 THEN val_ventoverificado END)\", \"unit\": \"m/s\"}, \"time_series\": {\"sql\": \"AVG(CASE WHEN flg_dadoventoinvalido = 0.0 THEN val_ventoverificado END)\", \"unit\": \"m/s\"}, \"ranking\": {\"sql\": \"AVG(CASE WHEN flg_dadoventoinvalido = 0.0 THEN val_ventoverificado END)\", \"unit\": \"m/s\"}, \"comparison\": {\"sql\": \"AVG(CASE WHEN flg_dadoventoinvalido = 0.0 THEN val_ventoverificado END)\", \"unit\": \"m/s\"}}" .

<https://w3id.org/tiago-ons/data/metric/restricao_coff_eolica_detail/geracaoestimada>
