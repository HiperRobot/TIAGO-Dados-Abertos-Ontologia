    skos:altLabel "teip"@pt ;
    skos:altLabel "indisponibilidade forçada"@pt ;
    skos:altLabel "indisponibilidade programada"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "TEIFa" ;
    ons:allowedValue "TEIP" .

<https://w3id.org/tiago-ons/data/column/taxa_teif_teip/val_taxa>
    a ons:Column ;
    dct:title "val_taxa" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Valor da taxa de indisponibilidade expressa como proporção entre 0,0 e 1,0 (equivalente a 0% a 100%). TEIFa representa a fração do tempo em que a usina esteve indisponível por falha forçada; TEIP representa a fração por manutenção programada."@pt ;
    skos:altLabel "taxa de indisponibilidade"@pt ;
    skos:altLabel "valor da taxa"@pt ;
    skos:altLabel "teifa"@pt ;
    skos:altLabel "teip"@pt ;
    skos:altLabel "indisponibilidade"@pt ;
    skos:altLabel "percentual de indisponibilidade"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/proporcao_0_a_1> .

<https://w3id.org/tiago-ons/data/column/taxa_teif_teip/num_versao>
    a ons:Column ;
    dct:title "num_versao" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Número da versão do cálculo/consistência dos dados para o período de referência. Varia de 1 a 19, refletindo o processo de consistência recorrente com múltiplas revisões — versões mais altas representam dados mais recentes e consistidos para o mesmo período."@pt ;
    skos:altLabel "versão"@pt ;
    skos:altLabel "número de versão"@pt ;
    skos:altLabel "revisão"@pt ;
    skos:altLabel "versão do cálculo"@pt ;
    skos:altLabel "ciclo de consistência"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "1.0" ;
    ons:allowedValue "2.0" ;
    ons:allowedValue "3.0" ;
    ons:allowedValue "4.0" ;
    ons:allowedValue "5.0" ;
    ons:allowedValue "6.0" ;
    ons:allowedValue "7.0" ;
    ons:allowedValue "8.0" ;
    ons:allowedValue "9.0" ;
    ons:allowedValue "10.0" ;
    ons:allowedValue "16.0" ;
    ons:allowedValue "17.0" ;
    ons:allowedValue "18.0" ;
    ons:allowedValue "19.0" .

<https://w3id.org/tiago-ons/data/column/taxa_teif_teip/din_calculo>
    a ons:Column ;
    dct:title "din_calculo" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data e hora em que o cálculo/consistência foi executado pelo ONS. Diferente de din_mes (referência mensal), registra o momento exato do processamento — atualizado diariamente às 12h e 19h conforme política de publicação."@pt ;
    skos:altLabel "data de cálculo"@pt ;
    skos:altLabel "data de consistência"@pt ;
    skos:altLabel "data de processamento"@pt ;
    skos:altLabel "timestamp do cálculo"@pt ;
    skos:altLabel "data de atualização"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/family/taxa_teif>
    a ons:Family ;
    skos:prefLabel "taxa_teif" .

<https://w3id.org/tiago-ons/data/dimension/taxa_teif_teip/usina>
    a ons:Dimension ;
