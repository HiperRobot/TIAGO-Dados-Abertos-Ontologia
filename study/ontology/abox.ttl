<https://w3id.org/tiago-ons/data/column/uge_opera_csi/dat_verificada>
    a ons:Column ;
    dct:title "dat_verificada" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Data em que o estado da unidade geradora foi verificado/registrado, armazenada como texto. Formato esperado DD/MM/YYYY ou YYYY-MM-DD. Requer TRY_CAST ou TRY_STRPTIME para conversão em pipelines analíticos."@pt ;
    skos:altLabel "data de verificação"@pt ;
    skos:altLabel "data do snapshot"@pt ;
    skos:altLabel "data de referência"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/uge_opera_csi/hora_verificada>
    a ons:Column ;
    dct:title "Hora_verificada" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Hora em que o estado da unidade geradora foi verificado/registrado, armazenada como texto (formato esperado HH:MM ou HH:MM:SS). Atenção ao nome com inicial maiúscula — pode causar erros em queries case-sensitive e pipelines que assumem normalização de nomes."@pt ;
    skos:altLabel "hora de verificação"@pt ;
    skos:altLabel "hora do snapshot"@pt ;
    skos:altLabel "hora_verificada"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "12:00" ;
    ons:allowedValue "19:00" .

<https://w3id.org/tiago-ons/data/column/uge_opera_csi/tip_usina>
