<https://w3id.org/tiago-ons/data/metric/ena_diario_por_bacia/ena_bruta_bacia_mwmed>
    a ons:Metric ;
    skos:prefLabel "Energia Natural Afluente Bruta por Bacia"@pt ;
    skos:altLabel "ENA bruta"@pt ;
    skos:altLabel "energia natural afluente bruta"@pt ;
    skos:altLabel "ENA bruta em MWmed"@pt ;
    skos:altLabel "afluencia bruta"@pt ;
    skos:altLabel "energia bruta da bacia"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ena_diario_por_bacia/ena_bruta_bacia_mwmed> ;
    ons:expression "ena_bruta_bacia_mwmed" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(ena_bruta_bacia_mwmed AS DOUBLE)) * 24.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_bacia_mwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(ena_bruta_bacia_mwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_bacia_mwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(ena_bruta_bacia_mwmed AS DOUBLE)) * 24.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_bacia_mwmed AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

