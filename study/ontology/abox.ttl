<https://w3id.org/tiago-ons/data/column/ear_diario_por_bacia/ear_verif_bacia_percentual>
    a ons:Column ;
    dct:title "ear_verif_bacia_percentual" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Energia armazenada verificada na bacia hidro energética expressa como percentual da capacidade máxima (ear_verif_bacia_mwmes / ear_max_bacia × 100). Pode ultrapassar 100% em situações de superenchimento ou quando o critério de cálculo considera volumes acima do nível máximo operacional normal. Valor máximo observado: 154,43%."@pt ;
    skos:altLabel "EAR percentual"@pt ;
    skos:altLabel "percentual de armazenamento"@pt ;
    skos:altLabel "nível dos reservatórios"@pt ;
    skos:altLabel "armazenamento em percentual"@pt ;
    skos:altLabel "EAR %"@pt ;
    skos:altLabel "porcentagem de armazenamento"@pt ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent> .

