<https://w3id.org/tiago-ons/data/metric/taxa_teif_teip/taxa>
    a ons:Metric ;
    skos:prefLabel "Taxa de Indisponibilidade"@pt ;
    skos:altLabel "taxa de indisponibilidade"@pt ;
    skos:altLabel "valor da taxa"@pt ;
    skos:altLabel "teifa"@pt ;
    skos:altLabel "teip"@pt ;
    skos:altLabel "indisponibilidade"@pt ;
    skos:altLabel "percentual de indisponibilidade"@pt ;
    skos:altLabel "taxa equivalente de indisponibilidade forcada"@pt ;
    skos:altLabel "taxa de indisponibilidade programada"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/taxa_teif_teip/val_taxa> ;
    ons:expression "val_taxa" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/ratio> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/proporcao_0_1> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:intervalHours "8760.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(val_taxa)\", \"unit\": \"proporcao_0_1\"}, \"maximum\": {\"sql\": \"MAX(val_taxa)\", \"unit\": \"proporcao_0_1\"}, \"minimum\": {\"sql\": \"MIN(val_taxa)\", \"unit\": \"proporcao_0_1\"}, \"time_series\": {\"sql\": \"AVG(val_taxa)\", \"unit\": \"proporcao_0_1\"}, \"ranking\": {\"sql\": \"AVG(val_taxa)\", \"unit\": \"proporcao_0_1\"}, \"comparison\": {\"sql\": \"AVG(val_taxa)\", \"unit\": \"proporcao_0_1\"}}" .

