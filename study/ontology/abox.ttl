    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(val_demanda AS DOUBLE)) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_demanda AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_demanda AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_demanda AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(val_demanda AS DOUBLE)) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_demanda AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

