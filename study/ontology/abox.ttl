    skos:altLabel "FTTR 440"@pt ;
    skos:altLabel "transformador 440kV"@pt ;
    ons:filter "cod_caracteristica = 'FTTR - 440'" .

<https://w3id.org/tiago-ons/data/value/ind_disponibilidade_ft_trlt/cod_caracteristica/fttr_500>
    a ons:ValueAlias ;
    skos:notation "FTTR - 500" ;
