    a ons:ValueAlias ;
    skos:notation "disponibilidade_plena" ;
    ons:onColumn <https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_conversor/val_dispftconv> ;
    skos:altLabel "disponivel 100%"@pt ;
    skos:altLabel "disponibilidade plena"@pt ;
