    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM(GREATEST(val_geracaoverificada, 0) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(GREATEST(val_geracaoverificada, 0))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(val_geracaoverificada)\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(GREATEST(val_geracaoverificada, 0))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM(GREATEST(val_geracaoverificada, 0) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(GREATEST(val_geracaoverificada, 0))\", \"unit\": \"MWmed\"}}" .

<https://w3id.org/tiago-ons/data/metric/restricao_coff_fotovoltaica_detail/curtailment>
    a ons:Metric ;
    skos:prefLabel "Curtailment Solar (energia cortada)"@pt ;
    skos:altLabel "curtailment"@pt ;
    skos:altLabel "constrained-off solar"@pt ;
    skos:altLabel "corte solar"@pt ;
    skos:altLabel "energia cortada"@pt ;
    skos:altLabel "restricao solar"@pt ;
    skos:altLabel "coff solar"@pt ;
    skos:altLabel "energia nao gerada"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/restricao_coff_fotovoltaica_detail/val_geracaoestimada> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/restricao_coff_fotovoltaica_detail/val_geracaoverificada> ;
    ons:expression "GREATEST(GREATEST(val_geracaoestimada, 0) - GREATEST(val_geracaoverificada, 0), 0)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/total_energy> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM(GREATEST(GREATEST(val_geracaoestimada, 0) - GREATEST(val_geracaoverificada, 0), 0) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(GREATEST(GREATEST(val_geracaoestimada, 0) - GREATEST(val_geracaoverificada, 0), 0))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(GREATEST(val_geracaoestimada - val_geracaoverificada, 0))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(GREATEST(GREATEST(val_geracaoestimada, 0) - GREATEST(val_geracaoverificada, 0), 0))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM(GREATEST(GREATEST(val_geracaoestimada, 0) - GREATEST(val_geracaoverificada, 0), 0) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(GREATEST(GREATEST(val_geracaoestimada, 0) - GREATEST(val_geracaoverificada, 0), 0))\", \"unit\": \"MWmed\"}}" .

<https://w3id.org/tiago-ons/data/metric/restricao_coff_fotovoltaica_detail/percentual_curtailment>
    a ons:Metric ;
    skos:prefLabel "Percentual de Curtailment Solar"@pt ;
    skos:altLabel "percentual curtailment"@pt ;
    skos:altLabel "taxa de corte"@pt ;
    skos:altLabel "percentual coff"@pt ;
    skos:altLabel "fracao cortada"@pt ;
    skos:altLabel "indice curtailment"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/restricao_coff_fotovoltaica_detail/val_geracaoestimada> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/restricao_coff_fotovoltaica_detail/val_geracaoverificada> ;
    ons:expression "CASE WHEN SUM(GREATEST(val_geracaoestimada, 0)) > 0 THEN 100.0 * SUM(GREATEST(GREATEST(val_geracaoestimada, 0) - GREATEST(val_geracaoverificada, 0), 0)) / SUM(GREATEST(val_geracaoestimada, 0)) ELSE NULL END" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/ratio> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/avg> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(CASE WHEN val_geracaoestimada > 0 THEN 100.0 * GREATEST(val_geracaoestimada - val_geracaoverificada, 0) / val_geracaoestimada ELSE NULL END)\", \"unit\": \"%\"}, \"maximum\": {\"sql\": \"MAX(CASE WHEN val_geracaoestimada > 0 THEN 100.0 * GREATEST(val_geracaoestimada - val_geracaoverificada, 0) / val_geracaoestimada ELSE NULL END)\", \"unit\": \"%\"}, \"minimum\": {\"sql\": \"MIN(CASE WHEN val_geracaoestimada > 0 THEN 100.0 * GREATEST(val_geracaoestimada - val_geracaoverificada, 0) / val_geracaoestimada ELSE NULL END)\", \"unit\": \"%\"}, \"time_series\": {\"sql\": \"AVG(CASE WHEN val_geracaoestimada > 0 THEN 100.0 * GREATEST(val_geracaoestimada - val_geracaoverificada, 0) / val_geracaoestimada ELSE NULL END)\", \"unit\": \"%\"}, \"ranking\": {\"sql\": \"AVG(CASE WHEN val_geracaoestimada > 0 THEN 100.0 * GREATEST(val_geracaoestimada - val_geracaoverificada, 0) / val_geracaoestimada ELSE NULL END)\", \"unit\": \"%\"}, \"comparison\": {\"sql\": \"AVG(CASE WHEN val_geracaoestimada > 0 THEN 100.0 * GREATEST(val_geracaoestimada - val_geracaoverificada, 0) / val_geracaoestimada ELSE NULL END)\", \"unit\": \"%\"}}" .

<https://w3id.org/tiago-ons/data/metric/restricao_coff_fotovoltaica_detail/geracaoreferenciafinal>
    a ons:Metric ;
    skos:prefLabel "Geração de referência final"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/restricao_coff_fotovoltaica_detail/val_geracaoreferenciafinal> ;
    ons:expression "val_geracaoreferenciafinal" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/avg> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM(val_geracaoreferenciafinal * 0.5) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(val_geracaoreferenciafinal)\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(val_geracaoreferenciafinal)\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(val_geracaoreferenciafinal)\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM(val_geracaoreferenciafinal * 0.5) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(val_geracaoreferenciafinal)\", \"unit\": \"MWmed\"}}" .

