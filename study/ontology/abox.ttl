<https://w3id.org/tiago-ons/data/column/interrupcao_carga/nom_subsistema>
    a ons:Column ;
    dct:title "nom_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome descritivo do subsistema elétrico onde ocorreu a interrupção de carga. Complementa id_subsistema com a denominação por extenso."@pt ;
    skos:altLabel "nome_subsistema"@pt ;
    skos:altLabel "subsistema_nome"@pt ;
    skos:altLabel "regiao_nome"@pt ;
    skos:altLabel "nome_regiao"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "NORDESTE" ;
    ons:allowedValue "NORTE" ;
    ons:allowedValue "SUDESTE/CENTRO-OESTE" ;
    ons:allowedValue "SUL" .

