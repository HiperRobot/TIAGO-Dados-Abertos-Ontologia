<https://w3id.org/tiago-ons/data/column/ind_confiarb_robustez/val_indicador>
    a ons:Column ;
    dct:title "val_indicador" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Valor percentual do indicador de robustez calculado para o período e agregação geográfica especificados. Representa a proporção de situações em que a rede básica atendeu aos critérios de robustez definidos no Submódulo 9.1 dos Procedimentos de Rede do ONS. Varia de 0,0 (nenhuma robustez) a 100,0 (robustez plena)."@pt ;
    skos:altLabel "valor do indicador"@pt ;
    skos:altLabel "indicador de robustez"@pt ;
    skos:altLabel "percentual de robustez"@pt ;
    skos:altLabel "RMAL"@pt ;
    skos:altLabel "RMCS"@pt ;
    skos:altLabel "RRB"@pt ;
    skos:altLabel "RRBCS"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent> .

<https://w3id.org/tiago-ons/data/column/ind_confiarb_robustez/num_perturbacoes>
    a ons:Column ;
    dct:title "num_perturbacoes" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Número total de perturbações registradas na rede básica no período e agregação geográfica de referência, independentemente de terem causado corte de carga. Inclui todas as ocorrências de contingências e distúrbios no sistema de transmissão. Valor máximo observado: 3844."@pt ;
    skos:altLabel "número de perturbações"@pt ;
    skos:altLabel "total de perturbações"@pt ;
    skos:altLabel "quantidade de perturbações"@pt ;
    skos:altLabel "ocorrências"@pt ;
    skos:altLabel "distúrbios"@pt ;
    ons:semanticRole "IDENTIFIER" .

