<https://w3id.org/tiago-ons/data/metric/ear_diario_por_subsistema/ear_verif_subsistema_mwmes>
    a ons:Metric ;
    skos:prefLabel "Energia Armazenada"@pt ;
    skos:altLabel "ear_verificada"@pt ;
    skos:altLabel "ear_mwmes"@pt ;
    skos:altLabel "energia_armazenada_mwmes"@pt ;
    skos:altLabel "ear_verif_mwmes"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ear_diario_por_subsistema/ear_verif_subsistema_mwmes> ;
    ons:expression "ear_verif_subsistema_mwmes" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/energy_stock> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmes> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/last_or_avg> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"last_value\": {\"sql\": \"LAST_VALUE(TRY_CAST(ear_verif_subsistema_mwmes AS DOUBLE))\", \"unit\": \"MWmes\"}, \"average\": {\"sql\": \"AVG(TRY_CAST(ear_verif_subsistema_mwmes AS DOUBLE))\", \"unit\": \"MWmes\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(ear_verif_subsistema_mwmes AS DOUBLE))\", \"unit\": \"MWmes\"}, \"ranking\": {\"sql\": \"AVG(TRY_CAST(ear_verif_subsistema_mwmes AS DOUBLE))\", \"unit\": \"MWmes\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(ear_verif_subsistema_mwmes AS DOUBLE))\", \"unit\": \"MWmes\"}}" .

