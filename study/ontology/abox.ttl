    skos:altLabel "CI MELO"@pt ;
    skos:altLabel "conversora melo"@pt ;
    ons:filter "TRIM(nom_conversora) = 'CI MELO'" .

<https://w3id.org/tiago-ons/data/value/intercambio_modalidade/nom_conversora/rivera>
    a ons:ValueAlias ;
