<https://w3id.org/tiago-ons/data/column/ind_providencia_ecpa_pcpa/num_nprat_atrasadas>
    a ons:Column ;
    dct:title "num_nprat_atrasadas" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Número de providências de manutenção concluídas com atraso em relação ao prazo programado. Indica o volume de providências que não foram cumpridas pontualmente, impactando negativamente o indicador PCPA."@pt ;
    skos:altLabel "providencias atrasadas"@pt ;
    skos:altLabel "nprat"@pt ;
    skos:altLabel "numero de providencias atrasadas"@pt ;
    skos:altLabel "atrasadas"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/unidade_contagem> .

<https://w3id.org/tiago-ons/data/column/ind_providencia_ecpa_pcpa/num_npra_antecipadas>
    a ons:Column ;
    dct:title "num_npra_antecipadas" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Número de providências de manutenção concluídas de forma antecipada, ou seja, antes do prazo programado. Contribui positivamente para o indicador PCPA, demonstrando eficiência na execução das manutenções."@pt ;
    skos:altLabel "providencias antecipadas"@pt ;
    skos:altLabel "npra"@pt ;
    skos:altLabel "numero de providencias antecipadas"@pt ;
    skos:altLabel "antecipadas"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/unidade_contagem> .

<https://w3id.org/tiago-ons/data/column/ind_providencia_ecpa_pcpa/num_nprcp_concluidas_prazo>
    a ons:Column ;
    dct:title "num_nprcp_concluidas_prazo" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Número de providências de manutenção concluídas dentro do prazo programado. Representa as providências cumpridas pontualmente, sendo o numerador do indicador PCPA (Pontualidade do Cumprimento às Providências)."@pt ;
    skos:altLabel "providencias concluidas no prazo"@pt ;
    skos:altLabel "nprcp"@pt ;
    skos:altLabel "concluidas no prazo"@pt ;
    skos:altLabel "cumpridas no prazo"@pt ;
    ons:semanticRole "IDENTIFIER" ;
