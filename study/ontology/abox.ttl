<https://w3id.org/tiago-ons/data/metric/ind_qualid_dfd_evento/dfd>
    a ons:Metric ;
    skos:prefLabel "Indicador DFD (duracao do disturbio)"@pt ;
    skos:altLabel "DFD"@pt ;
    skos:altLabel "indicador DFD"@pt ;
    skos:altLabel "valor DFD"@pt ;
    skos:altLabel "desempenho frequencia disturbio"@pt ;
    skos:altLabel "duracao disturbio"@pt ;
    skos:altLabel "val_dfd"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ind_qualid_dfd_evento/val_dfd> ;
    ons:expression "val_dfd" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/duration_minutes> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/s> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "8760.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total\": {\"sql\": \"SUM(val_dfd)\", \"unit\": \"s\"}, \"average\": {\"sql\": \"AVG(val_dfd)\", \"unit\": \"s\"}, \"maximum\": {\"sql\": \"MAX(val_dfd)\", \"unit\": \"s\"}, \"time_series\": {\"sql\": \"SUM(val_dfd)\", \"unit\": \"s\"}, \"ranking\": {\"sql\": \"SUM(val_dfd)\", \"unit\": \"s\"}, \"comparison\": {\"sql\": \"AVG(val_dfd)\", \"unit\": \"s\"}}" .

