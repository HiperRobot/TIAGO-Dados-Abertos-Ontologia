    dct:description "Modalidade de operação da usina conforme classificação do Submódulo 7.2 dos Procedimentos de Rede do ONS. Valores possíveis: Tipo I (despacho centralizado pelo ONS), Tipo II-A, Tipo II-B, Tipo II-C (despacho descentralizado com diferentes níveis de supervisão) e Tipo III (sem despacho centralizado)."@pt ;
    skos:altLabel "modalidade de operação"@pt ;
    skos:altLabel "tipo de operação"@pt ;
    skos:altLabel "modalidade"@pt ;
    skos:altLabel "tipo de despacho"@pt ;
    skos:altLabel "classificação de operação"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "TIPO I" ;
    ons:allowedValue "TIPO II-A" ;
    ons:allowedValue "TIPO II-B" ;
    ons:allowedValue "TIPO II-C" ;
    ons:allowedValue "TIPO III" ;
    ons:allowedValue "TIPO III (EM DIT)" .

<https://w3id.org/tiago-ons/data/column/modalidade_usina/val_potenciaautorizada>
