<https://w3id.org/tiago-ons/data/column/ind_confiarb_severidade/dsc_agregacao>
    a ons:Column ;
    dct:title "dsc_agregacao" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nível de agregação geográfica do indicador. Indica se o registro corresponde ao Sistema Interligado Nacional (SIN), a um subsistema elétrico (SE/CO, S, NE, N), a uma região geográfica ou a um estado federativo."@pt ;
