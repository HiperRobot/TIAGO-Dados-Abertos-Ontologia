<https://w3id.org/tiago-ons/data/template/usina_pqu/pattern_list_members_of_gpq>
    a ons:QueryTemplate ;
    skos:prefLabel "list_members_of_gpq" ;
    ons:sqlTemplate "SELECT nom_usina, ceg, id_tipousina, estad_id, nom_estado FROM {source} WHERE id_ons_pequenasusinas = '{id_gpq}' ORDER BY nom_usina\n" .

<https://w3id.org/tiago-ons/data/template/usina_pqu/pattern_count_by_subsistema>
    a ons:QueryTemplate ;
    skos:prefLabel "count_by_subsistema" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_subsistema, COUNT(*) AS qtd_usinas FROM {source} GROUP BY id_subsistema, nom_subsistema ORDER BY qtd_usinas DESC\n" .

<https://w3id.org/tiago-ons/data/template/usina_pqu/pattern_count_by_estado>
    a ons:QueryTemplate ;
    skos:prefLabel "count_by_estado" ;
    ons:sqlTemplate "SELECT estad_id, nom_estado, COUNT(*) AS qtd_usinas FROM {source} GROUP BY estad_id, nom_estado ORDER BY qtd_usinas DESC\n" .

<https://w3id.org/tiago-ons/data/template/usina_pqu/pattern_list_gpq_by_subsistema>
    a ons:QueryTemplate ;
    skos:prefLabel "list_gpq_by_subsistema" ;
    ons:sqlTemplate "SELECT id_ons_pequenasusinas, nom_pequenasusinas, COUNT(*) AS qtd_usinas_individuais FROM {source} WHERE id_subsistema = '{subsistema}' GROUP BY id_ons_pequenasusinas, nom_pequenasusinas ORDER BY nom_pequenasusinas\n" .

<https://w3id.org/tiago-ons/data/template/usina_pqu/pattern_find_ceg_by_usina>
    a ons:QueryTemplate ;
    skos:prefLabel "find_ceg_by_usina" ;
    ons:sqlTemplate "SELECT nom_usina, ceg, id_ons_pequenasusinas, nom_pequenasusinas, id_subsistema FROM {source} WHERE nom_usina ILIKE '%<nome>%'\n" .

<https://w3id.org/tiago-ons/data/template/usina_pqu/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT pqu.id_ons_pequenasusinas, pqu.nom_pequenasusinas, pqu.id_ons_usina, pqu.nom_usina, pqu.ceg, pqu.estad_id, pqu.nom_estado, pqu.id_subsistema FROM read_parquet('s3://ons-aws-prod-opendata/dataset/usina_pqu/*.parquet') AS pqu ORDER BY pqu.nom_pequenasusinas, pqu.nom_usina LIMIT 100;" ;
    ons:exampleQuestion "Quais usinas individuais compõem cada Grupo de Pequenas Usinas e em qual estado estão localizadas?"@pt .

<https://w3id.org/tiago-ons/data/template/usina_pqu/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT pqu.id_subsistema, pqu.nom_subsistema, COUNT(DISTINCT pqu.id_ons_usina) AS qtd_usinas, COUNT(DISTINCT pqu.id_ons_pequenasusinas) AS qtd_gpq FROM read_parquet('s3://ons-aws-prod-opendata/dataset/usina_pqu/*.parquet') AS pqu GROUP BY pqu.id_subsistema, pqu.nom_subsistema ORDER BY qtd_usinas DESC;" ;
    ons:exampleQuestion "Quantas usinas individuais Tipo III existem em cada subsistema elétrico?"@pt .

<https://w3id.org/tiago-ons/data/template/usina_pqu/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT pqu.estad_id, pqu.nom_estado, pqu.id_subsistema, COUNT(DISTINCT pqu.id_ons_usina) AS qtd_usinas FROM read_parquet('s3://ons-aws-prod-opendata/dataset/usina_pqu/*.parquet') AS pqu GROUP BY pqu.estad_id, pqu.nom_estado, pqu.id_subsistema ORDER BY qtd_usinas DESC LIMIT 27;" ;
    ons:exampleQuestion "Quais estados concentram o maior número de pequenas usinas Tipo III cadastradas no ONS?"@pt .
