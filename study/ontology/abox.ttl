<https://w3id.org/tiago-ons/data/metric/restricao_coff_fotovoltaica_detail/irradianciaverificado>
    a ons:Metric ;
    skos:prefLabel "Irradiancia Verificada"@pt ;
    skos:altLabel "irradiancia"@pt ;
    skos:altLabel "irradiancia verificada"@pt ;
    skos:altLabel "radiacao solar"@pt ;
    skos:altLabel "GHI"@pt ;
    skos:altLabel "irradiancia medida"@pt ;
    skos:altLabel "insolacao"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/restricao_coff_fotovoltaica_detail/val_irradianciaverificado> ;
    ons:expression "val_irradianciaverificado" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/irradiance> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/w_m2> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(val_irradianciaverificado)\", \"unit\": \"W/m2\"}, \"maximum\": {\"sql\": \"MAX(val_irradianciaverificado)\", \"unit\": \"W/m2\"}, \"minimum\": {\"sql\": \"MIN(val_irradianciaverificado)\", \"unit\": \"W/m2\"}, \"time_series\": {\"sql\": \"AVG(val_irradianciaverificado)\", \"unit\": \"W/m2\"}, \"ranking\": {\"sql\": \"AVG(val_irradianciaverificado)\", \"unit\": \"W/m2\"}, \"comparison\": {\"sql\": \"AVG(val_irradianciaverificado)\", \"unit\": \"W/m2\"}}" .

