    ons:physicalType "VARCHAR" ;
    dct:description "Código da origem da restrição. Valores possíveis: LOC (Local), SIS (Sistêmica). Ausente na maior parte dos registros (string vazia)."@pt ;
    skos:altLabel "origem_restricao"@pt ;
    skos:altLabel "tipo_origem"@pt ;
