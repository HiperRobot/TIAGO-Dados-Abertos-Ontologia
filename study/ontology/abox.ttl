<https://w3id.org/tiago-ons/data/template/modalidade_usina/pattern_potencia_total_por_modalidade>
    a ons:QueryTemplate ;
    skos:prefLabel "potencia_total_por_modalidade" ;
    ons:sqlTemplate "SELECT nom_modalidadeoperacao, SUM(TRY_CAST(val_potenciaautorizada AS DOUBLE)) AS potencia_total_mw\nFROM {source}\nWHERE val_potenciaautorizada IS NOT NULL\nGROUP BY nom_modalidadeoperacao\nORDER BY potencia_total_mw DESC" .

<https://w3id.org/tiago-ons/data/template/modalidade_usina/pattern_contagem_por_cosr>
    a ons:QueryTemplate ;
    skos:prefLabel "contagem_por_cosr" ;
    ons:sqlTemplate "SELECT TRIM(sgl_centrooperacao) AS cosr, COUNT(*) AS qtd_usinas\nFROM {source}\nGROUP BY TRIM(sgl_centrooperacao)" .

<https://w3id.org/tiago-ons/data/template/modalidade_usina/pattern_usinas_sem_id_ons>
    a ons:QueryTemplate ;
    skos:prefLabel "usinas_sem_id_ons" ;
    ons:sqlTemplate "SELECT nom_usina, ceg, nom_modalidadeoperacao,\n       TRY_CAST(val_potenciaautorizada AS DOUBLE) AS potencia_mw\nFROM {source}\nWHERE id_ons IS NULL" .

<https://w3id.org/tiago-ons/data/template/modalidade_usina/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT nom_modalidadeoperacao, COUNT(*) AS total_usinas, ROUND(SUM(TRY_CAST(val_potenciaautorizada AS DOUBLE)), 2) AS total_mw_autorizado, ROUND(AVG(TRY_CAST(val_potenciaautorizada AS DOUBLE)), 2) AS media_mw_por_usina FROM read_parquet('s3://ons-aws-prod-opendata/dataset/modalidade_usina/*.parquet') WHERE nom_modalidadeoperacao IS NOT NULL GROUP BY nom_modalidadeoperacao ORDER BY total_mw_autorizado DESC" ;
    ons:exampleQuestion "Qual a potência total autorizada (em MW) para cada modalidade de operação de usinas?"@pt .

<https://w3id.org/tiago-ons/data/template/modalidade_usina/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT sgl_centrooperacao, COUNT(*) AS total_usinas_tipo_i, ROUND(SUM(TRY_CAST(val_potenciaautorizada AS DOUBLE)), 2) AS total_mw_tipo_i FROM read_parquet('s3://ons-aws-prod-opendata/dataset/modalidade_usina/*.parquet') WHERE nom_modalidadeoperacao = 'TIPO I' AND sgl_centrooperacao IS NOT NULL GROUP BY sgl_centrooperacao ORDER BY total_usinas_tipo_i DESC" ;
    ons:exampleQuestion "Quais são as usinas com supervisão direta pelo ONS (Tipo I) e qual centro de operação as supervisiona?"@pt .

<https://w3id.org/tiago-ons/data/template/modalidade_usina/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT id_estado, nom_estado, nom_modalidadeoperacao, COUNT(*) AS total_usinas, ROUND(SUM(TRY_CAST(val_potenciaautorizada AS DOUBLE)), 2) AS total_mw FROM read_parquet('s3://ons-aws-prod-opendata/dataset/modalidade_usina/*.parquet') WHERE id_estado IS NOT NULL AND nom_modalidadeoperacao IS NOT NULL GROUP BY id_estado, nom_estado, nom_modalidadeoperacao ORDER BY id_estado, total_usinas DESC" ;
    ons:exampleQuestion "Quais estados têm mais usinas cadastradas no ONS e qual a distribuição por modalidade?"@pt .

<https://w3id.org/tiago-ons/data/dataset/oferta_resposta_da_demanda>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:oferta_respostademanda" ;
    dct:title "oferta-resposta-da-demanda" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/resposta_demanda> ;
    dcat:keyword "resposta da demanda"@pt ;
    dcat:keyword "demand response"@pt ;
    dcat:keyword "oferta"@pt ;
    dcat:keyword "reducao de carga"@pt ;
    dcat:keyword "subsistema"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "setor eletrico"@pt ;
    dcat:keyword "dados abertos"@pt ;
    dct:description "Ofertas de Resposta da Demanda: reducoes de carga ofertadas por agentes consumidores (montante em MW, preco, duracao, janela horaria e data de reducao), por subsistema. Usar para perguntas sobre programa de resposta da demanda, montante ofertado, precos e agentes participantes."@pt ;
    ons:usage "Consulta via DuckDB read_parquet sobre o bucket publico de dados abertos do ONS."@pt ;
    ons:limitation "Valores numericos (preco/montante/duracao) armazenados como VARCHAR com ponto decimal — usar TRY_CAST."@pt ;
    dct:source <https://dados.ons.org.br/dataset/oferta_respostademanda> ;
    ons:freshness "P1M — Atualizacao eventual conforme ofertas"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/oferta_respostademanda/" ;
    skos:altLabel "reducao de demanda"@pt ;
    skos:altLabel "oferta de reducao"@pt ;
    skos:altLabel "montante ofertado"@pt ;
    skos:altLabel "potencia ofertada"@pt ;
    skos:altLabel "preco da oferta"@pt ;
    skos:altLabel "flexibilidade de carga"@pt ;
    skos:altLabel "oferta de reducao de carga"@pt ;
    skos:altLabel "quem ofertou reduzir consumo"@pt ;
    ons:exampleQuestion "montante ofertado de resposta da demanda por subsistema"@pt ;
    ons:exampleQuestion "agentes participantes da resposta da demanda"@pt ;
    ons:exampleQuestion "preco medio das ofertas de reducao de carga"@pt ;
    ons:exampleQuestion "ofertas de resposta da demanda por data"@pt ;
    ons:exampleQuestion "Qual o maior montante de demanda resposta no Nordeste?"@pt ;
    ons:retrievalContext "Ofertas de Resposta da Demanda (demand response) no setor eletrico. Reducoes de carga ofertadas por agentes consumidores, com montante em MW, preco, duracao e janela horaria, por subsistema e data."@pt ;
    ons:agentInstruction "Ofertas de Resposta da Demanda do ONS. Uma linha por oferta (agente/data/janela horaria). val_montante e o montante ofertado em MW (metrica principal, SUM). val_preco em R$/MWh, val_duracao em horas. Dimensoes: agente, tipo de oferta, subsistema, data. Valores VARCHAR com ponto decimal — usar TRY_CAST."@pt ;
    dct:accrualPeriodicity "oferta" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/oferta_respostademanda/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY-4.0 (ONS Dados Abertos)" ;
    dct:temporal "2023-01-01/" ;
    ons:spatialGrain ons:Subsistema ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/nom_agente> ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/tip_oferta> ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/val_preco> ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/dat_reducao> ;
