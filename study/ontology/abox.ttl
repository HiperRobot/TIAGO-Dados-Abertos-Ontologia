<https://w3id.org/tiago-ons/data/column/programacao_fluxo_controlado/din_programacaodia>
    a ons:Column ;
    dct:title "din_programacaodia" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Data de referência da programação operativa, representando o dia ao qual os patamares de 30 minutos se referem. Armazenada como VARCHAR no Parquet; requer CAST(din_programacaodia AS DATE) para operações temporais."@pt ;
    skos:altLabel "data_programacao"@pt ;
    skos:altLabel "data_referencia"@pt ;
    skos:altLabel "dia_programacao"@pt ;
    skos:altLabel "din_referencia"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/programacao_fluxo_controlado/num_patamar>
    a ons:Column ;
    dct:title "num_patamar" ;
    dct:type "integer" ;
    ons:physicalType "INTEGER" ;
    dct:description "Número sequencial do patamar de 30 minutos dentro do dia de programação. Varia de 1 a 48, onde 1 representa o intervalo 00:00–00:30 e 48 representa 23:30–24:00. Confirma granularidade intradiária de 30 minutos (48 × 30min = 24h)."@pt ;
    skos:altLabel "patamar"@pt ;
    skos:altLabel "intervalo"@pt ;
    skos:altLabel "slot_30min"@pt ;
    skos:altLabel "periodo_30min"@pt ;
    ons:semanticRole "IDENTIFIER" ;
