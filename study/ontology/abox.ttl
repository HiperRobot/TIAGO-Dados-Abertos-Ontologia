    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(num_transformadoresoperacao)\", \"unit\": \"unidades\"}, \"maximum\": {\"sql\": \"MAX(num_transformadoresoperacao)\", \"unit\": \"unidades\"}, \"minimum\": {\"sql\": \"MIN(num_transformadoresoperacao)\", \"unit\": \"unidades\"}, \"time_series\": {\"sql\": \"AVG(num_transformadoresoperacao)\", \"unit\": \"unidades\"}, \"ranking\": {\"sql\": \"AVG(num_transformadoresoperacao)\", \"unit\": \"unidades\"}}" .

