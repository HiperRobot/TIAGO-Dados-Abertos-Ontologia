<https://w3id.org/tiago-ons/data/template/ind_qualid_dfp_regime/pattern_dfp_medio_anual>
    a ons:QueryTemplate ;
    skos:prefLabel "dfp_medio_anual" ;
    ons:sqlTemplate "SELECT\n  EXTRACT(YEAR FROM TRY_CAST(din_referencia AS TIMESTAMP)) AS ano,\n  AVG(val_dfp) AS dfp_medio\nFROM {source}\nWHERE id_periodicidade = 'AN'\nGROUP BY 1\nORDER BY 1\n" ;
    ons:outputUnitLabel "adimensional (indice 0-1)" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_qualid_dfp_regime/dfp> .

<https://w3id.org/tiago-ons/data/template/ind_qualid_dfp_regime/pattern_dfp_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "dfp_mensal" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_referencia AS TIMESTAMP)) AS mes,\n  AVG(val_dfp) AS dfp_medio\nFROM {source}\nWHERE id_periodicidade = 'ME'\n  AND EXTRACT(YEAR FROM din_referencia) = {year}\nGROUP BY 1\nORDER BY 1\n" ;
    ons:outputUnitLabel "adimensional (indice 0-1)" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_qualid_dfp_regime/dfp> .

<https://w3id.org/tiago-ons/data/template/ind_qualid_dfp_regime/pattern_pior_mes_dfp>
    a ons:QueryTemplate ;
    skos:prefLabel "pior_mes_dfp" ;
    ons:sqlTemplate "SELECT nom_agente,\n  DATE_TRUNC('month', TRY_CAST(din_referencia AS DATE)) AS mes,\n  MAX(TRY_CAST(val_dfp_real AS DOUBLE)) AS pior_dfp\nFROM {source}\nGROUP BY nom_agente, DATE_TRUNC('month', TRY_CAST(din_referencia AS DATE))\nORDER BY pior_dfp DESC\nLIMIT 10" ;
    ons:outputUnitLabel "adimensional (indice 0-1)" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_qualid_dfp_regime/dfp> .

<https://w3id.org/tiago-ons/data/template/ind_qualid_dfp_regime/pattern_desvios_disturbio_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "desvios_disturbio_mensal" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_referencia AS TIMESTAMP)) AS mes,\n  SUM(num_desvio_dist_sobre) AS minutos_dist_sobre,\n  SUM(num_desvio_dist_sub) AS minutos_dist_sub,\n  SUM(num_desvio_dist_sobre) + SUM(num_desvio_dist_sub) AS total_disturbio\nFROM {source}\nWHERE id_periodicidade = 'ME'\n  AND EXTRACT(YEAR FROM TRY_CAST(din_referencia AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1\n" ;
    ons:outputUnitLabel "minutos" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_qualid_dfp_regime/desvio_dist_sobre> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_qualid_dfp_regime/desvio_dist_sub> .

<https://w3id.org/tiago-ons/data/template/ind_qualid_dfp_regime/pattern_dias_dfp_abaixo_limiar>
    a ons:QueryTemplate ;
    skos:prefLabel "dias_dfp_abaixo_limiar" ;
    ons:sqlTemplate "SELECT\n  din_referencia AS dia,\n  val_dfp\nFROM {source}\nWHERE id_periodicidade = 'DI'\n  AND val_dfp < {limiar}\nORDER BY val_dfp ASC\n" ;
    ons:outputUnitLabel "adimensional (indice 0-1)" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_qualid_dfp_regime/dfp> .

<https://w3id.org/tiago-ons/data/template/ind_qualid_dfp_regime/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT YEAR(din_referencia) AS ano, ROUND(AVG(val_dfp), 6) AS dfp_medio, ROUND(MIN(val_dfp), 6) AS dfp_minimo, ROUND(MAX(val_dfp), 6) AS dfp_maximo, COUNT(*) AS qtd_dias FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_qualid_dfp_regime/*.parquet') WHERE id_periodicidade = 'D' GROUP BY YEAR(din_referencia) ORDER BY ano;" ;
    ons:exampleQuestion "Qual foi a evolução do indicador DFP médio ao longo dos anos?"@pt .

<https://w3id.org/tiago-ons/data/template/ind_qualid_dfp_regime/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT CAST(din_referencia AS DATE) AS data, val_dfp, num_desvio_perm_sobre, num_desvio_perm_sub, num_desvio_dist_sobre, num_desvio_dist_sub, num_minutos FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_qualid_dfp_regime/*.parquet') WHERE id_periodicidade = 'D' AND val_dfp < 0.99 ORDER BY val_dfp ASC LIMIT 20;" ;
    ons:exampleQuestion "Quais foram os dias com maior degradação do DFP no histórico?"@pt .

<https://w3id.org/tiago-ons/data/template/ind_qualid_dfp_regime/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT YEAR(din_referencia) AS ano, MONTH(din_referencia) AS mes, SUM(num_desvio_perm_sub) AS total_desvios_sub, SUM(num_desvio_perm_sobre) AS total_desvios_sobre, ROUND(AVG(val_dfp), 6) AS dfp_medio FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_qualid_dfp_regime/*.parquet') WHERE id_periodicidade = 'D' GROUP BY YEAR(din_referencia), MONTH(din_referencia) ORDER BY ano, mes;" ;
    ons:exampleQuestion "Como variam os desvios permanentes de subfrequência mês a mês?"@pt .

<https://w3id.org/tiago-ons/data/dataset/intercambio_internacional>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:intercambio-internacional" ;
    dct:title "intercambio-internacional" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/intercambio> ;
    dcat:keyword "Acaray"@pt ;
    dcat:keyword "Argentina"@pt ;
    dcat:keyword "Garabi"@pt ;
    dcat:keyword "Paraguai"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "Uruguai"@pt ;
    dcat:keyword "Uruguaiana"@pt ;
    dcat:keyword "exportacao energia Brasil"@pt ;
    dcat:keyword "exportacao-energia"@pt ;
    dcat:keyword "importacao energia Brasil"@pt ;
    dcat:keyword "importacao-energia"@pt ;
    dcat:keyword "intercambio SIN"@pt ;
    dcat:keyword "intercambio internacional"@pt ;
    dcat:keyword "intercambio-internacional"@pt ;
    dcat:keyword "intercâmbio internacional"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Monitorar e programar o intercâmbio internacional de energia elétrica entre o SIN e países vizinhos em base horária, suportando decisões de despacho operativo, balanço energético nacional, verificação de cumprimento de acordos bilaterais de fornecimento de energia e análise de fluxos de importação e exportação por operadores do ONS, analistas de mercado da CCEE e planejadores do setor elétrico brasileiro."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver fluxos de energia entre o Brasil e países vizinhos (Argentina, Uruguai, Paraguai), importação ou exportação de energia pelo SIN, balanço energético internacional, conversoras de frequência de fronteira (Garabi, Uruguaiana, Melo, Rivera, Acaray) ou comparação entre intercâmbio realizado e programado em base horária."@pt ;
    ons:limitation "Coluna numérica (MWmed) armazenada como VARCHAR devido ao formato de serialização no dataset intercambio-internacional. A maior parte dos registros possuem valor nulo em val_intercambioprogmwmed no dataset intercambio-internacional, indicando que o intercâmbio programado não está disponível para a maior parte do período histórico. Além da alta taxa de nulos, val_intercambioprogmwmed no dataset intercambio-internacional também é armazenada como VARCHAR pelo formato de serialização."@pt ;
    dct:source <https://dados.ons.org.br/dataset/intercambio-internacional> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/intercambio_internacional_ho/*.parquet" ;
    skos:altLabel "energia trocada com a argentina"@pt ;
    skos:altLabel "importacao e exportacao com paises vizinhos"@pt ;
    skos:altLabel "fluxo com o uruguai"@pt ;
    skos:altLabel "intercambio com o paraguai"@pt ;
    ons:exampleQuestion "Qual foi o intercâmbio médio de energia entre o Brasil e a Argentina em 2024?"@pt ;
    ons:exampleQuestion "O Brasil foi importador ou exportador líquido de energia para o Uruguai no último ano?"@pt ;
    ons:exampleQuestion "Quais foram os horários de pico de exportação de energia para o Paraguai?"@pt ;
    ons:exampleQuestion "Qual é o desvio entre o intercâmbio programado e o realizado com a Argentina?"@pt ;
    ons:exampleQuestion "Como evoluiu o saldo de intercâmbio internacional do SIN mês a mês em 2023?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver fluxos de energia entre o Brasil e países vizinhos (Argentina, Uruguai, Paraguai), importação ou exportação de energia pelo SIN, balanço energético internacional, conversoras de frequência de fronteira (Garabi, Uruguaiana, Melo, Rivera, Acaray) ou comparação entre intercâmbio realizado e programado em base horária. Também relevante para análises de balanço energético global do SIN que requerem o componente de intercâmbio externo."@pt ;
    ons:agentInstruction "- [val_intercambiomwmed] Coluna armazenada como VARCHAR no Parquet devido ao formato de serialização (dtype object convertido para UTF-8 em vez de DOUBLE). Contém valores numéricos de ponto flutuante representando MWmed realizados. Nenhum nulo detectado, mas operações aritméticas diretas falharão sem cast explícito.\n\n- [val_intercambioprogmwmed] Coluna com nulos na maior parte das linhas. O valor programado do intercâmbio não está disponível para a maior parte do período histórico, sendo preenchido possivelmente apenas para o horizonte de programação futura ou para registros mais recentes.\n\n- [val_intercambioprogmwmed] Coluna armazenada como VARCHAR no Parquet devido ao formato de serialização. Contém valores numéricos de ponto flutuante representando MWmed programados. Requer TRY_CAST para qualquer operação aritmética ou de agregação.\n\n- [din_instante] Possíveis lacunas horárias na série temporal por país. O volume publicado fica bem abaixo do que 3 paises em base horaria fariam esperar: a serie nao e densa. O volume atual sugere que nem todos os países possuem dados em todos os instantes, ou há períodos sem intercâmbio registrado.\n\n- [nom_paisdestino] Valores com trailing spaces detectados em 'nom_paisdestino'. Use TRIM() em filtros WHERE para evitar perda de registros.\n- [val_intercambioprogmwmed] Coluna 'val_intercambioprogmwmed' ausente em arquivos históricos (ex: INTERCAMBIO_INTERNACIONAL_2023.parquet). Presente apenas a partir de versões recentes (ex: INTERCAMBIO_INTERNACIONAL_2026.parquet). Queries históricas retornarão NULL para esta coluna. Use union_by_name=true ao combinar arquivos de diferentes períodos.\n- [tipos] As colunas `val_intercambiomwmed` mudam de tipo entre arquivos anuais (texto em uns, número em outros); cada uma traz `castExpression` no schema: use-o em toda agregação e comparação.\n"@pt ;
    dct:accrualPeriodicity "horária" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/intercambio_internacional_ho/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2023-01-01/" ;
    ons:spatialGrain ons:SIN ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/intercambio_internacional/din_instante> ;
    ons:rowKey <https://w3id.org/tiago-ons/data/column/intercambio_internacional/din_instante> ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/intercambio_internacional/nom_paisdestino> ;
