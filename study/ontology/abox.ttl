    skos:altLabel "percentual MLT bruta"@pt ;
    skos:altLabel "afluencia bruta relativa"@pt ;
    skos:altLabel "ENA bruta normalizada"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ena_diario_por_ree_reservatorio_equivalente_de_energia/ena_bruta_ree_percentualmlt> ;
    ons:expression "ena_bruta_ree_percentualmlt" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/ratio> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/avg> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_ree_percentualmlt AS DOUBLE))\", \"unit\": \"%\"}, \"maximum\": {\"sql\": \"MAX(TRY_CAST(ena_bruta_ree_percentualmlt AS DOUBLE))\", \"unit\": \"%\"}, \"minimum\": {\"sql\": \"MIN(TRY_CAST(ena_bruta_ree_percentualmlt AS DOUBLE))\", \"unit\": \"%\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_ree_percentualmlt AS DOUBLE))\", \"unit\": \"%\"}, \"ranking\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_ree_percentualmlt AS DOUBLE))\", \"unit\": \"%\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_ree_percentualmlt AS DOUBLE))\", \"unit\": \"%\"}}" .

