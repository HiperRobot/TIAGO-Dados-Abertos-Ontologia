    ons:physicalType "TIMESTAMP" ;
    dct:description "Data de referência da medição mensal, armazenada como timestamp com o último dia do mês (ex: 2000-01-31 00:00:00). Representa o mês de competência da carga de energia. Utilizada como eixo temporal principal da série histórica."@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "mês"@pt ;
    skos:altLabel "período"@pt ;
    skos:altLabel "data de referência"@pt ;
    skos:altLabel "instante"@pt ;
    skos:altLabel "competência"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/carga_mensal/val_cargaenergiamwmed>
    a ons:Column ;
    dct:title "val_cargaenergiamwmed" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Valor da carga de energia elétrica do subsistema no mês de referência, expresso em MWmed (megawatts médios). Representa a média da potência consumida ao longo do mês. A metodologia de cálculo evoluiu em três períodos. Valores variam de ~2.027 MWmed (subsistemas menores) a ~51.147 MWmed (SE/CO)."@pt ;
    skos:altLabel "carga"@pt ;
    skos:altLabel "carga de energia"@pt ;
    skos:altLabel "consumo"@pt ;
    skos:altLabel "demanda"@pt ;
    skos:altLabel "carga mensal"@pt ;
    skos:altLabel "MWmed"@pt ;
    skos:altLabel "megawatts médios"@pt ;
    skos:altLabel "valor da carga"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/dimension/carga_mensal/subsistema>
    a ons:Dimension ;
    skos:prefLabel "subsistema" ;
    ons:onColumn <https://w3id.org/tiago-ons/data/column/carga_mensal/id_subsistema> ;
    ons:refersTo ons:Subsistema .

<https://w3id.org/tiago-ons/data/metric/carga_mensal/cargaenergiamwmed>
    a ons:Metric ;
    skos:prefLabel "Carga Verificada"@pt ;
    skos:altLabel "carga"@pt ;
    skos:altLabel "carga de energia"@pt ;
    skos:altLabel "consumo"@pt ;
    skos:altLabel "demanda"@pt ;
    skos:altLabel "carga mensal"@pt ;
    skos:altLabel "MWmed"@pt ;
    skos:altLabel "megawatts médios"@pt ;
    skos:altLabel "valor da carga"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/carga_mensal/val_cargaenergiamwmed> ;
    ons:expression "val_cargaenergiamwmed" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "730.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(val_cargaenergiamwmed AS DOUBLE)) * 730.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_cargaenergiamwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_cargaenergiamwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_cargaenergiamwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(val_cargaenergiamwmed AS DOUBLE)) * 730.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_cargaenergiamwmed AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

