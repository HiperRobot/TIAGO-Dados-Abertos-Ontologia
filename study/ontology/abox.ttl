<https://w3id.org/tiago-ons/data/column/ind_qualid_dfp_regime/num_minutos>
    a ons:Column ;
    dct:title "num_minutos" ;
    dct:type "integer" ;
    ons:physicalType "BIGINT" ;
    dct:description "Total de minutos no período de referência considerado no cálculo do indicador DFP. Para registros diários: ~1.440 minutos (1 dia); para mensais: ~43.200 a ~44.640 minutos; para anuais: ~525.600 a ~527.040 minutos. Permite identificar a periodicidade do registro e é o denominador implícito no cálculo do DFP."@pt ;
    skos:altLabel "total de minutos"@pt ;
    skos:altLabel "minutos do período"@pt ;
    skos:altLabel "duração do período"@pt ;
    skos:altLabel "minutos totais"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/min> .

<https://w3id.org/tiago-ons/data/column/ind_qualid_dfp_regime/val_dfp>
    a ons:Column ;
    dct:title "val_dfp" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Valor do Indicador de Desempenho da Frequência em Regime Permanente (DFP), calculado conforme Submódulo 9.7 dos Procedimentos de Rede do ONS. Índice normalizado entre 0 e 1, onde 1,0 representa desempenho perfeito (sem desvios) e valores menores indicam piora na qualidade de frequência. No dataset, varia entre 0,975 e 1,0, indicando alto desempenho geral do sistema interligado nacional."@pt ;
    skos:altLabel "DFP"@pt ;
    skos:altLabel "indicador DFP"@pt ;
    skos:altLabel "desempenho da frequência"@pt ;
    skos:altLabel "índice de frequência"@pt ;
    skos:altLabel "qualidade de frequência"@pt ;
    skos:altLabel "val DFP"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/adimensional_indice_0_1> .

<https://w3id.org/tiago-ons/data/unit/adimensional_indice_0_1>
    a ons:Unit ;
    skos:prefLabel "adimensional_indice_0_1" ;
    skos:altLabel "adimensional (índice 0-1)" ;
    skos:altLabel "adimensional (indice 0-1)" .

<https://w3id.org/tiago-ons/data/metric/ind_qualid_dfp_regime/dfp>
    a ons:Metric ;
    skos:prefLabel "Indicador DFP"@pt ;
    skos:altLabel "DFP"@pt ;
    skos:altLabel "indicador DFP"@pt ;
