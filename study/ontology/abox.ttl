<https://w3id.org/tiago-ons/data/column/intercambio_nacional/val_intercambiomwmed>
    a ons:Column ;
    dct:title "val_intercambiomwmed" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Valor medido do intercâmbio de energia entre o subsistema origem e o subsistema destino, expresso em MWmed (megawatts médios). Representa a soma das medidas de fluxo de potência ativa nas linhas de transmissão de fronteira entre os subsistemas no intervalo horário. Valores positivos indicam fluxo no sentido origem→destino; valores negativos indicam fluxo reverso."@pt ;
    skos:altLabel "intercambio"@pt ;
    skos:altLabel "val_intercambio"@pt ;
    skos:altLabel "fluxo"@pt ;
    skos:altLabel "potencia_intercambio"@pt ;
    skos:altLabel "intercambio_mwmed"@pt ;
    skos:altLabel "energia_intercambiada"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_intercambiomwmed AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/intercambio_nacional/val_intercambioprogmwmed>
    a ons:Column ;
    dct:title "val_intercambioprogmwmed" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Valor programado do intercâmbio de energia entre o subsistema origem e o subsistema destino, expresso em MWmed. Representa o intercâmbio previsto/programado pelo ONS para o intervalo horário, permitindo comparação entre o realizado e o programado. Possui nulos na maior parte das linhas, indicando disponibilidade restrita — possivelmente preenchido apenas para períodos mais recentes ou para horizontes futuros de programação. Armazenado como VARCHAR no Parquet pelo formato de serialização."@pt ;
    ons:availableFrom "2026" ;
    ons:coverageNote "Coluna ausente nos arquivos anteriores a 2026 (1 de 4 periodos da serie, que comeca em 2023). Como a fonte e' lida com union_by_name, consulta que inclua periodo anterior recebe NULL e nao erro, e AVG/SUM ignoram nulo - filtre o periodo ou declare a cobertura na resposta. Apurado em 2026-09-07." ;
    skos:altLabel "intercambio_programado"@pt ;
    skos:altLabel "val_programado"@pt ;
    skos:altLabel "programado_mwmed"@pt ;
    skos:altLabel "intercambio_prog"@pt ;
    skos:altLabel "desvio_programacao"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_intercambioprogmwmed AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/metric/intercambio_nacional/intercambiomwmed>
    a ons:Metric ;
    skos:prefLabel "Intercâmbio Realizado"@pt ;
    skos:altLabel "intercambio"@pt ;
    skos:altLabel "val_intercambio"@pt ;
    skos:altLabel "fluxo"@pt ;
    skos:altLabel "potencia_intercambio"@pt ;
    skos:altLabel "intercambio_mwmed"@pt ;
