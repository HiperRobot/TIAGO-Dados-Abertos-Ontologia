<https://w3id.org/tiago-ons/data/template/ind_providencia_ecpa_pcpa/pattern_ecpa_medio_sin_ultimos_12_meses>
    a ons:QueryTemplate ;
    skos:prefLabel "ecpa_medio_sin_ultimos_12_meses" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_referencia AS TIMESTAMP)) AS mes,\n  AVG(val_ecpa) AS ecpa_medio\nFROM {source}\nWHERE dsc_agregacao = 'Sistema'\n  AND din_referencia >= CURRENT_DATE - INTERVAL '12 months'\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "indice [0,1]" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_providencia_ecpa_pcpa/ecpa> .

<https://w3id.org/tiago-ons/data/template/ind_providencia_ecpa_pcpa/pattern_ranking_agentes_pcpa_ano>
    a ons:QueryTemplate ;
    skos:prefLabel "ranking_agentes_pcpa_ano" ;
    ons:sqlTemplate "SELECT dsc_caracteristica AS agente,\n  AVG(val_pcpa) AS pcpa_medio\nFROM {source}\nWHERE dsc_agregacao = 'Agente'\n  AND EXTRACT(YEAR FROM TRY_CAST(din_referencia AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY pcpa_medio ASC" ;
    ons:outputUnitLabel "indice [0,1]" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_providencia_ecpa_pcpa/pcpa> .

<https://w3id.org/tiago-ons/data/template/ind_providencia_ecpa_pcpa/pattern_providencias_atrasadas_vs_antecipadas_agente>
    a ons:QueryTemplate ;
    skos:prefLabel "providencias_atrasadas_vs_antecipadas_agente" ;
    ons:sqlTemplate "SELECT dsc_caracteristica AS agente,\n  SUM(num_nprat_atrasadas) AS atrasadas,\n  SUM(num_npra_antecipadas) AS antecipadas,\n  SUM(num_nprc_concluidas) AS concluidas\nFROM {source}\nWHERE dsc_agregacao = 'Agente'\n  AND EXTRACT(YEAR FROM din_referencia) = {year}\nGROUP BY 1\nORDER BY atrasadas DESC" ;
    ons:outputUnitLabel "providencias" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_providencia_ecpa_pcpa/num_nprat_atrasadas> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_providencia_ecpa_pcpa/num_npra_antecipadas> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_providencia_ecpa_pcpa/num_nprc_concluidas> .

<https://w3id.org/tiago-ons/data/template/ind_providencia_ecpa_pcpa/pattern_ecpa_calculado_manual>
    a ons:QueryTemplate ;
    skos:prefLabel "ecpa_calculado_manual" ;
    ons:sqlTemplate "SELECT dsc_caracteristica,\n  din_referencia,\n  num_nprc_concluidas,\n  num_nprp_programadas,\n  CASE\n    WHEN num_nprp_programadas > 0\n    THEN num_nprc_concluidas / num_nprp_programadas\n    ELSE NULL\n  END AS ecpa_calculado,\n  val_ecpa AS ecpa_oficial\nFROM {source}\nWHERE dsc_agregacao = 'Agente'\nORDER BY din_referencia DESC" ;
    ons:outputUnitLabel "indice [0,1]" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_providencia_ecpa_pcpa/ecpa> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_providencia_ecpa_pcpa/num_nprc_concluidas> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_providencia_ecpa_pcpa/num_nprp_programadas> .

<https://w3id.org/tiago-ons/data/template/ind_providencia_ecpa_pcpa/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT din_referencia, val_ecpa, val_pcpa, num_nprc_concluidas, num_nprp_programadas, num_nprat_atrasadas, num_npra_antecipadas, num_nprcp_concluidas_prazo FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_providencia_ecpa_pcpa/*.parquet') WHERE dsc_agregacao = 'SIN' AND dsc_caracteristica = 'SIN' ORDER BY din_referencia ASC;" ;
    ons:exampleQuestion "Como evoluíram os indicadores ECPA e PCPA do SIN ao longo do tempo?"@pt .

<https://w3id.org/tiago-ons/data/template/ind_providencia_ecpa_pcpa/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT dsc_caracteristica AS agente, din_referencia, val_pcpa, val_ecpa, num_nprc_concluidas, num_nprat_atrasadas FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_providencia_ecpa_pcpa/*.parquet') WHERE dsc_agregacao = 'Agente' AND din_referencia = ( SELECT MAX(din_referencia) FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_providencia_ecpa_pcpa/*.parquet') WHERE dsc_agregacao = 'Agente' ) ORDER BY val_pcpa ASC LIMIT 20;" ;
    ons:exampleQuestion "Quais agentes tiveram menor pontualidade no cumprimento de providências no mês mais recente?"@pt .

<https://w3id.org/tiago-ons/data/template/ind_providencia_ecpa_pcpa/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "WITH ecpa_2023 AS ( SELECT dsc_caracteristica AS agente, AVG(val_ecpa) AS ecpa_medio_2023 FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_providencia_ecpa_pcpa/*.parquet') WHERE dsc_agregacao = 'Agente' AND din_referencia >= TIMESTAMP '2023-01-01' AND din_referencia < TIMESTAMP '2024-01-01' GROUP BY dsc_caracteristica ), ecpa_2024 AS ( SELECT dsc_caracteristica AS agente, AVG(val_ecpa) AS ecpa_medio_2024 FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_providencia_ecpa_pcpa/*.parquet') WHERE dsc_agregacao = 'Agente' AND din_referencia >= TIMESTAMP '2024-01-01' AND din_referencia < TIMESTAMP '2025-01-01' GROUP BY dsc_caracteristica ) SELECT a.agente, a.ecpa_medio_2023, b.ecpa_medio_2024, (b.ecpa_medio_2024 - a.ecpa_medio_2023) AS variacao_ecpa FROM ecpa_2023 a INNER JOIN ecpa_2024 b ON a.agente = b.agente ORDER BY variacao_ecpa ASC LIMIT 30;" ;
    ons:exampleQuestion "Quais agentes melhoraram ou pioraram o índice ECPA entre 2023 e 2024?"@pt .

<https://w3id.org/tiago-ons/data/dataset/ind_qualid_dfd_evento>
