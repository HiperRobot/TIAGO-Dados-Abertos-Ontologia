<https://w3id.org/tiago-ons/data/metric/restricao_coff_fotovoltaica/geracao>
    a ons:Metric ;
    skos:prefLabel "Geracao"@pt ;
    skos:altLabel "geracao"@pt ;
    skos:altLabel "geracao_verificada"@pt ;
    skos:altLabel "geracao_realizada"@pt ;
    skos:altLabel "potencia_gerada"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/restricao_coff_fotovoltaica/val_geracao> ;
    ons:expression "val_geracao" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM(val_geracao * num_minutos_rel / 60.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(val_geracao)\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(val_geracao)\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(val_geracao)\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM(val_geracao * num_minutos_rel / 60.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(val_geracao)\", \"unit\": \"MWmed\"}}" .

