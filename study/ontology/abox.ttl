<https://w3id.org/tiago-ons/data/column/ind_confiarb_ccal/val_ccal>
    a ons:Column ;
    dct:title "val_ccal" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Valor do Indicador de Controle de Carregamento de Linhas de Transmissão (CCAL), expresso como proporção entre o número de linhas violadas e o número de linhas em operação (num_linhasvioladas / num_linhasoperacao). Varia entre 0.0 (nenhuma violação) e 1.0 (todas as linhas violadas). Conforme Submódulo 9.1 dos Procedimentos de Rede do ONS."@pt ;
    skos:altLabel "CCAL"@pt ;
    skos:altLabel "indicador CCAL"@pt ;
    skos:altLabel "controle de carregamento"@pt ;
    skos:altLabel "índice de carregamento"@pt ;
    skos:altLabel "valor CCAL"@pt ;
    skos:altLabel "ccal"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/proporcao_0_a_1> .

<https://w3id.org/tiago-ons/data/unit/proporcao_0_a_1>
    a ons:Unit ;
    skos:prefLabel "proporcao_0_a_1" ;
    skos:altLabel "proporção (0 a 1)" .

<https://w3id.org/tiago-ons/data/metric/ind_confiarb_ccal/ccal>
    a ons:Metric ;
    skos:prefLabel "Indicador CCAL"@pt ;
    skos:altLabel "CCAL"@pt ;
    skos:altLabel "indicador CCAL"@pt ;
    skos:altLabel "controle de carregamento"@pt ;
    skos:altLabel "indice de carregamento"@pt ;
    skos:altLabel "valor CCAL"@pt ;
    skos:altLabel "proporcao linhas violadas"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ind_confiarb_ccal/val_ccal> ;
    ons:expression "val_ccal" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/ratio> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/proporcao_0_1> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:intervalHours "8760.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(val_ccal)\", \"unit\": \"proporcao_0_1\"}, \"maximum\": {\"sql\": \"MAX(val_ccal)\", \"unit\": \"proporcao_0_1\"}, \"minimum\": {\"sql\": \"MIN(val_ccal)\", \"unit\": \"proporcao_0_1\"}, \"time_series\": {\"sql\": \"AVG(val_ccal)\", \"unit\": \"proporcao_0_1\"}, \"ranking\": {\"sql\": \"AVG(val_ccal)\", \"unit\": \"proporcao_0_1\"}, \"comparison\": {\"sql\": \"AVG(val_ccal)\", \"unit\": \"proporcao_0_1\"}}" .

