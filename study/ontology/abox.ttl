<https://w3id.org/tiago-ons/data/template/equipamento_controle_reativo/pattern_contagem_por_tipo_equipamento>
    a ons:QueryTemplate ;
    skos:prefLabel "contagem_por_tipo_equipamento" ;
    ons:sqlTemplate "SELECT TRIM(nom_tipoequipamento) AS tipo_equipamento,\n  COUNT(*) AS quantidade,\n  SUM(val_potreativanominal_mvar) AS capacidade_total_mvar\nFROM {source}\nWHERE val_potreativanominal_mvar IS NOT NULL\nGROUP BY 1\nORDER BY 3 DESC" ;
    ons:outputUnitLabel "Mvar" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/equipamento_controle_reativo/potreativanominal_mvar> .

<https://w3id.org/tiago-ons/data/template/equipamento_controle_reativo/pattern_capacidade_por_subsistema>
    a ons:QueryTemplate ;
    skos:prefLabel "capacidade_por_subsistema" ;
    ons:sqlTemplate "SELECT TRIM(id_subsistema) AS subsistema,\n  TRIM(nom_tipoequipamento) AS tipo_equipamento,\n  COUNT(*) AS quantidade,\n  SUM(val_potreativanominal_mvar) AS capacidade_total_mvar\nFROM {source}\nWHERE val_potreativanominal_mvar IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1, 4 DESC" ;
    ons:outputUnitLabel "Mvar" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/equipamento_controle_reativo/potreativanominal_mvar> .

<https://w3id.org/tiago-ons/data/template/equipamento_controle_reativo/pattern_equipamentos_com_limites_operativos>
    a ons:QueryTemplate ;
    skos:prefLabel "equipamentos_com_limites_operativos" ;
    ons:sqlTemplate "SELECT nom_subestacao, nom_equipamento, TRIM(nom_tipoequipamento) AS tipo,\n  val_limiteinferior_mvar AS Qmin,\n  val_limitesuperior_mvar AS Qmax\nFROM {source}\nWHERE val_limiteinferior_mvar IS NOT NULL\n  AND val_limiteinferior_mvar != -9999.9\n  AND val_limitesuperior_mvar IS NOT NULL\n  AND val_limitesuperior_mvar != 9999.9\nORDER BY nom_subestacao" ;
    ons:outputUnitLabel "Mvar" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/equipamento_controle_reativo/limiteinferior_mvar> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/equipamento_controle_reativo/limitesuperior_mvar> .

<https://w3id.org/tiago-ons/data/template/equipamento_controle_reativo/pattern_equipamentos_ativos_por_agente>
    a ons:QueryTemplate ;
    skos:prefLabel "equipamentos_ativos_por_agente" ;
    ons:sqlTemplate "SELECT nom_agente_proprietario,\n  TRIM(nom_tipoequipamento) AS tipo_equipamento,\n  COUNT(*) AS quantidade,\n  SUM(val_potreativanominal_mvar) AS capacidade_total_mvar\nFROM {source}\nWHERE (dat_desativacao = '9999-12-31' OR dat_desativacao IS NULL)\n  AND nom_agente_proprietario IS NOT NULL\nGROUP BY 1, 2\nORDER BY 3 DESC" ;
    ons:outputUnitLabel "Mvar" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/equipamento_controle_reativo/potreativanominal_mvar> .

<https://w3id.org/tiago-ons/data/template/equipamento_controle_reativo/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_subsistema, nom_tipoequipamento, COUNT(*) AS qtd_equipamentos, ROUND(SUM(val_potreativanominal_mvar), 1) AS total_mvar_nominal, ROUND(AVG(val_potreativanominal_mvar), 1) AS media_mvar_nominal FROM read_parquet('s3://ons-aws-prod-opendata/dataset/equipamento_controle_reativo/*.parquet') WHERE val_potreativanominal_mvar IS NOT NULL GROUP BY id_subsistema, nom_subsistema, nom_tipoequipamento ORDER BY id_subsistema, total_mvar_nominal DESC" ;
    ons:exampleQuestion "Qual é a capacidade total instalada de compensação reativa (em Mvar) por subsistema e tipo de equipamento no SIN?"@pt .

<https://w3id.org/tiago-ons/data/template/equipamento_controle_reativo/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT nom_subestacao, id_subsistema, nom_estado, COUNT(*) AS qtd_equipamentos, ROUND(SUM(val_potreativanominal_mvar), 1) AS total_mvar_nominal FROM read_parquet('s3://ons-aws-prod-opendata/dataset/equipamento_controle_reativo/*.parquet') WHERE val_potreativanominal_mvar IS NOT NULL GROUP BY nom_subestacao, id_subsistema, nom_estado ORDER BY total_mvar_nominal DESC LIMIT 20" ;
    ons:exampleQuestion "Quais são as 20 subestações com maior capacidade instalada de equipamentos de controle de reativos?"@pt .

<https://w3id.org/tiago-ons/data/template/equipamento_controle_reativo/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT nom_agente_proprietario, nom_tipoequipamento, COUNT(*) AS qtd_equipamentos, ROUND(SUM(val_potreativanominal_mvar), 1) AS total_mvar_nominal FROM read_parquet('s3://ons-aws-prod-opendata/dataset/equipamento_controle_reativo/*.parquet') WHERE TRIM(nom_tipoderede) = 'Rede Básica' AND val_potreativanominal_mvar IS NOT NULL AND nom_agente_proprietario IS NOT NULL GROUP BY nom_agente_proprietario, nom_tipoequipamento ORDER BY nom_agente_proprietario, total_mvar_nominal DESC" ;
    ons:exampleQuestion "Qual é o inventário de equipamentos de controle de reativos da Rede Básica por agente proprietário, com total de Mvar instalado?"@pt .

<https://w3id.org/tiago-ons/data/dataset/fator_capacidade_2>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:fator-capacidade-2" ;
    dct:title "fator-capacidade-2" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/geracao> ;
    dcat:keyword "FC eólico"@pt ;
    dcat:keyword "FC solar"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "capacity factor"@pt ;
    dcat:keyword "fator capacidade eólica"@pt ;
    dcat:keyword "fator de aproveitamento"@pt ;
    dcat:keyword "fator de capacidade"@pt ;
    dcat:keyword "fator-de-capacidade"@pt ;
    dcat:keyword "geração-eólica"@pt ;
    dcat:keyword "geração-programada"@pt ;
    dcat:keyword "geração-verificada"@pt ;
    dcat:keyword "horário"@pt ;
    dcat:keyword "por-usina"@pt ;
    dcat:keyword "solar-fotovoltaica"@pt ;
    dcat:keyword "usinas-renováveis"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Permitir que analistas do ONS, agentes do setor elétrico, pesquisadores e reguladores avaliem o desempenho horário de usinas eólicas e solares fotovoltaicas no SIN, identificando padrões de variabilidade, desvios entre geração programada e verificada, e aproveitamento da capacidade instalada por usina, subsistema, estado e tipo de fonte. Suporta decisões de planejamento da operação, previsão de geração renovável, estudos de integração de fontes intermitentes, avaliação de acurácia de modelos de previsão e análises regulatórias de desempenho de empreendimentos cadastrados na ANEEL."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver fator de capacidade, aproveitamento de capacidade instalada, desempenho horário ou variabilidade de usinas eólicas ou solares fotovoltaicas no SIN."@pt ;
    ons:limitation "Coluna armazenada como VARCHAR no Parquet devido ao formato de serialização no dataset fator-capacidade-2. Coluna armazenada como VARCHAR no Parquet devido ao formato de serialização no dataset fator-capacidade-2. Coluna armazenada como VARCHAR no Parquet devido ao formato de serialização no dataset fator-capacidade-2."@pt ;
    dct:source <https://dados.ons.org.br/dataset/fator-capacidade-2> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/fator_capacidade_2_di/*.parquet" ;
    skos:altLabel "aproveitamento das eolicas"@pt ;
    skos:altLabel "quanto a usina gerou do que poderia"@pt ;
    skos:altLabel "fator de capacidade solar"@pt ;
    skos:altLabel "desempenho das renovaveis"@pt ;
    skos:altLabel "rendimento do parque eolico"@pt ;
    ons:exampleQuestion "Qual foi o fator de capacidade médio das usinas eólicas do Nordeste em janeiro de 2022?"@pt ;
    ons:exampleQuestion "Quais usinas solares apresentaram maior desvio entre geração programada e verificada?"@pt ;
    ons:exampleQuestion "Como varia o fator de capacidade horário das usinas eólicas ao longo do dia?"@pt ;
    ons:exampleQuestion "Qual a capacidade instalada total de usinas eólicas despachadas pelo ONS por subsistema?"@pt ;
    ons:exampleQuestion "Quais usinas tiveram fator de capacidade acima de 0,8 em algum instante horário?"@pt ;
    ons:exampleQuestion "Qual o desvio médio entre geração programada e verificada das eólicas?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver fator de capacidade, aproveitamento de capacidade instalada, desempenho horário ou variabilidade de usinas eólicas ou solares fotovoltaicas no SIN. Também relevante para perguntas sobre desvio entre geração programada e verificada de renováveis intermitentes, análise de perfil horário de geração renovável, ou avaliação de desempenho de empreendimentos cadastrados na ANEEL por CEG."@pt ;
    ons:agentInstruction "- [val_geracaoprogramada] Coluna armazenada como VARCHAR no Parquet devido ao formato de serialização. Contém valores numéricos representando MW de geração programada. Qualquer operação aritmética ou de agregação retornará erro ou resultado incorreto sem conversão explícita.\n\n- [val_geracaoverificada] Coluna armazenada como VARCHAR no Parquet devido ao formato de serialização. Contém valores numéricos representando MW de geração verificada. Operações aritméticas sem TRY_CAST resultarão em erro de tipo no DuckDB.\n\n- [val_capacidadeinstalada] Coluna armazenada como VARCHAR no Parquet devido ao formato de serialização. Contém valores numéricos representando MW de capacidade instalada. Sem TRY_CAST, cálculos de fator de capacidade derivados desta coluna produzirão resultados incorretos.\n\n- [val_fatorcapacidade] Coluna armazenada como VARCHAR no Parquet devido ao formato de serialização. Contém valores numéricos representando o fator de capacidade (razão entre geração verificada e capacidade instalada). Sem TRY_CAST, análises estatísticas do indicador principal do dataset serão inviáveis.\n\n- [val_latitudepontoconexao] Poucos registros possuem valor nulo na latitude do ponto de conexão. Embora a proporção seja baixa, pode impactar análises geoespaciais que dependam das coordenadas do ponto de conexão para mapeamento ou cálculo de distâncias.\n\n- [val_longitudepontoconexao] Poucos registros possuem valor nulo na longitude do ponto de conexão, coincidindo com os nulos de val_latitudepontoconexao. As usinas afetadas não possuem coordenadas completas do ponto de conexão cadastradas no ONS.\n\n- [din_instante] A serie e horaria e ativa, iniciada em 2009-07-01. Meca a cobertura corrente antes de assumir qualquer recorte. A cobertura histórica completa requer acesso a múltiplos datasets/arquivos do ONS; este glob isolado não representa série contínua de longo prazo.\n"@pt ;
    dct:accrualPeriodicity "horária" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/fator_capacidade_2_di/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2009-07-01/" ;
