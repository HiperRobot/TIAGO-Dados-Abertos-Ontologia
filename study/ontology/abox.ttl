<https://w3id.org/tiago-ons/data/column/geracao_usina_2/din_instante>
    a ons:Column ;
    dct:title "din_instante" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Instante de referência da medição horária de geração. Representa o início da hora (ex: 2024-01-01 00:00:00 = hora 0 do dia). Eixo temporal primário da série histórica cobrindo desde 2000."@pt ;
    skos:altLabel "instante"@pt ;
    skos:altLabel "hora"@pt ;
    skos:altLabel "data_hora"@pt ;
    skos:altLabel "timestamp"@pt ;
    skos:altLabel "data_geracao"@pt ;
    skos:altLabel "horario"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/geracao_usina_2/id_subsistema>
