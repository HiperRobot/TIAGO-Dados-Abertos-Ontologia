<https://w3id.org/tiago-ons/data/column/ear_diario_por_bacia/ear_verif_bacia_mwmes>
    a ons:Column ;
    dct:title "ear_verif_bacia_mwmes" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Energia armazenada verificada na bacia hidro energética na data de referência, expressa em MWmês. Representa a energia associada ao volume de água efetivamente disponível nos reservatórios da bacia, considerando o nível verificado e a capacidade de geração em cascata."@pt ;
