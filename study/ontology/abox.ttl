<https://w3id.org/tiago-ons/data/column/cmo_semi_horario/id_subsistema>
    a ons:Column ;
    dct:title "id_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificador alfanumérico do subsistema elétrico do SIN. Representa os quatro subsistemas principais: SE/CO, S, NE e N. Chave de join com outros datasets de subsistema do ONS."@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "id_sub"@pt ;
    skos:altLabel "codigo_subsistema"@pt ;
    skos:altLabel "regiao"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "N" ;
    ons:allowedValue "NE" ;
    ons:allowedValue "S" ;
    ons:allowedValue "SE" .

<https://w3id.org/tiago-ons/data/column/cmo_semi_horario/nom_subsistema>
    a ons:Column ;
    dct:title "nom_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome completo do subsistema elétrico do SIN correspondente ao id_subsistema. Identifica textualmente cada uma das quatro regiões do sistema interligado. Pode apresentar variações históricas de nomenclatura para o subsistema SE/CO."@pt ;
    skos:altLabel "nome_subsistema"@pt ;
    skos:altLabel "subsistema_nome"@pt ;
    skos:altLabel "regiao_nome"@pt ;
    skos:altLabel "nome_regiao"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "NORDESTE" ;
    ons:allowedValue "NORTE" ;
    ons:allowedValue "SUDESTE" ;
    ons:allowedValue "SUL" .

<https://w3id.org/tiago-ons/data/column/cmo_semi_horario/din_instante>
    a ons:Column ;
    dct:title "din_instante" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data e hora do instante de início do intervalo semi-horário (30 minutos) ao qual o CMO se refere. Gerado pelo modelo DESSEM com granularidade de 30 minutos, cobrindo 48 intervalos por dia (00:00, 00:30, 01:00, ..., 23:30). Componente da chave primária composta junto com id_subsistema."@pt ;
    skos:altLabel "instante"@pt ;
    skos:altLabel "data_hora"@pt ;
    skos:altLabel "timestamp"@pt ;
    skos:altLabel "data_instante"@pt ;
    skos:altLabel "horario"@pt ;
    skos:altLabel "din"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/cmo_semi_horario/val_cmo>
    a ons:Column ;
    dct:title "val_cmo" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Custo Marginal de Operação (CMO) estimado pelo modelo DESSEM para o subsistema no intervalo semi-horário correspondente. Representa o custo por unidade de energia produzida para atender ao incremento de uma unidade de carga no subsistema, calculado como média ponderada pela carga dos CMOs nas barras pertencentes ao subsistema. Valores negativos são possíveis em situações de excesso de geração ou vertimento."@pt ;
    skos:altLabel "cmo"@pt ;
    skos:altLabel "custo_marginal"@pt ;
    skos:altLabel "custo_marginal_operacao"@pt ;
    skos:altLabel "preco_cmo"@pt ;
    skos:altLabel "valor_cmo"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_cmo AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/brl_per_mwh> .

<https://w3id.org/tiago-ons/data/dimension/cmo_semi_horario/subsistema>
    a ons:Dimension ;
    skos:prefLabel "subsistema" ;
    ons:onColumn <https://w3id.org/tiago-ons/data/column/cmo_semi_horario/id_subsistema> ;
    ons:refersTo ons:Subsistema .

<https://w3id.org/tiago-ons/data/metric/cmo_semi_horario/cmo>
    a ons:Metric ;
    skos:prefLabel "CMO"@pt ;
    skos:altLabel "cmo"@pt ;
    skos:altLabel "custo_marginal"@pt ;
    skos:altLabel "custo_marginal_operacao"@pt ;
    skos:altLabel "preco_cmo"@pt ;
    skos:altLabel "valor_cmo"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/cmo_semi_horario/val_cmo> ;
    ons:expression "TRY_CAST(val_cmo AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/price> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/brl_per_mwh> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/avg> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(TRY_CAST(val_cmo AS DOUBLE))\", \"unit\": \"R$/MWh\"}, \"maximum\": {\"sql\": \"MAX(TRY_CAST(val_cmo AS DOUBLE))\", \"unit\": \"R$/MWh\"}, \"minimum\": {\"sql\": \"MIN(TRY_CAST(val_cmo AS DOUBLE))\", \"unit\": \"R$/MWh\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_cmo AS DOUBLE))\", \"unit\": \"R$/MWh\"}, \"ranking\": {\"sql\": \"AVG(TRY_CAST(val_cmo AS DOUBLE))\", \"unit\": \"R$/MWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_cmo AS DOUBLE))\", \"unit\": \"R$/MWh\"}}" .

