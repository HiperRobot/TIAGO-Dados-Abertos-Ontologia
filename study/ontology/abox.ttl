<https://w3id.org/tiago-ons/data/template/balanco_energia_subsistema/pattern_geracao_total_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "geracao_total_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, id_subsistema,\n  SUM((TRY_CAST(val_gerhidraulica AS DOUBLE) + TRY_CAST(val_gertermica AS DOUBLE) + TRY_CAST(val_gereolica AS DOUBLE) + TRY_CAST(val_gersolar AS DOUBLE)) * 1.0) / 1000 AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM din_instante) = {year}\n  AND id_subsistema NOT IN ('SIN')\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_energia_subsistema/geracao_total> .

<https://w3id.org/tiago-ons/data/template/balanco_energia_subsistema/pattern_balanco_horario_subsistema>
    a ons:QueryTemplate ;
    skos:prefLabel "balanco_horario_subsistema" ;
    ons:sqlTemplate "SELECT din_instante, id_subsistema,\n  TRY_CAST(val_gerhidraulica AS DOUBLE) AS hidraulica_mwmed,\n  TRY_CAST(val_gertermica AS DOUBLE) AS termica_mwmed,\n  TRY_CAST(val_gereolica AS DOUBLE) AS eolica_mwmed,\n  TRY_CAST(val_gersolar AS DOUBLE) AS solar_mwmed,\n  TRY_CAST(val_carga AS DOUBLE) AS carga_mwmed\nFROM {source}\nWHERE TRY_CAST(din_instante AS DATE) = '{data}'\nORDER BY din_instante" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_energia_subsistema/geracao_total> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_energia_subsistema/carga> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_energia_subsistema/intercambio> .

<https://w3id.org/tiago-ons/data/template/balanco_energia_subsistema/pattern_intercambio_liquido_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "intercambio_liquido_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, id_subsistema,\n  SUM(TRY_CAST(val_intercambio AS DOUBLE) * 1.0) / 1000 AS intercambio_gwh\nFROM {source}\nWHERE id_subsistema NOT IN ('SIN')\n  AND din_instante BETWEEN {start} AND {end}\nGROUP BY 1, 2\nORDER BY 1, intercambio_gwh DESC" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_energia_subsistema/intercambio> .

<https://w3id.org/tiago-ons/data/template/balanco_energia_subsistema/pattern_geracao_por_fonte_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "geracao_por_fonte_mensal" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  SUM(TRY_CAST(val_gerhidraulica AS DOUBLE)) / 1000 AS hidraulica_gwh,\n  SUM(TRY_CAST(val_gertermica AS DOUBLE)) / 1000 AS termica_gwh,\n  SUM(TRY_CAST(val_gereolica AS DOUBLE)) / 1000 AS eolica_gwh,\n  SUM(TRY_CAST(val_gersolar AS DOUBLE)) / 1000 AS solar_gwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\n  AND id_subsistema NOT IN ('SIN')\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_energia_subsistema/geracao_total> .

<https://w3id.org/tiago-ons/data/template/balanco_energia_subsistema/pattern_geracao_por_fonte_mensal_mwmed>
    a ons:QueryTemplate ;
    skos:prefLabel "geracao_por_fonte_mensal_mwmed" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  ROUND(SUM(TRY_CAST(val_gerhidraulica AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS hidraulica_mwmed,\n  ROUND(SUM(TRY_CAST(val_gertermica AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS termica_mwmed,\n  ROUND(SUM(TRY_CAST(val_gereolica AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS eolica_mwmed,\n  ROUND(SUM(TRY_CAST(val_gersolar AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS solar_mwmed\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\n  AND id_subsistema NOT IN ('SIN')\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_energia_subsistema/geracao_total> .

<https://w3id.org/tiago-ons/data/template/balanco_energia_subsistema/pattern_geracao_por_fonte_anual>
    a ons:QueryTemplate ;
    skos:prefLabel "geracao_por_fonte_anual" ;
    ons:sqlTemplate "WITH a AS (\n  SELECT\n    SUM(TRY_CAST(val_gerhidraulica AS DOUBLE)) AS hidraulica,\n    SUM(TRY_CAST(val_gertermica AS DOUBLE)) AS termica,\n    SUM(TRY_CAST(val_gereolica AS DOUBLE)) AS eolica,\n    SUM(TRY_CAST(val_gersolar AS DOUBLE)) AS solar\n  FROM {source}\n  WHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\n    AND id_subsistema NOT IN ('SIN')\n)\nSELECT fonte,\n       ROUND(energia / 1000, 1) AS energia_gwh,\n       ROUND(100.0 * energia / (SELECT hidraulica + termica + eolica + solar FROM a), 1) AS participacao_pct\nFROM (\n  SELECT 'Hidraulica' AS fonte, hidraulica AS energia FROM a\n  UNION ALL SELECT 'Termica', termica FROM a\n  UNION ALL SELECT 'Eolica', eolica FROM a\n  UNION ALL SELECT 'Solar', solar FROM a\n) t\nORDER BY energia_gwh DESC" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_energia_subsistema/geracao_total> .

<https://w3id.org/tiago-ons/data/template/balanco_energia_subsistema/pattern_geracao_total_mensal_mwmed>
    a ons:QueryTemplate ;
    skos:prefLabel "geracao_total_mensal_mwmed" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  ROUND(SUM(TRY_CAST(val_gerhidraulica AS DOUBLE) + TRY_CAST(val_gertermica AS DOUBLE) + TRY_CAST(val_gereolica AS DOUBLE) + TRY_CAST(val_gersolar AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS geracao_total_mwmed\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\n  AND id_subsistema NOT IN ('SIN')\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_energia_subsistema/geracao_total> .

<https://w3id.org/tiago-ons/data/template/balanco_energia_subsistema/pattern_intercambio_diario_por_subsistema>
    a ons:QueryTemplate ;
    skos:prefLabel "intercambio_diario_por_subsistema" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('day', TRY_CAST(din_instante AS TIMESTAMP)) AS dia,\n  TRIM(id_subsistema) AS id_subsistema,\n  ROUND(AVG(TRY_CAST(val_intercambio AS DOUBLE)), 1) AS intercambio_medio_mwmed,\n  ROUND(MIN(TRY_CAST(val_intercambio AS DOUBLE)), 1) AS intercambio_min_mwmed,\n  ROUND(MAX(TRY_CAST(val_intercambio AS DOUBLE)), 1) AS intercambio_max_mwmed,\n  COUNT(TRY_CAST(val_intercambio AS DOUBLE)) AS horas\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\n  AND EXTRACT(MONTH FROM TRY_CAST(din_instante AS TIMESTAMP)) = {month}\n  AND TRIM(id_subsistema) IN ('N', 'NE', 'S', 'SE')\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_energia_subsistema/intercambio> .

<https://w3id.org/tiago-ons/data/template/balanco_energia_subsistema/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, id_subsistema, AVG(TRY_CAST(val_gereolica AS DOUBLE)) AS media_eolica_mwmed, AVG(val_carga) AS media_carga_mwmed, ROUND(100.0 * AVG(val_gereolica) / NULLIF(AVG(val_carga), 0), 2) AS participacao_eolica_pct FROM read_parquet('s3://ons-aws-prod-opendata/dataset/balanco_energia_subsistema_ho/*.parquet') WHERE id_subsistema = 'NE' AND din_instante >= '2015-01-01' GROUP BY DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)), id_subsistema ORDER BY mes DESC LIMIT 100;" ;
    ons:exampleQuestion "Como evoluiu a participação percentual da geração eólica na carga do subsistema Nordeste mês a mês?"@pt .

<https://w3id.org/tiago-ons/data/template/balanco_energia_subsistema/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "WITH ranked AS ( SELECT id_subsistema, nom_subsistema, din_instante, val_carga, ROW_NUMBER() OVER (PARTITION BY id_subsistema ORDER BY val_carga DESC) AS rn FROM read_parquet('s3://ons-aws-prod-opendata/dataset/balanco_energia_subsistema_ho/*.parquet') WHERE din_instante >= '2024-01-01' AND din_instante < '2025-01-01' ) SELECT id_subsistema, nom_subsistema, din_instante AS instante_pico, val_carga AS pico_carga_mwmed FROM ranked WHERE rn = 1 ORDER BY pico_carga_mwmed DESC;" ;
    ons:exampleQuestion "Qual foi o pico de carga horária em cada subsistema do SIN durante o ano de 2024 e em que data/hora ocorreu?"@pt .

<https://w3id.org/tiago-ons/data/template/balanco_energia_subsistema/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "WITH ultima_data AS ( SELECT MAX(DATE_TRUNC('day', TRY_CAST(din_instante AS TIMESTAMP))) AS max_dia FROM read_parquet('s3://ons-aws-prod-opendata/dataset/balanco_energia_subsistema_ho/*.parquet') ) SELECT b.din_instante, SUM((b.val_gerhidraulica) * 1.0) / 1000 AS geracao_hidraulica_sin, SUM((b.val_gertermica) * 1.0) / 1000 AS geracao_termica_sin, SUM((b.val_gereolica) * 1.0) / 1000 AS geracao_eolica_sin, SUM((b.val_gersolar) * 1.0) / 1000 AS geracao_solar_sin, SUM((b.val_gerhidraulica + b.val_gertermica + b.val_gereolica + b.val_gersolar) * 1.0) / 1000 AS geracao_total_sin, SUM((b.val_carga) * 1.0) / 1000 AS carga_total_sin, SUM((b.val_gerhidraulica + b.val_gertermica + b.val_gereolica + b.val_gersolar) * 1.0) / 1000 - SUM((b.val_carga) * 1.0) / 1000 AS saldo_balanco FROM read_parquet('s3://ons-aws-prod-opendata/dataset/balanco_energia_subsistema_ho/*.parquet') AS b CROSS JOIN ultima_data AS u WHERE DATE_TRUNC('day', b.din_instante) = u.max_dia GROUP BY b.din_instante ORDER BY b.din_instante;" ;
    ons:exampleQuestion "Qual foi o balanço entre geração total e carga verificada no SIN nas últimas 24 horas disponíveis?"@pt .

<https://w3id.org/tiago-ons/data/dataset/balanco_dessem_detalhe>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:balanco_dessem_detalhe" ;
    dct:title "balanco_dessem_detalhe" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/planejamento> ;
    dcat:keyword "30min"@pt ;
    dcat:keyword "DESSEM"@pt ;
    dcat:keyword "DESSEM balanço semi-horário"@pt ;
    dcat:keyword "DESSEM detalhe"@pt ;
    dcat:keyword "PCH"@pt ;
    dcat:keyword "balanco_dessem_detalhe"@pt ;
    dcat:keyword "balanço DESSEM semi-horário"@pt ;
    dcat:keyword "balanço energético"@pt ;
    dcat:keyword "despacho semi-horário por subsistema"@pt ;
    dcat:keyword "geração eólica"@pt ;
    dcat:keyword "geração fotovoltaica"@pt ;
    dcat:keyword "geração hidráulica"@pt ;
    dcat:keyword "geração térmica"@pt ;
    dcat:keyword "programação diária por fonte"@pt ;
    dcat:keyword "semi-horário"@pt ;
    dcat:keyword "subsistema"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Suportar operadores e planejadores do ONS no acompanhamento e validação da programação eletro-energética diária resultante do modelo DESSEM, permitindo análise intra-diária do balanço entre demanda e geração por fonte e subsistema. Utilizado para decisões de despacho, verificação de adequação de oferta, análise de participação de fontes renováveis na matriz programada e fechamento do balanço energético semi-horário do SIN."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver programação eletro-energética diária resultante do modelo DESSEM com detalhamento por fonte de geração (hidráulica, térmica, eólica, solar, PCH, PCT, MMGD) em granularidade semi-horária (30 minutos) por subsistema."@pt ;
    ons:limitation "Coluna armazenada como VARCHAR no Parquet devido ao formato de serialização. Coluna armazenada como VARCHAR no Parquet devido ao formato de serialização. Coluna armazenada como VARCHAR no Parquet devido a formato de serialização."@pt ;
    dct:source <https://dados.ons.org.br/dataset/balanco_dessem_detalhe> ;
    ons:freshness "P1D — Atualizado diariamente com resultado do modelo DESSEM do dia anterior; sujeito a revisões retroativas por processo de consistência recorrente."@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/balanco_dessem_detalhe/*.parquet" ;
    skos:altLabel "o que o dessem programou por fonte"@pt ;
    skos:altLabel "programacao do dessem detalhada"@pt ;
    skos:altLabel "despacho previsto por fonte"@pt ;
    skos:altLabel "saida do modelo dessem"@pt ;
    skos:altLabel "carga prevista por fonte"@pt ;
    skos:altLabel "previsao de carga detalhada"@pt ;
    ons:exampleQuestion "Qual foi a geração eólica programada pelo DESSEM no subsistema NE no dia 2025-06-01 por patamar?"@pt ;
    ons:exampleQuestion "Como se distribui a geração fotovoltaica ao longo do dia no subsistema SE segundo o DESSEM?"@pt ;
    ons:exampleQuestion "Qual a participação percentual de cada fonte na geração total programada pelo DESSEM por subsistema?"@pt ;
    ons:exampleQuestion "Qual o patamar de maior demanda programada pelo DESSEM no subsistema SE em um dia típico?"@pt ;
    ons:exampleQuestion "Qual a diferença entre demanda e geração total programada pelo DESSEM (balanço) por subsistema e patamar?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver programação eletro-energética diária resultante do modelo DESSEM com detalhamento por fonte de geração (hidráulica, térmica, eólica, solar, PCH, PCT, MMGD) em granularidade semi-horária (30 minutos) por subsistema. Também relevante para análises de balanço intra-diário, perfil de geração renovável ao longo do dia, despacho de elevatórias e fechamento do balanço energético do SIN."@pt ;
    ons:agentInstruction "- [din_programacaodia] Coluna de data armazenada como VARCHAR em vez de DATE. O formato exato (YYYY-MM-DD, DD/MM/YYYY ou outro) deve ser verificado antes de operações temporais. Filtros por data requerem conversão explícita para evitar comparações lexicográficas incorretas.\n\n- [val_demanda] Campo numérico armazenado como VARCHAR devido ao formato de serialização. Qualquer agregação (SUM, AVG, MIN, MAX) ou comparação numérica requer TRY_CAST explícito. Valores não conversíveis retornarão NULL silenciosamente.\n\n- [val_ger_hidraulica] Campo numérico armazenado como VARCHAR pelo formato de serialização. Requer TRY_CAST para uso analítico. Verificar se existem valores negativos inesperados, que poderiam indicar reversão de fluxo ou erro de sinal na exportação.\n\n- [val_ger_pch] Campo numérico armazenado como VARCHAR pelo formato de serialização. Requer TRY_CAST para uso analítico. Valores esperados não negativos; verificar anomalias.\n\n- [val_ger_termica] Campo numérico armazenado como VARCHAR pelo formato de serialização. Requer TRY_CAST para uso analítico. Valores esperados não negativos; picos elevados podem indicar despacho de emergência ou erro de modelo.\n\n- [val_ger_pct] Campo numérico armazenado como VARCHAR pelo formato de serialização. Requer TRY_CAST para uso analítico.\n\n- [val_ger_eolica] Campo numérico armazenado como VARCHAR pelo formato de serialização. Requer TRY_CAST para uso analítico. Valores de geração eólica variam significativamente por patamar; verificar se patamares noturnos apresentam valores coerentes.\n\n- [val_ger_fotovoltaica] Campo numérico armazenado como VARCHAR pelo formato de serialização. Requer TRY_CAST para uso analítico. Geração fotovoltaica deve ser zero ou próxima de zero nos patamares noturnos (1–6 e 44–48 aproximadamente); valores positivos nesses patamares indicam possível inconsistência no modelo.\n\n- [val_ger_mmgd] Campo numérico armazenado como VARCHAR pelo formato de serialização. Requer TRY_CAST para uso analítico. MMGD de origem solar deve apresentar geração nula em patamares noturnos.\n\n- [val_cons_elevatoria] Campo numérico armazenado como VARCHAR pelo formato de serialização. Requer TRY_CAST para uso analítico. Consumo de elevatórias pode apresentar valores negativos dependendo da convenção de sinal adotada no DESSEM. Verificar consistência do sinal antes de somar ao balanço.\n"@pt ;
    dct:accrualPeriodicity "30min" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/balanco_dessem_detalhe/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2025-05-23/" ;
