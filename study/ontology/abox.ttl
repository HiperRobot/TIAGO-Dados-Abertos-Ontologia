<https://w3id.org/tiago-ons/data/column/ind_confiarb_ccal/cod_tipoagregacao>
    a ons:Column ;
    dct:title "cod_tipoagregacao" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Código que identifica o tipo de agregação espacial do indicador CCAL. Indica se o registro representa o Sistema Interligado Nacional (SIN), uma Área de Controle (ARE) ou um Agente de transmissão específico (AGE)."@pt ;
    skos:altLabel "tipo de agregação"@pt ;
    skos:altLabel "nível de agregação"@pt ;
    skos:altLabel "tipo agregação"@pt ;
    skos:altLabel "cod_tipo_agregacao"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "Agente" ;
    ons:allowedValue "COSR" ;
    ons:allowedValue "SIN" .

<https://w3id.org/tiago-ons/data/column/ind_confiarb_ccal/id_periodicidade>
    a ons:Column ;
    dct:title "id_periodicidade" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificador da periodicidade do registro. Indica se o valor do indicador CCAL corresponde a uma apuração mensal (M) ou anual (A), conforme Submódulo 9.1 dos Procedimentos de Rede do ONS."@pt ;
    skos:altLabel "periodicidade"@pt ;
    skos:altLabel "frequência"@pt ;
    skos:altLabel "tipo de período"@pt ;
    skos:altLabel "mensal"@pt ;
    skos:altLabel "anual"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "AN" ;
    ons:allowedValue "ME" .

<https://w3id.org/tiago-ons/data/column/ind_confiarb_ccal/nom_agregacao>
    a ons:Column ;
    dct:title "nom_agregacao" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome descritivo da entidade de agregação correspondente ao cod_tipoagregacao. Para SIN, contém \"SIN\"; para Área de Controle, contém o nome da área; para Agente, contém o nome do agente de transmissão."@pt ;
    skos:altLabel "nome da agregação"@pt ;
    skos:altLabel "nome do agente"@pt ;
    skos:altLabel "nome da área de controle"@pt ;
    skos:altLabel "agente"@pt ;
    skos:altLabel "área de controle"@pt ;
    skos:altLabel "nom_agente"@pt ;
    ons:semanticRole "DIMENSION" .

<https://w3id.org/tiago-ons/data/column/ind_confiarb_ccal/din_referencia>
    a ons:Column ;
    dct:title "din_referencia" ;
    dct:type "timestamp" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Data de referência do indicador CCAL. Para registros mensais, corresponde ao primeiro dia do mês de apuração. Para registros anuais, corresponde ao primeiro dia do ano de apuração. Cobre o período de 2016-01-01 em diante."@pt ;
    ons:castExpression "TRY_CAST(din_referencia AS TIMESTAMP)" ;
    skos:altLabel "data de referência"@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "mês"@pt ;
    skos:altLabel "ano"@pt ;
    skos:altLabel "período"@pt ;
    skos:altLabel "competência"@pt ;
    skos:altLabel "din_ref"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/ind_confiarb_ccal/num_linhasoperacao>
    a ons:Column ;
    dct:title "num_linhasoperacao" ;
    dct:type "integer" ;
    ons:physicalType "BIGINT" ;
    dct:description "Número total de linhas de transmissão da rede básica em operação no período de referência, dentro do escopo da agregação (SIN, Área de Controle ou Agente). Utilizado como denominador no cálculo do indicador CCAL. Máximo observado: 1604."@pt ;
    skos:altLabel "linhas em operação"@pt ;
    skos:altLabel "total de linhas"@pt ;
    skos:altLabel "linhas operando"@pt ;
    skos:altLabel "número de linhas"@pt ;
    skos:altLabel "num_linhas_operacao"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/linhas> .

