<https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_trlt/val_disp>
    a ons:Column ;
    dct:title "val_disp" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Indicador percentual de Disponibilidade (DISP) da Função Transmissão no mês de referência. Representa a fração do tempo em que o equipamento (linha de transmissão ou transformador) esteve disponível para operação, conforme Submódulo 9.2 dos Procedimentos de Rede do ONS. Valores observados entre 88,69% e 100%."@pt ;
    skos:altLabel "disponibilidade"@pt ;
    skos:altLabel "DISP"@pt ;
    skos:altLabel "índice de disponibilidade"@pt ;
    skos:altLabel "disponibilidade da função transmissão"@pt ;
    skos:altLabel "percentual de disponibilidade"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent> .

<https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_trlt/val_indisppf>
    a ons:Column ;
