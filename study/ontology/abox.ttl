    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data e hora do instante de referência da medição horária de carga, com discretização de 1 hora. Representa o início ou o centro do intervalo horário conforme convenção ONS. Cobre o período de 2000-01-01 em diante."@pt ;
    skos:altLabel "instante"@pt ;
    skos:altLabel "data hora"@pt ;
    skos:altLabel "timestamp"@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "hora"@pt ;
    skos:altLabel "din instante"@pt ;
    skos:altLabel "data e hora"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/curva_carga/val_cargaenergiahomwmed>
    a ons:Column ;
    dct:title "val_cargaenergiahomwmed" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Valor da carga de energia elétrica verificada no subsistema para o intervalo horário indicado em din_instante, expresso em megawatts médios (MWmed). O sufixo 'ho' indica discretização horária e 'mwmed' indica a unidade. Representa a demanda média integrada ao longo da hora."@pt ;
    skos:altLabel "carga"@pt ;
    skos:altLabel "carga horária"@pt ;
    skos:altLabel "demanda"@pt ;
    skos:altLabel "consumo"@pt ;
    skos:altLabel "carga de energia"@pt ;
    skos:altLabel "MWmed"@pt ;
    skos:altLabel "megawatts médios"@pt ;
    skos:altLabel "val carga"@pt ;
    skos:altLabel "carga energia"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_cargaenergiahomwmed AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/dimension/curva_carga/subsistema>
    a ons:Dimension ;
    skos:prefLabel "subsistema" ;
    ons:onColumn <https://w3id.org/tiago-ons/data/column/curva_carga/id_subsistema> ;
    ons:refersTo ons:Subsistema .

<https://w3id.org/tiago-ons/data/metric/curva_carga/cargaenergiahomwmed>
    a ons:Metric ;
    skos:prefLabel "Carga Verificada"@pt ;
    skos:altLabel "carga"@pt ;
    skos:altLabel "carga horária"@pt ;
    skos:altLabel "demanda"@pt ;
    skos:altLabel "consumo"@pt ;
    skos:altLabel "carga de energia"@pt ;
    skos:altLabel "MWmed"@pt ;
    skos:altLabel "megawatts médios"@pt ;
    skos:altLabel "val carga"@pt ;
    skos:altLabel "carga energia"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/curva_carga/val_cargaenergiahomwmed> ;
    ons:expression "TRY_CAST(val_cargaenergiahomwmed AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "1.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(val_cargaenergiahomwmed AS DOUBLE)) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_cargaenergiahomwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_cargaenergiahomwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_cargaenergiahomwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(val_cargaenergiahomwmed AS DOUBLE)) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_cargaenergiahomwmed AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

