<https://w3id.org/tiago-ons/data/template/coff_fotovoltaica_intrasemihora/pattern_todas_metricas_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "todas_metricas_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  ROUND(SUM(num_minutosrestricao), 1) AS num_minutosrestricao,\n  ROUND(AVG(val_geracaolimitada), 1) AS geracaolimitada\nFROM {source}\nWHERE EXTRACT(YEAR FROM din_instante) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "minutos" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/coff_fotovoltaica_intrasemihora/num_minutosrestricao> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/coff_fotovoltaica_intrasemihora/geracaolimitada> .

<https://w3id.org/tiago-ons/data/template/coff_fotovoltaica_intrasemihora/pattern_geracaolimitada_mensal_mwmed>
    a ons:QueryTemplate ;
    skos:prefLabel "geracaolimitada_mensal_mwmed" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, id_subsistema,\n  AVG(val_geracaolimitada) AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM din_instante) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/coff_fotovoltaica_intrasemihora/geracaolimitada> .

<https://w3id.org/tiago-ons/data/template/coff_fotovoltaica_intrasemihora/pattern_num_minutosrestricao_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "num_minutosrestricao_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, id_subsistema,\n  SUM(num_minutosrestricao) AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM din_instante) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "minutos" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/coff_fotovoltaica_intrasemihora/num_minutosrestricao> .

<https://w3id.org/tiago-ons/data/template/coff_fotovoltaica_intrasemihora/pattern_geracaolimitada_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "geracaolimitada_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, id_subsistema,\n  SUM(val_geracaolimitada * num_minutosrestricao / 60.0) / 1000 AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM din_instante) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/coff_fotovoltaica_intrasemihora/geracaolimitada> .

<https://w3id.org/tiago-ons/data/template/coff_fotovoltaica_intrasemihora/pattern_curtailment_fotovoltaico_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "curtailment_fotovoltaico_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  id_subsistema,\n  SUM(num_minutosrestricao) AS total\nFROM {source}\nWHERE EXTRACT(YEAR FROM din_instante) = {year}\nGROUP BY 1, 2\nORDER BY 1, 3 DESC" ;
    ons:outputUnitLabel "minutos" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/coff_fotovoltaica_intrasemihora/num_minutosrestricao> .

<https://w3id.org/tiago-ons/data/template/coff_fotovoltaica_intrasemihora/pattern_ranking_num_minutosrestricao_por_subsistema>
    a ons:QueryTemplate ;
    skos:prefLabel "ranking_num_minutosrestricao_por_subsistema" ;
    ons:sqlTemplate "SELECT id_subsistema,\n  SUM(num_minutosrestricao) AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM din_instante) = {year}\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT {limit}" ;
    ons:outputUnitLabel "minutos" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/coff_fotovoltaica_intrasemihora/num_minutosrestricao> .

<https://w3id.org/tiago-ons/data/template/coff_fotovoltaica_intrasemihora/pattern_ranking_geracaolimitada_por_subsistema>
    a ons:QueryTemplate ;
    skos:prefLabel "ranking_geracaolimitada_por_subsistema" ;
    ons:sqlTemplate "SELECT id_subsistema,\n  SUM(val_geracaolimitada * num_minutosrestricao / 60.0) / 1000 AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM din_instante) = {year}\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT {limit}" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/coff_fotovoltaica_intrasemihora/geracaolimitada> .

<https://w3id.org/tiago-ons/data/template/coff_fotovoltaica_intrasemihora/pattern_ranking_num_minutosrestricao_por_ons>
    a ons:QueryTemplate ;
    skos:prefLabel "ranking_num_minutosrestricao_por_ons" ;
    ons:sqlTemplate "SELECT id_ons,\n  SUM(num_minutosrestricao) AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM din_instante) = {year}\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT {limit}" ;
    ons:outputUnitLabel "minutos" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/coff_fotovoltaica_intrasemihora/num_minutosrestricao> .

<https://w3id.org/tiago-ons/data/template/coff_fotovoltaica_intrasemihora/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT SUM(num_minutosrestricao) AS duracao_total_minutos FROM read_parquet('s3://ons-aws-prod-opendata/dataset/restricao_coff_fotovoltaica_intrasemihora/*.parquet', union_by_name=true) WHERE nom_usina = 'X' AND din_instante >= '2025-01-01' AND din_instante < '2025-02-01'" ;
    ons:exampleQuestion "Qual foi a duração total de restrições por constrained-off na usina X em janeiro de 2025?"@pt .

<https://w3id.org/tiago-ons/data/template/coff_fotovoltaica_intrasemihora/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT nom_usina, SUM(num_minutosrestricao) AS total_minutos_restricao FROM read_parquet('s3://ons-aws-prod-opendata/dataset/restricao_coff_fotovoltaica_intrasemihora/*.parquet', union_by_name=true) WHERE id_subsistema = 'NE' AND din_instante >= '2025-01-01' AND din_instante < '2025-04-01' GROUP BY nom_usina ORDER BY total_minutos_restricao DESC LIMIT 20" ;
    ons:exampleQuestion "Quais usinas fotovoltaicas do Nordeste tiveram maior número de minutos de restrição acumulados no primeiro trimestre?"@pt .

<https://w3id.org/tiago-ons/data/template/coff_fotovoltaica_intrasemihora/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT cod_razaorestricao, COUNT(*) AS frequencia FROM read_parquet('s3://ons-aws-prod-opendata/dataset/restricao_coff_fotovoltaica_intrasemihora/*.parquet', union_by_name=true) WHERE id_subsistema = 'SE' GROUP BY cod_razaorestricao ORDER BY frequencia DESC" ;
    ons:exampleQuestion "Qual a razão de restrição mais frequente (CNF, ENE, REL) nas usinas fotovoltaicas do subsistema SE?"@pt .

<https://w3id.org/tiago-ons/data/template/coff_fotovoltaica_intrasemihora/fewshot_3>
    a ons:QueryTemplate ;
    skos:prefLabel "3" ;
    ons:sqlTemplate "SELECT id_estado, cod_origemrestricao, COUNT(*) AS total_restricoes, ROUND(100.0 * COUNT(*) / SUM(COUNT(*)) OVER (PARTITION BY id_estado), 2) AS percentual FROM read_parquet('s3://ons-aws-prod-opendata/dataset/restricao_coff_fotovoltaica_intrasemihora/*.parquet', union_by_name=true) GROUP BY id_estado, cod_origemrestricao ORDER BY id_estado, cod_origemrestricao" ;
    ons:exampleQuestion "Qual o percentual de restrições de origem local (LOC) versus sistêmica (SIS) por estado?"@pt .

<https://w3id.org/tiago-ons/data/template/coff_fotovoltaica_intrasemihora/fewshot_4>
    a ons:QueryTemplate ;
    skos:prefLabel "4" ;
    ons:sqlTemplate "SELECT AVG(val_geracaolimitada) AS geracao_limitada_media_mw FROM read_parquet('s3://ons-aws-prod-opendata/dataset/restricao_coff_fotovoltaica_intrasemihora/*.parquet', union_by_name=true) WHERE cod_razaorestricao = 'CNF' AND id_subsistema = 'NE' AND din_instante >= '2024-01-01' AND din_instante < '2025-01-01'" ;
    ons:exampleQuestion "Qual foi a geração limitada média imposta nas restrições por confiabilidade (CNF) no NE em 2024?"@pt .

<https://w3id.org/tiago-ons/data/template/coff_fotovoltaica_intrasemihora/fewshot_5>
    a ons:QueryTemplate ;
    skos:prefLabel "5" ;
    ons:sqlTemplate "SELECT hor_inicial, COUNT(*) AS total_restricoes FROM read_parquet('s3://ons-aws-prod-opendata/dataset/restricao_coff_fotovoltaica_intrasemihora/*.parquet', union_by_name=true) WHERE id_subsistema = 'SE' GROUP BY hor_inicial ORDER BY total_restricoes DESC LIMIT 20" ;
    ons:exampleQuestion "Em quais horários do dia (hor_inicial) ocorrem mais restrições fotovoltaicas no subsistema SE?"@pt .

<https://w3id.org/tiago-ons/data/dataset/curva_carga>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:curva-carga" ;
    dct:title "curva-carga" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/carga> ;
    dcat:keyword "MWmed"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "SIN"@pt ;
