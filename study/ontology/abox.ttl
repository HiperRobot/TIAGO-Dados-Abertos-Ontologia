    skos:altLabel "taxa falha"@pt ;
    skos:altLabel "fdff"@pt ;
    skos:altLabel "val_fdff"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ind_disponibilidade_fgeracao_uge_anual/val_fdff> ;
    ons:expression "val_fdff" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/intensive> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/falhas_h> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(val_fdff)\", \"unit\": \"falhas/h\"}, \"maximum\": {\"sql\": \"MAX(val_fdff)\", \"unit\": \"falhas/h\"}, \"minimum\": {\"sql\": \"MIN(val_fdff)\", \"unit\": \"falhas/h\"}, \"time_series\": {\"sql\": \"AVG(val_fdff)\", \"unit\": \"falhas/h\"}, \"ranking\": {\"sql\": \"AVG(val_fdff)\", \"unit\": \"falhas/h\"}, \"comparison\": {\"sql\": \"AVG(val_fdff)\", \"unit\": \"falhas/h\"}}" .

