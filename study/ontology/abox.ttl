    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_fgeracao_uge_mensal/dispf> .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_fgeracao_uge_mensal/pattern_indisppf_mensal>
