<https://w3id.org/tiago-ons/data/column/interrupcao_carga/cod_perturbacao>
    a ons:Column ;
    dct:title "cod_perturbacao" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Código identificador único da perturbação registrada no sistema elétrico. Referencia o evento de desligamento forçado que originou a interrupção de carga, conforme apurado na RO-AO.BR.03."@pt ;
    skos:altLabel "codigo_perturbacao"@pt ;
    skos:altLabel "perturbacao"@pt ;
    skos:altLabel "id_perturbacao"@pt ;
    skos:altLabel "cod_evento"@pt ;
    ons:semanticRole "IDENTIFIER" .

<https://w3id.org/tiago-ons/data/column/interrupcao_carga/din_interrupcaocarga>
    a ons:Column ;
    dct:title "din_interrupcaocarga" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data e hora do início da interrupção de carga associada à perturbação. Registra o momento exato do evento com precisão de timestamp. Período real dos dados: a partir de 2007-01-01."@pt ;
    skos:altLabel "data_interrupcao"@pt ;
    skos:altLabel "data_hora_interrupcao"@pt ;
    skos:altLabel "din_interrupcao"@pt ;
    skos:altLabel "timestamp_evento"@pt ;
    skos:altLabel "data_perturbacao"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/interrupcao_carga/id_subsistema>
    a ons:Column ;
    dct:title "id_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Código identificador do subsistema elétrico onde ocorreu a interrupção de carga. Dimensão geográfica primária de operação do ONS. Valores típicos: SE, S, NE, N."@pt ;
