<https://w3id.org/tiago-ons/data/column/ena_diario_por_ree_reservatorio_equivalente_de_energia/nom_reservatorioee>
    a ons:Column ;
    dct:title "nom_reservatorioee" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome do Reservatório Equivalente de Energia (REE), que representa a agregação hidrológica e energética de usinas hidrelétricas por região/subsistema do Sistema Interligado Nacional (SIN). Funciona como identificador espacial equivalente ao subsistema para fins de estudos energéticos."@pt ;
    skos:altLabel "reservatório equivalente"@pt ;
    skos:altLabel "REE"@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "região hidrológica"@pt ;
    skos:altLabel "bacia equivalente"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "BELO MONTE" ;
    ons:allowedValue "IGUACU" ;
    ons:allowedValue "ITAIPU" ;
    ons:allowedValue "MADEIRA" ;
    ons:allowedValue "MANAUS-AMAPA" ;
    ons:allowedValue "NORDESTE" ;
    ons:allowedValue "NORTE" ;
    ons:allowedValue "PARANA" ;
    ons:allowedValue "PARANAPANEMA" ;
    ons:allowedValue "SUDESTE" ;
    ons:allowedValue "SUL" ;
    ons:allowedValue "TELES PIRES" .

<https://w3id.org/tiago-ons/data/column/ena_diario_por_ree_reservatorio_equivalente_de_energia/ena_data>
    a ons:Column ;
    dct:title "ena_data" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Data de referência da medição da Energia Natural Afluente, armazenada como VARCHAR no Parquet no formato YYYY-MM-DD. Representa o dia calendário ao qual os valores de ENA se referem. Recomenda-se CAST para DATE nas queries para operações temporais corretas."@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "data da ENA"@pt ;
    skos:altLabel "data de referência"@pt ;
    skos:altLabel "dia"@pt ;
    skos:altLabel "data hidrológica"@pt ;
    ons:semanticRole "DIMENSION" .

<https://w3id.org/tiago-ons/data/column/ena_diario_por_ree_reservatorio_equivalente_de_energia/ena_bruta_ree_mwmed>
    a ons:Column ;
    dct:title "ena_bruta_ree_mwmed" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Energia Natural Afluente Bruta do REE em MWmed (megawatts médios). Representa a energia produzível calculada pelo produto das vazões naturais aos reservatórios com as produtividades a 65% dos volumes úteis. Inclui toda a energia afluente, independentemente da capacidade de armazenamento."@pt ;
    ons:castExpression "TRY_CAST(ena_bruta_ree_mwmed AS DOUBLE)" ;
    skos:altLabel "ENA bruta"@pt ;
    skos:altLabel "energia natural afluente bruta"@pt ;
    skos:altLabel "ENA bruta MWmed"@pt ;
    skos:altLabel "afluência bruta"@pt ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/ena_diario_por_ree_reservatorio_equivalente_de_energia/ena_bruta_ree_percentualmlt>
    a ons:Column ;
    dct:title "ena_bruta_ree_percentualmlt" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Energia Natural Afluente Bruta do REE expressa como percentual da Média de Longo Termo (MLT). Indica o desvio da afluência bruta em relação à média histórica de longo prazo, sendo 100% equivalente à MLT. Valores abaixo de 100% indicam condição hidrológica desfavorável; acima de 100%, favorável."@pt ;
    ons:castExpression "TRY_CAST(ena_bruta_ree_percentualmlt AS DOUBLE)" ;
    skos:altLabel "ENA bruta percentual MLT"@pt ;
    skos:altLabel "ENA bruta % MLT"@pt ;
    skos:altLabel "percentual MLT bruta"@pt ;
    skos:altLabel "afluência bruta relativa"@pt ;
    skos:altLabel "ENA bruta normalizada"@pt ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent_mlt> .

<https://w3id.org/tiago-ons/data/column/ena_diario_por_ree_reservatorio_equivalente_de_energia/ena_armazenavel_ree_mwmed>
    a ons:Column ;
    dct:title "ena_armazenavel_ree_mwmed" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Energia Natural Afluente Armazenável do REE em MWmed (megawatts médios). Considera as vazões naturais descontadas das vazões vertidas nos reservatórios, representando a parcela da afluência que pode efetivamente ser armazenada e utilizada para geração futura. Sempre menor ou igual à ENA bruta."@pt ;
    ons:castExpression "TRY_CAST(ena_armazenavel_ree_mwmed AS DOUBLE)" ;
    skos:altLabel "ENA armazenável"@pt ;
    skos:altLabel "energia natural afluente armazenável"@pt ;
    skos:altLabel "ENA armazenável MWmed"@pt ;
    skos:altLabel "afluência armazenável"@pt ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/ena_diario_por_ree_reservatorio_equivalente_de_energia/ena_armazenavel_ree_percentualmlt>
    a ons:Column ;
    dct:title "ena_armazenavel_ree_percentualmlt" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Energia Natural Afluente Armazenável do REE expressa como percentual da Média de Longo Termo (MLT). Indica o desvio da afluência armazenável em relação à média histórica de longo prazo. Tende a ser menor que o percentual bruto em períodos de cheias, quando ocorre vertimento."@pt ;
    ons:castExpression "TRY_CAST(ena_armazenavel_ree_percentualmlt AS DOUBLE)" ;
    skos:altLabel "ENA armazenável percentual MLT"@pt ;
    skos:altLabel "ENA armazenável % MLT"@pt ;
    skos:altLabel "percentual MLT armazenável"@pt ;
    skos:altLabel "afluência armazenável relativa"@pt ;
    skos:altLabel "ENA armazenável normalizada"@pt ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent_mlt> .

<https://w3id.org/tiago-ons/data/metric/ena_diario_por_ree_reservatorio_equivalente_de_energia/ena_bruta_ree_mwmed>
    a ons:Metric ;
    skos:prefLabel "Energia Natural Afluente Bruta REE"@pt ;
    skos:altLabel "ENA bruta"@pt ;
    skos:altLabel "energia natural afluente bruta"@pt ;
    skos:altLabel "ENA bruta MWmed"@pt ;
    skos:altLabel "afluencia bruta"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ena_diario_por_ree_reservatorio_equivalente_de_energia/ena_bruta_ree_mwmed> ;
    ons:expression "ena_bruta_ree_mwmed" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(ena_bruta_ree_mwmed AS DOUBLE)) * 24.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_ree_mwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(ena_bruta_ree_mwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_ree_mwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(ena_bruta_ree_mwmed AS DOUBLE)) * 24.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(ena_bruta_ree_mwmed AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

<https://w3id.org/tiago-ons/data/metric/ena_diario_por_ree_reservatorio_equivalente_de_energia/ena_bruta_ree_percentualmlt>
    a ons:Metric ;
    skos:prefLabel "ENA Bruta REE % MLT"@pt ;
