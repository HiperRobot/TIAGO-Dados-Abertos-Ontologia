<https://w3id.org/tiago-ons/data/column/geracao_itaipu/val_itaipu_total>
    a ons:Column ;
    dct:title "val_itaipu_total" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Geração total da UHE Itaipu Binacional no instante horário, somando os setores de 60 Hz e 50 Hz. Representa a potência bruta gerada pela usina antes da segregação por frequência ou país beneficiário. Pode assumir valor zero em períodos de parada total da usina."@pt ;
    skos:altLabel "geração total itaipu"@pt ;
    skos:altLabel "total itaipu"@pt ;
    skos:altLabel "potência total"@pt ;
    skos:altLabel "val_itaipu_total"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> .

<https://w3id.org/tiago-ons/data/column/geracao_itaipu/val_itaipu_60hz>
    a ons:Column ;
    dct:title "val_itaipu_60hz" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Geração da UHE Itaipu Binacional no setor de 60 Hz, destinada ao Sistema Interligado Nacional (SIN) brasileiro. Corresponde às unidades geradoras conectadas à rede de 60 Hz, cujo fornecimento é integralmente direcionado ao Brasil. Pode assumir valor zero em paradas parciais do setor."@pt ;
    skos:altLabel "itaipu 60hz"@pt ;
    skos:altLabel "setor 60hz"@pt ;
    skos:altLabel "geração 60hz"@pt ;
    skos:altLabel "val_itaipu_60hz"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> .

<https://w3id.org/tiago-ons/data/column/geracao_itaipu/val_itaipu_50hz>
    a ons:Column ;
    dct:title "val_itaipu_50hz" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Geração da UHE Itaipu Binacional no setor de 50 Hz, compartilhada entre Brasil e Paraguai conforme o Tratado de Itaipu. A parcela destinada ao Brasil neste setor é registrada separadamente em val_itaipu_50hz_br. Pode assumir valor zero em paradas parciais do setor."@pt ;
    skos:altLabel "itaipu 50hz"@pt ;
    skos:altLabel "setor 50hz"@pt ;
    skos:altLabel "geração 50hz"@pt ;
    skos:altLabel "val_itaipu_50hz"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> .

<https://w3id.org/tiago-ons/data/column/geracao_itaipu/val_itaipu_50hz_br>
    a ons:Column ;
    dct:title "val_itaipu_50hz_br" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Parcela da geração do setor de 50 Hz da UHE Itaipu Binacional destinada ao Brasil. Representa a energia cedida pelo Paraguai ao Brasil no setor de 50 Hz, conforme acordos binacionais. Apresenta mínimo histórico de 2,05 MW, indicando geração mínima garantida ao Brasil neste setor — nunca assume valor zero."@pt ;
    skos:altLabel "itaipu 50hz brasil"@pt ;
    skos:altLabel "cessão paraguai brasil"@pt ;
    skos:altLabel "50hz br"@pt ;
    skos:altLabel "val_itaipu_50hz_br"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> .

<https://w3id.org/tiago-ons/data/column/geracao_itaipu/val_itaipu_br>
    a ons:Column ;
    dct:title "val_itaipu_br" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Geração total da UHE Itaipu Binacional destinada ao Brasil, somando a geração do setor de 60 Hz (integralmente brasileira) e a parcela do setor de 50 Hz cedida pelo Paraguai ao Brasil (val_itaipu_50hz_br). Representa a contribuição efetiva de Itaipu ao Sistema Interligado Nacional. Mínimo histórico de 13,28 MW."@pt ;
    skos:altLabel "itaipu brasil"@pt ;
    skos:altLabel "geração itaipu brasil"@pt ;
    skos:altLabel "contribuição itaipu SIN"@pt ;
    skos:altLabel "val_itaipu_br"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> .

<https://w3id.org/tiago-ons/data/metric/geracao_itaipu/itaipu_total>
    a ons:Metric ;
    skos:prefLabel "Itaipu Total"@pt ;
    skos:altLabel "geração total itaipu"@pt ;
    skos:altLabel "total itaipu"@pt ;
    skos:altLabel "potência total"@pt ;
    skos:altLabel "val_itaipu_total"@pt ;
    skos:altLabel "geracao binacional total"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/geracao_itaipu/val_itaipu_total> ;
    ons:expression "val_itaipu_total" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "1.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM(val_itaipu_total) * 1.0\", \"unit\": \"MWh\"}, \"average_power\": {\"sql\": \"AVG(val_itaipu_total)\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(val_itaipu_total)\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(val_itaipu_total)\", \"unit\": \"MWmed\"}, \"comparison\": {\"sql\": \"AVG(val_itaipu_total)\", \"unit\": \"MWmed\"}}" .

