<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_fgeracao_uge_anual/pattern_disponibilidade_media_por_tipo_ano>
    a ons:QueryTemplate ;
    skos:prefLabel "disponibilidade_media_por_tipo_ano" ;
    ons:sqlTemplate "SELECT din_ano, id_tipousina,\n  AVG(val_dispf) AS dispf_media_pct,\n  AVG(val_indispff) AS indispff_media_pct,\n  AVG(val_indisppf) AS indisppf_media_pct\nFROM {source}\nWHERE TRY_CAST(din_ano AS INTEGER) BETWEEN {ano_inicio} AND {ano_fim}\nGROUP BY din_ano, id_tipousina\nORDER BY din_ano, id_tipousina" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_fgeracao_uge_anual/dispf> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_fgeracao_uge_anual/indispff> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_fgeracao_uge_anual/indisppf> .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_fgeracao_uge_anual/pattern_ranking_agente_disponibilidade>
    a ons:QueryTemplate ;
    skos:prefLabel "ranking_agente_disponibilidade" ;
    ons:sqlTemplate "SELECT nom_agenteproprietario,\n  AVG(val_dispf) AS dispf_media_pct,\n  COUNT(DISTINCT ceg || '-' || num_unidadegeradora) AS num_ugs\nFROM {source}\nWHERE TRY_CAST(din_ano AS INTEGER) = {ano}\nGROUP BY nom_agenteproprietario\nORDER BY dispf_media_pct ASC" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_fgeracao_uge_anual/dispf> .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_fgeracao_uge_anual/pattern_dmdff_serie_historica>
    a ons:QueryTemplate ;
    skos:prefLabel "dmdff_serie_historica" ;
    ons:sqlTemplate "SELECT din_ano, id_tipousina,\n  AVG(val_dmdff) AS dmdff_media_h,\n  MAX(val_dmdff) AS dmdff_max_h\nFROM {source}\nWHERE TRY_CAST(din_ano AS INTEGER) BETWEEN {ano_inicio} AND {ano_fim}\nGROUP BY din_ano, id_tipousina\nORDER BY din_ano, id_tipousina" ;
    ons:outputUnitLabel "h" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_fgeracao_uge_anual/dmdff> .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_fgeracao_uge_anual/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT id_tipousina, COUNT(DISTINCT cod_equipamento) AS qtd_unidades, ROUND(AVG(val_dispf), 2) AS dispf_media_pct, ROUND(AVG(val_indispff), 2) AS indispff_media_pct, ROUND(AVG(val_indisppf), 2) AS indisppf_media_pct FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_disponibilidade_fgeracao_uge_an/*.parquet') WHERE din_ano = 2023 GROUP BY id_tipousina ORDER BY dispf_media_pct DESC" ;
    ons:exampleQuestion "Qual foi a disponibilidade forçada média por tipo de usina em 2023, ordenada da maior para a menor?"@pt .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_fgeracao_uge_anual/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT din_ano, id_subsistema, nom_subsistema, ROUND(AVG(val_indispff), 3) AS indispff_media_pct, COUNT(DISTINCT cod_equipamento) AS qtd_unidades FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_disponibilidade_fgeracao_uge_an/*.parquet') WHERE din_ano BETWEEN 2015 AND 2023 AND id_subsistema NOT IN ('SIN') GROUP BY din_ano, id_subsistema, nom_subsistema ORDER BY din_ano, id_subsistema" ;
    ons:exampleQuestion "Como evoluiu a indisponibilidade forçada média das unidades geradoras por subsistema entre 2015 e 2023?"@pt .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_fgeracao_uge_anual/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT cod_equipamento, nom_unidadegeradora, id_tipousina, nom_agenteproprietario, id_subsistema, val_potencia, val_tdff, val_fdff, val_dmdff, val_indispff FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind_disponibilidade_fgeracao_uge_an/*.parquet') WHERE din_ano = 2022 AND val_tdff <= 8760 ORDER BY val_tdff DESC LIMIT 20" ;
    ons:exampleQuestion "Quais unidades geradoras acumularam mais horas de falhas forçadas em 2022?"@pt .

<https://w3id.org/tiago-ons/data/dataset/ind_disponibilidade_fgeracao_uge_mensal>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:ind_disponibilidade_fgeracao_uge_mensal" ;
    dct:title "ind_disponibilidade_fgeracao_uge_mensal" ;
    owl:versionInfo "1.1.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/geracao> ;
    dcat:keyword "ANEEL"@pt ;
    dcat:keyword "DISPF"@pt ;
    dcat:keyword "DMDFF"@pt ;
    dcat:keyword "FDFF"@pt ;
    dcat:keyword "INDISPFF"@pt ;
    dcat:keyword "INDISPPF"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "TDFF"@pt ;
    dcat:keyword "confiabilidade"@pt ;
    dcat:keyword "desempenho-mensal"@pt ;
    dcat:keyword "disponibilidade"@pt ;
    dcat:keyword "falhas-forcadas"@pt ;
    dcat:keyword "geracao"@pt ;
    dcat:keyword "indisponibilidade"@pt ;
    dcat:keyword "manutencao-programada"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dcat:keyword "submodulo-9-2"@pt ;
    dcat:keyword "unidade-geradora"@pt ;
    dct:description "Suportar o monitoramento regulatório e operacional da confiabilidade do parque gerador brasileiro em base mensal, permitindo que agentes do setor elétrico, reguladores (ANEEL) e o próprio ONS avaliem o desempenho histórico de cada unidade geradora, identifiquem padrões de indisponibilidade forçada e programada, subsidiem decisões de planejamento da operação e manutenção, e cumpram obrigações regulatórias de reporte de confiabilidade conforme o Submódulo 9.2 dos Procedimentos de Rede. Analistas de confiabilidade, engenheiros de manutenção e gestores de ativos de geração utilizam este dataset para benchmarking de desempenho entre usinas, identificação de unidades geradoras com alta taxa de falhas forçadas e planejamento de intervenções de manutenção em base mensal."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver indicadores mensais de desempenho de unidades geradoras como disponibilidade (DISPF), indisponibilidade programada (INDISPPF) ou forçada (INDISPFF), frequência de desligamentos forçados (FDFF), duração média de falhas forçadas (DMDFF), taxa de desligamento forçado (TDFF), ou confiabilidade do parque gerador brasileiro em base mensal por unidade geradora."@pt ;
    ons:limitation "A granularidade temporal é mensal, com chave natural (dat_mesreferencia, cod_equipamento). A coluna nom_estado apresenta nulos em parte dos registros. Os dados fazem parte de processo de consistência recorrente e podem ser atualizados após publicação. Valores de val_tdff podem atingir magnitudes elevadas que requerem validação contra a metodologia do Submódulo 9.2."@pt ;
    dct:source <https://dados.ons.org.br/dataset/ind_disponibilidade_fgeracao_uge_mensal> ;
    ons:freshness "P1D — Diariamento, as 12h e 19h"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/ind_disponibilidade_fgeracao_uge_me/*.parquet" ;
    skos:altLabel "disponibilidade mensal das unidades geradoras"@pt ;
    skos:altLabel "indisponibilidade das maquinas por mes"@pt ;
    skos:altLabel "falhas forcadas das unidades geradoras mensais"@pt ;
    skos:altLabel "disponibilidade por unidade geradora mensal"@pt ;
    skos:altLabel "indisponibilidade forcada por maquina mes"@pt ;
    skos:altLabel "taxa de falha mensal por ug"@pt ;
    skos:altLabel "confiabilidade das turbinas mensal"@pt ;
    skos:altLabel "tempo parado por falha na usina mes"@pt ;
    skos:altLabel "fator disponibilidade mensal por equipamento"@pt ;
    skos:altLabel "desempenho das unidades geradoras por agente mensal"@pt ;
    skos:altLabel "frequencia desligamento forcado por ug mes"@pt ;
    skos:altLabel "duracao media falha mensal ug"@pt ;
    ons:exampleQuestion "Quais usinas hidrelétricas tiveram maior fator de indisponibilidade forçada em janeiro de 2024?"@pt ;
    ons:exampleQuestion "Qual a evolução mensal do fator de disponibilidade médio das termelétricas do subsistema Nordeste em 2023?"@pt ;
    ons:exampleQuestion "Quais unidades geradoras apresentaram maior duração média de desligamento forçado nos últimos 12 meses?"@pt ;
    ons:exampleQuestion "Como se compara a disponibilidade mensal média de usinas nucleares versus hidrelétricas por subsistema?"@pt ;
    ons:exampleQuestion "Quais agentes proprietários têm as unidades geradoras com maior frequência de desligamentos forçados no último trimestre disponível?"@pt ;
    ons:retrievalContext "Indicadores mensais de disponibilidade, indisponibilidade programada e forçada de unidades geradoras individuais (UHE, UTE, UTN), com fatores DISPF, INDISPPF, INDISPFF, duração média (DMDFF), frequência (FDFF) e taxa de desligamentos forçados (TDFF), agregados por unidade geradora em base mensal. Permite benchmarking de confiabilidade entre máquinas, identificação de unidades com alta taxa de falhas, análise de desempenho por agente proprietário, subsistema ou tipo de geração, e monitoramento de tendências mensais de confiabilidade do parque gerador brasileiro conforme Submódulo 9.2 dos Procedimentos de Rede."@pt ;
    ons:agentInstruction "- [dat_mesreferencia] A chave natural do dataset é (dat_mesreferencia, cod_equipamento). Sempre filtrar por ambas as colunas para garantir unicidade de registros por unidade geradora e mês.\n\n- [nom_estado] A coluna nom_estado apresenta nulos em parte dos registros. Filtros ou agregações por estado devem usar COALESCE ou tratar nulos explicitamente para evitar perda de registros.\n\n- [val_dispf] Verificar consistência entre val_dispf, val_indisppf e val_indispff: a soma dos três indicadores deve ser aproximadamente 100%. Desvios significativos podem indicar sobreposição de eventos ou erro de apuração conforme Submódulo 9.2.\n\n- [val_indisppf] Valores de val_indisppf próximos a 100% indicam unidade geradora com quase todo o tempo em manutenção programada no mês, podendo representar unidades em reforma completa ou dados inconsistentes.\n\n- [val_indispff] Valores de val_indispff próximos a 100% indicam unidade geradora com quase todo o tempo em indisponibilidade forçada no mês, situação extrema que pode indicar unidade desativada ou erro de dados.\n\n- [val_dmdff] Valores elevados de val_dmdff (acima de 720 horas ou 30 dias) merecem validação para distinguir falhas forçadas de manutenções programadas mal classificadas conforme Submódulo 9.2.\n\n- [val_fdff] O valor de val_fdff tem unidade de medida não explicitamente documentada. Pode representar desligamentos por hora de operação ou outra métrica. Requer confirmação da unidade com a metodologia do Submódulo 9.2 para uso correto em análises comparativas.\n\n- [val_tdff] Valores muito elevados de val_tdff podem indicar acumulação de horas de desligamento forçado; interpretar conforme a metodologia do Submódulo 9.2.\n\n- [num_unidadegeradora] A coluna num_unidadegeradora é armazenada como VARCHAR, podendo conter valores com formatação especial. Ordenações e comparações numéricas requerem CAST explícito para evitar ordenação lexicográfica incorreta.\n\n- [geral] Os dados fazem parte de processo de consistência recorrente do ONS e podem ser atualizados após publicação. Análises históricas devem considerar possíveis reprocessamentos que alterem valores passados.\n"@pt ;
    dct:accrualPeriodicity "mensal" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/ind_disponibilidade_fgeracao_uge_me/*.parquet', union_by_name=true)" ;
