<https://w3id.org/tiago-ons/data/column/balanco_energia_subsistema/id_subsistema>
    a ons:Column ;
    dct:title "id_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificador alfanumérico do subsistema elétrico do SIN. Valores possíveis: SE (Sudeste/Centro-Oeste), S (Sul), NE (Nordeste), N (Norte) e SIN (linha AGREGADA oficial = soma exata dos 4 subsistemas, presente em todos os anos). CUIDADO: somar sem filtrar esta coluna DOBRA o total — use = 'SIN' para o total oficial ou <> 'SIN' para abrir por subsistema. Compõe a chave primária natural junto com din_instante."@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "id subsistema"@pt ;
    skos:altLabel "código do subsistema"@pt ;
    skos:altLabel "sigla subsistema"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "N" ;
    ons:allowedValue "NE" ;
    ons:allowedValue "S" ;
    ons:allowedValue "SE" ;
    ons:allowedValue "SIN" .

