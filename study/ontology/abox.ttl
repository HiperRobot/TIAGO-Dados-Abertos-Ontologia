    skos:altLabel "vazão vertida não turbinável"@pt ;
    skos:altLabel "perda por vertimento"@pt ;
    skos:altLabel "spill não turbinável"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/dados_hidrologicos_ho/val_vazaovertidanaoturbinavel> ;
    ons:expression "val_vazaovertidanaoturbinavel" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/flow> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/m3_per_s> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/avg> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "1.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(val_vazaovertidanaoturbinavel)\", \"unit\": \"m³/s\"}, \"peak\": {\"sql\": \"MAX(val_vazaovertidanaoturbinavel)\", \"unit\": \"m³/s\"}, \"minimum\": {\"sql\": \"MIN(val_vazaovertidanaoturbinavel)\", \"unit\": \"m³/s\"}, \"time_series\": {\"sql\": \"AVG(val_vazaovertidanaoturbinavel)\", \"unit\": \"m³/s\"}, \"ranking\": {\"sql\": \"AVG(val_vazaovertidanaoturbinavel)\", \"unit\": \"m³/s\"}, \"comparison\": {\"sql\": \"AVG(val_vazaovertidanaoturbinavel)\", \"unit\": \"m³/s\"}}" .

