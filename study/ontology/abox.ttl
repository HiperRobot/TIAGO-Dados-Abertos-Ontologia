    skos:altLabel "indice de disponibilidade"@pt ;
    skos:altLabel "disponibilidade da funcao transmissao"@pt ;
    skos:altLabel "percentual de disponibilidade"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_trlt/val_disp> ;
    ons:expression "val_disp" ;
