<https://w3id.org/tiago-ons/data/column/taxa_teif_teip/din_mes>
    a ons:Column ;
    dct:title "din_mes" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data de referência mensal da taxa de indisponibilidade, sempre no primeiro dia do mês (ex: 2021-04-01 representa abril/2021). Cobre os últimos 60 meses conforme política de publicação ONS."@pt ;
    skos:altLabel "mês"@pt ;
    skos:altLabel "mês de referência"@pt ;
    skos:altLabel "período"@pt ;
    skos:altLabel "competência"@pt ;
    skos:altLabel "data de referência"@pt ;
    skos:altLabel "mês de apuração"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/taxa_teif_teip/nom_taxa>
    a ons:Column ;
    dct:title "nom_taxa" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome do indicador de indisponibilidade apurado. Distingue os dois tipos de taxa na mesma tabela em formato long/unpivot — TEIFa (Taxa Equivalente de Indisponibilidade Forçada ajustada) ou TEIP (Taxa de Indisponibilidade Programada)."@pt ;
    skos:altLabel "taxa"@pt ;
    skos:altLabel "tipo de taxa"@pt ;
    skos:altLabel "indicador"@pt ;
    skos:altLabel "nome do indicador"@pt ;
