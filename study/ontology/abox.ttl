<https://w3id.org/tiago-ons/data/template/capacidade_transformacao/pattern_capacidade_total_por_subsistema>
    a ons:QueryTemplate ;
    skos:prefLabel "capacidade_total_por_subsistema" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_subsistema,\n  COUNT(*) AS qtd_transformadores,\n  SUM(val_potencianominal_mva) AS total_mva\nFROM {source}\nWHERE dat_desativacao IS NULL\n  OR TRY_CAST(dat_desativacao AS DATE) > CURRENT_DATE\nGROUP BY id_subsistema, nom_subsistema\nORDER BY total_mva DESC" ;
    ons:outputUnitLabel "MVA" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/capacidade_transformacao/potencianominal_mva> .

<https://w3id.org/tiago-ons/data/template/capacidade_transformacao/pattern_transformadores_ativos>
    a ons:QueryTemplate ;
    skos:prefLabel "transformadores_ativos" ;
    ons:sqlTemplate "SELECT *\nFROM {source}\nWHERE dat_desativacao IS NULL\n  OR TRY_CAST(dat_desativacao AS DATE) > CURRENT_DATE\nORDER BY nom_subestacao, nom_transformador" .

<https://w3id.org/tiago-ons/data/template/capacidade_transformacao/pattern_capacidade_por_subestacao>
    a ons:QueryTemplate ;
    skos:prefLabel "capacidade_por_subestacao" ;
    ons:sqlTemplate "SELECT nom_subestacao, nom_agenteproprietario, id_subsistema,\n  COUNT(*) AS qtd_transformadores,\n  SUM(val_potencianominal_mva) AS total_mva\nFROM {source}\nWHERE dat_desativacao IS NULL\n  OR TRY_CAST(dat_desativacao AS DATE) > CURRENT_DATE\nGROUP BY nom_subestacao, nom_agenteproprietario, id_subsistema\nORDER BY total_mva DESC" ;
    ons:outputUnitLabel "MVA" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/capacidade_transformacao/potencianominal_mva> .

<https://w3id.org/tiago-ons/data/template/capacidade_transformacao/pattern_transformadores_tres_enrolamentos>
    a ons:QueryTemplate ;
    skos:prefLabel "transformadores_tres_enrolamentos" ;
    ons:sqlTemplate "SELECT nom_subestacao, nom_transformador, nom_agenteproprietario,\n  val_tensaoprimario_kv, val_tensaosecundario_kv, val_tensaoterciario_kv,\n  val_potencianominal_mva\nFROM {source}\nWHERE nom_tipotransformador = 'TRANSFORMADOR DE 3 TERMINAIS'\n  AND (dat_desativacao IS NULL OR TRY_CAST(dat_desativacao AS DATE) > CURRENT_DATE)\nORDER BY val_potencianominal_mva DESC" ;
    ons:outputUnitLabel "MVA" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/capacidade_transformacao/potencianominal_mva> .

<https://w3id.org/tiago-ons/data/template/capacidade_transformacao/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_subsistema, COUNT(*) AS qtd_transformadores, ROUND(SUM(val_potencianominal_mva), 2) AS potencia_total_mva, ROUND(AVG(val_potencianominal_mva), 2) AS potencia_media_mva FROM read_parquet('s3://ons-aws-prod-opendata/dataset/capacidade-transformacao/*.parquet') GROUP BY id_subsistema, nom_subsistema ORDER BY potencia_total_mva DESC" ;
    ons:exampleQuestion "Qual é a capacidade total de transformação instalada em cada subsistema elétrico do SIN?"@pt .

<https://w3id.org/tiago-ons/data/template/capacidade_transformacao/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT nom_subestacao, nom_subsistema, nom_estado, COUNT(*) AS qtd_transformadores, ROUND(SUM(val_potencianominal_mva), 2) AS potencia_total_mva FROM read_parquet('s3://ons-aws-prod-opendata/dataset/capacidade-transformacao/*.parquet') GROUP BY nom_subestacao, nom_subsistema, nom_estado ORDER BY potencia_total_mva DESC LIMIT 20" ;
    ons:exampleQuestion "Quais são as subestações com maior capacidade total de transformação instalada na rede básica?"@pt .

<https://w3id.org/tiago-ons/data/template/capacidade_transformacao/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT nom_agenteproprietario, COUNT(*) AS qtd_transformadores, ROUND(SUM(val_potencianominal_mva), 2) AS potencia_total_mva, ROUND(100.0 * SUM(val_potencianominal_mva) / SUM(SUM(val_potencianominal_mva)) OVER (), 2) AS participacao_pct FROM read_parquet('s3://ons-aws-prod-opendata/dataset/capacidade-transformacao/*.parquet') GROUP BY nom_agenteproprietario ORDER BY potencia_total_mva DESC" ;
    ons:exampleQuestion "Qual é a participação de cada agente de transmissão na capacidade de transformação da rede básica?"@pt .

<https://w3id.org/tiago-ons/data/dataset/carga_energia>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:carga-energia" ;
    dct:title "carga-energia" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/carga> ;
    dcat:keyword "MWmed"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "carga SIN"@pt ;
    dcat:keyword "carga elétrica diária"@pt ;
    dcat:keyword "carga energia diária"@pt ;
    dcat:keyword "carga energia subsistema"@pt ;
    dcat:keyword "carga-energia"@pt ;
    dcat:keyword "consumo energia SIN"@pt ;
    dcat:keyword "demanda energia subsistema"@pt ;
    dcat:keyword "demanda-energia"@pt ;
    dcat:keyword "diario"@pt ;
    dcat:keyword "operacao-sistema"@pt ;
    dcat:keyword "planejamento-energetico"@pt ;
    dcat:keyword "serie-temporal"@pt ;
    dcat:keyword "subsistema-eletrico"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Prover série temporal de demanda diária de energia por subsistema elétrico para operadores do ONS, planejadores energéticos e agentes do setor elétrico, permitindo monitorar a evolução da carga, subsidiar o despacho de usinas, apoiar decisões de planejamento operacional e expansão do sistema, e avaliar tendências sazonais e estruturais de consumo no SIN ao longo de mais de duas décadas."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver demanda, consumo ou carga de energia elétrica agregada por subsistema (SE/CO, Sul, Nordeste, Norte ou SIN) em granularidade diária."@pt ;
    ons:limitation "A coluna val_cargaenergiamwmed tem poucos valores ausentes, e eles vêm como string vazia, não como NULL — um filtro IS NOT NULL não os exclui. O dataset carga-energia é publicado duas vezes ao dia (12h e 19h), podendo gerar múltiplos registros para a mesma data e subsistema. Possíveis lacunas temporais na série diária por subsistema ao longo de ~26 anos de dados do dataset carga-energia."@pt ;
    dct:source <https://dados.ons.org.br/dataset/carga-energia> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/carga_energia_di/*.parquet" ;
    skos:altLabel "consumo de energia"@pt ;
    skos:altLabel "consumo eletrico"@pt ;
    skos:altLabel "consumo de eletricidade"@pt ;
    skos:altLabel "consumo residencial"@pt ;
    skos:altLabel "consumo industrial"@pt ;
    skos:altLabel "demanda de energia"@pt ;
    skos:altLabel "quanto o brasil consumiu por dia"@pt ;
    skos:altLabel "consumo diario por subsistema"@pt ;
    skos:altLabel "carga diaria do sin"@pt ;
    skos:altLabel "quanta energia foi consumida no dia"@pt ;
    skos:altLabel "demanda diaria por regiao"@pt ;
    ons:exampleQuestion "Qual foi a carga de energia do subsistema Sudeste em janeiro de 2024?"@pt ;
    ons:exampleQuestion "Como evoluiu a demanda de energia no subsistema Nordeste nos últimos 5 anos?"@pt ;
    ons:exampleQuestion "Qual subsistema apresentou maior crescimento de carga entre 2015 e 2025?"@pt ;
    ons:exampleQuestion "Qual foi o pico de carga do SIN em 2023 e em qual data ocorreu?"@pt ;
    ons:exampleQuestion "Como a carga do subsistema Sul varia sazonalmente ao longo do ano?"@pt ;
    ons:exampleQuestion "Qual foi a carga média do SIN em julho de 2025?"@pt ;
    ons:exampleQuestion "Que subsistema teve menor carga em dezembro de 2024?"@pt ;
    ons:exampleQuestion "Como tá a carga do SE agora?"@pt ;
    ons:exampleQuestion "Tem dados de carga do Norte em agosto de 2022?"@pt ;
    ons:exampleQuestion "A carga do Sul ta crescendo ou caindo desde 2020?"@pt ;
    ons:exampleQuestion "Qual a carga do Norte em janeiro de 2026?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver demanda, consumo ou carga de energia elétrica agregada por subsistema (SE/CO, Sul, Nordeste, Norte ou SIN) em granularidade diária. Também relevante para análises de tendência histórica de consumo, sazonalidade da demanda, picos de carga e balanço energético regional no horizonte de 2000 em diante."@pt ;
    ons:agentInstruction "- [val_cargaenergiamwmed] Poucos valores ausentes, e vêm como string vazia, não como NULL — um filtro IS NOT NULL não os exclui. Use val_cargaenergiamwmed != '' ou NULLIF. Podem indicar falhas de telemetria, dias sem apuração ou períodos de transição metodológica.\n\n- [id_subsistema] Verificar se existem registros duplicados para a mesma combinação de din_instante e id_subsistema, o que violaria a chave primária natural do dataset. Duplicatas podem ocorrer por reprocessamento ou publicação dupla nos snapshots de 12h e 19h declarados na frequência de atualização.\n\n- [nom_subsistema] Verificar se o nome do subsistema apresenta variações de grafia ao longo do histórico (ex: \"Sudeste\" vs \"Sudeste/Centro-Oeste\", maiúsculas/minúsculas, acentuação), especialmente em períodos de transição metodológica ou reestruturação do SIN. Inconsistências podem causar erros em agrupamentos por nome.\n\n- [tipos] As colunas `val_cargaenergiamwmed` mudam de tipo entre arquivos anuais (texto em uns, número em outros); cada uma traz `castExpression` no schema: use-o em toda agregação e comparação.\n"@pt ;
    dct:accrualPeriodicity "diária" ;
