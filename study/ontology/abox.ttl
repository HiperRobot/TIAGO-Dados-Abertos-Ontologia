<https://w3id.org/tiago-ons/data/template/geracao_usina_2/pattern_geracao_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "geracao_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, id_subsistema,\n  SUM((TRY_CAST(val_geracao AS DOUBLE)) * 1.0) / 1000 AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_usina_2/geracao> .

<https://w3id.org/tiago-ons/data/template/geracao_usina_2/pattern_geracao_por_combustivel>
    a ons:QueryTemplate ;
    skos:prefLabel "geracao_por_combustivel" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  nom_tipocombustivel,\n  SUM((TRY_CAST(val_geracao AS DOUBLE)) * 1.0) / 1000 AS valor_gwh\nFROM {source}\nWHERE din_instante BETWEEN '{start_date}' AND '{end_date}'\n  AND nom_tipocombustivel IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_usina_2/geracao> .

<https://w3id.org/tiago-ons/data/template/geracao_usina_2/pattern_ranking_usinas>
    a ons:QueryTemplate ;
    skos:prefLabel "ranking_usinas" ;
    ons:sqlTemplate "SELECT nom_usina, nom_tipousina, nom_tipocombustivel, id_subsistema,\n  SUM((TRY_CAST(val_geracao AS DOUBLE)) * 1.0) / 1000 AS total_gwh\nFROM {source}\nWHERE din_instante BETWEEN '{start_date}' AND '{end_date}'\n  AND TRY_CAST(val_geracao AS DOUBLE) > 0\nGROUP BY 1, 2, 3, 4\nORDER BY total_gwh DESC\nLIMIT {top_n}" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_usina_2/geracao> .

<https://w3id.org/tiago-ons/data/template/geracao_usina_2/pattern_geracao_negativa_bombeamento>
    a ons:QueryTemplate ;
    skos:prefLabel "geracao_negativa_bombeamento" ;
    ons:sqlTemplate "SELECT nom_usina, din_instante,\n  TRY_CAST(val_geracao AS DOUBLE) AS geracao_mw\nFROM {source}\nWHERE TRY_CAST(val_geracao AS DOUBLE) < 0\nORDER BY geracao_mw ASC" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_usina_2/geracao> .

<https://w3id.org/tiago-ons/data/template/geracao_usina_2/pattern_geracao_usina_2_mensal_gwh>
    a ons:QueryTemplate ;
    skos:prefLabel "geracao_usina_2_mensal_gwh" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_geracao AS VARCHAR) AS DOUBLE)) * 1.0 / 1000, 1) AS val_geracao_gwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "GWh" .

<https://w3id.org/tiago-ons/data/template/geracao_usina_2/pattern_geracao_usina_2_mensal_mwmed>
    a ons:QueryTemplate ;
    skos:prefLabel "geracao_usina_2_mensal_mwmed" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_geracao AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS val_geracao_mwmed\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "MWmed" .

<https://w3id.org/tiago-ons/data/template/geracao_usina_2/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT din_instante, nom_tipousina, SUM((TRY_CAST(val_geracao AS DOUBLE)) * 1.0) / 1000 AS geracao_total_mwmed FROM read_parquet('s3://ons-aws-prod-opendata/dataset/geracao_usina_2_ho/*.parquet') WHERE id_subsistema = 'SE' AND din_instante >= TIMESTAMP '2024-01-01 00:00:00' AND din_instante < TIMESTAMP '2024-02-01 00:00:00' GROUP BY din_instante, nom_tipousina ORDER BY din_instante, nom_tipousina LIMIT 1000;" ;
    ons:exampleQuestion "Qual foi a geração total por tipo de usina no subsistema Sudeste em janeiro de 2024, hora a hora?"@pt .

<https://w3id.org/tiago-ons/data/template/geracao_usina_2/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT id_ons, nom_usina, nom_tipousina, id_subsistema, AVG(TRY_CAST(val_geracao AS DOUBLE)) AS geracao_media_mwmed, SUM(TRY_CAST(val_geracao AS DOUBLE)) AS geracao_total_mwmed, COUNT(*) AS horas_operacao FROM read_parquet('s3://ons-aws-prod-opendata/dataset/geracao_usina_2_ho/*.parquet') WHERE din_instante >= TIMESTAMP '2023-01-01 00:00:00' AND din_instante < TIMESTAMP '2024-01-01 00:00:00' AND TRY_CAST(val_geracao AS DOUBLE) > 0 GROUP BY id_ons, nom_usina, nom_tipousina, id_subsistema ORDER BY geracao_media_mwmed DESC LIMIT 20;" ;
    ons:exampleQuestion "Quais foram as 20 usinas com maior geração média horária em 2023?"@pt .

<https://w3id.org/tiago-ons/data/template/geracao_usina_2/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "WITH geracao_mensal AS ( SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, nom_tipousina, SUM((TRY_CAST(val_geracao AS DOUBLE)) * 1.0) / 1000 AS geracao_total FROM read_parquet('s3://ons-aws-prod-opendata/dataset/geracao_usina_2_ho/*.parquet') WHERE id_subsistema = 'NE' AND din_instante >= TIMESTAMP '2020-01-01 00:00:00' AND din_instante < TIMESTAMP '2025-01-01 00:00:00' AND TRY_CAST(val_geracao AS DOUBLE) > 0 GROUP BY DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)), nom_tipousina ), total_mensal AS ( SELECT mes, SUM(geracao_total) AS total_subsistema FROM geracao_mensal GROUP BY mes ) SELECT g.mes, g.nom_tipousina, g.geracao_total, t.total_subsistema, ROUND(100.0 * g.geracao_total / t.total_subsistema, 2) AS participacao_pct FROM geracao_mensal AS g JOIN total_mensal AS t ON g.mes = t.mes WHERE g.nom_tipousina = 'Eólica' ORDER BY g.mes;" ;
    ons:exampleQuestion "Como evoluiu a participação percentual da geração eólica no total gerado pelo subsistema Nordeste entre 2020 e 2024?"@pt .

<https://w3id.org/tiago-ons/data/dataset/geracao_itaipu>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:geracao_itaipu" ;
    dct:title "geracao_itaipu" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/geracao> ;
    dcat:keyword "50hz"@pt ;
    dcat:keyword "60hz"@pt ;
    dcat:keyword "Itaipu"@pt ;
    dcat:keyword "Itaipu 60Hz"@pt ;
    dcat:keyword "Itaipu Binacional"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "UHE Itaipu"@pt ;
    dcat:keyword "binacional"@pt ;
    dcat:keyword "brasil"@pt ;
    dcat:keyword "geração Itaipu"@pt ;
    dcat:keyword "geração hidrelétrica"@pt ;
    dcat:keyword "itaipu"@pt ;
    dcat:keyword "paraguai"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Monitorar a contribuição horária da UHE Itaipu Binacional ao Sistema Interligado Nacional (SIN), suportando operadores do ONS no despacho de geração, analistas de planejamento energético na avaliação da participação de Itaipu na matriz elétrica brasileira, e pesquisadores na análise do cumprimento dos acordos binacionais Brasil-Paraguai. Permite calcular índices de atendimento à carga, avaliar complementaridade com outras fontes e subsidiar decisões de intercâmbio de energia."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver geração de energia da UHE Itaipu Binacional, contribuição de Itaipu ao SIN, divisão de energia entre Brasil e Paraguai, ou análise dos setores de frequência 60 Hz e 50 Hz da usina."@pt ;
    ons:limitation "Valor máximo de 14. Valor máximo de 7. Valor máximo de 8."@pt ;
    dct:source <https://dados.ons.org.br/dataset/geracao_itaipu> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/geracao_itaipu/*.parquet" ;
    skos:altLabel "geracao de itaipu"@pt ;
    skos:altLabel "quanto itaipu gerou"@pt ;
    skos:altLabel "energia da binacional"@pt ;
    skos:altLabel "itaipu 50 hz e 60 hz"@pt ;
    skos:altLabel "elo de corrente continua"@pt ;
    skos:altLabel "hvdc"@pt ;
    skos:altLabel "geracao hvdc"@pt ;
    ons:exampleQuestion "Qual foi a geração média horária de Itaipu destinada ao Brasil em 2023?"@pt ;
    ons:exampleQuestion "Qual a participação percentual de Itaipu no total hidrelétrico do SIN por mês?"@pt ;
    ons:exampleQuestion "Em quais horas do dia Itaipu apresenta maior geração no setor de 60 Hz?"@pt ;
    ons:exampleQuestion "Qual foi a geração máxima registrada de Itaipu e em que data ocorreu?"@pt ;
    ons:exampleQuestion "Como evoluiu a cessão de energia do Paraguai ao Brasil (50 Hz) ao longo dos anos?"@pt ;
    ons:exampleQuestion "Qual a geração horária média de Itaipu pro Brasil nesse mês?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver geração de energia da UHE Itaipu Binacional, contribuição de Itaipu ao SIN, divisão de energia entre Brasil e Paraguai, ou análise dos setores de frequência 60 Hz e 50 Hz da usina. Também relevante para perguntas sobre participação de Itaipu na matriz hidrelétrica brasileira em base horária ou avaliação de acordos binacionais de energia."@pt ;
    ons:agentInstruction "- [val_itaipu_total] Máximo de 14.348,863 MW supera a capacidade instalada nominal de Itaipu (~14.000 MW). Registros acima de 14.100 MW devem ser investigados como possíveis erros de medição, sobrecargas transitórias ou arredondamentos do sistema SCADA do ONS.\n\n- [val_itaipu_60hz] Máximo de 7.265,429 MW supera a capacidade nominal do setor de 60 Hz (~7.000 MW, 10 geradores × ~700 MW cada). Registros acima de 7.100 MW devem ser verificados como possíveis sobrecargas ou erros de medição.\n\n- [val_itaipu_50hz] Máximo de 8.872,7 MW supera significativamente a capacidade nominal do setor de 50 Hz (~7.000 MW, 10 geradores × ~700 MW cada). Diferença de ~1.872 MW acima da capacidade nominal é expressiva e pode indicar erros de medição, sobrecargas prolongadas ou inconsistência de contabilização entre os setores.\n\n- [val_itaipu_50hz_br] Mínimo de 2,05 MW nunca atinge zero, mesmo quando val_itaipu_50hz pode ser zero. Isso indica possível geração mínima de serviços auxiliares das estações conversoras ou arredondamento sistemático de medição. Verificar consistência com val_itaipu_50hz em períodos de parada do setor.\n\n- [val_itaipu_br] Mínimo de 13,28 MW nunca atinge zero, sugerindo geração mínima de serviços auxiliares ou arredondamento. Adicionalmente, val_itaipu_br deve ser aproximadamente igual a val_itaipu_60hz + val_itaipu_50hz_br; desvios significativos indicam inconsistência de contabilização.\n\n- [parcela paraguaia] Não existe coluna val_itaipu_py no dado. A parcela do Paraguai é val_itaipu_50hz - val_itaipu_50hz_br; a do Brasil é val_itaipu_br, que fecha exatamente como val_itaipu_60hz + val_itaipu_50hz_br em 100% das linhas. A diferença sai negativa em 0,1% dos registros, ruído de medição: trate valor negativo como zero.\n\n- [din_instante] Serie horaria iniciada em 2000-01-01 e ativa; a cobertura corrente esta em descrever_dataset. Compare a contagem de horas distintas com o intervalo coberto para achar gaps horarios e duplicatas. Verificar ausência de horas e duplicatas na chave primária.\n"@pt ;
    dct:accrualPeriodicity "horária" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/geracao_itaipu/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2000-01-01/" ;
