<https://w3id.org/tiago-ons/data/template/res_volumeespera/pattern_volumeespera_serie_diaria>
    a ons:QueryTemplate ;
    skos:prefLabel "volumeespera_serie_diaria" ;
    ons:sqlTemplate "SELECT\n  CAST(din_instante AS DATE) AS data,\n  nom_reservatorio,\n  AVG(val_volumeespera) AS volume_espera_pct\nFROM {source}\nWHERE nom_reservatorio = '{reservatorio}'\n  AND din_instante BETWEEN '{data_inicio}' AND '{data_fim}'\nGROUP BY 1, 2\nORDER BY 1" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/res_volumeespera/volumeespera> .

<https://w3id.org/tiago-ons/data/template/res_volumeespera/pattern_volumeespera_por_reservatorio_periodo>
    a ons:QueryTemplate ;
    skos:prefLabel "volumeespera_por_reservatorio_periodo" ;
    ons:sqlTemplate "SELECT\n  nom_reservatorio,\n  TRIM(id_subsistema) AS subsistema,\n  TRIM(nom_bacia) AS bacia,\n  AVG(val_volumeespera) AS volume_espera_medio_pct,\n  MAX(val_volumeespera) AS volume_espera_max_pct,\n  MIN(val_volumeespera) AS volume_espera_min_pct\nFROM {source}\nWHERE din_instante BETWEEN '{data_inicio}' AND '{data_fim}'\nGROUP BY 1, 2, 3\nORDER BY 4 DESC" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/res_volumeespera/volumeespera> .

<https://w3id.org/tiago-ons/data/template/res_volumeespera/pattern_volumeespera_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "volumeespera_mensal" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  nom_reservatorio,\n  TRIM(id_subsistema) AS subsistema,\n  AVG(val_volumeespera) AS volume_espera_medio_pct\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1, 2, 3\nORDER BY 1, 2" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/res_volumeespera/volumeespera> .

<https://w3id.org/tiago-ons/data/template/res_volumeespera/pattern_reservatorios_acima_limite>
    a ons:QueryTemplate ;
    skos:prefLabel "reservatorios_acima_limite" ;
    ons:sqlTemplate "SELECT nom_reservatorio, \n       val_volumeesperaperc,\n       TRY_CAST(din_instante AS DATE) AS data\nFROM {source}\nWHERE TRY_CAST(val_volumeesperaperc AS DOUBLE) > 80\nORDER BY val_volumeesperaperc DESC" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/res_volumeespera/volumeespera> .

<https://w3id.org/tiago-ons/data/template/res_volumeespera/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "WITH ultimo_registro AS ( SELECT cod_usina, nom_reservatorio, nom_bacia, nom_ree, id_subsistema, val_volumeespera, din_instante, ROW_NUMBER() OVER (PARTITION BY cod_usina ORDER BY din_instante DESC) AS rn FROM read_parquet('s3://ons-aws-prod-opendata/dataset/res_volumeespera/*.parquet') ) SELECT cod_usina, nom_reservatorio, nom_bacia, nom_ree, id_subsistema, val_volumeespera, CAST(din_instante AS DATE) AS data_referencia FROM ultimo_registro WHERE rn = 1 ORDER BY id_subsistema, nom_bacia, nom_reservatorio" ;
    ons:exampleQuestion "Qual é o volume de espera recomendado mais recente para cada reservatório hidrelétrico?"@pt .

<https://w3id.org/tiago-ons/data/template/res_volumeespera/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT cod_usina, nom_reservatorio, nom_bacia, nom_ree, id_subsistema, ROUND(AVG(val_volumeespera), 2) AS media_vol_espera, MIN(val_volumeespera) AS min_vol_espera, COUNT(*) AS dias_com_restricao FROM read_parquet('s3://ons-aws-prod-opendata/dataset/res_volumeespera/*.parquet') WHERE val_volumeespera < 70.0 AND CAST(din_instante AS DATE) >= CURRENT_DATE - INTERVAL '30' DAY GROUP BY cod_usina, nom_reservatorio, nom_bacia, nom_ree, id_subsistema ORDER BY min_vol_espera ASC" ;
    ons:exampleQuestion "Quais reservatórios têm volume de espera recomendado abaixo de 70% do volume útil no último mês?"@pt .

<https://w3id.org/tiago-ons/data/template/res_volumeespera/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT nom_bacia, DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes_referencia, ROUND(AVG(val_volumeespera), 2) AS media_vol_espera, MIN(val_volumeespera) AS min_vol_espera, MAX(val_volumeespera) AS max_vol_espera, COUNT(DISTINCT cod_usina) AS num_usinas FROM read_parquet('s3://ons-aws-prod-opendata/dataset/res_volumeespera/*.parquet') GROUP BY nom_bacia, DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) ORDER BY nom_bacia, mes_referencia" ;
    ons:exampleQuestion "Como evoluiu o volume de espera médio por bacia hidrográfica ao longo dos anos?"@pt .

<https://w3id.org/tiago-ons/data/dataset/reservatorio>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:reservatorio" ;
    dct:title "reservatorio" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/reservatorio> ;
    dcat:keyword "DECOMP"@pt ;
    dcat:keyword "NEWAVE"@pt ;
    dcat:keyword "REE"@pt ;
    dcat:keyword "cadastro"@pt ;
    dcat:keyword "cadastro de reservatórios"@pt ;
    dcat:keyword "cota operacional"@pt ;
    dcat:keyword "hidrelétrica"@pt ;
    dcat:keyword "posto fluviométrico"@pt ;
    dcat:keyword "produtibilidade"@pt ;
    dcat:keyword "reservatório"@pt ;
    dcat:keyword "reservatório equivalente de energia"@pt ;
    dcat:keyword "reservatório hidrelétrico cadastro"@pt ;
    dcat:keyword "reservatórios ONS"@pt ;
    dcat:keyword "reservatórios hidrelétricos"@pt ;
    dcat:keyword "volume útil"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Prover tabela de referência cadastral para planejadores, operadores e analistas do ONS e agentes do setor elétrico que necessitam dos parâmetros físicos dos reservatórios hidrelétricos do SIN. Suporta decisões de despacho hidrotérmico, cálculo de energia armazenada, modelagem nos sistemas NEWAVE e DECOMP, e estudos de planejamento energético que dependem de cotas, volumes, produtibilidade e localização geográfica dos reservatórios. É utilizado como dimensão de enriquecimento em joins com séries temporais de vazões, energia armazenada e geração hidrelétrica."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver atributos físicos ou operacionais de reservatórios hidrelétricos do SIN, como cotas, volumes, produtibilidade, perdas hidráulicas ou localização geográfica."@pt ;
    ons:limitation "Coluna armazena valores numéricos de cota máxima (metros) como VARCHAR devido ao formato de serialização. Coluna armazena valores numéricos de cota mínima (metros) como VARCHAR devido ao formato de serialização. Coluna armazena valores numéricos de volume máximo (hm³) como VARCHAR devido ao formato de serialização."@pt ;
    dct:source <https://dados.ons.org.br/dataset/reservatorio> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/reservatorio/*.parquet" ;
    skos:altLabel "cadastro dos reservatorios"@pt ;
    skos:altLabel "dados fisicos da represa"@pt ;
    skos:altLabel "cota maxima e minima"@pt ;
    skos:altLabel "caracteristicas do reservatorio"@pt ;
    skos:altLabel "onde fica o reservatorio"@pt ;
    ons:exampleQuestion "Quais são os reservatórios com maior volume útil total no subsistema Sudeste/Centro-Oeste?"@pt ;
    ons:exampleQuestion "Qual a cota máxima e mínima operacional do reservatório de Itaipu?"@pt ;
    ons:exampleQuestion "Quais reservatórios pertencem à bacia do Paraná e ao REE PARANA?"@pt ;
    ons:exampleQuestion "Quais reservatórios não possuem produtibilidade específica cadastrada no sistema ONS?"@pt ;
    ons:exampleQuestion "Qual o volume útil total agregado por subsistema elétrico no SIN?"@pt ;
    ons:exampleQuestion "Me mostra os 10 maiores reservatorios por volume util total"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver atributos físicos ou operacionais de reservatórios hidrelétricos do SIN, como cotas, volumes, produtibilidade, perdas hidráulicas ou localização geográfica. Também recuperar quando for necessário identificar a qual subsistema, bacia, rio ou REE um reservatório pertence, ou quando se precisar de parâmetros de referência para modelos de planejamento energético (NEWAVE, DECOMP) identificados por cod_resplanejamento ou cod_posto."@pt ;
    ons:agentInstruction "- [val_cotamaxima] Coluna numérica (cota máxima em metros) exportada como VARCHAR pelo formato de serialização. Impede agregações diretas (SUM, AVG, MIN, MAX) sem conversão explícita de tipo.\n\n- [val_cotaminima] Coluna numérica (cota mínima em metros) exportada como VARCHAR pelo formato de serialização. Impede agregações diretas sem conversão explícita de tipo.\n\n- [val_volmax] Coluna numérica (volume máximo em hm³) exportada como VARCHAR pelo formato de serialização. Impede cálculos de capacidade total do sistema sem conversão explícita de tipo.\n\n- [val_volmin] Coluna numérica (volume mínimo em hm³) exportada como VARCHAR pelo formato de serialização. Impede cálculos de volume morto e útil sem conversão explícita de tipo.\n\n- [val_volutiltot] Coluna numérica (volume útil total em hm³) exportada como VARCHAR pelo formato de serialização. Impede cálculos de capacidade útil agregada do sistema sem conversão explícita de tipo. É a coluna mais crítica para análises de energia armazenada (EAR%).\n\n- [val_produtibilidadeespecifica] Possui poucos nulos. Reservatórios sem produtibilidade específica cadastrada podem ser fio d'água ou ter dados incompletos.\n\n- [val_produtividade65volutil] Possui poucos nulos. Reservatórios sem produtividade a 65% do volume útil podem impactar modelos de planejamento que utilizam este parâmetro como referência obrigatória.\n\n- [val_perda] Possui poucos nulos. Ausência do percentual de perda hidráulica pode afetar cálculos de energia disponível líquida para esses reservatórios.\n\n- [dat_entrada] Data de entrada em operação armazenada como VARCHAR em vez de DATE. Pode conter formatos variados (YYYY-MM-DD, DD/MM/YYYY) dependendo da origem dos dados. Requer TRY_CAST ou strptime para uso em filtros e ordenações temporais.\n"@pt ;
    dct:accrualPeriodicity "STATIC" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/reservatorio/*.parquet', union_by_name=true)" ;
