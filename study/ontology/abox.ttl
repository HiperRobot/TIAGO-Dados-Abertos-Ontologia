    ons:expression "val_dfp" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/ratio> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/adimensional_indice_0_1> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(val_dfp)\", \"unit\": \"adimensional (indice 0-1)\"}, \"maximum\": {\"sql\": \"MAX(val_dfp)\", \"unit\": \"adimensional (indice 0-1)\"}, \"minimum\": {\"sql\": \"MIN(val_dfp)\", \"unit\": \"adimensional (indice 0-1)\"}, \"time_series\": {\"sql\": \"AVG(val_dfp)\", \"unit\": \"adimensional (indice 0-1)\"}, \"ranking\": {\"sql\": \"AVG(val_dfp)\", \"unit\": \"adimensional (indice 0-1)\"}, \"comparison\": {\"sql\": \"AVG(val_dfp)\", \"unit\": \"adimensional (indice 0-1)\"}}" .

