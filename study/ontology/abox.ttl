<https://w3id.org/tiago-ons/data/template/fator_capacidade_2/pattern_fatorcapacidade_medio_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "fatorcapacidade_medio_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  id_subsistema,\n  nom_tipousina,\n  AVG(TRY_CAST(val_fatorcapacidade AS DOUBLE)) AS fator_capacidade_medio\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1, 2, 3\nORDER BY 1, 2, 3" ;
    ons:outputUnitLabel "p.u." ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/fator_capacidade_2/fatorcapacidade> .

<https://w3id.org/tiago-ons/data/template/fator_capacidade_2/pattern_geracaoverificada_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "geracaoverificada_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  id_subsistema,\n  nom_tipousina,\n  SUM((TRY_CAST(val_geracaoverificada AS DOUBLE)) * 1.0) / 1000 AS energia_gwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1, 2, 3\nORDER BY 1, 2, 3" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/fator_capacidade_2/geracaoverificada> .

<https://w3id.org/tiago-ons/data/template/fator_capacidade_2/pattern_desvio_programado_verificado>
    a ons:QueryTemplate ;
    skos:prefLabel "desvio_programado_verificado" ;
    ons:sqlTemplate "SELECT nom_usina_conjunto,\n  ceg,\n  AVG(TRY_CAST(val_geracaoverificada AS DOUBLE) - TRY_CAST(val_geracaoprogramada AS DOUBLE)) AS desvio_medio_mwmed,\n  AVG(ABS(TRY_CAST(val_geracaoverificada AS DOUBLE) - TRY_CAST(val_geracaoprogramada AS DOUBLE))) AS desvio_absoluto_medio_mwmed\nFROM {source}\nWHERE TRY_CAST(val_geracaoprogramada AS DOUBLE) IS NOT NULL\n  AND TRY_CAST(val_geracaoverificada AS DOUBLE) IS NOT NULL\nGROUP BY 1, 2\nORDER BY desvio_absoluto_medio_mwmed DESC" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/fator_capacidade_2/geracaoverificada> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/fator_capacidade_2/geracaoprogramada> .

<https://w3id.org/tiago-ons/data/template/fator_capacidade_2/pattern_capacidade_instalada_por_subsistema>
    a ons:QueryTemplate ;
    skos:prefLabel "capacidade_instalada_por_subsistema" ;
    ons:sqlTemplate "SELECT id_subsistema,\n  nom_tipousina,\n  SUM(TRY_CAST(val_capacidadeinstalada AS DOUBLE)) AS capacidade_total_mw\nFROM {source}\nWHERE din_instante = ( SELECT MAX(din_instante) FROM {source} )\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/fator_capacidade_2/capacidadeinstalada> .

<https://w3id.org/tiago-ons/data/template/fator_capacidade_2/pattern_geracaoprogramada_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "geracaoprogramada_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, id_subsistema,\n  SUM((TRY_CAST(val_geracaoprogramada AS DOUBLE)) * 1.0) / 1000 AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/fator_capacidade_2/geracaoprogramada> .

<https://w3id.org/tiago-ons/data/template/fator_capacidade_2/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT nom_tipousina, id_subsistema, nom_subsistema, ROUND(AVG(TRY_CAST(val_fatorcapacidade AS DOUBLE)), 4) AS fc_medio, ROUND(MIN(TRY_CAST(val_fatorcapacidade AS DOUBLE)), 4) AS fc_min, ROUND(MAX(TRY_CAST(val_fatorcapacidade AS DOUBLE)), 4) AS fc_max, COUNT(DISTINCT id_ons) AS qtd_usinas FROM read_parquet('s3://ons-aws-prod-opendata/dataset/fator_capacidade_2_di/*.parquet') GROUP BY nom_tipousina, id_subsistema, nom_subsistema ORDER BY nom_tipousina, fc_medio DESC" ;
    ons:exampleQuestion "Qual foi o fator de capacidade médio de usinas eólicas e solares por subsistema no período disponível?"@pt .

<https://w3id.org/tiago-ons/data/template/fator_capacidade_2/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT id_ons, nom_usina_conjunto, nom_tipousina, id_subsistema, ROUND(AVG( ABS( TRY_CAST(val_geracaoverificada AS DOUBLE) - TRY_CAST(val_geracaoprogramada AS DOUBLE) ) ), 2) AS desvio_medio_mw, ROUND(AVG(TRY_CAST(val_geracaoprogramada AS DOUBLE)), 2) AS prog_media_mw, ROUND(AVG(TRY_CAST(val_geracaoverificada AS DOUBLE)), 2) AS verif_media_mw, COUNT(*) AS horas FROM read_parquet('s3://ons-aws-prod-opendata/dataset/fator_capacidade_2_di/*.parquet') GROUP BY id_ons, nom_usina_conjunto, nom_tipousina, id_subsistema ORDER BY desvio_medio_mw DESC LIMIT 20" ;
    ons:exampleQuestion "Quais usinas apresentaram maior desvio absoluto entre geração programada e verificada, indicando possível curtailment ou erro de previsão?"@pt .

<https://w3id.org/tiago-ons/data/template/fator_capacidade_2/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT EXTRACT(HOUR FROM TRY_CAST(din_instante AS TIMESTAMP)) AS hora_do_dia, ROUND(AVG(TRY_CAST(val_fatorcapacidade AS DOUBLE)), 4) AS fc_medio, ROUND(MAX(TRY_CAST(val_fatorcapacidade AS DOUBLE)), 4) AS fc_max, COUNT(*) AS observacoes FROM read_parquet('s3://ons-aws-prod-opendata/dataset/fator_capacidade_2_di/*.parquet') WHERE nom_tipousina = 'Solar Fotovoltaica' GROUP BY EXTRACT(HOUR FROM TRY_CAST(din_instante AS TIMESTAMP)) ORDER BY hora_do_dia" ;
    ons:exampleQuestion "Como o fator de capacidade de usinas solares varia ao longo das horas do dia?"@pt .

<https://w3id.org/tiago-ons/data/dataset/geracao_exportacao_internacional>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:geracao-exportacao-internacional" ;
    dct:title "geracao-exportacao-internacional" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/intercambio> ;
    dcat:keyword "EVT Argentina"@pt ;
    dcat:keyword "EVT Uruguai"@pt ;
    dcat:keyword "argentina"@pt ;
    dcat:keyword "evt"@pt ;
    dcat:keyword "exportacao-internacional"@pt ;
    dcat:keyword "exportação internacional de energia"@pt ;
    dcat:keyword "exportação internacional energia elétrica Argentina Uruguai ONS"@pt ;
    dcat:keyword "geracao-termica"@pt ;
    dcat:keyword "geração para exportação"@pt ;
    dcat:keyword "horario"@pt ;
    dcat:keyword "intercambio-energia"@pt ;
    dcat:keyword "intercâmbio internacional comercial"@pt ;
    dcat:keyword "mwmed"@pt ;
    dcat:keyword "portaria-mme-049-2022"@pt ;
    dcat:keyword "sin"@pt ;
    dcat:keyword "uruguai"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Permitir que agentes do setor elétrico, reguladores, o ONS e a CCEE monitorem e contabilizem os intercâmbios internacionais de energia elétrica exportada para Argentina e Uruguai em base horária, suportando decisões de despacho térmico, contabilização comercial de contratos EVT, cumprimento de obrigações contratuais de exportação conforme Portaria MME nº 049/2022, e reconciliação entre geração contratada e fluxo físico realizado nas interligações internacionais do SIN."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver exportação de energia elétrica do Brasil para Argentina ou Uruguai, intercâmbios internacionais comerciais do SIN, geração EVT (Energia de Venda a Terceiros) para destinos internacionais, ou despacho térmico específico para contratos de exportação conforme Portaria MME nº 049/2022."@pt ;
    ons:limitation "val_gerexpevt_ar tem poucos nulos, para geração EVT destinada à Argentina, indicando períodos sem contrato ativo ou sem despacho EVT para esse destino. val_gerexpevt_uy apresenta valor mínimo de -3,0 MWmed, fisicamente inesperado para geração destinada à exportação. val_gerexpevt_uy tem poucos nulos, para geração EVT destinada ao Uruguai."@pt ;
    dct:source <https://dados.ons.org.br/dataset/geracao-exportacao-internacional> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/geracao_exportacao_internacional_ho/*.parquet" ;
    skos:altLabel "quanto foi exportado para a argentina"@pt ;
    skos:altLabel "energia vendida para o uruguai"@pt ;
    skos:altLabel "exportacao de energia"@pt ;
    skos:altLabel "geracao para exportar"@pt ;
    ons:exampleQuestion "Qual foi o volume total de energia exportada para Argentina e Uruguai em 2024?"@pt ;
    ons:exampleQuestion "Em quais meses de 2023 a exportação para Argentina foi maior que 1000 MWmed médios?"@pt ;
    ons:exampleQuestion "Qual a relação entre geração térmica para exportação e o fluxo efetivamente exportado?"@pt ;
    ons:exampleQuestion "Houve períodos em que a geração EVT para Argentina foi zero ou nula em 2024?"@pt ;
    ons:exampleQuestion "Qual o perfil horário típico de exportação para Uruguai em dias úteis versus fins de semana?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver exportação de energia elétrica do Brasil para Argentina ou Uruguai, intercâmbios internacionais comerciais do SIN, geração EVT (Energia de Venda a Terceiros) para destinos internacionais, ou despacho térmico específico para contratos de exportação conforme Portaria MME nº 049/2022. Também relevante para perguntas sobre reconciliação entre geração contratada e fluxo físico realizado nas interligações internacionais."@pt ;
    ons:agentInstruction "- [val_gerexpevt_ar] Poucos registros possuem valor nulo, o maior percentual de nulos entre todas as colunas do dataset. Pode refletir períodos sem despacho EVT para Argentina ou ausência de contratos ativos naquele instante. Deve ser tratado como ausência de despacho (zero lógico) ou como dado não disponível, dependendo do contexto analítico.\n\n- [val_gerexpevt_uy] Valor mínimo de -3,0 MWmed detectado na coluna, o que é fisicamente inesperado para uma grandeza de geração destinada à exportação. Pode indicar reversão de fluxo (importação pontual do Uruguai), ajuste de medição retroativo ou erro de registro. Requer investigação dos registros com valor negativo.\n\n- [val_exportacao_ar] Nenhum registro possuem valor nulo para o fluxo efetivo exportado para a Argentina. Embora percentualmente baixo, pode impactar cálculos de energia total exportada em séries contínuas. Verificar se os nulos coincidem com manutenções de interligação ou indisponibilidades operacionais.\n\n- [val_exportacao_uy] Nenhum registro possuem valor nulo para o fluxo efetivo exportado para o Uruguai. Embora percentualmente baixo, pode impactar cálculos de energia total exportada. Verificar se os nulos coincidem com os mesmos instantes de nulos em val_exportacao_ar, sugerindo problema sistêmico de coleta.\n\n- [din_instante] O período real dos dados (a partir de 2023-01-01) diverge significativamente da última atualização registrada nos metadados CKAN (2023-10-18), confirmando que os metadados estão desatualizados. A densidade diaria fica muito abaixo das 24 horas que a granularidade horaria faria esperar: apenas as horas com despacho ativo sao registradas.\n"@pt ;
    dct:accrualPeriodicity "horária" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/geracao_exportacao_internacional_ho/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2023-01-01/" ;
