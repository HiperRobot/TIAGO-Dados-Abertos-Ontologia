    skos:altLabel "EAR máxima"@pt ;
    skos:altLabel "capacidade máxima"@pt ;
    skos:altLabel "armazenamento máximo"@pt ;
    skos:altLabel "ear max"@pt ;
    skos:altLabel "energia máxima do reservatório"@pt ;
