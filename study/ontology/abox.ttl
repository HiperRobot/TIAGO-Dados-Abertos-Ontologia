<https://w3id.org/tiago-ons/data/column/ind_confiarb_robustez/din_referencia>
    a ons:Column ;
    dct:title "din_referencia" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data de referência do registro, representando o mês/ano ao qual o indicador se refere. As datas são registradas no primeiro dia de cada mês (ex: 2024-01-01 00:00:00 para janeiro de 2024). Para registros anuais (id_periodicidade='Anual'), representa o primeiro mês do ano de referência."@pt ;
    skos:altLabel "data de referência"@pt ;
