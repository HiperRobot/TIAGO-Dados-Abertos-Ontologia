    ons:physicalType "VARCHAR" ;
    dct:description "Código da Razão da Restrição, podendo ser: REL – Razão de indisponibilidade externa (elétrica). CNF – Razão de atendimento a requisitos de confiabilidade. ENE – Razão energética PAR - Restrição indicada no parecer de acesso"@pt ;
    skos:altLabel "razao_restricao"@pt ;
    skos:altLabel "motivo_restricao"@pt ;
    skos:altLabel "tipo_restricao"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "CNF" ;
    ons:allowedValue "ENE" ;
    ons:allowedValue "REL" .

