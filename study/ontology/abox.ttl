<https://w3id.org/tiago-ons/data/column/intercambio_internacional/din_instante>
    a ons:Column ;
    dct:title "din_instante" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Instante de referência da medição horária do intercâmbio internacional, representando o início do intervalo horário. Serve como eixo temporal principal da série e componente da chave primária composta com nom_paisdestino."@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "hora"@pt ;
    skos:altLabel "instante"@pt ;
    skos:altLabel "timestamp"@pt ;
    skos:altLabel "data_hora"@pt ;
    skos:altLabel "din_instante"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/intercambio_internacional/nom_paisdestino>
    a ons:Column ;
    dct:title "nom_paisdestino" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome do país de destino (ou origem) do intercâmbio de energia com o SIN. Representa o país contraparte na troca de energia via conversoras de frequência de fronteira. Valores conhecidos: Argentina (via Garabi I, Garabi II e Uruguaiana), Uruguai (via Melo e Rivera) e Paraguai (via Acaray). Valores positivos indicam exportação do SIN para o país; valores negativos indicam importação pelo SIN."@pt ;
    skos:altLabel "pais"@pt ;
    skos:altLabel "pais_destino"@pt ;
    skos:altLabel "pais_origem"@pt ;
    skos:altLabel "contraparte"@pt ;
    skos:altLabel "nom_paisdestino"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "ARGENTINA" ;
    ons:allowedValue "Argentina" ;
    ons:allowedValue "PARAGUAI" ;
    ons:allowedValue "URUGUAI" ;
    ons:allowedValue "Uruguai" .

<https://w3id.org/tiago-ons/data/column/intercambio_internacional/val_intercambiomwmed>
    a ons:Column ;
    dct:title "val_intercambiomwmed" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Valor medido do intercâmbio de energia entre o SIN e o país de destino no intervalo horário, expresso em MWmed (megawatts médios). Representa a soma das medidas de fluxo de potência ativa nas conversoras de frequência de fronteira. Valores positivos indicam exportação do SIN; valores negativos indicam importação. ATENÇÃO: armazenado fisicamente como VARCHAR pelo formato de serialização; requer TRY_CAST para uso numérico."@pt ;
    skos:altLabel "intercambio"@pt ;
    skos:altLabel "intercambio_realizado"@pt ;
    skos:altLabel "fluxo"@pt ;
    skos:altLabel "potencia_intercambio"@pt ;
    skos:altLabel "val_intercambio"@pt ;
    skos:altLabel "mwmed"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_intercambiomwmed AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/intercambio_internacional/val_intercambioprogmwmed>
    a ons:Column ;
    dct:title "val_intercambioprogmwmed" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Valor programado do intercâmbio de energia entre o SIN e o país de destino no intervalo horário, expresso em MWmed (megawatts médios). Representa o intercâmbio previsto para o instante, possivelmente preenchido apenas para horizonte futuro ou datas específicas de programação operativa. Possui nulos na maior parte das linhas, indicando disponibilidade parcial. ATENÇÃO: armazenado fisicamente como VARCHAR pelo formato de serialização; requer TRY_CAST para uso numérico."@pt ;
    ons:availableFrom "2026" ;
    ons:coverageNote "Coluna ausente nos arquivos anteriores a 2026 (1 de 4 periodos da serie, que comeca em 2023). Como a fonte e' lida com union_by_name, consulta que inclua periodo anterior recebe NULL e nao erro, e AVG/SUM ignoram nulo - filtre o periodo ou declare a cobertura na resposta. Apurado em 2026-09-07." ;
    skos:altLabel "intercambio_programado"@pt ;
    skos:altLabel "programado"@pt ;
    skos:altLabel "prog"@pt ;
    skos:altLabel "val_prog"@pt ;
    skos:altLabel "val_intercambio_programado"@pt ;
    skos:altLabel "mwmed_programado"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_intercambioprogmwmed AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/family/intercambio>
    a ons:Family ;
    skos:prefLabel "intercambio" .

<https://w3id.org/tiago-ons/data/metric/intercambio_internacional/intercambiomwmed>
    a ons:Metric ;
    skos:prefLabel "Intercâmbio Realizado"@pt ;
    skos:altLabel "intercambio"@pt ;
    skos:altLabel "intercambio_realizado"@pt ;
    skos:altLabel "fluxo"@pt ;
    skos:altLabel "potencia_intercambio"@pt ;
    skos:altLabel "val_intercambio"@pt ;
    skos:altLabel "mwmed"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/intercambio_internacional/val_intercambiomwmed> ;
    ons:expression "TRY_CAST(val_intercambiomwmed AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "1.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(val_intercambiomwmed AS DOUBLE)) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_intercambiomwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_intercambiomwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_intercambiomwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(val_intercambiomwmed AS DOUBLE)) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_intercambiomwmed AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

<https://w3id.org/tiago-ons/data/metric/intercambio_internacional/intercambioprogmwmed>
    a ons:Metric ;
    skos:prefLabel "Intercâmbio Programado"@pt ;
    skos:altLabel "intercambio_programado"@pt ;
    skos:altLabel "programado"@pt ;
    skos:altLabel "prog"@pt ;
    skos:altLabel "val_prog"@pt ;
    skos:altLabel "val_intercambio_programado"@pt ;
    skos:altLabel "mwmed_programado"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/intercambio_internacional/val_intercambioprogmwmed> ;
    ons:expression "TRY_CAST(val_intercambioprogmwmed AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "1.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(val_intercambioprogmwmed AS DOUBLE)) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_intercambioprogmwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_intercambioprogmwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_intercambioprogmwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(val_intercambioprogmwmed AS DOUBLE)) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_intercambioprogmwmed AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

<https://w3id.org/tiago-ons/data/value/intercambio_internacional/nom_paisdestino/argentina>
    a ons:ValueAlias ;
    skos:notation "argentina" ;
