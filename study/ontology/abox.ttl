<https://w3id.org/tiago-ons/data/template/reservatorio/pattern_cotamaxima_por_reservatorio>
    a ons:QueryTemplate ;
    skos:prefLabel "cotamaxima_por_reservatorio" ;
    ons:sqlTemplate "SELECT nom_reservatorio, id_subsistema,\n  MAX(TRY_CAST(val_cotamaxima AS DOUBLE)) AS cota_maxima_m\nFROM {source}\nWHERE TRY_CAST(val_cotamaxima AS DOUBLE) IS NOT NULL\nGROUP BY 1, 2\nORDER BY cota_maxima_m DESC" ;
    ons:outputUnitLabel "m" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/reservatorio/cotamaxima> .

<https://w3id.org/tiago-ons/data/template/reservatorio/pattern_volume_util_por_subsistema>
    a ons:QueryTemplate ;
    skos:prefLabel "volume_util_por_subsistema" ;
    ons:sqlTemplate "SELECT nom_subsistema,\n  SUM(TRY_CAST(val_volutiltot AS DOUBLE)) AS vol_util_total_hm3\nFROM {source}\nWHERE TRY_CAST(val_volutiltot AS DOUBLE) IS NOT NULL\nGROUP BY 1\nORDER BY vol_util_total_hm3 DESC" ;
    ons:outputUnitLabel "hm3" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/reservatorio/volutiltot> .

<https://w3id.org/tiago-ons/data/template/reservatorio/pattern_reservatorios_sem_produtibilidade>
    a ons:QueryTemplate ;
    skos:prefLabel "reservatorios_sem_produtibilidade" ;
    ons:sqlTemplate "SELECT nom_reservatorio, nom_usina, tip_reservatorio, nom_subsistema\nFROM {source}\nWHERE val_produtibilidadeespecifica IS NULL\nORDER BY nom_reservatorio" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/reservatorio/produtibilidadeespecifica> .

<https://w3id.org/tiago-ons/data/template/reservatorio/pattern_parametros_por_ree>
    a ons:QueryTemplate ;
    skos:prefLabel "parametros_por_ree" ;
    ons:sqlTemplate "SELECT nom_ree,\n  COUNT(*) AS qtd_reservatorios,\n  SUM(TRY_CAST(val_volutiltot AS DOUBLE)) AS vol_util_total_hm3,\n  AVG(val_produtibilidadeespecifica) AS produtibilidade_media\nFROM {source}\nWHERE TRY_CAST(val_volutiltot AS DOUBLE) IS NOT NULL\nGROUP BY 1\nORDER BY vol_util_total_hm3 DESC" ;
    ons:outputUnitLabel "hm3" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/reservatorio/volutiltot> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/reservatorio/produtibilidadeespecifica> .

<https://w3id.org/tiago-ons/data/template/reservatorio/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT nom_subsistema, id_subsistema, COUNT(*) AS qtd_reservatorios, SUM(TRY_CAST(val_volutiltot AS DOUBLE)) AS vol_util_total_hm3, SUM(TRY_CAST(val_volmax AS DOUBLE)) AS vol_max_total_hm3, SUM(TRY_CAST(val_volmin AS DOUBLE)) AS vol_min_total_hm3 FROM read_parquet('s3://ons-aws-prod-opendata/dataset/reservatorio/*.parquet') WHERE TRY_CAST(val_volutiltot AS DOUBLE) IS NOT NULL GROUP BY nom_subsistema, id_subsistema ORDER BY vol_util_total_hm3 DESC" ;
    ons:exampleQuestion "Qual é o volume útil total de armazenamento (hm³) dos reservatórios por subsistema elétrico?"@pt .

<https://w3id.org/tiago-ons/data/template/reservatorio/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT nom_reservatorio, nom_usina, nom_subsistema, nom_bacia, nom_ree, TRY_CAST(val_volutiltot AS DOUBLE) AS vol_util_hm3, TRY_CAST(val_volmax AS DOUBLE) AS vol_max_hm3, TRY_CAST(val_cotamaxima AS DOUBLE) AS cota_max_m, TRY_CAST(val_cotaminima AS DOUBLE) AS cota_min_m FROM read_parquet('s3://ons-aws-prod-opendata/dataset/reservatorio/*.parquet') WHERE TRY_CAST(val_volutiltot AS DOUBLE) IS NOT NULL ORDER BY vol_util_hm3 DESC LIMIT 20" ;
    ons:exampleQuestion "Quais são os 20 reservatórios com maior volume útil total no Brasil?"@pt .

<https://w3id.org/tiago-ons/data/template/reservatorio/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT nom_ree, nom_subsistema, COUNT(*) AS qtd_reservatorios, AVG(val_produtibilidadeespecifica) AS prod_especifica_media, MIN(val_produtibilidadeespecifica) AS prod_especifica_min, MAX(val_produtibilidadeespecifica) AS prod_especifica_max, AVG(val_produtividade65volutil) AS prod_65_media, AVG(val_perda) AS perda_media_pct FROM read_parquet('s3://ons-aws-prod-opendata/dataset/reservatorio/*.parquet') WHERE val_produtibilidadeespecifica IS NOT NULL AND val_produtividade65volutil IS NOT NULL GROUP BY nom_ree, nom_subsistema ORDER BY nom_subsistema, nom_ree" ;
    ons:exampleQuestion "Quais são os parâmetros de produtibilidade dos reservatórios agrupados por Reservatório Equivalente de Energia?"@pt .

<https://w3id.org/tiago-ons/data/dataset/restricao_coff_eolica_detail>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:restricao_coff_eolica_detail" ;
    dct:title "restricao_coff_eolica_detail" ;
    owl:versionInfo "1.1.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/geracao> ;
    dcat:keyword "30min"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "coff eólico detalhe"@pt ;
    dcat:keyword "constrained-off"@pt ;
    dcat:keyword "constrained-off eólico"@pt ;
    dcat:keyword "constrained-off eólico por usina"@pt ;
    dcat:keyword "corte de geração eólica"@pt ;
    dcat:keyword "curtailment"@pt ;
    dcat:keyword "curtailment eólico 30min"@pt ;
    dcat:keyword "eólica"@pt ;
    dcat:keyword "geração-eólica"@pt ;
    dcat:keyword "por-usina"@pt ;
    dcat:keyword "restrição eólica detalhada"@pt ;
    dcat:keyword "restrição-operativa"@pt ;
    dcat:keyword "semi-horário"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Registrar e disponibilizar o detalhamento por usina individual das restrições de geração eólica por constrained-off, permitindo que operadores do ONS, agentes do setor elétrico, auditores da CCEE e pesquisadores calculem a energia curtailed por usina, apurem compensações financeiras regulatórias, monitorem a qualidade dos dados de vento e analisem o impacto operativo do curtailment eólico no SIN. Suporta decisões de despacho, auditoria de restrições e estudos de planejamento da expansão eólica."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver restrições de geração eólica por constrained-off com detalhamento por usina individual, cálculo de energia curtailed (diferença entre geração estimada e verificada), análise de velocidade do vento em períodos de restrição, ou auditoria de modalidades operativas (Tipo I, Tipo II-B, Tipo II-C) em granularidade semi-horária."@pt ;
    ons:limitation "Valor máximo de 297,529 m/s é fisicamente impossível para velocidade do vento em operação de turbinas eólicas (limite operacional típico: 25 m/s). val_geracaoestimada possui poucos nulos."@pt ;
    dct:source <https://dados.ons.org.br/dataset/restricao_coff_eolica_detail> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/restricao_coff_eolica_detail_tm/*.parquet" ;
    skos:altLabel "corte de geracao eolica por usina"@pt ;
    skos:altLabel "razao do corte eolico"@pt ;
    skos:altLabel "motivo do corte por usina"@pt ;
    skos:altLabel "quanto a eolica deixou de gerar por usina"@pt ;
    skos:altLabel "curtailment por parque eolico"@pt ;
    ons:exampleQuestion "Qual foi a energia curtailed (não gerada por restrição) das usinas eólicas do subsistema NE em janeiro de 2024?"@pt ;
    ons:exampleQuestion "Quais usinas eólicas tiveram maior volume de constrained-off Tipo I no primeiro semestre de 2024?"@pt ;
    ons:exampleQuestion "Qual a diferença entre geração estimada e verificada por complexo eólico em um determinado mês?"@pt ;
    ons:exampleQuestion "Em quais períodos do dia ocorre maior concentração de constrained-off eólico no subsistema Nordeste?"@pt ;
    ons:exampleQuestion "Qual a proporção de registros com dado de vento inválido por usina e como isso afeta o cálculo de curtailment?"@pt ;
    ons:exampleQuestion "Top 10 usinas com maior curtailment acumulado no SE em 2024"@pt ;
    ons:exampleQuestion "Qual horário do dia concentra mais COFF no NE?"@pt ;
    ons:exampleQuestion "Geração verificada vs estimada das usinas do Ceará no Q1 2024"@pt ;
    ons:exampleQuestion "Geração estimada vs verificada do complexo Y de março a maio 2024"@pt ;
    ons:exampleQuestion "Em quantos patamares de 30 minutos houve restrição (flg_geracaorestrita = 1) por usina no último mês?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver restrições de geração eólica por constrained-off com detalhamento por usina individual, cálculo de energia curtailed (diferença entre geração estimada e verificada), análise de velocidade do vento em períodos de restrição, ou auditoria de modalidades operativas (Tipo I, Tipo II-B, Tipo II-C) em granularidade semi-horária. Também relevante para perguntas sobre compensações financeiras de usinas eólicas restritas e análise de curtailment no SIN."@pt ;
    ons:agentInstruction "- [val_geracaoestimada] Poucos registros possuem val_geracaoestimada nulo. Ocorre possivelmente quando o modelo de estimativa não está disponível para o instante, usina em manutenção, ou período de retroalimentação de dados ainda não processado. Nulos devem ser tratados antes de calcular o volume de energia cortada (estimada - verificada).\n\n- [val_ventoverificado] val_ventoverificado apresenta valor máximo de 297,529, extremamente elevado para velocidade de vento em m/s (velocidades operacionais típicas de turbinas eólicas ficam entre 0 e 25 m/s). Pode indicar medição atípica, unidade diferente em casos específicos, ou dado de anemômetro com leitura não capturada pelo flag flg_dadoventoinvalido.\n\n- [flg_dadoventoinvalido] flg_dadoventoinvalido é armazenado como DOUBLE (0.0 ou 1.0) em vez de BOOLEAN ou INTEGER, o que pode causar confusão em filtros. Verificar se existem valores intermediários (ex: 0.5) que não sejam estritamente 0.0 ou 1.0, indicando possível corrupção ou uso indevido do campo.\n\n- [val_geracaoverificada] val_geracaoverificada apresenta valor máximo de 122,0 MW para uma usina individual. Usinas eólicas individuais raramente ultrapassam 30-50 MW de capacidade instalada. Verificar se registros com valores acima de 100 MW correspondem a usinas com capacidade instalada compatível ou se representam agregações indevidas.\n\n- [din_instante] Dado o processo de consistência recorrente com atualizações às 12h e 19h, podem existir lacunas temporais para usinas específicas em determinados períodos, especialmente próximo à data de início (2023-01-01) ou em períodos de manutenção do sistema. Verificar continuidade da série temporal por usina.\n\n- [ceg] A combinação (din_instante, id_ons, ceg) é assumida como chave primária natural. Verificar se existem duplicatas que possam indicar reprocessamento parcial de dados ou sobreposição de arquivos Parquet no S3 durante o processo de consistência recorrente.\n\n- [flg_geracaorestrita] 1 quando houve limitacao da geracao do conjunto na semi-hora; use flg_geracaorestrita = 1 para restringir a analise aos patamares com constrained-off (mais direto do que comparar estimada e verificada).\n\n- [val_geracaoreferenciafinal] Preenchida apenas nos patamares com restricao REL apos a apuracao definitiva do ONS (nulos na maior parte das linhas); e' a base do calculo de geracao frustrada enviado a CCEE.\n\n- [nom_origemgeracaoreferencia] Origem da referencia (Curva, Garantia Física, Migrado do SAGIC, Períodos Anteriores, Períodos Anteriores/Garantia Física); util para segmentar a qualidade da estimativa.\n\n- [flags] flg_* sao INTEGER 0/1 em todos os arquivos atuais.\n\n- [din_instante] Serie desde 2021-10-01, patamares de 30 minutos, atualizada diariamente."@pt ;
    dct:accrualPeriodicity "horária" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/restricao_coff_eolica_detail_tm/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2021-10-01/" ;
