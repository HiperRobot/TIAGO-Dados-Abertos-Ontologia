<https://w3id.org/tiago-ons/data/template/ear_diario_por_subsistema/pattern_ear_verif_percentual_serie_diaria>
    a ons:QueryTemplate ;
    skos:prefLabel "ear_verif_percentual_serie_diaria" ;
    ons:sqlTemplate "SELECT TRY_CAST(ear_data AS DATE) AS data,\n  id_subsistema,\n  TRY_CAST(ear_verif_subsistema_percentual AS DOUBLE) AS ear_pct\nFROM {source}\nWHERE id_subsistema = '{subsistema}'\n  AND TRY_CAST(ear_data AS DATE) BETWEEN '{data_inicio}' AND '{data_fim}'\nORDER BY 1" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ear_diario_por_subsistema/ear_verif_subsistema_percentual> .

<https://w3id.org/tiago-ons/data/template/ear_diario_por_subsistema/pattern_ear_verif_mwmes_media_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "ear_verif_mwmes_media_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(ear_data AS DATE)) AS mes,\n  id_subsistema,\n  AVG(TRY_CAST(ear_verif_subsistema_mwmes AS DOUBLE)) AS ear_media_mwmes\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(ear_data AS DATE)) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "MWmes" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ear_diario_por_subsistema/ear_verif_subsistema_mwmes> .

<https://w3id.org/tiago-ons/data/template/ear_diario_por_subsistema/pattern_ear_verif_percentual_abaixo_limiar>
    a ons:QueryTemplate ;
    skos:prefLabel "ear_verif_percentual_abaixo_limiar" ;
    ons:sqlTemplate "SELECT TRY_CAST(ear_data AS DATE) AS data,\n  id_subsistema,\n  TRY_CAST(ear_verif_subsistema_percentual AS DOUBLE) AS ear_pct\nFROM {source}\nWHERE id_subsistema = '{subsistema}'\n  AND TRY_CAST(ear_verif_subsistema_percentual AS DOUBLE) < {limiar}\nORDER BY 1" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ear_diario_por_subsistema/ear_verif_subsistema_percentual> .

<https://w3id.org/tiago-ons/data/template/ear_diario_por_subsistema/pattern_ear_comparacao_subsistemas>
    a ons:QueryTemplate ;
    skos:prefLabel "ear_comparacao_subsistemas" ;
    ons:sqlTemplate "SELECT id_subsistema,\n  AVG(TRY_CAST(ear_verif_subsistema_percentual AS DOUBLE)) AS ear_pct_medio\nFROM {source}\nWHERE DATE_TRUNC('month', TRY_CAST(ear_data AS DATE)) = DATE_TRUNC('month', DATE '{data_ref}')\nGROUP BY 1\nORDER BY 2 DESC" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ear_diario_por_subsistema/ear_verif_subsistema_percentual> .

<https://w3id.org/tiago-ons/data/template/ear_diario_por_subsistema/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT TRY_CAST(ear_data AS DATE) AS data_ref, id_subsistema, nom_subsistema, ear_verif_subsistema_percentual FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ear_subsistema_di/*.parquet') WHERE TRY_CAST(ear_data AS DATE) >= CURRENT_DATE - INTERVAL '90' DAY ORDER BY data_ref, id_subsistema;" ;
    ons:exampleQuestion "Como evoluiu o percentual de armazenamento de cada subsistema nos últimos 90 dias?"@pt .

<https://w3id.org/tiago-ons/data/template/ear_diario_por_subsistema/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "WITH ranked AS (\n  SELECT\n    TRY_CAST(ear_data AS DATE) AS data_ref,\n    id_subsistema,\n    nom_subsistema,\n    TRY_CAST(ear_verif_subsistema_percentual AS DOUBLE) AS ear_verif_subsistema_percentual,\n    ROW_NUMBER() OVER (\n      PARTITION BY id_subsistema\n      ORDER BY TRY_CAST(ear_verif_subsistema_percentual AS DOUBLE) ASC\n    ) AS rn\n  FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ear_subsistema_di/*.parquet', union_by_name=true)\n  WHERE TRY_CAST(ear_verif_subsistema_percentual AS DOUBLE) >= 0.0\n)\nSELECT\n  data_ref,\n  id_subsistema,\n  nom_subsistema,\n  ear_verif_subsistema_percentual AS minimo_historico_pct\nFROM ranked\nWHERE rn = 1\nORDER BY id_subsistema\nLIMIT 100" ;
    ons:exampleQuestion "Qual foi o menor percentual de armazenamento já registrado em cada subsistema e em que data ocorreu?"@pt .

<https://w3id.org/tiago-ons/data/template/ear_diario_por_subsistema/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(ear_data AS DATE)) AS mes_ref, id_subsistema, nom_subsistema, ROUND(AVG(ear_verif_subsistema_mwmes), 2) AS media_ear_mwmes, ROUND(AVG(ear_verif_subsistema_percentual), 2) AS media_ear_pct FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ear_subsistema_di/*.parquet') WHERE TRY_CAST(ear_data AS DATE) >= CURRENT_DATE - INTERVAL '2' YEAR GROUP BY DATE_TRUNC('month', TRY_CAST(ear_data AS DATE)), id_subsistema, nom_subsistema ORDER BY mes_ref, id_subsistema;" ;
    ons:exampleQuestion "Qual foi a média mensal de energia armazenada em MWmês para cada subsistema nos últimos 2 anos?"@pt .

<https://w3id.org/tiago-ons/data/dataset/ena_diario_por_bacia>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:ena-diario-por-bacia" ;
    dct:title "ena-diario-por-bacia" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/hidrologia> ;
    dcat:keyword "ENA"@pt ;
    dcat:keyword "ENA bruta bacia"@pt ;
    dcat:keyword "ENA diária bacia"@pt ;
    dcat:keyword "ENA diária por bacia"@pt ;
    dcat:keyword "ENA por bacia"@pt ;
    dcat:keyword "MLT"@pt ;
    dcat:keyword "MWmed"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "afluência"@pt ;
    dcat:keyword "afluência diária por bacia"@pt ;
    dcat:keyword "bacia hidro energética"@pt ;
    dcat:keyword "energia natural afluente"@pt ;
    dcat:keyword "energia natural afluente bacia"@pt ;
    dcat:keyword "hidrologia"@pt ;
    dcat:keyword "média de longo termo"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Fornecer a geradores, comercializadores de energia, planejadores do setor elétrico e pesquisadores os valores diários de ENA por bacia hidro energética, permitindo o monitoramento da disponibilidade hídrica para geração, a avaliação de risco hidrológico, a projeção do Custo Marginal de Operação (CMO) e o suporte a decisões de despacho hidrotérmico e planejamento energético de curto, médio e longo prazo no SIN."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver Energia Natural Afluente (ENA) com granularidade diária e desagregação por bacia hidro energética, incluindo análises de afluência bruta ou armazenável em MWmed ou percentual da MLT."@pt ;
    ons:limitation "Coluna armazenada como VARCHAR no schema DuckDB em vez de DATE. Valores de ENA Bruta em MWmed podem ocasionalmente ser negativos ou próximos de zero em períodos de seca extrema ou inconsistências no processo de consistência recorrente do ONS. Valores de ENA Armazenável em MWmed podem ser negativos quando as vazões vertidas superam as vazões naturais afluentes."@pt ;
    dct:source <https://dados.ons.org.br/dataset/ena-diario-por-bacia> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/ena_bacia_di/*.parquet" ;
    skos:altLabel "quanta chuva chegou por bacia"@pt ;
    skos:altLabel "afluencia por bacia"@pt ;
    skos:altLabel "ena da bacia"@pt ;
    ons:exampleQuestion "Qual foi a ENA bruta da bacia do Paraná nos últimos 30 dias?"@pt ;
    ons:exampleQuestion "Quais bacias estão com ENA abaixo de 50% da MLT hoje?"@pt ;
    ons:exampleQuestion "Como evoluiu a ENA armazenável da bacia do São Francisco em 2024?"@pt ;
    ons:exampleQuestion "Qual a média histórica de ENA bruta por bacia no período de chuvas (novembro a março)?"@pt ;
    ons:exampleQuestion "Quais foram os 10 dias com menor ENA armazenável no SIN considerando todas as bacias?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver Energia Natural Afluente (ENA) com granularidade diária e desagregação por bacia hidro energética, incluindo análises de afluência bruta ou armazenável em MWmed ou percentual da MLT. Também recuperar quando o analista precisar monitorar condições hidrológicas diárias de bacias específicas do SIN, avaliar risco de déficit hídrico por bacia ou comparar afluência atual com a média histórica de longo prazo."@pt ;
    ons:agentInstruction "- [ena_data] A coluna ena_data é armazenada como VARCHAR no schema físico DuckDB, embora represente datas no formato YYYY-MM-DD. Operações de filtro temporal, ordenação cronológica e joins com outros datasets temporais requerem conversão explícita. Comparações diretas como VARCHAR podem produzir resultados incorretos.\n\n- [ena_armazenavel_bacia_mwmed] A ENA Armazenável pode assumir valores negativos em situações de vertimento elevado nos reservatórios, quando as vazões vertidas superam as vazões naturais afluentes. Embora fisicamente possível, valores muito negativos podem indicar inconsistências no processo de consistência recorrente do ONS.\n\n- [ena_bruta_bacia_percentualmlt] Valores percentuais de ENA Bruta em relação à MLT podem apresentar outliers extremos em eventos hidrológicos excepcionais (cheias ou secas severas). Valores acima de 500% ou abaixo de 5% da MLT merecem verificação, pois podem indicar erros de consistência ou eventos extremos que impactam modelos de despacho.\n\n- [ena_armazenavel_bacia_percentualmlt] Valores percentuais de ENA Armazenável em relação à MLT podem ser mais extremos que os da ENA Bruta, pois o desconto do vertimento amplifica desvios. Valores negativos expressivos (abaixo de -50% da MLT) ou acima de 600% indicam condições hidrológicas excepcionais ou possíveis inconsistências no processo de cálculo do ONS.\n\n- [nom_bacia] A chave primária natural do dataset é composta por (nom_bacia, ena_data). Dado que os dados passam por processo de consistência recorrente e podem ser atualizados após publicação, é possível que existam registros duplicados para a mesma bacia e data em versões intermediárias dos arquivos parquet, especialmente em datas recentes próximas à última modificação S3.\n\n- [tipos] As colunas `ena_armazenavel_bacia_mwmed`, `ena_armazenavel_bacia_percentualmlt`, `ena_bruta_bacia_mwmed`, `ena_bruta_bacia_percentualmlt` mudam de tipo entre arquivos anuais (texto em uns, número em outros); cada uma traz `castExpression` no schema: use-o em toda agregação e comparação.\n"@pt ;
    dct:accrualPeriodicity "diária" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/ena_bacia_di/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2021-01-01/" ;
