<https://w3id.org/tiago-ons/data/template/carga_mensal/pattern_cargaenergiamwmed_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "cargaenergiamwmed_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, id_subsistema,\n  SUM((TRY_CAST(val_cargaenergiamwmed AS DOUBLE)) * 730.0) / 1000 AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/carga_mensal/cargaenergiamwmed> .

<https://w3id.org/tiago-ons/data/template/carga_mensal/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT YEAR(din_instante) AS ano, ROUND(SUM(TRY_CAST(val_cargaenergiamwmed AS DOUBLE)), 2) AS carga_total_mwmed FROM read_parquet('s3://ons-aws-prod-opendata/dataset/carga_energia_me/*.parquet') WHERE id_subsistema IN ('SE', 'S', 'NE', 'N') GROUP BY YEAR(din_instante) ORDER BY ano;" ;
    ons:exampleQuestion "Como evoluiu a carga total do SIN (soma dos subsistemas) ano a ano desde 2000?"@pt .

<https://w3id.org/tiago-ons/data/template/carga_mensal/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_subsistema, MONTH(din_instante) AS mes_numero, ROUND(AVG(TRY_CAST(val_cargaenergiamwmed AS DOUBLE)), 2) AS carga_media_mwmed FROM read_parquet('s3://ons-aws-prod-opendata/dataset/carga_energia_me/*.parquet') WHERE id_subsistema IN ('SE', 'S', 'NE', 'N') GROUP BY id_subsistema, nom_subsistema, MONTH(din_instante) ORDER BY id_subsistema, mes_numero;" ;
    ons:exampleQuestion "Qual é o perfil de sazonalidade mensal da carga em cada subsistema do SIN?"@pt .

<https://w3id.org/tiago-ons/data/template/carga_mensal/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_subsistema, din_instante AS mes_referencia, ROUND(TRY_CAST(val_cargaenergiamwmed AS DOUBLE), 2) AS carga_mwmed FROM read_parquet('s3://ons-aws-prod-opendata/dataset/carga_energia_me/*.parquet') WHERE din_instante = ( SELECT MAX(din_instante) FROM read_parquet('s3://ons-aws-prod-opendata/dataset/carga_energia_me/*.parquet') ) AND id_subsistema IN ('SE', 'S', 'NE', 'N') ORDER BY carga_mwmed DESC;" ;
    ons:exampleQuestion "Qual subsistema teve maior carga de energia no mês mais recente disponível?"@pt .

<https://w3id.org/tiago-ons/data/dataset/cargaglobal_roraima>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:cargaglobal-roraima" ;
