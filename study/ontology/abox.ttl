<https://w3id.org/tiago-ons/data/column/curva_carga/id_subsistema>
    a ons:Column ;
    dct:title "id_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificador alfanumérico do subsistema elétrico. Valores possíveis: SE (Sudeste/Centro-Oeste), S (Sul), NE (Nordeste) e N (Norte) — este dataset NÃO tem a linha agregada SIN (verificado na fonte em 13/08/2026); a curva do SIN é a SOMA dos 4 subsistemas por instante. Utilizado como chave de join com outros datasets do ONS."@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "id subsistema"@pt ;
    skos:altLabel "código subsistema"@pt ;
    skos:altLabel "região elétrica"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "N" ;
    ons:allowedValue "NE" ;
    ons:allowedValue "S" ;
    ons:allowedValue "SE" .

<https://w3id.org/tiago-ons/data/column/curva_carga/nom_subsistema>
    a ons:Column ;
    dct:title "nom_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome por extenso do subsistema elétrico do SIN correspondente ao id_subsistema. Exemplos: Sudeste/Centro-Oeste, Sul, Nordeste, Norte, Sistema Interligado Nacional."@pt ;
    skos:altLabel "nome subsistema"@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "região"@pt ;
    skos:altLabel "nome da região"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "NORDESTE" ;
    ons:allowedValue "NORTE" ;
    ons:allowedValue "SUDESTE" ;
    ons:allowedValue "SUDESTE/CENTRO-OESTE" ;
    ons:allowedValue "SUL" .

<https://w3id.org/tiago-ons/data/column/curva_carga/din_instante>
    a ons:Column ;
