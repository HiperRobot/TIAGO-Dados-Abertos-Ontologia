    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"maximum\": {\"sql\": \"MAX(val_volumeespera)\", \"unit\": \"%\"}, \"average\": {\"sql\": \"AVG(val_volumeespera)\", \"unit\": \"%\"}, \"minimum\": {\"sql\": \"MIN(val_volumeespera)\", \"unit\": \"%\"}, \"time_series\": {\"sql\": \"AVG(val_volumeespera)\", \"unit\": \"%\"}, \"ranking\": {\"sql\": \"AVG(val_volumeespera)\", \"unit\": \"%\"}, \"comparison\": {\"sql\": \"AVG(val_volumeespera)\", \"unit\": \"%\"}}" .

