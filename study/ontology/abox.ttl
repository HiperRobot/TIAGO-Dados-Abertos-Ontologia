<https://w3id.org/tiago-ons/data/metric/ind_confiarb_atls/atls>
    a ons:Metric ;
    skos:prefLabel "Atls"@pt ;
    skos:altLabel "ATLS"@pt ;
    skos:altLabel "indicador ATLS"@pt ;
    skos:altLabel "atendimento aos limites sistêmicos"@pt ;
    skos:altLabel "índice de atendimento"@pt ;
    skos:altLabel "valor do indicador"@pt ;
    skos:altLabel "desempenho do fluxo"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ind_confiarb_atls/val_atls> ;
    ons:expression "val_atls" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/percent> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/adimensional> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "8760.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total\": {\"sql\": \"SUM(val_atls)\", \"unit\": \"\"}, \"average\": {\"sql\": \"AVG(val_atls)\", \"unit\": \"\"}, \"maximum\": {\"sql\": \"MAX(val_atls)\", \"unit\": \"\"}, \"time_series\": {\"sql\": \"SUM(val_atls)\", \"unit\": \"\"}, \"ranking\": {\"sql\": \"SUM(val_atls)\", \"unit\": \"\"}, \"comparison\": {\"sql\": \"SUM(val_atls)\", \"unit\": \"\"}}" .

