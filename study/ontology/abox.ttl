<https://w3id.org/tiago-ons/data/template/capacidade_geracao/pattern_capacidade_total_por_tipo>
    a ons:QueryTemplate ;
    skos:prefLabel "capacidade_total_por_tipo" ;
    ons:sqlTemplate "SELECT nom_tipousina,\n  SUM(val_potenciaefetiva) AS potencia_total_mw\nFROM {source}\nGROUP BY nom_tipousina\nORDER BY potencia_total_mw DESC" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/capacidade_geracao/potenciaefetiva> .

<https://w3id.org/tiago-ons/data/template/capacidade_geracao/pattern_capacidade_por_subsistema_tipo>
    a ons:QueryTemplate ;
    skos:prefLabel "capacidade_por_subsistema_tipo" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_tipousina,\n  SUM(val_potenciaefetiva) AS potencia_total_mw\nFROM {source}\nGROUP BY id_subsistema, nom_tipousina\nORDER BY id_subsistema, potencia_total_mw DESC" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/capacidade_geracao/potenciaefetiva> .

<https://w3id.org/tiago-ons/data/template/capacidade_geracao/pattern_ranking_usinas_por_potencia>
    a ons:QueryTemplate ;
    skos:prefLabel "ranking_usinas_por_potencia" ;
    ons:sqlTemplate "SELECT nom_usina, nom_tipousina, id_subsistema,\n  SUM(val_potenciaefetiva) AS potencia_total_mw\nFROM {source}\nGROUP BY nom_usina, nom_tipousina, id_subsistema\nORDER BY potencia_total_mw DESC\nLIMIT {limit}" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/capacidade_geracao/potenciaefetiva> .

<https://w3id.org/tiago-ons/data/template/capacidade_geracao/pattern_usinas_ativas>
    a ons:QueryTemplate ;
    skos:prefLabel "usinas_ativas" ;
    ons:sqlTemplate "SELECT nom_usina, ceg, nom_tipousina, nom_combustivel, id_subsistema,\n  SUM(val_potenciaefetiva) AS potencia_total_mw\nFROM {source}\nWHERE (dat_desativacao IS NULL\n  OR TRY_CAST(dat_desativacao AS DATE) > CURRENT_DATE\n  OR dat_desativacao = '9999-12-31')\nGROUP BY nom_usina, ceg, nom_tipousina, nom_combustivel, id_subsistema\nORDER BY potencia_total_mw DESC" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/capacidade_geracao/potenciaefetiva> .

<https://w3id.org/tiago-ons/data/template/capacidade_geracao/pattern_capacidade_por_combustivel>
    a ons:QueryTemplate ;
    skos:prefLabel "capacidade_por_combustivel" ;
    ons:sqlTemplate "SELECT nom_combustivel,\n  SUM(val_potenciaefetiva) AS potencia_total_mw\nFROM {source}\nGROUP BY nom_combustivel\nORDER BY potencia_total_mw DESC" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/capacidade_geracao/potenciaefetiva> .

<https://w3id.org/tiago-ons/data/template/capacidade_geracao/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_subsistema, nom_tipousina, COUNT(DISTINCT nom_usina) AS qtd_usinas, COUNT(cod_equipamento) AS qtd_ugs, SUM(val_potenciaefetiva) AS potencia_total_mw, ROUND(AVG(val_potenciaefetiva), 2) AS potencia_media_mw FROM read_parquet('s3://ons-aws-prod-opendata/dataset/capacidade-geracao/*.parquet') GROUP BY id_subsistema, nom_subsistema, nom_tipousina ORDER BY id_subsistema, potencia_total_mw DESC;" ;
    ons:exampleQuestion "Qual é a capacidade total instalada em MW por subsistema e tipo de usina?"@pt .

<https://w3id.org/tiago-ons/data/template/capacidade_geracao/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT nom_usina, nom_tipousina, nom_combustivel, id_subsistema, nom_estado, nom_agenteproprietario, COUNT(cod_equipamento) AS qtd_ugs, SUM(val_potenciaefetiva) AS potencia_total_mw FROM read_parquet('s3://ons-aws-prod-opendata/dataset/capacidade-geracao/*.parquet') GROUP BY nom_usina, nom_tipousina, nom_combustivel, id_subsistema, nom_estado, nom_agenteproprietario ORDER BY potencia_total_mw DESC LIMIT 20;" ;
    ons:exampleQuestion "Quais são as 20 maiores usinas em termos de potência efetiva total instalada?"@pt .

<https://w3id.org/tiago-ons/data/template/capacidade_geracao/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT nom_combustivel, id_estado, nom_estado, id_subsistema, COUNT(DISTINCT nom_usina) AS qtd_usinas, COUNT(cod_equipamento) AS qtd_ugs, ROUND(SUM(val_potenciaefetiva), 2) AS potencia_total_mw FROM read_parquet('s3://ons-aws-prod-opendata/dataset/capacidade-geracao/*.parquet') WHERE nom_combustivel IN ('VENTO', 'SOLAR') GROUP BY nom_combustivel, id_estado, nom_estado, id_subsistema ORDER BY nom_combustivel, potencia_total_mw DESC;" ;
    ons:exampleQuestion "Qual a capacidade instalada de geração eólica e solar por estado?"@pt .

<https://w3id.org/tiago-ons/data/dataset/capacidade_transformacao>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:capacidade-transformacao" ;
    dct:title "capacidade-transformacao" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/transmissao> ;
    dcat:keyword "AT rede básica"@pt ;
    dcat:keyword "cadastro-equipamentos"@pt ;
    dcat:keyword "capacidade de transformação"@pt ;
    dcat:keyword "capacidade trafo"@pt ;
    dcat:keyword "mva"@pt ;
    dcat:keyword "ons"@pt ;
    dcat:keyword "potencia-nominal"@pt ;
    dcat:keyword "rede-basica"@pt ;
    dcat:keyword "sin"@pt ;
    dcat:keyword "subestacao"@pt ;
    dcat:keyword "tensao-kv"@pt ;
    dcat:keyword "trafo"@pt ;
    dcat:keyword "transformador"@pt ;
    dcat:keyword "transformador rede básica"@pt ;
    dcat:keyword "transformação SIN"@pt ;
    dcat:keyword "transmissao"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Suportar planejadores e operadores do sistema elétrico na análise da capacidade de transformação instalada na Rede Básica do SIN, permitindo estudos de fluxo de potência, avaliação de adequação da infraestrutura de transmissão, decisões sobre expansão da rede, manutenção de equipamentos e conformidade regulatória com normas ANEEL/ONS. Utilizado por agentes de transmissão, pesquisadores e reguladores para inventário e diagnóstico da infraestrutura de transformação."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver capacidade instalada de transformação, inventário de transformadores da Rede Básica, potência nominal em MVA por subestação ou subsistema, tensões de transformação (primário/secundário/terciário), agentes proprietários de transformadores ou análise de infraestrutura de transformação do SIN."@pt ;
    ons:limitation "Parte dos registros (aproximadamente 384 linhas) possuem val_tensaoterciario_kv nulo. Poucos registros possuem num_barra_primario nulo, indicando transformadores sem barra primária associada no modelo computacional. Poucos registros possuem num_barra_secundario nulo, indicando transformadores sem barra secundária associada no modelo computacional."@pt ;
    dct:source <https://dados.ons.org.br/dataset/capacidade-transformacao> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/capacidade-transformacao/*.parquet" ;
    skos:altLabel "quantos transformadores existem"@pt ;
    skos:altLabel "capacidade das subestacoes em mva"@pt ;
    skos:altLabel "transformadores por subestacao"@pt ;
    skos:altLabel "quantos mva instalados"@pt ;
    skos:altLabel "lista de transformadores"@pt ;
    ons:exampleQuestion "Qual é a capacidade total de transformação instalada por subsistema no SIN?"@pt ;
    ons:exampleQuestion "Quais subestações possuem maior potência nominal de transformação instalada?"@pt ;
    ons:exampleQuestion "Quais agentes proprietários detêm mais transformadores de extra-alta tensão (500 kV ou acima)?"@pt ;
    ons:exampleQuestion "Quantos transformadores de três enrolamentos estão cadastrados na Rede Básica?"@pt ;
    ons:exampleQuestion "Quais transformadores foram desativados nos últimos anos e qual era sua capacidade?"@pt ;
    ons:exampleQuestion "Subestações com trafo de 765 kV em operação"@pt ;
    ons:exampleQuestion "Qual a maior potência nominal de trafo em MG?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver capacidade instalada de transformação, inventário de transformadores da Rede Básica, potência nominal em MVA por subestação ou subsistema, tensões de transformação (primário/secundário/terciário), agentes proprietários de transformadores ou análise de infraestrutura de transformação do SIN. Também relevante para perguntas sobre adequação da rede de transmissão, expansão de subestações e estudos de fluxo de potência que requerem dados cadastrais de transformadores."@pt ;
    ons:agentInstruction "- [val_tensaoterciario_kv] Parte dos registros possuem val_tensaoterciario_kv nulo. Comportamento esperado para transformadores de dois enrolamentos, que não possuem enrolamento terciário. Filtrar por nom_tipotransformador antes de agregar para evitar distorções.\n\n- [num_barra_primario] Poucos registros possuem num_barra_primario nulo, indicando transformadores sem barra primária cadastrada no modelo de rede. Pode impactar joins com datasets de modelagem elétrica e estudos de fluxo de potência.\n\n- [num_barra_secundario] Poucos registros possuem num_barra_secundario nulo, proporção maior que num_barra_primario. Transformadores sem barra secundária cadastrada podem estar em processo de comissionamento ou com dados incompletos no sistema de origem.\n\n- [dat_entradaoperacao] Coluna armazenada como VARCHAR no Parquet. Pode conter formatos de data heterogêneos (YYYY-MM-DD, DD/MM/YYYY, etc.) provenientes do sistema de origem. Requer TRY_CAST ou strptime para uso em filtros e ordenações temporais.\n\n- [dat_desativacao] Coluna armazenada como VARCHAR no Parquet. Pode conter formatos de data heterogêneos. Requer TRY_CAST para uso em filtros temporais. As datas cadastradas de desativacao comecam em 1990-12-31 e alcancam o presente; sao um cadastro, nao uma serie temporal de medicoes.\n\n- [cod_equipamento] cod_equipamento é a chave primária natural esperada. Duplicatas indicariam inconsistência cadastral no sistema de origem ONS. Verificar existência de registros duplicados antes de usar como chave de join.\n\n- [val_potencianominal_mva] Potência nominal varia de 4,687 MVA a 1650 MVA. O valor mínimo de 4,687 MVA é incomum para transformadores da rede básica (tipicamente acima de 25 MVA) e pode indicar erro de cadastro ou equipamento de características especiais. O máximo de 1650 MVA corresponde a grandes autotransformadores de 765/500 kV.\n\n- [nom_tipoderede] Valores com trailing spaces detectados em 'nom_tipoderede'. Use TRIM() em filtros WHERE para evitar perda de registros."@pt ;
    dct:accrualPeriodicity "STATIC" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/capacidade-transformacao/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "1965-03-29/" ;
