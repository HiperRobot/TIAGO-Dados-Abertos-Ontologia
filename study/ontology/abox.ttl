<https://w3id.org/tiago-ons/data/column/restricao_coff_fotovoltaica_detail/val_geracaoreferenciafinal>
    a ons:Column ;
    dct:title "val_geracaoreferenciafinal" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Geração de Referência Final, em MWmed. Considera as regras de apuração estabelecidas na RO-AO.BR.13 aplicadas na Geração de Referência do Conjunto e distribuição proporcional nas usinas. O valor é calculado apenas para os patamares em que houve restrição por indisponibilidade externa (REL), sendo encaminhado pelo ONS à CCEE para fins de obtenção da geração frustrada e cálculo dos ESS por constrained-off. Ausente nos arquivos de 2024-05 a 2024-12 (publicados no schema anterior); com union_by_name=true vem como NULL nesses meses. Agregados de 2024 nesta coluna cobrem apenas abril; declare a cobertura ao responder."@pt ;
    skos:altLabel "geracao_referencia_final"@pt ;
    skos:altLabel "referencia_final"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

