    ons:aggregationSQL "{\"count_eligible\": {\"sql\": \"COUNT(CASE WHEN flg_cpsa = 1.0 THEN 1 END)\", \"unit\": \"usinas\"}, \"count_not_eligible\": {\"sql\": \"COUNT(CASE WHEN flg_cpsa = 0.0 THEN 1 END)\", \"unit\": \"usinas\"}, \"rate_eligible\": {\"sql\": \"COUNT(CASE WHEN flg_cpsa = 1.0 THEN 1 END) * 1.0 / COUNT(flg_cpsa)\", \"unit\": \"proporcao\"}}" .

