<https://w3id.org/tiago-ons/data/column/ind_confiarb_ciper/val_ciper1>
    a ons:Column ;
    dct:title "val_ciper1" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Componente principal do Indicador de Carga Interrompida por Perturbações (CIPER), conforme Submódulo 9.1 dos Procedimentos de Rede do ONS. Representa a carga interrompida total em decorrência de perturbações no sistema elétrico. Possui o maior range de valores (0 a 345 MW), sendo o indicador de maior abrangência."@pt ;
    skos:altLabel "ciper1"@pt ;
    skos:altLabel "carga_interrompida_1"@pt ;
    skos:altLabel "indicador_ciper_1"@pt ;
    skos:altLabel "ciper_principal"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> .

<https://w3id.org/tiago-ons/data/column/ind_confiarb_ciper/val_ciper2>
    a ons:Column ;
    dct:title "val_ciper2" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Segundo componente do Indicador CIPER, possivelmente representando um subcomponente ou categoria específica de perturbação. Possui range reduzido (0 a 10 MW) em relação ao val_ciper1, sugerindo menor magnitude ou escopo mais restrito."@pt ;
    skos:altLabel "ciper2"@pt ;
    skos:altLabel "carga_interrompida_2"@pt ;
    skos:altLabel "indicador_ciper_2"@pt ;
    ons:semanticRole "METRIC" ;
