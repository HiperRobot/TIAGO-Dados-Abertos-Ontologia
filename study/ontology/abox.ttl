<https://w3id.org/tiago-ons/data/metric/grandezas_fluviometricas/vazaomedia>
    a ons:Metric ;
    skos:prefLabel "Vazaomedia"@pt ;
    skos:altLabel "vazão média"@pt ;
    skos:altLabel "vazão"@pt ;
    skos:altLabel "vazão diária"@pt ;
