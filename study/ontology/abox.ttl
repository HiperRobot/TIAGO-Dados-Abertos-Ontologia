<https://w3id.org/tiago-ons/data/template/energia_vertida_turbinavel/pattern_evt_mensal_por_usina>
    a ons:QueryTemplate ;
    skos:prefLabel "evt_mensal_por_usina" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  nom_reservatorio,\n  SUM(TRY_CAST(val_energiavertidaturbinavel AS DOUBLE) * 0.5) AS evt_mwh\nFROM {source}\nWHERE TRY_CAST(din_instante AS TIMESTAMP) IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/energia_vertida_turbinavel/energiavertidaturbinavel> .

<https://w3id.org/tiago-ons/data/template/energia_vertida_turbinavel/pattern_produtividade_media_por_usina>
    a ons:QueryTemplate ;
    skos:prefLabel "produtividade_media_por_usina" ;
    ons:sqlTemplate "SELECT nom_reservatorio,\n  nom_bacia,\n  AVG(TRY_CAST(val_produtividade AS DOUBLE)) AS produtividade_media\nFROM {source}\nWHERE TRY_CAST(val_produtividade AS DOUBLE) BETWEEN 0.1 AND 10.0\n  AND TRY_CAST(val_vazaoturbinada AS DOUBLE) > 0\nGROUP BY 1, 2\nORDER BY produtividade_media DESC" ;
    ons:outputUnitLabel "MW/(m³/s)" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/energia_vertida_turbinavel/produtividade> .

<https://w3id.org/tiago-ons/data/template/energia_vertida_turbinavel/pattern_geracao_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "geracao_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  nom_reservatorio,\n  SUM(TRY_CAST(val_geracao AS DOUBLE) * 0.5) AS geracao_mwh\nFROM {source}\nWHERE TRY_CAST(din_instante AS TIMESTAMP) IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/energia_vertida_turbinavel/geracao> .

<https://w3id.org/tiago-ons/data/template/energia_vertida_turbinavel/pattern_folga_geracao_horaria>
    a ons:QueryTemplate ;
    skos:prefLabel "folga_geracao_horaria" ;
    ons:sqlTemplate "SELECT din_instante,\n  nom_reservatorio,\n  AVG(TRY_CAST(val_folgadegeracao AS DOUBLE)) AS folga_mwmed\nFROM {source}\nWHERE TRY_CAST(din_instante AS TIMESTAMP) >= CURRENT_TIMESTAMP - INTERVAL '7 days'\nGROUP BY 1, 2\nORDER BY 1" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/energia_vertida_turbinavel/folgadegeracao> .

<https://w3id.org/tiago-ons/data/template/energia_vertida_turbinavel/pattern_energia_vertida_turbinavel_mensal_gwh>
    a ons:QueryTemplate ;
    skos:prefLabel "energia_vertida_turbinavel_mensal_gwh" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_disponibilidade AS VARCHAR) AS DOUBLE)) * 1.0 / 1000, 1) AS val_disponibilidade_gwh,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_energiavertida AS VARCHAR) AS DOUBLE)) * 1.0 / 1000, 1) AS val_energiavertida_gwh,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_energiavertidaturbinavel AS VARCHAR) AS DOUBLE)) * 1.0 / 1000, 1) AS val_energiavertidaturbinavel_gwh,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_folgadegeracao AS VARCHAR) AS DOUBLE)) * 1.0 / 1000, 1) AS val_folgadegeracao_gwh,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_geracao AS VARCHAR) AS DOUBLE)) * 1.0 / 1000, 1) AS val_geracao_gwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "GWh" .

<https://w3id.org/tiago-ons/data/template/energia_vertida_turbinavel/pattern_energia_vertida_turbinavel_mensal_mwmed>
    a ons:QueryTemplate ;
    skos:prefLabel "energia_vertida_turbinavel_mensal_mwmed" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_disponibilidade AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS val_disponibilidade_mwmed,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_energiavertida AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS val_energiavertida_mwmed,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_energiavertidaturbinavel AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS val_energiavertidaturbinavel_mwmed,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_folgadegeracao AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS val_folgadegeracao_mwmed,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_geracao AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS val_geracao_mwmed\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "MWmed" .

<https://w3id.org/tiago-ons/data/template/energia_vertida_turbinavel/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT cod_usina, nom_reservatorio, nom_bacia, id_subsistema, SUM((val_energiavertidaturbinavel) * 1.0) / 1000 AS total_evt_mwmed, COUNT(*) AS horas_com_vertimento FROM read_parquet('s3://ons-aws-prod-opendata/dataset/energia_vertida_turbinavel_ho/*.parquet') WHERE YEAR(din_instante) = 2024 AND val_energiavertidaturbinavel > 0 GROUP BY cod_usina, nom_reservatorio, nom_bacia, id_subsistema ORDER BY total_evt_mwmed DESC LIMIT 20;" ;
    ons:exampleQuestion "Quais usinas hidrelétricas tiveram maior energia vertida turbinável acumulada no ano de 2024?"@pt .

<https://w3id.org/tiago-ons/data/template/energia_vertida_turbinavel/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_subsistema, DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes_referencia, SUM((val_energiavertidaturbinavel) * 1.0) / 1000 AS total_evt_mwmed, SUM((val_energiavertida) * 1.0) / 1000 AS total_ev_mwmed, CASE WHEN SUM((val_energiavertida) * 1.0) / 1000 > 0 THEN ROUND(SUM((val_energiavertidaturbinavel) * 1.0) / 1000 / SUM((val_energiavertida) * 1.0) / 1000 * 100, 2) ELSE 0 END AS pct_turbinavel FROM read_parquet('s3://ons-aws-prod-opendata/dataset/energia_vertida_turbinavel_ho/*.parquet') WHERE din_instante >= '2020-01-01' AND din_instante < '2025-01-01' GROUP BY id_subsistema, nom_subsistema, DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) ORDER BY id_subsistema, mes_referencia;" ;
    ons:exampleQuestion "Como evoluiu mensalmente a energia vertida turbinável em cada subsistema elétrico entre 2020 e 2024?"@pt .

<https://w3id.org/tiago-ons/data/template/energia_vertida_turbinavel/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT cod_usina, nom_reservatorio, nom_bacia, id_subsistema, COUNT(*) AS horas_com_evt, ROUND(AVG(val_geracao), 2) AS geracao_media_mwmed, ROUND(AVG(val_disponibilidade), 2) AS disponibilidade_media_mwmed, ROUND(AVG(val_energiavertidaturbinavel), 2) AS evt_medio_mwmed, CASE WHEN AVG(val_disponibilidade) > 0 THEN ROUND(AVG(val_geracao) / AVG(val_disponibilidade) * 100, 2) ELSE NULL END AS fator_aproveitamento_pct FROM read_parquet('s3://ons-aws-prod-opendata/dataset/energia_vertida_turbinavel_ho/*.parquet') WHERE YEAR(din_instante) = 2023 AND val_energiavertidaturbinavel > 0 AND val_disponibilidade > 0 GROUP BY cod_usina, nom_reservatorio, nom_bacia, id_subsistema ORDER BY evt_medio_mwmed DESC LIMIT 30;" ;
    ons:exampleQuestion "Qual o fator de aproveitamento hidráulico (geração / disponibilidade) médio por usina em 2023, considerando apenas horas com vertimento turbinável?"@pt .

<https://w3id.org/tiago-ons/data/dataset/equipamento_controle_reativo>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:equipamento-controle-reativo" ;
    dct:title "equipamento-controle-reativo" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/transmissao> ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "capacitor shunt"@pt ;
    dcat:keyword "capacitor-shunt"@pt ;
    dcat:keyword "compensador estático de reativos"@pt ;
    dcat:keyword "compensador síncrono"@pt ;
    dcat:keyword "compensador-estatico"@pt ;
    dcat:keyword "compensador-sincrono"@pt ;
    dcat:keyword "controle de reativos"@pt ;
    dcat:keyword "controle-de-reativos"@pt ;
    dcat:keyword "equipamento controle reativo"@pt ;
    dcat:keyword "potencia-reativa"@pt ;
    dcat:keyword "reator shunt"@pt ;
    dcat:keyword "reator-shunt"@pt ;
    dcat:keyword "subestacao"@pt ;
    dcat:keyword "transmissao"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Subsidiar operadores do sistema elétrico, planejadores e analistas de transmissão no inventário e caracterização dos ativos de controle de tensão e potência reativa do SIN, suportando decisões de despacho de reativos, controle de tensão em subestações, planejamento da expansão da rede e análises regulatórias de adequação do parque de equipamentos por subsistema e agente proprietário."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver inventário, cadastro ou caracterização de equipamentos de suporte de tensão e controle de potência reativa (reatores shunt, capacitores shunt, compensadores síncronos ou estáticos) nas subestações do SIN."@pt ;
    ons:limitation "93. 93. Valor mínimo de -9999."@pt ;
    dct:source <https://dados.ons.org.br/dataset/equipamento-controle-reativo> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/equipamento_controle_reativo/*.parquet" ;
    skos:altLabel "quantos capacitores existem"@pt ;
    skos:altLabel "compensadores sincronos instalados"@pt ;
    skos:altLabel "equipamentos de controle de tensao"@pt ;
    skos:altLabel "reatores das subestacoes"@pt ;
    skos:altLabel "lista de compensadores"@pt ;
    ons:exampleQuestion "Quais subestações possuem compensadores estáticos de reativos cadastrados no SIN?"@pt ;
    ons:exampleQuestion "Qual é a capacidade total de reativos instalada por subsistema elétrico?"@pt ;
    ons:exampleQuestion "Quais equipamentos de controle de reativos pertencem à FURNAS e estão ativos?"@pt ;
    ons:exampleQuestion "Qual a distribuição de tipos de equipamentos de controle de reativos por estado?"@pt ;
    ons:exampleQuestion "Quais subestações têm limites operativos de Qmin e Qmax definidos para seus compensadores?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver inventário, cadastro ou caracterização de equipamentos de suporte de tensão e controle de potência reativa (reatores shunt, capacitores shunt, compensadores síncronos ou estáticos) nas subestações do SIN. Também relevante para perguntas sobre capacidade instalada de reativos por subestação, subsistema, estado ou agente proprietário, e para análises de adequação do parque de equipamentos de controle de tensão da rede de transmissão."@pt ;
    ons:agentInstruction "- [val_limiteinferior_mvar] A maior parte dos registros possuem val_limiteinferior_mvar nulo no dataset equipamento-controle-reativo, indicando que limites operativos inferiores não estão preenchidos para a grande maioria dos equipamentos cadastrados. Isso limita o uso desta coluna em análises de capacidade operativa.\n\n- [val_limitesuperior_mvar] A maior parte dos registros possuem val_limitesuperior_mvar nulo no dataset equipamento-controle-reativo, indicando que limites operativos superiores não estão preenchidos para a grande maioria dos equipamentos cadastrados. Isso limita o uso desta coluna em análises de capacidade operativa.\n\n- [val_limiteinferior_mvar] val_limiteinferior_mvar no dataset equipamento-controle-reativo apresenta valor mínimo de -9999,9, possivelmente sentinela para \"sem limite inferior definido\". Deve ser filtrado antes de qualquer análise quantitativa de limites operativos.\n\n- [val_limitesuperior_mvar] val_limitesuperior_mvar no dataset equipamento-controle-reativo apresenta valor máximo de 9999,9, possivelmente sentinela para \"sem limite superior definido\". Deve ser filtrado antes de qualquer análise quantitativa de limites operativos.\n\n- [val_potreativanominal_mvar] Parte dos registros possuem val_potreativanominal_mvar nulo no dataset equipamento-controle-reativo. Para um campo que representa a capacidade nominal do equipamento, a ausência compromete análises de capacidade instalada de compensação reativa por subestação ou subsistema.\n\n- [nom_agente_proprietario] Poucos registros possuem nom_agente_proprietario nulo no dataset equipamento-controle-reativo. Embora residual, equipamentos sem agente proprietário identificado podem gerar inconsistências em relatórios de responsabilidade operativa e manutenção.\n\n- [dat_entradaoperacao] dat_entradaoperacao é armazenado como VARCHAR no dataset equipamento-controle-reativo, exigindo conversão explícita para DATE em análises temporais. Podem existir formatos inconsistentes que causariam falha no TRY_CAST.\n\n- [dat_desativacao] dat_desativacao é armazenado como VARCHAR no dataset equipamento-controle-reativo, exigindo conversão explícita para DATE em análises temporais. Podem existir valores padrão (ex: \"9999-12-31\") para equipamentos ainda ativos que devem ser tratados antes de filtros de vigência.\n\n- [cod_equipamento] cod_equipamento é a chave primária natural do dataset equipamento-controle-reativo. Duplicatas indicariam inconsistência cadastral grave, como equipamentos com múltiplos registros ativos simultaneamente.\n\n- [id_subsistema] Valores com trailing spaces detectados em 'id_subsistema'. Use TRIM() em filtros WHERE para evitar perda de registros.\n- [nom_subsistema] Valores com trailing spaces detectados em 'nom_subsistema'. Use TRIM() em filtros WHERE para evitar perda de registros.\n- [nom_estado] Valores com trailing spaces detectados em 'nom_estado'. Use TRIM() em filtros WHERE para evitar perda de registros.\n- [nom_tipoderede] Valores com trailing spaces detectados em 'nom_tipoderede'. Use TRIM() em filtros WHERE para evitar perda de registros.\n- [nom_tipoequipamento] Valores com trailing spaces detectados em 'nom_tipoequipamento'. Use TRIM() em filtros WHERE para evitar perda de registros."@pt ;
    dct:accrualPeriodicity "STATIC" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/equipamento_controle_reativo/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "1988-12-31/" ;
