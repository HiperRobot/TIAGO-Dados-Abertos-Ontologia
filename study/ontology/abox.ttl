<https://w3id.org/tiago-ons/data/column/geracao_usina_2/ceg>
    a ons:Column ;
    dct:title "ceg" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Código de Empreendimento Gerador (CEG) da ANEEL. Identificador regulatório único da usina no cadastro da Agência Nacional de Energia Elétrica. Permite cruzamento com dados regulatórios e de outorga da ANEEL. Pode conter valor vazio ou placeholder para conjuntos Tipo II-C e grupos Tipo III sem CEG individual."@pt ;
    skos:altLabel "codigo_aneel"@pt ;
    skos:altLabel "ceg_aneel"@pt ;
    skos:altLabel "cod_empreendimento"@pt ;
    skos:altLabel "codigo_empreendimento_gerador"@pt ;
    ons:semanticRole "IDENTIFIER" .

<https://w3id.org/tiago-ons/data/column/geracao_usina_2/val_geracao>
    a ons:Column ;
    dct:title "val_geracao" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Valor de geração verificada (medida) da usina no instante horário, em Megawatts (MW). Armazenado como VARCHAR no Parquet devido ao formato de serialização. Para uso numérico em agregações, aplicar TRY_CAST(val_geracao AS DOUBLE). Para usinas Tipo III, representa previsão de geração e não medição verificada. Valores negativos podem ocorrer em usinas reversíveis (bombeamento)."@pt ;
    skos:altLabel "geracao"@pt ;
    skos:altLabel "potencia_gerada"@pt ;
    skos:altLabel "geracao_verificada"@pt ;
    skos:altLabel "geracao_mw"@pt ;
    skos:altLabel "potencia_mw"@pt ;
    skos:altLabel "medicao"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_geracao AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> .

