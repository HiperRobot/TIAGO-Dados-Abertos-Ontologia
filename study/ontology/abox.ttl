<https://w3id.org/tiago-ons/data/dimension/balanco_energia_subsistema/fonte>
    a ons:Dimension ;
    skos:prefLabel "fonte" .

<https://w3id.org/tiago-ons/data/metric/balanco_energia_subsistema/geracao_total>
    a ons:Metric ;
    skos:prefLabel "Geração Total"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_energia_subsistema/val_gerhidraulica> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_energia_subsistema/val_gertermica> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_energia_subsistema/val_gereolica> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_energia_subsistema/val_gersolar> ;
    ons:expression "TRY_CAST(val_gerhidraulica AS DOUBLE) + TRY_CAST(val_gertermica AS DOUBLE) + TRY_CAST(val_gereolica AS DOUBLE) + TRY_CAST(val_gersolar AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "1.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(val_gerhidraulica AS DOUBLE) + TRY_CAST(val_gertermica AS DOUBLE) + TRY_CAST(val_gereolica AS DOUBLE) + TRY_CAST(val_gersolar AS DOUBLE)) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_gerhidraulica AS DOUBLE) + TRY_CAST(val_gertermica AS DOUBLE) + TRY_CAST(val_gereolica AS DOUBLE) + TRY_CAST(val_gersolar AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_gerhidraulica AS DOUBLE) + TRY_CAST(val_gertermica AS DOUBLE) + TRY_CAST(val_gereolica AS DOUBLE) + TRY_CAST(val_gersolar AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_gerhidraulica AS DOUBLE) + TRY_CAST(val_gertermica AS DOUBLE) + TRY_CAST(val_gereolica AS DOUBLE) + TRY_CAST(val_gersolar AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(val_gerhidraulica AS DOUBLE) + TRY_CAST(val_gertermica AS DOUBLE) + TRY_CAST(val_gereolica AS DOUBLE) + TRY_CAST(val_gersolar AS DOUBLE)) * 1.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_gerhidraulica AS DOUBLE) + TRY_CAST(val_gertermica AS DOUBLE) + TRY_CAST(val_gereolica AS DOUBLE) + TRY_CAST(val_gersolar AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

