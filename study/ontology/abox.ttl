<https://w3id.org/tiago-ons/data/column/classificacao_evt/din_instante>
    a ons:Column ;
    dct:title "din_instante" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Instante de referência horária do registro de Energia Vertida Turbinável (EVT), armazenado como string no formato ISO 8601 (ex: \"2024-01-01T00:00:00\"). Representa o início de cada hora do Sistema Interligado Nacional (SIN). Requer TRY_CAST para uso em filtros temporais e joins com outros datasets horários."@pt ;
    skos:altLabel "instante"@pt ;
    skos:altLabel "data_hora"@pt ;
    skos:altLabel "timestamp"@pt ;
    skos:altLabel "hora"@pt ;
    skos:altLabel "data_instante"@pt ;
    skos:altLabel "din_instante"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/classificacao_evt/val_evt_verificado>
    a ons:Column ;
    dct:title "val_evt_verificado" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Valor verificado (realizado) da Energia Vertida Turbinável (EVT) do Sistema Interligado Nacional para o instante horário correspondente. Representa o total de energia que foi vertida e poderia ter sido turbinada, mas não foi aproveitada. Armazenado como VARCHAR devido ao formato de serialização; requer TRY_CAST para uso analítico."@pt ;
    skos:altLabel "evt_verificado"@pt ;
    skos:altLabel "energia_vertida_turbinavel"@pt ;
    skos:altLabel "evt_realizado"@pt ;
    skos:altLabel "vertimento_turbinavel"@pt ;
    skos:altLabel "val_evt"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_evt_verificado AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/classificacao_evt/val_evt_razaoenergetica>
    a ons:Column ;
    dct:title "val_evt_razaoenergetica" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Parcela da Energia Vertida Turbinável (EVT) classificada como de razão energética, ou seja, vertimento causado por limitações de capacidade de armazenamento ou afluência excessiva sob perspectiva do balanço energético do sistema. Armazenado como VARCHAR devido ao formato de serialização; requer TRY_CAST para uso analítico."@pt ;
    skos:altLabel "evt_razao_energetica"@pt ;
    skos:altLabel "razao_energetica"@pt ;
    skos:altLabel "evt_energetico"@pt ;
    skos:altLabel "vertimento_energetico"@pt ;
    skos:altLabel "val_razao_energetica"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_evt_razaoenergetica AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/classificacao_evt/val_evt_razaoeletrica>
    a ons:Column ;
    dct:title "val_evt_razaoeletrica" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Parcela da Energia Vertida Turbinável (EVT) classificada como de razão elétrica, ou seja, vertimento causado por restrições elétricas do sistema de transmissão (congestionamentos, limites de intercâmbio, etc.) que impedem o aproveitamento da energia disponível. Armazenado como VARCHAR devido ao formato de serialização; requer TRY_CAST para uso analítico."@pt ;
    skos:altLabel "evt_razao_eletrica"@pt ;
    skos:altLabel "razao_eletrica"@pt ;
    skos:altLabel "evt_eletrico"@pt ;
    skos:altLabel "vertimento_eletrico"@pt ;
    skos:altLabel "val_razao_eletrica"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_evt_razaoeletrica AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/metric/classificacao_evt/evt_verificado>
    a ons:Metric ;
    skos:prefLabel "Evt Verificado"@pt ;
    skos:altLabel "evt_verificado"@pt ;
    skos:altLabel "energia_vertida_turbinavel"@pt ;
    skos:altLabel "evt_realizado"@pt ;
    skos:altLabel "vertimento_turbinavel"@pt ;
    skos:altLabel "val_evt"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/classificacao_evt/val_evt_verificado> ;
    ons:expression "TRY_CAST(val_evt_verificado AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "1.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM(TRY_CAST(val_evt_verificado AS DOUBLE)) * 1.0\", \"unit\": \"MWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_evt_verificado AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_evt_verificado AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"SUM(TRY_CAST(val_evt_verificado AS DOUBLE)) * 1.0\", \"unit\": \"MWh\"}, \"comparison\": {\"sql\": \"SUM(TRY_CAST(val_evt_verificado AS DOUBLE)) * 1.0\", \"unit\": \"MWh\"}}" .

