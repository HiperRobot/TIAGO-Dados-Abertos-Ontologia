<https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_conversor/cod_caracteristica>
    a ons:Column ;
    dct:title "cod_caracteristica" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Código identificador da característica técnica do conversor, provavelmente representando o nível de tensão ou tipo de Função Transmissão Conversora (FTConv) agregada. Utilizado para segmentar os indicadores de disponibilidade por categoria técnica do equipamento conversor."@pt ;
    skos:altLabel "caracteristica"@pt ;
    skos:altLabel "nivel_tensao"@pt ;
    skos:altLabel "tipo_conversor"@pt ;
    skos:altLabel "categoria_conversor"@pt ;
    skos:altLabel "cod_ft_conversor"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "FT - 13.8" ;
    ons:allowedValue "FT - 500" ;
    ons:allowedValue "FT - 525" ;
    ons:allowedValue "FT - 800" .

<https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_conversor/dat_referencia>
    a ons:Column ;
    dct:title "dat_referencia" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data de referência do indicador de disponibilidade, sempre no primeiro dia do mês (ex: 2023-01-01, 2023-02-01), confirmando granularidade mensal. Representa o mês de competência do indicador DISPFTConv calculado."@pt ;
    skos:altLabel "data_referencia"@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "mes_referencia"@pt ;
    skos:altLabel "competencia"@pt ;
    skos:altLabel "periodo"@pt ;
    skos:altLabel "dat_ref"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_conversor/val_dispftconv>
