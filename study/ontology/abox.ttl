    dct:description "Nome completo do subsistema elétrico correspondente ao id_subsistema. Exemplos: Sudeste/Centro-Oeste, Sul, Nordeste, Norte."@pt ;
    skos:altLabel "nome subsistema"@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "região"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "NORDESTE" ;
    ons:allowedValue "NORTE" ;
    ons:allowedValue "SISTEMA INTERLIGADO NACIONAL" ;
    ons:allowedValue "SUDESTE/CENTRO-OESTE" ;
    ons:allowedValue "SUL" .

<https://w3id.org/tiago-ons/data/column/balanco_energia_subsistema/din_instante>
    a ons:Column ;
    dct:title "din_instante" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data e hora do registro horário do balanço de energia. Representa o instante de referência (início do intervalo horário) para os valores de geração, carga e intercâmbio registrados. Granularidade horária confirmada pela descrição CKAN e pelo tipo TIMESTAMP no schema físico. Compõe a chave primária natural junto com id_subsistema."@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "hora"@pt ;
    skos:altLabel "instante"@pt ;
    skos:altLabel "data hora"@pt ;
    skos:altLabel "timestamp"@pt ;
    skos:altLabel "data e hora"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/balanco_energia_subsistema/val_gerhidraulica>
    a ons:Column ;
    dct:title "val_gerhidraulica" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Geração hidráulica verificada no subsistema no instante de referência, expressa em MWmed. Representa a potência média gerada pelas usinas hidrelétricas do subsistema no intervalo horário. Valores negativos são fisicamente impossíveis em condições normais (exceto usinas reversíveis, raras no SIN)."@pt ;
    skos:altLabel "geração hidráulica"@pt ;
    skos:altLabel "geração hidrelétrica"@pt ;
    skos:altLabel "hidráulica"@pt ;
    skos:altLabel "hidro"@pt ;
    skos:altLabel "geração hídrica"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_gerhidraulica AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/unit/mwmed>
    a ons:Unit ;
    skos:prefLabel "MWmed" ;
    skos:altLabel "MWmed" .

<https://w3id.org/tiago-ons/data/column/balanco_energia_subsistema/val_gertermica>
    a ons:Column ;
    dct:title "val_gertermica" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Geração térmica verificada no subsistema no instante de referência, expressa em MWmed. Inclui usinas termelétricas a gás natural, carvão, óleo combustível, nuclear e biomassa despachadas no período. Valores negativos são fisicamente impossíveis."@pt ;
    skos:altLabel "geração térmica"@pt ;
    skos:altLabel "geração termelétrica"@pt ;
    skos:altLabel "térmica"@pt ;
    skos:altLabel "termelétrica"@pt ;
    skos:altLabel "despacho térmico"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_gertermica AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/balanco_energia_subsistema/val_gereolica>
    a ons:Column ;
    dct:title "val_gereolica" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Geração eólica verificada no subsistema no instante de referência, expressa em MWmed. Representa a potência média gerada pelos parques eólicos do subsistema no intervalo horário. Valores próximos de zero são esperados para o subsistema Norte (N) e para períodos anteriores à expansão eólica (~2005)."@pt ;
    skos:altLabel "geração eólica"@pt ;
    skos:altLabel "eólica"@pt ;
    skos:altLabel "vento"@pt ;
    skos:altLabel "geração eólica verificada"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_gereolica AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/balanco_energia_subsistema/val_gersolar>
    a ons:Column ;
    dct:title "val_gersolar" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Geração solar fotovoltaica verificada no subsistema no instante de referência, expressa em MWmed. Inclui geração centralizada (UFV) e distribuída (GD solar). Valores zero são esperados em períodos noturnos e em anos anteriores à expansão solar (~2015). Pode incluir geração distribuída a partir de determinado período de revisão metodológica."@pt ;
    skos:altLabel "geração solar"@pt ;
    skos:altLabel "solar"@pt ;
    skos:altLabel "fotovoltaica"@pt ;
    skos:altLabel "geração fotovoltaica"@pt ;
    skos:altLabel "GD solar"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_gersolar AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/balanco_energia_subsistema/val_carga>
    a ons:Column ;
    dct:title "val_carga" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Carga verificada (demanda de energia elétrica) no subsistema no instante de referência, expressa em MWmed. Representa o consumo total verificado no subsistema, incluindo perdas de transmissão e distribuição. É a variável central do balanço carga-geração. Valores zero ou negativos são fisicamente impossíveis para subsistemas em operação normal."@pt ;
    skos:altLabel "carga"@pt ;
    skos:altLabel "demanda"@pt ;
    skos:altLabel "consumo"@pt ;
    skos:altLabel "carga verificada"@pt ;
    skos:altLabel "demanda verificada"@pt ;
    skos:altLabel "carga do sistema"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_carga AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/balanco_energia_subsistema/val_intercambio>
    a ons:Column ;
    dct:title "val_intercambio" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Intercâmbio líquido de energia verificado no subsistema no instante de referência, expresso em MWmed. Valor positivo indica exportação líquida; valor negativo indica importação líquida. A soma dos intercâmbios de todos os subsistemas para um mesmo din_instante deve ser próxima de zero (balanço sistêmico do SIN)."@pt ;
    skos:altLabel "intercâmbio"@pt ;
    skos:altLabel "intercambio"@pt ;
    skos:altLabel "troca de energia"@pt ;
    skos:altLabel "exportação"@pt ;
    skos:altLabel "importação"@pt ;
    skos:altLabel "fluxo entre subsistemas"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_intercambio AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/perspective/verificado>
    a ons:Perspective ;
    skos:prefLabel "verificado" .

<https://w3id.org/tiago-ons/data/dimension/balanco_energia_subsistema/subsistema>
    a ons:Dimension ;
    skos:prefLabel "subsistema" ;
    ons:onColumn <https://w3id.org/tiago-ons/data/column/balanco_energia_subsistema/id_subsistema> ;
