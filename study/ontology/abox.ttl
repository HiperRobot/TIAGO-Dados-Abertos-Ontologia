<https://w3id.org/tiago-ons/data/family/ind_disponibilidade_ft>
    a ons:Family ;
    skos:prefLabel "ind_disponibilidade_ft" .

<https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_ft_conversor/dispftconv>
    a ons:Metric ;
    skos:prefLabel "Disponibilidade FT Conversora (DISPFTConv)"@pt ;
    skos:altLabel "disponibilidade_conversor"@pt ;
    skos:altLabel "disp_ft_conv"@pt ;
    skos:altLabel "disponibilidade_ftconv"@pt ;
    skos:altLabel "indicador_disponibilidade"@pt ;
    skos:altLabel "percentual_disponibilidade"@pt ;
    skos:altLabel "val_disp"@pt ;
    skos:altLabel "DISPFTConv"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_conversor/val_dispftconv> ;
    ons:expression "val_dispftconv" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/ratio> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/avg> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(val_dispftconv)\", \"unit\": \"%\"}, \"maximum\": {\"sql\": \"MAX(val_dispftconv)\", \"unit\": \"%\"}, \"minimum\": {\"sql\": \"MIN(val_dispftconv)\", \"unit\": \"%\"}, \"time_series\": {\"sql\": \"AVG(val_dispftconv)\", \"unit\": \"%\"}, \"ranking\": {\"sql\": \"AVG(val_dispftconv)\", \"unit\": \"%\"}, \"comparison\": {\"sql\": \"AVG(val_dispftconv)\", \"unit\": \"%\"}}" .

<https://w3id.org/tiago-ons/data/value/ind_disponibilidade_ft_conversor/cod_caracteristica/ft_13_8>
    a ons:ValueAlias ;
    skos:notation "FT - 13.8" ;
