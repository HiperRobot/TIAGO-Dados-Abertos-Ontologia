    ons:physicalType "DOUBLE" ;
    dct:description "Indicador de Pontualidade do Cumprimento às Providências (PCPA), calculado conforme o Submódulo 9.5 dos Procedimentos de Rede do ONS. Representa a razão entre o número de providências concluídas no prazo (num_nprcp_concluidas_prazo) e o número de providências concluídas (num_nprc_concluidas). Varia entre 0.0 e 1.0, onde 1.0 indica que todas as providências concluídas foram cumpridas pontualmente."@pt ;
    skos:altLabel "pcpa"@pt ;
    skos:altLabel "pontualidade do cumprimento"@pt ;
    skos:altLabel "indice pcpa"@pt ;
    skos:altLabel "pontualidade de providencias"@pt ;
    skos:altLabel "taxa de pontualidade"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/indice_normalizado_0_1> .

