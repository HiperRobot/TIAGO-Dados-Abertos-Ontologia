    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(val_vazaomedia)\", \"unit\": \"m³/s\"}, \"peak\": {\"sql\": \"MAX(val_vazaomedia)\", \"unit\": \"m³/s\"}, \"minimum\": {\"sql\": \"MIN(val_vazaomedia)\", \"unit\": \"m³/s\"}, \"time_series\": {\"sql\": \"AVG(val_vazaomedia)\", \"unit\": \"m³/s\"}, \"ranking\": {\"sql\": \"AVG(val_vazaomedia)\", \"unit\": \"m³/s\"}, \"comparison\": {\"sql\": \"AVG(val_vazaomedia)\", \"unit\": \"m³/s\"}}" .

