<https://w3id.org/tiago-ons/data/value/ind_disponibilidade_ft_conversor/val_dispftconv/indisponibilidade_total>
    a ons:ValueAlias ;
    skos:notation "indisponibilidade_total" ;
    ons:onColumn <https://w3id.org/tiago-ons/data/column/ind_disponibilidade_ft_conversor/val_dispftconv> ;
    skos:altLabel "indisponivel"@pt ;
    skos:altLabel "indisponibilidade total"@pt ;
