<https://w3id.org/tiago-ons/data/column/interrupcao_carga/val_cargainterrompida_mw>
    a ons:Column ;
    dct:title "val_cargainterrompida_mw" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Valor da carga interrompida em megawatts (MW) durante o evento de perturbação. Conforme critério CKAN, eventos devem ser superiores a 100 MW por 10 minutos ou mais para serem registrados. Valores observados: mín=0.01 MW, máx=6700.0 MW."@pt ;
    skos:altLabel "carga_interrompida"@pt ;
    skos:altLabel "carga_interrompida_mw"@pt ;
    skos:altLabel "potencia_interrompida"@pt ;
    skos:altLabel "val_carga_mw"@pt ;
    skos:altLabel "interrupcao_mw"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> .

<https://w3id.org/tiago-ons/data/column/interrupcao_carga/val_tempomedio_minutos>
    a ons:Column ;
    dct:title "val_tempomedio_minutos" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Tempo médio de duração da interrupção de carga em minutos. Apresenta valores negativos (mín=-64182.0), indicando possíveis inconsistências nos dados submetidos pelos agentes ou correções retroativas. Valores positivos esperados para eventos válidos; máximo observado: 68102.7 minutos (~47 dias)."@pt ;
    skos:altLabel "tempo_medio"@pt ;
    skos:altLabel "duracao_minutos"@pt ;
    skos:altLabel "tempo_interrupcao"@pt ;
    skos:altLabel "duracao_media"@pt ;
    skos:altLabel "val_tempo_minutos"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/min> .

<https://w3id.org/tiago-ons/data/column/interrupcao_carga/val_energianaosuprida_mwh>
    a ons:Column ;
    dct:title "val_energianaosuprida_mwh" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Energia não suprida em megawatt-hora (MWh) decorrente da interrupção de carga. Calculada a partir da carga interrompida e do tempo de duração. Apresenta valores negativos (mín=-7487.9 MWh), sugerindo correções retroativas ou ajustes de consistência após revisão pelos agentes. Máximo observado: 77509.6 MWh."@pt ;
    skos:altLabel "energia_nao_suprida"@pt ;
    skos:altLabel "ens"@pt ;
    skos:altLabel "energia_nao_fornecida"@pt ;
    skos:altLabel "val_ens"@pt ;
    skos:altLabel "energia_interrompida_mwh"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwh> .

<https://w3id.org/tiago-ons/data/column/interrupcao_carga/flg_envolveuredebasica>
    a ons:Column ;
    dct:title "flg_envolveuredebasica" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Flag indicando se a perturbação envolveu a Rede Básica do sistema elétrico (linhas de transmissão e equipamentos de alta tensão sob responsabilidade das transmissoras). Valores esperados: 'S' (sim) ou 'N' (não), ou equivalentes."@pt ;
    skos:altLabel "envolve_rede_basica"@pt ;
    skos:altLabel "flg_rede_basica"@pt ;
    skos:altLabel "rede_basica"@pt ;
    skos:altLabel "flag_rede_basica"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "N" ;
    ons:allowedValue "S" .

<https://w3id.org/tiago-ons/data/column/interrupcao_carga/flg_envolveuredeoperacao>
    a ons:Column ;
    dct:title "flg_envolveuredeoperacao" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Flag indicando se a perturbação envolveu a Rede de Operação do ONS, conforme definição da RO-AO.BR.03. Valores esperados: 'S' (sim) ou 'N' (não), ou equivalentes. Perturbações na Rede de Distribuição acima de 100 MW por 10 minutos também são registradas."@pt ;
    skos:altLabel "envolve_rede_operacao"@pt ;
    skos:altLabel "flg_rede_operacao"@pt ;
    skos:altLabel "rede_operacao"@pt ;
    skos:altLabel "flag_rede_operacao"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "N" ;
    ons:allowedValue "S" .

