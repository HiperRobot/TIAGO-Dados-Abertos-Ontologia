<https://w3id.org/tiago-ons/data/column/ind_qualid_dfd_meano/id_periodicidade>
    a ons:Column ;
    dct:title "id_periodicidade" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificador da periodicidade do registro, indicando se o valor corresponde a uma apuração mensal ('M') ou anual ('A') do indicador DFD. Mistura ambas as granularidades no mesmo arquivo; filtrar explicitamente para evitar dupla contagem."@pt ;
    skos:altLabel "periodicidade"@pt ;
    skos:altLabel "tipo_periodo"@pt ;
    skos:altLabel "frequencia_apuracao"@pt ;
    skos:altLabel "mensal_anual"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "12" ;
    ons:allowedValue "ME" .

<https://w3id.org/tiago-ons/data/column/ind_qualid_dfd_meano/din_referencia>
    a ons:Column ;
    dct:title "din_referencia" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data e hora de referência do registro, representando o mês ou ano de apuração do indicador DFD. Para registros mensais corresponde ao primeiro dia do mês; para registros anuais corresponde ao primeiro dia do ano."@pt ;
    skos:altLabel "data_referencia"@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "mes_referencia"@pt ;
    skos:altLabel "ano_referencia"@pt ;
    skos:altLabel "periodo"@pt ;
    skos:altLabel "competencia"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/ind_qualid_dfd_meano/id_faixafrequencia>
    a ons:Column ;
    dct:title "id_faixafrequencia" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Código identificador da faixa de frequência monitorada durante os distúrbios, conforme definição do Submódulo 9.7 dos Procedimentos de Rede do ONS. Segmenta o indicador DFD por intervalo de desvio de frequência."@pt ;
    skos:altLabel "codigo_faixa"@pt ;
    skos:altLabel "faixa_frequencia"@pt ;
    skos:altLabel "id_faixa"@pt ;
    skos:altLabel "cod_faixa_frequencia"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "FI1" ;
    ons:allowedValue "FI2" ;
    ons:allowedValue "FI3" ;
    ons:allowedValue "FI4" ;
    ons:allowedValue "FS1" ;
    ons:allowedValue "FS2" ;
    ons:allowedValue "FS3" ;
    ons:allowedValue "FS4" .

<https://w3id.org/tiago-ons/data/column/ind_qualid_dfd_meano/nom_faixafrequencia>
    a ons:Column ;
    dct:title "nom_faixafrequencia" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome descritivo da faixa de frequência monitorada, correspondente ao código id_faixafrequencia. Descreve o intervalo de frequência (em Hz) avaliado no cálculo do indicador DFD conforme Submódulo 9.7."@pt ;
    skos:altLabel "nome_faixa"@pt ;
    skos:altLabel "descricao_faixa"@pt ;
    skos:altLabel "faixa"@pt ;
    skos:altLabel "intervalo_frequencia"@pt ;
    skos:altLabel "nom_faixa"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "56,5Hz <= f < 57,5Hz" ;
    ons:allowedValue "57,5Hz <= f < 58,5Hz" ;
    ons:allowedValue "58,5Hz <= f < 59,5Hz" ;
    ons:allowedValue "60,5Hz < f <= 62,0Hz" ;
    ons:allowedValue "62,0Hz < f <= 63,5Hz" ;
    ons:allowedValue "63,5Hz < f <= 66,0Hz" ;
    ons:allowedValue "66,0Hz < f" ;
    ons:allowedValue "f < 56,5Hz" .

<https://w3id.org/tiago-ons/data/column/ind_qualid_dfd_meano/val_dfd>
    a ons:Column ;
    dct:title "val_dfd" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Valor do Indicador de Desempenho da Frequência em Distúrbios (DFD) para a faixa de frequência e período de referência indicados. Representa a duração acumulada (em minutos) em que a frequência do sistema permaneceu na faixa especificada durante eventos de distúrbio. Valor mínimo observado: 0,0; máximo observado: 608,0."@pt ;
    skos:altLabel "dfd"@pt ;
    skos:altLabel "indicador_dfd"@pt ;
    skos:altLabel "desempenho_frequencia"@pt ;
    skos:altLabel "valor_dfd"@pt ;
    skos:altLabel "val_indicador"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/min> .

<https://w3id.org/tiago-ons/data/metric/ind_qualid_dfd_meano/dfd>
    a ons:Metric ;
    skos:prefLabel "Dfd"@pt ;
    skos:altLabel "dfd"@pt ;
    skos:altLabel "indicador_dfd"@pt ;
    skos:altLabel "desempenho_frequencia"@pt ;
    skos:altLabel "valor_dfd"@pt ;
    skos:altLabel "val_indicador"@pt ;
    skos:altLabel "duracao disturbio frequencia"@pt ;
    skos:altLabel "minutos fora da faixa"@pt ;
    skos:altLabel "tempo em disturbio"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ind_qualid_dfd_meano/val_dfd> ;
    ons:expression "val_dfd" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/duration_minutes> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/min> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "730.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total\": {\"sql\": \"SUM(val_dfd)\", \"unit\": \"min\"}, \"average\": {\"sql\": \"AVG(val_dfd)\", \"unit\": \"min\"}, \"maximum\": {\"sql\": \"MAX(val_dfd)\", \"unit\": \"min\"}, \"time_series\": {\"sql\": \"SUM(val_dfd)\", \"unit\": \"min\"}, \"ranking\": {\"sql\": \"SUM(val_dfd)\", \"unit\": \"min\"}, \"comparison\": {\"sql\": \"SUM(val_dfd)\", \"unit\": \"min\"}}" .

