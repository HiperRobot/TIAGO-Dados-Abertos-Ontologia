<https://w3id.org/tiago-ons/data/column/ear_diario_por_ree_reservatorio_equivalente_de_energia/nom_ree>
    a ons:Column ;
    dct:title "nom_ree" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome do Reservatório Equivalente de Energia (REE), que representa uma agregação de usinas hidrelétricas por bacia hidrográfica e subsistema do SIN. É a dimensão espacial principal do dataset, equivalente conceitualmente a um subsistema/bacia."@pt ;
    skos:altLabel "reservatório equivalente"@pt ;
    skos:altLabel "REE"@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "bacia"@pt ;
    skos:altLabel "nome do REE"@pt ;
    skos:altLabel "nome do reservatório equivalente"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "BELO MONTE" ;
    ons:allowedValue "IGUACU" ;
    ons:allowedValue "ITAIPU" ;
    ons:allowedValue "MADEIRA" ;
    ons:allowedValue "MANAUS-AMAPA" ;
    ons:allowedValue "NORDESTE" ;
    ons:allowedValue "NORTE" ;
    ons:allowedValue "PARANA" ;
    ons:allowedValue "PARANAPANEMA" ;
    ons:allowedValue "SUDESTE" ;
    ons:allowedValue "SUL" ;
    ons:allowedValue "TELES PIRES" .

<https://w3id.org/tiago-ons/data/column/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_data>
    a ons:Column ;
    dct:title "ear_data" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Data de referência da medição da energia armazenada, representando o dia em que o nível dos reservatórios foi verificado. Armazenada como VARCHAR no Parquet (formato YYYY-MM-DD), devendo ser convertida para DATE em consultas temporais."@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "data de referência"@pt ;
    skos:altLabel "data da EAR"@pt ;
    skos:altLabel "data do reservatório"@pt ;
    skos:altLabel "dia"@pt ;
    ons:semanticRole "DIMENSION" .

<https://w3id.org/tiago-ons/data/column/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_max_ree>
    a ons:Column ;
