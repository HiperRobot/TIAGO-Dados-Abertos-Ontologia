<https://w3id.org/tiago-ons/data/template/balanco_dessem_geral/pattern_geracao_total_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "geracao_total_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', CAST(din_programacaodia AS DATE)) AS mes, cod_subsistema,\n  SUM((TRY_CAST(val_geracao_renovavel AS DOUBLE) + TRY_CAST(val_geracao_hidraulica AS DOUBLE) + TRY_CAST(val_geracao_termica AS DOUBLE)) * 0.5) / 1000 AS geracao_gwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM CAST(din_programacaodia AS DATE)) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_dessem_geral/geracao_total> .

<https://w3id.org/tiago-ons/data/template/balanco_dessem_geral/pattern_mix_geracao_diario>
    a ons:QueryTemplate ;
    skos:prefLabel "mix_geracao_diario" ;
    ons:sqlTemplate "SELECT CAST(din_programacaodia AS DATE) AS dia, cod_subsistema,\n  SUM(TRY_CAST(val_geracao_hidraulica AS DOUBLE) * 0.5) / 1000 AS hidraulica_gwh,\n  SUM(TRY_CAST(val_geracao_termica AS DOUBLE) * 0.5) / 1000 AS termica_gwh,\n  SUM(TRY_CAST(val_geracao_renovavel AS DOUBLE) * 0.5) / 1000 AS renovavel_gwh\nFROM {source}\nWHERE CAST(din_programacaodia AS DATE) = '{date}'\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_dessem_geral/geracao_hidraulica> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_dessem_geral/geracao_termica> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_dessem_geral/geracao_renovavel> .

<https://w3id.org/tiago-ons/data/template/balanco_dessem_geral/pattern_participacao_renovavel>
    a ons:QueryTemplate ;
    skos:prefLabel "participacao_renovavel" ;
    ons:sqlTemplate "SELECT CAST(din_programacaodia AS DATE) AS dia, cod_subsistema,\n  AVG(\n    TRY_CAST(val_geracao_renovavel AS DOUBLE) /\n    NULLIF(TRY_CAST(val_geracao_renovavel AS DOUBLE) + TRY_CAST(val_geracao_hidraulica AS DOUBLE) + TRY_CAST(val_geracao_termica AS DOUBLE), 0)\n  ) * 100 AS participacao_renovavel_pct\nFROM {source}\nWHERE CAST(din_programacaodia AS DATE) BETWEEN '{start}' AND '{end}'\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_dessem_geral/geracao_renovavel> .

<https://w3id.org/tiago-ons/data/template/balanco_dessem_geral/pattern_pico_demanda_patamar>
    a ons:QueryTemplate ;
    skos:prefLabel "pico_demanda_patamar" ;
    ons:sqlTemplate "SELECT num_patamar, cod_subsistema,\n  MAX(TRY_CAST(val_demanda AS DOUBLE)) AS pico_demanda_mwmed\nFROM {source}\nWHERE CAST(din_programacaodia AS DATE) BETWEEN '{start}' AND '{end}'\nGROUP BY 1, 2\nORDER BY 3 DESC" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/balanco_dessem_geral/demanda> .

<https://w3id.org/tiago-ons/data/template/balanco_dessem_geral/pattern_balanco_dessem_geral_mensal_gwh>
    a ons:QueryTemplate ;
    skos:prefLabel "balanco_dessem_geral_mensal_gwh" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_programacaodia AS TIMESTAMP)) AS mes,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_cons_elevatoria AS VARCHAR) AS DOUBLE)) * 0.5 / 1000, 1) AS val_cons_elevatoria_gwh,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_demanda AS VARCHAR) AS DOUBLE)) * 0.5 / 1000, 1) AS val_demanda_gwh,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_geracao_hidraulica AS VARCHAR) AS DOUBLE)) * 0.5 / 1000, 1) AS val_geracao_hidraulica_gwh,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_geracao_renovavel AS VARCHAR) AS DOUBLE)) * 0.5 / 1000, 1) AS val_geracao_renovavel_gwh,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_geracao_termica AS VARCHAR) AS DOUBLE)) * 0.5 / 1000, 1) AS val_geracao_termica_gwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_programacaodia AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "GWh" .

<https://w3id.org/tiago-ons/data/template/balanco_dessem_geral/pattern_balanco_dessem_geral_mensal_mwmed>
    a ons:QueryTemplate ;
    skos:prefLabel "balanco_dessem_geral_mensal_mwmed" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_programacaodia AS TIMESTAMP)) AS mes,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_cons_elevatoria AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_programacaodia AS TIMESTAMP)), 1) AS val_cons_elevatoria_mwmed,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_demanda AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_programacaodia AS TIMESTAMP)), 1) AS val_demanda_mwmed,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_geracao_hidraulica AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_programacaodia AS TIMESTAMP)), 1) AS val_geracao_hidraulica_mwmed,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_geracao_renovavel AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_programacaodia AS TIMESTAMP)), 1) AS val_geracao_renovavel_mwmed,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_geracao_termica AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_programacaodia AS TIMESTAMP)), 1) AS val_geracao_termica_mwmed\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_programacaodia AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "MWmed" .

<https://w3id.org/tiago-ons/data/template/balanco_dessem_geral/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT cod_subsistema, TRY_CAST(din_programacaodia AS DATE) AS data_programacao, SUM(TRY_CAST(val_geracao_hidraulica AS DOUBLE)) AS total_hidraulica_mwmed, SUM(TRY_CAST(val_geracao_termica AS DOUBLE)) AS total_termica_mwmed, SUM(TRY_CAST(val_geracao_renovavel AS DOUBLE)) AS total_renovavel_mwmed, SUM(TRY_CAST(val_demanda AS DOUBLE)) AS total_demanda_mwmed, ROUND( 100.0 * SUM(TRY_CAST(val_geracao_hidraulica AS DOUBLE)) / NULLIF(SUM(TRY_CAST(val_geracao_hidraulica AS DOUBLE)) + SUM(TRY_CAST(val_geracao_termica AS DOUBLE)) + SUM(TRY_CAST(val_geracao_renovavel AS DOUBLE)), 0), 2 ) AS pct_hidraulica FROM read_parquet('s3://ons-aws-prod-opendata/dataset/balanco_dessem_geral/*.parquet') WHERE TRY_CAST(din_programacaodia AS DATE) = '2025-06-01' AND cod_subsistema <> 'SIN' GROUP BY cod_subsistema, TRY_CAST(din_programacaodia AS DATE) ORDER BY cod_subsistema;" ;
    ons:exampleQuestion "Qual a composição da geração hidráulica, térmica e renovável programada pelo DESSEM para cada subsistema em um dia específico?"@pt .

<https://w3id.org/tiago-ons/data/template/balanco_dessem_geral/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT num_patamar, AVG(TRY_CAST(val_demanda AS DOUBLE)) AS demanda_media_mwmed, MIN(TRY_CAST(val_demanda AS DOUBLE)) AS demanda_min_mwmed, MAX(TRY_CAST(val_demanda AS DOUBLE)) AS demanda_max_mwmed FROM read_parquet('s3://ons-aws-prod-opendata/dataset/balanco_dessem_geral/*.parquet') WHERE cod_subsistema = 'SE' GROUP BY num_patamar ORDER BY num_patamar;" ;
    ons:exampleQuestion "Como varia a demanda programada pelo DESSEM ao longo dos 48 patamares do dia para o subsistema Sudeste?"@pt .

<https://w3id.org/tiago-ons/data/template/balanco_dessem_geral/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT TRY_CAST(din_programacaodia AS DATE) AS data_programacao, cod_subsistema, COUNT(DISTINCT num_patamar) AS qtd_patamares, CASE WHEN COUNT(DISTINCT num_patamar) = 48 THEN 'COMPLETO' ELSE 'INCOMPLETO' END AS status_completude FROM read_parquet('s3://ons-aws-prod-opendata/dataset/balanco_dessem_geral/*.parquet') GROUP BY TRY_CAST(din_programacaodia AS DATE), cod_subsistema ORDER BY status_completude DESC, data_programacao, cod_subsistema;" ;
    ons:exampleQuestion "Existem dias ou subsistemas com menos de 48 patamares no dataset DESSEM geral?"@pt .

<https://w3id.org/tiago-ons/data/dataset/capacidade_geracao>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:capacidade-geracao" ;
    dct:title "capacidade-geracao" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/geracao> ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "UHE"@pt ;
    dcat:keyword "cadastro de usinas ONS"@pt ;
    dcat:keyword "capacidade instalada"@pt ;
    dcat:keyword "capacidade instalada geração"@pt ;
    dcat:keyword "capacidade-instalada"@pt ;
    dcat:keyword "despacho-centralizado"@pt ;
    dcat:keyword "geracao"@pt ;
    dcat:keyword "matriz-eletrica"@pt ;
    dcat:keyword "parque gerador"@pt ;
    dcat:keyword "potencia-efetiva"@pt ;
    dcat:keyword "potência efetiva"@pt ;
    dcat:keyword "potência instalada"@pt ;
    dcat:keyword "unidade-geradora"@pt ;
    dcat:keyword "usina"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Prover o cadastro de referência de capacidade instalada por unidade geradora para analistas de planejamento energético, operadores do sistema elétrico e agentes do setor (geradoras, comercializadoras, reguladores), suportando decisões de despacho centralizado, planejamento da expansão da oferta, cálculo de fator de capacidade, análise de balanço oferta-demanda por subsistema e monitoramento da composição da matriz elétrica brasileira por fonte e região."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver capacidade instalada, potência efetiva, potência nominal ou potência cadastrada de usinas ou unidades geradoras despachadas pelo ONS."@pt ;
    ons:limitation "Coluna armazenada como VARCHAR no schema físico em vez de DATE. Coluna armazenada como VARCHAR no schema físico em vez de DATE. Coluna armazenada como VARCHAR no schema físico em vez de DATE."@pt ;
    dct:source <https://dados.ons.org.br/dataset/capacidade-geracao> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/capacidade-geracao/*.parquet" ;
    skos:altLabel "potencia instalada das usinas"@pt ;
    skos:altLabel "quantas usinas existem"@pt ;
    skos:altLabel "lista de usinas do sin"@pt ;
    skos:altLabel "maiores usinas do brasil"@pt ;
    skos:altLabel "parque gerador brasileiro"@pt ;
    skos:altLabel "quantos megawatts instalados"@pt ;
    skos:altLabel "usinas por estado"@pt ;
    skos:altLabel "tamanho das usinas"@pt ;
    skos:altLabel "quanta energia o brasil pode gerar"@pt ;
    skos:altLabel "potencia das usinas"@pt ;
    skos:altLabel "usinas cadastradas"@pt ;
    ons:exampleQuestion "Qual é a capacidade instalada total de geração hidrelétrica no subsistema Sudeste/Centro-Oeste?"@pt ;
    ons:exampleQuestion "Quais usinas eólicas têm maior potência efetiva cadastrada no Nordeste?"@pt ;
    ons:exampleQuestion "Qual a potência efetiva total por tipo de usina (UHE, UTE, EOL, UFV) no SIN?"@pt ;
    ons:exampleQuestion "Quais unidades geradoras estão cadastradas para a usina de Itaipu e qual a potência de cada uma?"@pt ;
    ons:exampleQuestion "Qual a distribuição de capacidade instalada por modalidade de operação (Tipo I, Tipo II-A, II-B, II-C)?"@pt ;
    ons:exampleQuestion "Qual a potência efetiva total de UTE no Brasil?"@pt ;
    ons:exampleQuestion "Top 10 maiores usinas por potencia no SIN"@pt ;
    ons:exampleQuestion "Quantas unidades geradoras Tucuruí tem?"@pt ;
    ons:exampleQuestion "Potência total operada pela Cemig em todo o SIN"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver capacidade instalada, potência efetiva, potência nominal ou potência cadastrada de usinas ou unidades geradoras despachadas pelo ONS. Também recuperar quando a análise exigir o denominador para cálculo de fator de capacidade (geração real dividida pela potência instalada) ou quando for necessário identificar o parque gerador disponível por subsistema, estado, tipo de usina ou fonte de energia."@pt ;
    ons:agentInstruction "- [dat_entradateste] Campo de data armazenado como VARCHAR no Parquet. Pode conter formatos variados (YYYY-MM-DD, DD/MM/YYYY) ou valores sentinela para UGs sem data de teste registrada. Requer TRY_CAST para operações temporais.\n\n- [dat_entradaoperacao] Campo de data de entrada em operação comercial armazenado como VARCHAR no Parquet. Pode conter formatos variados ou valores sentinela. Requer TRY_CAST para operações temporais.\n\n- [dat_desativacao] Campo de data de desativação armazenado como VARCHAR no Parquet. UGs ativas provavelmente contêm valor sentinela (ex: \"9999-12-31\", \"31/12/9999\") ou string vazia/nula mascarada. Verificar distribuição de valores para identificar convenção adotada.\n\n- [val_potenciaefetiva] Potência efetiva varia de 0,325 MW a 1.350 MW — amplitude de ~4.000x. Valores muito baixos (< 1 MW) podem representar pequenas CGHs legítimas ou erros de cadastro. Valores próximos a 1.350 MW correspondem às unidades de Itaipu. Verificar distribuição para identificar outliers reais.\n\n- [num_unidadegeradora] Número da unidade geradora armazenado como VARCHAR apesar de representar valor numérico sequencial. Pode conter zeros à esquerda, sufixos alfanuméricos ou formatos não padronizados. Usar CAST(num_unidadegeradora AS INTEGER) com cautela.\n\n- [cod_equipamento] cod_equipamento é a chave primária natural esperada do dataset. Verificar se existem duplicatas que possam indicar registros redundantes ou erro de carga do snapshot diário.\n\n- [ceg] O CEG (Código de Empreendimento de Geração) da ANEEL segue formato padronizado (ex: UHE.PH.RS.030040-0.01). Verificar se todos os registros seguem o padrão esperado, pois inconsistências dificultam joins com bases regulatórias da ANEEL.\n\n- [nom_subsistema] Valores com trailing spaces detectados em 'nom_subsistema'. Use TRIM() em filtros WHERE para evitar perda de registros."@pt ;
    dct:accrualPeriodicity "STATIC" ;
