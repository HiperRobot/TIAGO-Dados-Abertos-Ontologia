<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_geracao_sin/pattern_dispf_serie_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "dispf_serie_mensal" ;
    ons:sqlTemplate "SELECT\n  TRY_CAST(dat_referencia AS DATE) AS mes,\n  val_dispf AS disponibilidade_pct\nFROM {source}\nWHERE TRY_CAST(dat_referencia AS DATE) BETWEEN '{data_inicio}' AND '{data_fim}'\nORDER BY 1\n" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_geracao_sin/dispf> .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_geracao_sin/pattern_dispf_media_anual>
    a ons:QueryTemplate ;
    skos:prefLabel "dispf_media_anual" ;
    ons:sqlTemplate "SELECT\n  EXTRACT(YEAR FROM TRY_CAST(dat_referencia AS DATE)) AS ano,\n  AVG(val_dispf) AS dispf_medio_pct,\n  MIN(val_dispf) AS dispf_minimo_pct,\n  MAX(val_dispf) AS dispf_maximo_pct\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(dat_referencia AS DATE)) = {year}\nGROUP BY 1\nORDER BY 1\n" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_geracao_sin/dispf> .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_geracao_sin/pattern_indispff_acima_limiar>
    a ons:QueryTemplate ;
    skos:prefLabel "indispff_acima_limiar" ;
    ons:sqlTemplate "SELECT\n  TRY_CAST(dat_referencia AS DATE) AS mes,\n  val_indispff AS indisponibilidade_forcada_pct\nFROM {source}\nWHERE val_indispff > {limiar}\nORDER BY val_indispff DESC\n" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_geracao_sin/indispff> .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_geracao_sin/pattern_tres_indicadores_serie>
    a ons:QueryTemplate ;
    skos:prefLabel "tres_indicadores_serie" ;
    ons:sqlTemplate "SELECT\n  TRY_CAST(dat_referencia AS DATE) AS mes,\n  val_dispf   AS dispf_pct,\n  val_indisppf AS indisppf_pct,\n  val_indispff AS indispff_pct\nFROM {source}\nORDER BY 1\n" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_geracao_sin/dispf> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_geracao_sin/indisppf> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ind_disponibilidade_geracao_sin/indispff> .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_geracao_sin/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT\n  TRY_CAST(dat_referencia AS DATE) AS competencia,\n  EXTRACT(YEAR FROM TRY_CAST(dat_referencia AS DATE)) AS ano,\n  EXTRACT(MONTH FROM TRY_CAST(dat_referencia AS DATE)) AS mes,\n  ROUND(val_dispf, 4) AS dispf_pct,\n  ROUND(val_indisppf, 4) AS indisppf_pct,\n  ROUND(val_indispff, 4) AS indispff_pct,\n  ROUND(val_dispf + val_indisppf + val_indispff, 4) AS soma_total\nFROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind-disponibilidade-geracao-sin/*.parquet')\nWHERE TRY_CAST(dat_referencia AS DATE) IS NOT NULL\nORDER BY TRY_CAST(dat_referencia AS DATE)" ;
    ons:exampleQuestion "Como evoluíram os indicadores DISPF, INDISPPF e INDISPFF do SIN mês a mês desde 2023?"@pt .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_geracao_sin/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT\n  EXTRACT(YEAR FROM TRY_CAST(dat_referencia AS DATE)) AS ano,\n  ROUND(AVG(val_dispf), 4) AS dispf_medio_pct,\n  ROUND(AVG(val_indisppf), 4) AS indisppf_medio_pct,\n  ROUND(AVG(val_indispff), 4) AS indispff_medio_pct,\n  COUNT(*) AS qtd_competencias\nFROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind-disponibilidade-geracao-sin/*.parquet')\nWHERE TRY_CAST(dat_referencia AS DATE) IS NOT NULL\nGROUP BY EXTRACT(YEAR FROM TRY_CAST(dat_referencia AS DATE))\nORDER BY ano" ;
    ons:exampleQuestion "Qual foi a disponibilidade média do parque gerador nacional por ano?"@pt .

<https://w3id.org/tiago-ons/data/template/ind_disponibilidade_geracao_sin/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT\n  TRY_CAST(dat_referencia AS DATE) AS competencia,\n  ROUND(val_indispff, 4) AS indispff_pct,\n  ROUND(val_dispf, 4) AS dispf_pct,\n  ROUND(val_indisppf, 4) AS indisppf_pct\nFROM read_parquet('s3://ons-aws-prod-opendata/dataset/ind-disponibilidade-geracao-sin/*.parquet')\nWHERE TRY_CAST(dat_referencia AS DATE) IS NOT NULL\nORDER BY val_indispff DESC\nLIMIT 5" ;
    ons:exampleQuestion "Em quais meses a indisponibilidade forçada do SIN foi mais elevada?"@pt .

<https://w3id.org/tiago-ons/data/dataset/ind_confiarb_atls>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:ind_confiarb_atls" ;
    dct:title "ind_confiarb_atls" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/transmissao> ;
    dcat:keyword "ATLS"@pt ;
    dcat:keyword "Indicador de Atendimento aos Limites Sistêmicos"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "Procedimentos de Rede"@pt ;
    dcat:keyword "Submódulo 9.1"@pt ;
    dcat:keyword "confiabilidade"@pt ;
    dcat:keyword "confiabilidade da rede básica"@pt ;
    dcat:keyword "fluxo"@pt ;
    dcat:keyword "indicador operativo"@pt ;
    dcat:keyword "limites sistêmicos"@pt ;
    dcat:keyword "rede básica"@pt ;
    dcat:keyword "transmissão"@pt ;
    dcat:keyword "violação de fluxo"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Permitir que analistas de confiabilidade, planejadores do sistema elétrico e reguladores monitorem o cumprimento dos limites operativos sistêmicos em cada fluxo da rede básica, suportando decisões de reforço de rede, avaliação de desempenho operativo, relatórios regulatórios de qualidade da transmissão e identificação de fluxos críticos com violações recorrentes conforme exigências do Submódulo 9.1 dos Procedimentos de Rede do ONS."@pt ;
    ons:usage "Recuperar este dataset quando o usuário perguntar sobre atendimento a limites sistêmicos, violações operativas em fluxos da rede básica de transmissão, desempenho de confiabilidade por linha de transmissão ou interligação, ou indicadores do Submódulo 9."@pt ;
    ons:limitation "O dataset mistura registros mensais e anuais na mesma tabela sem separação física. O valor mínimo observado de val_atls é 0. O valor máximo de num_horasviolacao é 230."@pt ;
    dct:source <https://dados.ons.org.br/dataset/ind_confiarb_atls> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/ind_confiarb_atls/*.parquet" ;
    skos:altLabel "violacao de limite operativo"@pt ;
    skos:altLabel "atendimento aos limites do sistema"@pt ;
    skos:altLabel "limites sistemicos violados"@pt ;
    ons:exampleQuestion "Quais fluxos da rede básica apresentaram maior número de horas de violação de limites sistêmicos em 2023?"@pt ;
    ons:exampleQuestion "Qual foi a evolução mensal do ATLS para o fluxo Itaipu 500 kV nos últimos 3 anos?"@pt ;
    ons:exampleQuestion "Quais fluxos tiveram val_atls abaixo de 0.95 em mais de 3 meses consecutivos?"@pt ;
    ons:exampleQuestion "Qual é o ranking dos fluxos com pior desempenho de atendimento aos limites sistêmicos no período anual de 2024?"@pt ;
    ons:exampleQuestion "Quantas horas totais de violação sistêmica foram registradas por mês em toda a rede básica em 2022?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando o usuário perguntar sobre atendimento a limites sistêmicos, violações operativas em fluxos da rede básica de transmissão, desempenho de confiabilidade por linha de transmissão ou interligação, ou indicadores do Submódulo 9.1 dos Procedimentos de Rede do ONS. Também relevante para perguntas sobre horas de violação, índice ATLS, ranking de fluxos críticos e relatórios regulatórios de qualidade da transmissão."@pt ;
    ons:agentInstruction "- [id_periodicidade] O dataset mistura registros de periodicidade mensal e anual na mesma tabela. Análises de séries temporais ou agregações sem filtro por id_periodicidade resultarão em dupla contagem, pois os valores anuais são derivados dos mensais. É obrigatório filtrar por id_periodicidade = 'Mensal' ou 'Anual' conforme o objetivo analítico.\n\n- [val_atls] O valor mínimo de val_atls é 0.8288, indicando que alguns fluxos apresentaram atendimento inferior a 83% no período de referência. Esses registros representam situações críticas de violação sistêmica e devem ser investigados separadamente. Verificar se correspondem a períodos de obras, contingências ou eventos extremos.\n\n- [num_horasviolacao] O valor máximo de num_horasviolacao é 230.17 horas, o que representa aproximadamente 31% de um mês de 744 horas (31 dias). Registros com valores elevados de horas de violação merecem atenção especial na análise de conformidade regulatória. Verificar consistência com val_atls correspondente.\n\n- [din_referencia] Verificar se há lacunas temporais na série mensal por fluxo. O volume publicado nao cobre todos os fluxos em todo o periodo: alguns comecaram a ser monitorados depois, outros foram descontinuados. Confira a cobertura por fluxo antes de comparar series.\n\n- [nom_fluxo] Verificar existência de registros duplicados para a chave primária natural (nom_fluxo, id_periodicidade, din_referencia). Duplicatas podem ocorrer em função do processo de consistência recorrente mencionado no CKAN, onde dados são atualizados após publicação inicial.\n"@pt ;
    dct:accrualPeriodicity "anual" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/ind_confiarb_atls/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2017-01-01/" ;
    ons:spatialGrain ons:SIN ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/ind_confiarb_atls/nom_fluxo> ;
    ons:rowKey <https://w3id.org/tiago-ons/data/column/ind_confiarb_atls/nom_fluxo> ;
