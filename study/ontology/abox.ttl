<https://w3id.org/tiago-ons/data/template/ena_diario_por_reservatorio/pattern_ena_bruta_res_mwmed_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "ena_bruta_res_mwmed_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(ena_data AS DATE)) AS mes,\n  id_subsistema,\n  SUM((TRY_CAST(ena_bruta_res_mwmed AS DOUBLE)) * 24.0) / 1000 AS ena_bruta_gwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(ena_data AS DATE)) = {year}\n  AND ena_bruta_res_mwmed IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ena_diario_por_reservatorio/ena_bruta_res_mwmed> .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_reservatorio/pattern_ena_percentual_mlt_por_reservatorio>
    a ons:QueryTemplate ;
    skos:prefLabel "ena_percentual_mlt_por_reservatorio" ;
    ons:sqlTemplate "SELECT nom_reservatorio,\n  AVG(TRY_CAST(ena_bruta_res_percentualmlt AS DOUBLE)) AS ena_bruta_pct_mlt_media,\n  AVG(TRY_CAST(ena_armazenavel_res_percentualmlt AS DOUBLE)) AS ena_arm_pct_mlt_media\nFROM {source}\nWHERE TRY_CAST(ena_data AS DATE) BETWEEN '{data_inicio}' AND '{data_fim}'\n  AND ena_bruta_res_percentualmlt IS NOT NULL\nGROUP BY 1\nORDER BY 2 ASC" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ena_diario_por_reservatorio/ena_bruta_res_percentualmlt> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ena_diario_por_reservatorio/ena_armazenavel_res_percentualmlt> .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_reservatorio/pattern_ena_armazenavel_fio_dagua>
    a ons:QueryTemplate ;
    skos:prefLabel "ena_armazenavel_fio_dagua" ;
    ons:sqlTemplate "SELECT nom_reservatorio,\n  TRY_CAST(ena_data AS DATE) AS data,\n  TRY_CAST(ena_armazenavel_res_mwmed AS DOUBLE) AS ena_armazenavel_mwmed\nFROM {source}\nWHERE tip_reservatorio = 'Fio dagua'\n  AND TRY_CAST(ena_data AS DATE) BETWEEN '{data_inicio}' AND '{data_fim}'\n  AND ena_armazenavel_res_mwmed IS NOT NULL\nORDER BY 1, 2" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ena_diario_por_reservatorio/ena_armazenavel_res_mwmed> .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_reservatorio/pattern_mlt_referencia_por_reservatorio>
    a ons:QueryTemplate ;
    skos:prefLabel "mlt_referencia_por_reservatorio" ;
    ons:sqlTemplate "SELECT nom_reservatorio, nom_ree, id_subsistema,\n  AVG(TRY_CAST(mlt_ena AS DOUBLE)) AS mlt_mwmed\nFROM {source}\nWHERE mlt_ena IS NOT NULL\nGROUP BY 1, 2, 3\nORDER BY 4 DESC" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ena_diario_por_reservatorio/mlt_ena> .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_reservatorio/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT TRY_CAST(ena_data AS DATE) AS data, nom_reservatorio, ena_bruta_res_mwmed, ena_bruta_res_percentualmlt FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ena_reservatorio_di/*.parquet') WHERE nom_reservatorio = 'FURNAS' AND TRY_CAST(ena_data AS DATE) BETWEEN DATE '2023-01-01' AND DATE '2023-12-31' ORDER BY data" ;
    ons:exampleQuestion "Qual foi a ENA bruta diária do reservatório de Furnas em 2023?"@pt .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_reservatorio/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT nom_reservatorio, id_subsistema, nom_bacia, TRY_CAST(ena_data AS DATE) AS data, TRY_CAST(ena_armazenavel_res_percentualmlt AS DOUBLE) AS ena_armazenavel_res_percentualmlt FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ena_reservatorio_di/*.parquet', union_by_name=true) WHERE TRY_CAST(ena_armazenavel_res_percentualmlt AS DOUBLE) < 30.0 AND TRY_CAST(ena_armazenavel_res_percentualmlt AS DOUBLE) IS NOT NULL AND TRY_CAST(ena_data AS DATE) >= (CURRENT_DATE - INTERVAL '30' DAY) ORDER BY TRY_CAST(ena_armazenavel_res_percentualmlt AS DOUBLE) ASC LIMIT 100" ;
    ons:exampleQuestion "Quais reservatórios estiveram com ENA armazenável abaixo de 30% da MLT nos últimos 30 dias?"@pt .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_reservatorio/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_subsistema, DATE_TRUNC('month', TRY_CAST(ena_data AS DATE)) AS mes, SUM(ena_bruta_res_mwmed) AS ena_bruta_total_mwmed, AVG(ena_bruta_res_percentualmlt) AS ena_bruta_media_pct_mlt FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ena_reservatorio_di/*.parquet') WHERE TRY_CAST(ena_data AS DATE) BETWEEN DATE '2023-01-01' AND DATE '2023-12-31' AND ena_bruta_res_mwmed IS NOT NULL GROUP BY id_subsistema, nom_subsistema, DATE_TRUNC('month', TRY_CAST(ena_data AS DATE)) ORDER BY id_subsistema, mes" ;
    ons:exampleQuestion "Qual foi a ENA bruta média mensal por subsistema em 2023, somando todos os reservatórios?"@pt .

<https://w3id.org/tiago-ons/data/dataset/ena_diario_por_subsistema>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:ena-diario-por-subsistema" ;
    dct:title "ena-diario-por-subsistema" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/hidrologia> ;
    dcat:keyword "ENA"@pt ;
    dcat:keyword "ENA bruta diária"@pt ;
    dcat:keyword "ENA diária"@pt ;
    dcat:keyword "ENA subsistema"@pt ;
    dcat:keyword "MLT"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "afluencia"@pt ;
    dcat:keyword "afluência diária por subsistema"@pt ;
    dcat:keyword "energia natural afluente diária"@pt ;
    dcat:keyword "energia-natural-afluente"@pt ;
    dcat:keyword "hidrologia"@pt ;
    dcat:keyword "media-longo-termo"@pt ;
    dcat:keyword "planejamento-energetico"@pt ;
    dcat:keyword "reservatorios"@pt ;
    dcat:keyword "subsistema"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Fornecer aos geradores, comercializadores, planejadores e pesquisadores do setor elétrico brasileiro os indicadores diários de afluência hídrica por subsistema, permitindo avaliação das condições hidrológicas dos reservatórios, projeção do Custo Marginal de Operação (CMO), estudos de planejamento energético de curto e médio prazo, monitoramento de desvios em relação à Média de Longo Termo (MLT) e suporte a decisões de despacho e comercialização de energia no mercado de curto prazo."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver Energia Natural Afluente (ENA), afluência hídrica, condições hidrológicas por subsistema ou desvio em relação à Média de Longo Termo (MLT) em granularidade diária."@pt ;
    ons:limitation "A coluna ena_data é tipada como VARCHAR no schema físico Parquet, embora represente datas no formato YYYY-MM-DD. A ENA Armazenável pode assumir valores negativos em situações de vertimento intenso, quando as vazões vertidas superam as vazões naturais afluentes em determinados reservatórios. Percentuais de MLT da ENA Armazenável extremamente elevados (acima de 300%) ou muito baixos (negativos) podem indicar eventos hidrológicos excepcionais (cheias históricas ou secas severas) ou inconsistências no processo de revisão recorrente dos dados."@pt ;
    dct:source <https://dados.ons.org.br/dataset/ena-diario-por-subsistema> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/ena_subsistema_di/*.parquet" ;
    skos:altLabel "ena do sin"@pt ;
    skos:altLabel "ena por submercado"@pt ;
    skos:altLabel "afluencia do subsistema"@pt ;
    skos:altLabel "quanta chuva chegou ao sistema"@pt ;
    skos:altLabel "condicao hidrologica por regiao"@pt ;
    skos:altLabel "mlt por subsistema"@pt ;
    skos:altLabel "ena do sudeste"@pt ;
    skos:altLabel "ena do nordeste"@pt ;
    ons:exampleQuestion "Qual foi a ENA Bruta do subsistema Sudeste nos últimos 30 dias?"@pt ;
    ons:exampleQuestion "Quais subsistemas apresentaram ENA Armazenável abaixo de 50% da MLT em 2024?"@pt ;
    ons:exampleQuestion "Como evoluiu a ENA Armazenável do subsistema Sul ao longo de 2023?"@pt ;
    ons:exampleQuestion "Qual subsistema teve maior desvio positivo em relação à MLT no verão de 2022?"@pt ;
    ons:exampleQuestion "Qual a média mensal de ENA Bruta por subsistema no primeiro semestre de 2024?"@pt ;
    ons:exampleQuestion "Qual era a ENA armazenável do Sudeste em setembro de 2025?"@pt ;
    ons:exampleQuestion "Qual a media de ENA bruta do Sudeste desde julho?"@pt ;
    ons:exampleQuestion "Historico de ENA armazenavel % MLT do Centro-Oeste nos ultimos 90 dias"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver Energia Natural Afluente (ENA), afluência hídrica, condições hidrológicas por subsistema ou desvio em relação à Média de Longo Termo (MLT) em granularidade diária. Também relevante quando a análise requer correlação entre hidrologia e preços de energia (CMO) ou avaliação de risco hídrico por região do SIN em base diária."@pt ;
    ons:agentInstruction "- [ena_data] A coluna ena_data é tipada como VARCHAR no schema físico Parquet, embora represente datas no formato YYYY-MM-DD. Operações de ordenação lexicográfica funcionam corretamente para este formato ISO, mas filtros por intervalo, funções de data (YEAR, MONTH, DAY, date_trunc) e joins temporais exigem CAST explícito para DATE. Sem o cast, funções como date_trunc() falharão.\n\n- [ena_armazenavel_regiao_mwmed] A ENA Armazenável pode assumir valores negativos em situações de vertimento intenso, quando as vazões vertidas superam as vazões naturais afluentes em determinados reservatórios. Embora fisicamente possível no modelo de cálculo do ONS, valores muito negativos podem indicar inconsistências no processo de consistência recorrente e devem ser investigados antes de uso em modelos.\n\n- [ena_armazenavel_regiao_percentualmlt] Percentuais de MLT da ENA Armazenável extremamente elevados (acima de 300%) ou muito baixos (negativos) podem indicar eventos hidrológicos excepcionais (cheias históricas ou secas severas) ou inconsistências no processo de revisão recorrente dos dados. Recomenda-se verificar esses registros antes de utilizá-los em modelos de precificação ou planejamento.\n\n- [ena_bruta_regiao_percentualmlt] Percentuais de MLT da ENA Bruta acima de 300% ou negativos são estatisticamente atípicos e podem sinalizar eventos extremos ou erros no processo de consistência. A ENA Bruta não deveria ser negativa, pois é calculada pelo produto de vazões naturais (sempre não-negativas) pelas produtividades. Valores negativos indicam possível erro de dados.\n\n- [id_subsistema] Verificar se todos os subsistemas esperados (SE, S, NE, N) possuem registros contínuos para todas as datas do período coberto. Lacunas na série temporal de um subsistema específico podem indicar falhas na coleta ou no processo de publicação, impactando análises de correlação entre subsistemas e cálculos do SIN consolidado.\n\n- [tipos] As colunas `ena_armazenavel_regiao_mwmed`, `ena_armazenavel_regiao_percentualmlt`, `ena_bruta_regiao_mwmed`, `ena_bruta_regiao_percentualmlt` mudam de tipo entre arquivos anuais (texto em uns, número em outros); cada uma traz `castExpression` no schema: use-o em toda agregação e comparação.\n"@pt ;
    dct:accrualPeriodicity "diária" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/ena_subsistema_di/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2021-01-01/" ;
    ons:spatialGrain ons:Subsistema ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/ena_diario_por_subsistema/id_subsistema> ;
    ons:rowKey <https://w3id.org/tiago-ons/data/column/ena_diario_por_subsistema/id_subsistema> ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/ena_diario_por_subsistema/nom_subsistema> ;
