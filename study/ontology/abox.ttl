    ons:aggregationSQL "{\"total\": {\"sql\": \"AVG(val_freqmaxmin)\", \"unit\": \"Hz\"}, \"average\": {\"sql\": \"AVG(val_freqmaxmin)\", \"unit\": \"Hz\"}, \"maximum\": {\"sql\": \"MAX(val_freqmaxmin)\", \"unit\": \"Hz\"}, \"time_series\": {\"sql\": \"AVG(val_freqmaxmin)\", \"unit\": \"Hz\"}, \"ranking\": {\"sql\": \"MIN(val_freqmaxmin)\", \"unit\": \"Hz\"}, \"comparison\": {\"sql\": \"AVG(val_freqmaxmin)\", \"unit\": \"Hz\"}}" .

