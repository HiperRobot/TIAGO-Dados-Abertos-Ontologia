    ons:allowedValue "Nordeste" ;
    ons:allowedValue "Norte" ;
    ons:allowedValue "Sudeste/Centro-Oeste" ;
    ons:allowedValue "Sul" .

<https://w3id.org/tiago-ons/data/column/carga_energia/din_instante>
    a ons:Column ;
    dct:title "din_instante" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data e hora de referência do registro de carga de energia. Representa o instante de apuração diária. Publicado duas vezes ao dia (12h e 19h), podendo gerar registros duplicados intradiários para a mesma data e subsistema. Para análises diárias, recomenda-se agregar por DATE(din_instante)."@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "instante"@pt ;
    skos:altLabel "data referência"@pt ;
    skos:altLabel "din instante"@pt ;
    skos:altLabel "data carga"@pt ;
    skos:altLabel "timestamp"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/carga_energia/val_cargaenergiamwmed>
    a ons:Column ;
    dct:title "val_cargaenergiamwmed" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Valor da carga de energia do subsistema no instante de referência, expresso em MWmed (megawatts médios). Representa a demanda média de energia elétrica atendida no período diário. A metodologia de cálculo evoluiu ao longo do tempo: até fev/2021 considera apenas usinas despachadas/programadas pelo ONS; entre mar/2021 e abr/2023 inclui previsão de geração de usinas não despachadas; a partir de 29/04/2023 incorpora também estimativa de micro e minigeração distribuída (MMGD). Apresenta poucos nulos — aceitável operacionalmente."@pt ;
    skos:altLabel "carga"@pt ;
    skos:altLabel "carga energia"@pt ;
    skos:altLabel "carga MWmed"@pt ;
    skos:altLabel "demanda"@pt ;
    skos:altLabel "demanda energia"@pt ;
    skos:altLabel "consumo energia"@pt ;
    skos:altLabel "val carga energia mwmed"@pt ;
    skos:altLabel "carga subsistema"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_cargaenergiamwmed AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/family/carga>
    a ons:Family ;
    skos:prefLabel "carga" .

<https://w3id.org/tiago-ons/data/dimension/carga_energia/subsistema>
    a ons:Dimension ;
