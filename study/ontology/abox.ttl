<https://w3id.org/tiago-ons/data/column/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_verif_ree_mwmes>
    a ons:Column ;
    dct:title "ear_verif_ree_mwmes" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Energia Armazenada Verificada no REE em MWmês, representando a energia associada ao volume de água efetivamente disponível nos reservatórios na data de referência, considerando a geração na própria usina e em todas as usinas à jusante na cascata. Pode assumir valores negativos em situações de déficit ou ajustes de consistência."@pt ;
    ons:castExpression "TRY_CAST(ear_verif_ree_mwmes AS DOUBLE)" ;
    skos:altLabel "EAR verificada"@pt ;
    skos:altLabel "energia armazenada verificada"@pt ;
    skos:altLabel "ear verificada em MWmês"@pt ;
    skos:altLabel "armazenamento verificado"@pt ;
    skos:altLabel "ear mwmes"@pt ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmes> .

<https://w3id.org/tiago-ons/data/column/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_verif_ree_percentual>
    a ons:Column ;
    dct:title "ear_verif_ree_percentual" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Energia Armazenada Verificada no REE expressa como percentual da capacidade máxima (ear_max_ree). Indica o grau de enchimento dos reservatórios equivalentes em relação à sua capacidade total. Pode assumir valores negativos consistentes com ear_verif_ree_mwmes negativo."@pt ;
    ons:castExpression "TRY_CAST(ear_verif_ree_percentual AS DOUBLE)" ;
    skos:altLabel "EAR percentual"@pt ;
    skos:altLabel "percentual de armazenamento"@pt ;
    skos:altLabel "ear em percentual"@pt ;
    skos:altLabel "nível do reservatório em %"@pt ;
    skos:altLabel "ear %"@pt ;
    skos:altLabel "percentual da capacidade"@pt ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent> .

<https://w3id.org/tiago-ons/data/metric/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_verif_ree_mwmes>
    a ons:Metric ;
    skos:prefLabel "Energia Armazenada"@pt ;
    skos:altLabel "EAR verificada"@pt ;
    skos:altLabel "energia armazenada verificada"@pt ;
    skos:altLabel "ear verificada em MWmês"@pt ;
    skos:altLabel "armazenamento verificado"@pt ;
    skos:altLabel "ear mwmes"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_verif_ree_mwmes> ;
    ons:expression "ear_verif_ree_mwmes" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/energy_stock> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmes> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/last_or_avg> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"last_value\": {\"sql\": \"LAST_VALUE(TRY_CAST(ear_verif_ree_mwmes AS DOUBLE))\", \"unit\": \"MWmes\"}, \"average\": {\"sql\": \"AVG(TRY_CAST(ear_verif_ree_mwmes AS DOUBLE))\", \"unit\": \"MWmes\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(ear_verif_ree_mwmes AS DOUBLE))\", \"unit\": \"MWmes\"}, \"ranking\": {\"sql\": \"AVG(TRY_CAST(ear_verif_ree_mwmes AS DOUBLE))\", \"unit\": \"MWmes\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(ear_verif_ree_mwmes AS DOUBLE))\", \"unit\": \"MWmes\"}}" .

<https://w3id.org/tiago-ons/data/metric/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_verif_ree_percentual>
    a ons:Metric ;
    skos:prefLabel "Percentual de Armazenamento REE"@pt ;
    skos:altLabel "EAR percentual"@pt ;
    skos:altLabel "percentual de armazenamento"@pt ;
    skos:altLabel "ear em percentual"@pt ;
    skos:altLabel "nivel do reservatorio em %"@pt ;
    skos:altLabel "ear %"@pt ;
    skos:altLabel "percentual da capacidade"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_verif_ree_percentual> ;
    ons:expression "ear_verif_ree_percentual" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/ratio> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/avg> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(TRY_CAST(ear_verif_ree_percentual AS DOUBLE))\", \"unit\": \"%\"}, \"maximum\": {\"sql\": \"MAX(TRY_CAST(ear_verif_ree_percentual AS DOUBLE))\", \"unit\": \"%\"}, \"minimum\": {\"sql\": \"MIN(TRY_CAST(ear_verif_ree_percentual AS DOUBLE))\", \"unit\": \"%\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(ear_verif_ree_percentual AS DOUBLE))\", \"unit\": \"%\"}, \"ranking\": {\"sql\": \"AVG(TRY_CAST(ear_verif_ree_percentual AS DOUBLE))\", \"unit\": \"%\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(ear_verif_ree_percentual AS DOUBLE))\", \"unit\": \"%\"}}" .

<https://w3id.org/tiago-ons/data/metric/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_max>
    a ons:Metric ;
    skos:prefLabel "Capacidade Maxima de Armazenamento REE"@pt ;
    skos:altLabel "EAR maxima"@pt ;
    skos:altLabel "capacidade maxima REE"@pt ;
    skos:altLabel "armazenamento maximo REE"@pt ;
    skos:altLabel "ear max"@pt ;
    skos:altLabel "energia maxima do reservatorio equivalente"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_max_ree> ;
    ons:expression "ear_max_ree" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/energy_stock> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmes> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/last_or_avg> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"last_value\": {\"sql\": \"LAST_VALUE(TRY_CAST(ear_max_ree AS DOUBLE))\", \"unit\": \"MWmes\"}, \"average\": {\"sql\": \"AVG(TRY_CAST(ear_max_ree AS DOUBLE))\", \"unit\": \"MWmes\"}, \"maximum\": {\"sql\": \"MAX(TRY_CAST(ear_max_ree AS DOUBLE))\", \"unit\": \"MWmes\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(ear_max_ree AS DOUBLE))\", \"unit\": \"MWmes\"}}" .

<https://w3id.org/tiago-ons/data/metric/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_percentual_calculado>
    a ons:Metric ;
    skos:prefLabel "Percentual de Armazenamento Calculado"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_verif_ree_mwmes> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/ear_diario_por_ree_reservatorio_equivalente_de_energia/ear_max_ree> ;
    ons:expression "ear_verif_ree_mwmes / NULLIF(ear_max_ree, 0) * 100" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/ratio> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/percent> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/avg> ;
    ons:forbiddenAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "false"^^xsd:boolean ;
    ons:aggregationSQL "{\"average\": {\"sql\": \"AVG(TRY_CAST(ear_verif_ree_mwmes AS DOUBLE) / NULLIF(ear_max_ree, 0) * 100)\", \"unit\": \"%\"}, \"maximum\": {\"sql\": \"MAX(TRY_CAST(ear_verif_ree_mwmes AS DOUBLE) / NULLIF(ear_max_ree, 0) * 100)\", \"unit\": \"%\"}, \"minimum\": {\"sql\": \"MIN(TRY_CAST(ear_verif_ree_mwmes AS DOUBLE) / NULLIF(ear_max_ree, 0) * 100)\", \"unit\": \"%\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(ear_verif_ree_mwmes AS DOUBLE) / NULLIF(ear_max_ree, 0) * 100)\", \"unit\": \"%\"}}" .

