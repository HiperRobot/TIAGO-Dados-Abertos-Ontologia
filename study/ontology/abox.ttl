<https://w3id.org/tiago-ons/data/template/disponibilidade_usina/pattern_potenciainstalada_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "potenciainstalada_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, id_subsistema,\n  SUM(TRY_CAST(val_potenciainstalada AS DOUBLE)) AS valor\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/disponibilidade_usina/potenciainstalada> .

<https://w3id.org/tiago-ons/data/template/disponibilidade_usina/pattern_dispoperacional_media_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "dispoperacional_media_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, id_subsistema,\n  AVG(TRY_CAST(val_dispoperacional AS DOUBLE)) AS disp_operacional_media_mw\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/disponibilidade_usina/dispoperacional> .

<https://w3id.org/tiago-ons/data/template/disponibilidade_usina/pattern_diferenca_potencia_disponibilidade>
    a ons:QueryTemplate ;
    skos:prefLabel "diferenca_potencia_disponibilidade" ;
    ons:sqlTemplate "SELECT nom_usina, id_subsistema,\n  AVG(TRY_CAST(val_potenciainstalada AS DOUBLE)) AS potencia_instalada_media_mw,\n  AVG(TRY_CAST(val_dispoperacional AS DOUBLE)) AS disp_operacional_media_mw,\n  AVG(TRY_CAST(val_potenciainstalada AS DOUBLE)) - AVG(TRY_CAST(val_dispoperacional AS DOUBLE)) AS diferenca_mw\nFROM {source}\nWHERE din_instante >= {start_date} AND din_instante < {end_date}\nGROUP BY 1, 2\nORDER BY diferenca_mw DESC" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/disponibilidade_usina/potenciainstalada> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/disponibilidade_usina/dispoperacional> .

<https://w3id.org/tiago-ons/data/template/disponibilidade_usina/pattern_dispsincronizada_por_combustivel>
    a ons:QueryTemplate ;
    skos:prefLabel "dispsincronizada_por_combustivel" ;
    ons:sqlTemplate "SELECT nom_tipocombustivel,\n  AVG(TRY_CAST(val_dispsincronizada AS DOUBLE)) AS disp_sincronizada_media_mw\nFROM {source}\nWHERE din_instante >= {start_date} AND din_instante < {end_date}\n  AND nom_tipocombustivel IS NOT NULL\nGROUP BY 1\nORDER BY disp_sincronizada_media_mw DESC" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/disponibilidade_usina/dispsincronizada> .

<https://w3id.org/tiago-ons/data/template/disponibilidade_usina/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_subsistema, id_tipousina, AVG(TRY_CAST(val_dispoperacional AS DOUBLE)) AS avg_disp_operacional_mw, AVG(TRY_CAST(val_potenciainstalada AS DOUBLE)) AS avg_potencia_instalada_mw, AVG(TRY_CAST(val_dispoperacional AS DOUBLE)) / NULLIF(AVG(TRY_CAST(val_potenciainstalada AS DOUBLE)), 0) AS fator_disponibilidade FROM read_parquet('s3://ons-aws-prod-opendata/dataset/disponibilidade_usina_ho/*.parquet') WHERE din_instante >= '2023-01-01' AND din_instante < '2024-01-01' GROUP BY id_subsistema, nom_subsistema, id_tipousina ORDER BY id_subsistema, id_tipousina;" ;
    ons:exampleQuestion "Qual foi a disponibilidade operacional média (em MW) por subsistema e tipo de usina em 2023?"@pt .

<https://w3id.org/tiago-ons/data/template/disponibilidade_usina/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT id_ons, nom_usina, id_subsistema, id_tipousina, SUM( TRY_CAST(val_potenciainstalada AS DOUBLE) - TRY_CAST(val_dispoperacional AS DOUBLE) ) AS indisponibilidade_acumulada_mwh, COUNT(*) AS horas_com_registro, AVG(TRY_CAST(val_potenciainstalada AS DOUBLE)) AS potencia_media_mw FROM read_parquet('s3://ons-aws-prod-opendata/dataset/disponibilidade_usina_ho/*.parquet') WHERE din_instante >= '2024-01-01' AND din_instante < '2025-01-01' AND TRY_CAST(val_potenciainstalada AS DOUBLE) > 0 GROUP BY id_ons, nom_usina, id_subsistema, id_tipousina ORDER BY indisponibilidade_acumulada_mwh DESC LIMIT 20;" ;
    ons:exampleQuestion "Quais usinas acumularam maior indisponibilidade (MW×hora) no ano de 2024?"@pt .

<https://w3id.org/tiago-ons/data/template/disponibilidade_usina/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT din_instante, SUM(TRY_CAST(val_dispsincronizada AS DOUBLE)) AS total_disp_sincronizada_mw, SUM(TRY_CAST(val_dispoperacional AS DOUBLE)) AS total_disp_operacional_mw, SUM(TRY_CAST(val_potenciainstalada AS DOUBLE)) AS total_potencia_instalada_mw FROM read_parquet('s3://ons-aws-prod-opendata/dataset/disponibilidade_usina_ho/*.parquet') WHERE din_instante >= '2024-01-01' AND din_instante < '2024-02-01' GROUP BY din_instante ORDER BY din_instante;" ;
    ons:exampleQuestion "Como evoluiu a disponibilidade sincronizada total do SIN hora a hora em janeiro de 2024?"@pt .

<https://w3id.org/tiago-ons/data/dataset/ear_diario_por_bacia>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:ear-diario-por-bacia" ;
    dct:title "ear-diario-por-bacia" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/reservatorio> ;
    dcat:keyword "CMO"@pt ;
    dcat:keyword "EAR"@pt ;
    dcat:keyword "EAR bacia"@pt ;
    dcat:keyword "EAR diária bacia"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "armazenamento reservatórios por bacia"@pt ;
    dcat:keyword "bacia hidro energética"@pt ;
    dcat:keyword "despacho hidrotérmico"@pt ;
    dcat:keyword "energia armazenada"@pt ;
    dcat:keyword "energia armazenada bacia"@pt ;
    dcat:keyword "hidrologia"@pt ;
    dcat:keyword "nível dos reservatórios por bacia"@pt ;
    dcat:keyword "reservatórios"@pt ;
    dcat:keyword "série temporal diária"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Disponibilizar aos geradores, comercializadores, agentes do mercado de energia elétrica, pesquisadores e reguladores a evolução diária do nível de armazenamento dos reservatórios hidrelétricos por bacia, permitindo o acompanhamento das condições hídricas do SIN, a projeção do Custo Marginal de Operação (CMO), estudos de despacho hidrotérmico, análise de risco hidrológico e suporte à tomada de decisão em comercialização de energia."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver nível de armazenamento de reservatórios hidrelétricos por bacia, percentual de capacidade dos reservatórios, evolução histórica da EAR diária ou análise de risco hidrológico por bacia do SIN."@pt ;
    ons:limitation "Coluna ear_data está armazenada como VARCHAR no Parquet em vez de DATE. Valor máximo de 154,43% ultrapassa o limite esperado de 100% para um percentual de capacidade. Valor mínimo de 0."@pt ;
    dct:source <https://dados.ons.org.br/dataset/ear-diario-por-bacia> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/ear_bacia_di/*.parquet" ;
    skos:altLabel "nivel dos reservatorios por bacia"@pt ;
    skos:altLabel "armazenamento por bacia"@pt ;
    skos:altLabel "quanto de energia estocada por bacia"@pt ;
    ons:exampleQuestion "Qual é o percentual de armazenamento atual de cada bacia hidro energética?"@pt ;
    ons:exampleQuestion "Como evoluiu a EAR da bacia Sudeste nos últimos 12 meses?"@pt ;
    ons:exampleQuestion "Quais foram os períodos históricos de menor armazenamento na bacia Nordeste?"@pt ;
    ons:exampleQuestion "Qual bacia apresentou maior variação de EAR percentual no último trimestre?"@pt ;
    ons:exampleQuestion "Como comparar a EAR atual com a média histórica para o mesmo período do ano?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver nível de armazenamento de reservatórios hidrelétricos por bacia, percentual de capacidade dos reservatórios, evolução histórica da EAR diária ou análise de risco hidrológico por bacia do SIN. Também relevante para perguntas sobre CMO, despacho hidrotérmico e condições hídricas que requerem granularidade diária e desagregação por bacia."@pt ;
    ons:agentInstruction "- [ear_data] Coluna ear_data está armazenada como VARCHAR no Parquet em vez de DATE. Operações de filtro temporal, ordenação e extração de componentes de data falharão sem conversão explícita. O formato observado é YYYY-MM-DD (ISO 8601), mas a ausência de tipagem nativa exige cuidado em joins temporais.\n\n- [ear_max_bacia] Valor mínimo de 0.0 em ear_max_bacia pode indicar bacias sem capacidade de regularização em períodos históricos específicos ou registros de bacias a fio d'água. Divisões por ear_max_bacia para recalcular percentual resultarão em erro de divisão por zero nesses casos.\n\n- [ear_verif_bacia_percentual] Valor máximo de 154.43% ultrapassa 100%, indicando situações de volume acima da capacidade nominal dos reservatórios (vertimento ou cheias extraordinárias). Não é anomalia de dados — é comportamento físico real. Sistemas de monitoramento que alertem para valores acima de 100% devem considerar esse limiar estendido (até ~160%) como válido para este dataset.\n\n- [ear_verif_bacia_mwmes] Valor mínimo de 0.0 em ear_verif_bacia_mwmes pode representar situações de reservatórios completamente vazios (volume morto atingido) ou bacias sem armazenamento regularizável. Embora fisicamente possível, valores zero merecem verificação contextual para distinguir dado real de possível falha de coleta.\n\n- [nomecurto] A chave primária natural é (nomecurto, ear_data). Duplicatas nessa combinação indicariam inconsistência no processo de carga dos 27 arquivos Parquet, possivelmente por sobreposição de partições ou reprocessamento parcial. Deve ser verificado antes de agregações que assumam unicidade por bacia/data.\n"@pt ;
    dct:accrualPeriodicity "diária" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/ear_bacia_di/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "2000-01-01/" ;
