<https://w3id.org/tiago-ons/data/column/ind_disponibilidade_fgeracao_uge_anual/id_subsistema>
    a ons:Column ;
    dct:title "id_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificador do subsistema elétrico ao qual a unidade geradora pertence (ex: SE, S, NE, N)"@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "sistema"@pt ;
