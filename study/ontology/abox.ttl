<https://w3id.org/tiago-ons/data/domain/resposta_demanda>
    a ons:Domain ;
    skos:prefLabel "resposta_demanda" .

<https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/nom_agente>
    a ons:Column ;
    dct:title "nom_agente" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome do agente que fez a oferta de reducao (ex.: CB ALUMINIO)"@pt ;
    skos:altLabel "agente"@pt ;
    skos:altLabel "consumidor"@pt ;
    skos:altLabel "empresa"@pt .

<https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/tip_oferta>
    a ons:Column ;
    dct:title "tip_oferta" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Tipo/modalidade da oferta (ex.: Potencia d-1)"@pt ;
    skos:altLabel "tipo de oferta"@pt ;
    skos:altLabel "modalidade"@pt .

<https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/val_preco>
    a ons:Column ;
    dct:title "val_preco" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Preco ofertado (R$/MWh), VARCHAR com ponto decimal. Ausente em parte das linhas, quase sempre como string VAZIA e nao como NULL — um filtro IS NOT NULL nao a exclui. Use NULLIF(val_preco, '') ou filtre val_preco != '' antes de agregar."@pt ;
    ons:castExpression "TRY_CAST(val_preco AS DOUBLE)" ;
    skos:altLabel "preco"@pt ;
    skos:altLabel "valor"@pt .

<https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/dat_reducao>
    a ons:Column ;
    dct:title "dat_reducao" ;
    dct:type "date" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Data da reducao de carga ofertada (ex.: 2023-11-28)"@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "data reducao"@pt .

<https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/id_subsistema>
    a ons:Column ;
    dct:title "id_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Sigla do subsistema (ex.: SE, S, NE, N)"@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "sigla subsistema"@pt .

<https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/nom_subsistema>
    a ons:Column ;
    dct:title "nom_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome do subsistema (ex.: SUDESTE/CENTRO-OESTE)"@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "regiao"@pt .

<https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/hor_inicial>
    a ons:Column ;
    dct:title "hor_inicial" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
