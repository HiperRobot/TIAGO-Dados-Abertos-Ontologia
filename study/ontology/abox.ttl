<https://w3id.org/tiago-ons/data/column/ena_diario_por_bacia/ena_bruta_bacia_mwmed>
    a ons:Column ;
    dct:title "ena_bruta_bacia_mwmed" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Energia Natural Afluente Bruta da bacia em MWmed, calculada pelo produto das vazões naturais aos reservatórios com as produtividades a 65% dos volumes úteis. Representa a energia produzível total pela bacia sem desconto de vertimentos."@pt ;
    ons:castExpression "TRY_CAST(ena_bruta_bacia_mwmed AS DOUBLE)" ;
    skos:altLabel "ENA bruta"@pt ;
    skos:altLabel "energia natural afluente bruta"@pt ;
    skos:altLabel "ENA bruta em MWmed"@pt ;
    skos:altLabel "afluência bruta"@pt ;
    skos:altLabel "energia bruta da bacia"@pt ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/ena_diario_por_bacia/ena_bruta_bacia_percentualmlt>
    a ons:Column ;
    dct:title "ena_bruta_bacia_percentualmlt" ;
    dct:type "number" ;
    ons:physicalType "VARCHAR" ;
