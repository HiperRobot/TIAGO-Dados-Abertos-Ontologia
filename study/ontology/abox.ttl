<https://w3id.org/tiago-ons/data/metric/geracao_itaipu/itaipu_py>
    a ons:Metric ;
    skos:prefLabel "Itaipu Paraguai"@pt ;
    skos:altLabel "itaipu paraguai"@pt ;
    skos:altLabel "geração itaipu paraguai"@pt ;
    skos:altLabel "parcela paraguaia"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/geracao_itaipu/val_itaipu_50hz> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/geracao_itaipu/val_itaipu_50hz_br> ;
    ons:expression "(val_itaipu_50hz - val_itaipu_50hz_br)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "1.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM(val_itaipu_50hz - val_itaipu_50hz_br) * 1.0\", \"unit\": \"MWh\"}, \"average_power\": {\"sql\": \"AVG(val_itaipu_50hz - val_itaipu_50hz_br)\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(val_itaipu_50hz - val_itaipu_50hz_br)\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(val_itaipu_50hz - val_itaipu_50hz_br)\", \"unit\": \"MWmed\"}, \"comparison\": {\"sql\": \"AVG(val_itaipu_50hz - val_itaipu_50hz_br)\", \"unit\": \"MWmed\"}}" .

<https://w3id.org/tiago-ons/data/template/geracao_itaipu/pattern_itaipu_total_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "itaipu_total_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  AVG(val_itaipu_total) AS media_mwmed,\n  SUM(val_itaipu_total) * 1.0 AS energia_mwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "MWmed (media), MWh (energia)" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_itaipu/itaipu_total> .

<https://w3id.org/tiago-ons/data/template/geracao_itaipu/pattern_itaipu_brasil_vs_paraguai_anual>
    a ons:QueryTemplate ;
    skos:prefLabel "itaipu_brasil_vs_paraguai_anual" ;
    ons:sqlTemplate "SELECT EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) AS ano,\n  AVG(val_itaipu_br) AS media_brasil_mwmed,\n  AVG(val_itaipu_50hz - val_itaipu_50hz_br) AS media_paraguai_mwmed,\n  SUM(val_itaipu_br) * 1.0 AS energia_brasil_mwh,\n  SUM(val_itaipu_50hz - val_itaipu_50hz_br) * 1.0 AS energia_paraguai_mwh\nFROM {source}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "MWmed (media), MWh (energia)" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_itaipu/itaipu_br> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_itaipu/itaipu_py> .

<https://w3id.org/tiago-ons/data/template/geracao_itaipu/pattern_itaipu_60hz_vs_50hz_horario>
    a ons:QueryTemplate ;
    skos:prefLabel "itaipu_60hz_vs_50hz_horario" ;
    ons:sqlTemplate "SELECT EXTRACT(HOUR FROM TRY_CAST(din_instante AS TIMESTAMP)) AS hora_dia,\n  AVG(val_itaipu_60hz) AS media_60hz_mwmed,\n  AVG(val_itaipu_50hz) AS media_50hz_mwmed\nFROM {source}\nWHERE din_instante BETWEEN '{data_inicio}' AND '{data_fim}'\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_itaipu/itaipu_60hz> ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_itaipu/itaipu_50hz> .

<https://w3id.org/tiago-ons/data/template/geracao_itaipu/pattern_itaipu_pico_historico>
    a ons:QueryTemplate ;
    skos:prefLabel "itaipu_pico_historico" ;
    ons:sqlTemplate "SELECT din_instante,\n  val_itaipu_total,\n  val_itaipu_60hz,\n  val_itaipu_50hz,\n  val_itaipu_br,\n  (val_itaipu_50hz - val_itaipu_50hz_br) AS itaipu_paraguai\nFROM {source}\nORDER BY val_itaipu_total DESC\nLIMIT 10" ;
    ons:outputUnitLabel "MWmed" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/geracao_itaipu/itaipu_total> .

<https://w3id.org/tiago-ons/data/template/geracao_itaipu/pattern_geracao_itaipu_mensal_gwh>
    a ons:QueryTemplate ;
    skos:prefLabel "geracao_itaipu_mensal_gwh" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_itaipu_50hz AS VARCHAR) AS DOUBLE)) * 1.0 / 1000, 1) AS val_itaipu_50hz_gwh,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_itaipu_50hz_br AS VARCHAR) AS DOUBLE)) * 1.0 / 1000, 1) AS val_itaipu_50hz_br_gwh,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_itaipu_60hz AS VARCHAR) AS DOUBLE)) * 1.0 / 1000, 1) AS val_itaipu_60hz_gwh,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_itaipu_br AS VARCHAR) AS DOUBLE)) * 1.0 / 1000, 1) AS val_itaipu_br_gwh,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_itaipu_total AS VARCHAR) AS DOUBLE)) * 1.0 / 1000, 1) AS val_itaipu_total_gwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "GWh" .

<https://w3id.org/tiago-ons/data/template/geracao_itaipu/pattern_geracao_itaipu_mensal_mwmed>
    a ons:QueryTemplate ;
    skos:prefLabel "geracao_itaipu_mensal_mwmed" ;
    ons:sqlTemplate "SELECT\n  DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_itaipu_50hz AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS val_itaipu_50hz_mwmed,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_itaipu_50hz_br AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS val_itaipu_50hz_br_mwmed,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_itaipu_60hz AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS val_itaipu_60hz_mwmed,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_itaipu_br AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS val_itaipu_br_mwmed,\n  ROUND(SUM(TRY_CAST(TRY_CAST(val_itaipu_total AS VARCHAR) AS DOUBLE)) / COUNT(DISTINCT TRY_CAST(din_instante AS TIMESTAMP)), 1) AS val_itaipu_total_mwmed\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 1" ;
    ons:outputUnitLabel "MWmed" .

<https://w3id.org/tiago-ons/data/template/geracao_itaipu/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) AS mes, AVG(val_itaipu_60hz) AS media_60hz_mw, AVG(val_itaipu_50hz) AS media_50hz_mw, AVG(val_itaipu_total) AS media_total_mw FROM read_parquet('s3://ons-aws-prod-opendata/dataset/geracao_itaipu/*.parquet') GROUP BY DATE_TRUNC('month', TRY_CAST(din_instante AS TIMESTAMP)) ORDER BY mes;" ;
    ons:exampleQuestion "Qual foi a geração média mensal de Itaipu no setor de 60 Hz e no setor de 50 Hz em cada ano?"@pt .

<https://w3id.org/tiago-ons/data/template/geracao_itaipu/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) AS ano, SUM((val_itaipu_br) * 1.0) AS geracao_brasil_gwh, SUM((val_itaipu_total) * 1.0) AS geracao_total_gwh, ROUND(100.0 * SUM((val_itaipu_br) * 1.0) / NULLIF(SUM((val_itaipu_total) * 1.0), 0), 2) AS participacao_brasil_pct FROM read_parquet('s3://ons-aws-prod-opendata/dataset/geracao_itaipu/*.parquet') GROUP BY EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) ORDER BY ano;" ;
    ons:exampleQuestion "Qual foi a participação percentual da geração destinada ao Brasil em relação ao total de Itaipu em cada ano?"@pt .

<https://w3id.org/tiago-ons/data/template/geracao_itaipu/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) AS ano, COUNT(*) AS horas_operacao, AVG(val_itaipu_total) AS geracao_media_mw, ROUND(100.0 * AVG(val_itaipu_total) / 14000.0, 2) AS fator_capacidade_pct FROM read_parquet('s3://ons-aws-prod-opendata/dataset/geracao_itaipu/*.parquet') GROUP BY EXTRACT(YEAR FROM TRY_CAST(din_instante AS TIMESTAMP)) ORDER BY ano;" ;
    ons:exampleQuestion "Qual foi o fator de capacidade anual de Itaipu considerando capacidade instalada de 14.000 MW?"@pt .

<https://w3id.org/tiago-ons/data/dataset/grandezas_fluviometricas>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:grandezas_fluviometricas" ;
    dct:title "grandezas_fluviometricas" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/hidrologia> ;
    dcat:keyword "ENA"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "bacia hidrográfica"@pt ;
    dcat:keyword "disponibilidade hídrica"@pt ;
    dcat:keyword "energia natural afluente"@pt ;
    dcat:keyword "fluviometria"@pt ;
    dcat:keyword "geração hidrelétrica"@pt ;
    dcat:keyword "grandezas fluviométricas"@pt ;
    dcat:keyword "hidrologia"@pt ;
    dcat:keyword "medições de vazão"@pt ;
    dcat:keyword "posto fluviométrico"@pt ;
    dcat:keyword "postos fluviométricos ONS"@pt ;
    dcat:keyword "vazão"@pt ;
    dcat:keyword "vazão diária por bacia"@pt ;
    dcat:keyword "vazão fluviométrica"@pt ;
    dcat:keyword "vazão fluviométrica ONS"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Fornecer séries históricas diárias de vazão para analistas de hidrologia, operadores do sistema elétrico e planejadores energéticos que necessitam acompanhar a disponibilidade hídrica nas bacias hidrográficas brasileiras, subsidiar o despacho hidrelétrico, alimentar modelos de previsão de Energia Natural Afluente (ENA) e suportar decisões de operação e planejamento do Sistema Interligado Nacional (SIN)."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver vazão de rios, medições em postos fluviométricos, disponibilidade hídrica por bacia hidrográfica ou séries temporais diárias de grandezas hidrológicas no contexto do sistema elétrico brasileiro."@pt ;
    ons:limitation "Coluna de data tipada como VARCHAR no schema físico DuckDB, quando deveria ser DATE. Quase todos os registros possuem val_vazaomediaincr nulo. val_vazaomedia possui valor mínimo igual a 0."@pt ;
    dct:source <https://dados.ons.org.br/dataset/grandezas_fluviometricas> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/grandezas_fluviometricas_di/*.parquet" ;
    skos:altLabel "vazao do rio"@pt ;
    skos:altLabel "quanta agua passou no posto"@pt ;
    skos:altLabel "medicao fluviometrica"@pt ;
    skos:altLabel "vazao natural do rio"@pt ;
    skos:altLabel "vazao afluente media"@pt ;
    ons:exampleQuestion "Qual foi a vazão média diária na bacia do Paraná nos últimos 30 dias?"@pt ;
    ons:exampleQuestion "Quais postos fluviométricos registraram vazão zero em 2024?"@pt ;
    ons:exampleQuestion "Como evoluiu a vazão média no rio Paraná ao longo de 2023 e 2024?"@pt ;
    ons:exampleQuestion "Quais bacias hidrográficas apresentaram maior variabilidade de vazão no período seco?"@pt ;
    ons:exampleQuestion "Quais postos possuem dados de vazão incremental disponíveis?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver vazão de rios, medições em postos fluviométricos, disponibilidade hídrica por bacia hidrográfica ou séries temporais diárias de grandezas hidrológicas no contexto do sistema elétrico brasileiro. Também relevante quando a análise requer correlação entre condições hidrológicas e geração hidrelétrica ou Energia Natural Afluente (ENA)."@pt ;
    ons:agentInstruction "- [val_vazaomediaincr] Quase todos os registros possuem val_vazaomediaincr nulo. A vazão incremental é calculada apenas para postos com contribuição incremental relevante ao SIN, tornando este campo esparso por design. Filtros sem tratamento de nulos em agregações produzirão resultados enviesados ou incorretos.\n\n- [val_latitude] Poucos registros possuem val_latitude nulo, indicando postos fluviométricos sem coordenadas georreferenciadas cadastradas no dataset grandezas_fluviometricas. Análises espaciais devem filtrar ou tratar esses registros para evitar erros em joins geoespaciais.\n\n- [val_longitude] Poucos registros possuem val_longitude nulo, coincidindo com os mesmos postos sem val_latitude no dataset grandezas_fluviometricas. Postos sem coordenadas completas não podem ser utilizados em análises geoespaciais ou mapas de distribuição de vazões.\n\n- [din_medicao] Coluna din_medicao está tipada como VARCHAR no schema físico DuckDB do dataset grandezas_fluviometricas, embora represente datas no formato YYYY-MM-DD. Operações de filtro temporal, ordenação cronológica e agregações por período requerem cast explícito para DATE.\n\n- [val_vazaomedia] val_vazaomedia no dataset grandezas_fluviometricas possui valor máximo de 37181.93 m³/s, compatível com grandes rios como o Paraná próximo a Itaipu, mas requer validação contextual por posto. Valor mínimo de 0.0 m³/s pode indicar períodos de seca extrema, postos em rios intermitentes ou erros de medição/registro.\n\n- [nom_rio] Valores têm ACENTO e prefixo \"RIO \" (ex.: 'RIO SÃO FRANCISCO', 'RIO PARANÁ'). Igualdade exata sem acento retorna ZERO linhas, e LIKE simples também falha com acento ('RIO PARANÁ' NÃO casa com LIKE '%PARANA%'). Na PRIMEIRA consulta normalize os dois lados: strip_accents(upper(nom_rio)) LIKE '%PARANA%' (fragmento maiúsculo sem acento; strip_accents é nativo do DuckDB). NÃO gaste consultas separadas sondando cobertura de datas: a cobertura temporal varia POR POSTO — traga MAX(TRY_CAST(din_medicao AS DATE)) por posto junto com a vazão mais recente na mesma consulta (window function ou GROUP BY) e declare a data real dos dados na resposta.\n\n- [val_vazaomedia] DIA MAIS RECENTE NÃO CONSOLIDADO: o último dia da série pode chegar com val_vazaomedia = 0.0 em TODOS os postos (artefato de ingestão D-1; provado em 2026-08-12: 17/17 postos do São Francisco em 0.0, contra 4/20 zeros crônicos localizados em dias normais). O descarte automático da borda só vale quando o recorte tem VÁRIOS postos e TODOS zeram juntos no último dia — nesse caso descarte o dia, use o anterior como \"mais recente\" e declare a data. Com UM posto só ou em recorte histórico pedido pelo usuário, NÃO descarte: zero isolado pode ser seca real (a própria coluna registra secas extremas) — reporte e marque como \"a confirmar (borda da série)\". ATENÇÃO aos padrões prontos deste contrato que contam ou agregam zeros (vazao_zero_por_posto, médias mensais): eles NÃO excluem a borda zerada — exclua o último dia não consolidado antes de contar/mediar, senão o artefato contamina o resultado.\n"@pt ;
    dct:accrualPeriodicity "diária" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/grandezas_fluviometricas_di/*.parquet', union_by_name=true)" ;
