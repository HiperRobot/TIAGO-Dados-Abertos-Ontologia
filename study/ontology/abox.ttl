<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/id_subsistema>
    a ons:Column ;
    dct:title "id_subsistema" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificador do subsistema elétrico ao qual a usina eólica pertence (ex: NE, SE, S, N)"@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "sistema"@pt ;
    skos:altLabel "região elétrica"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "N" ;
    ons:allowedValue "NE" ;
    ons:allowedValue "S" ;
    ons:allowedValue "SE" .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/id_estado>
    a ons:Column ;
    dct:title "id_estado" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Sigla do estado brasileiro onde a usina eólica está localizada"@pt ;
    skos:altLabel "estado"@pt ;
    skos:altLabel "UF"@pt ;
    skos:altLabel "unidade federativa"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "BA" ;
    ons:allowedValue "CE" ;
    ons:allowedValue "MA" ;
    ons:allowedValue "PB" ;
    ons:allowedValue "PE" ;
    ons:allowedValue "PI" ;
    ons:allowedValue "RN" ;
    ons:allowedValue "RS" ;
    ons:allowedValue "SC" .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/nom_modalidadeoperacao>
    a ons:Column ;
    dct:title "nom_modalidadeoperacao" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome da modalidade de operação de constrained-off à qual a usina está classificada. Valores possíveis: Tipo I (restrição por congestionamento de rede), Tipo II-B e Tipo II-C (restrições por outros critérios operativos definidos pelo ONS)."@pt ;
    skos:altLabel "modalidade"@pt ;
    skos:altLabel "tipo de constrained-off"@pt ;
    skos:altLabel "modalidade operação"@pt ;
    skos:altLabel "tipo operação"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "Tipo I" ;
    ons:allowedValue "Tipo II-B" ;
    ons:allowedValue "Tipo II-C" .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/nom_conjuntousina>
    a ons:Column ;
    dct:title "nom_conjuntousina" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome do conjunto (agrupamento) de usinas ao qual a usina individual pertence. Representa o complexo eólico ou grupo operativo de referência para fins de apuração do constrained-off."@pt ;
    skos:altLabel "conjunto"@pt ;
    skos:altLabel "complexo eólico"@pt ;
    skos:altLabel "grupo de usinas"@pt ;
    skos:altLabel "conjunto de usinas"@pt ;
    ons:semanticRole "DIMENSION" .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/nom_usina>
    a ons:Column ;
    dct:title "nom_usina" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome da usina eólica individual conforme cadastro do ONS. Identifica a unidade geradora específica dentro do conjunto/complexo eólico."@pt ;
    skos:altLabel "usina"@pt ;
    skos:altLabel "nome da usina"@pt ;
    skos:altLabel "usina eólica"@pt ;
    skos:altLabel "planta eólica"@pt ;
    ons:semanticRole "DIMENSION" .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/id_ons>
    a ons:Column ;
    dct:title "id_ons" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Código identificador da usina no cadastro do ONS. Chave de referência para joins com datasets de cadastro de usinas e outros datasets operativos do ONS."@pt ;
    skos:altLabel "código ONS"@pt ;
    skos:altLabel "id ONS"@pt ;
    skos:altLabel "código da usina"@pt ;
    skos:altLabel "identificador ONS"@pt ;
    ons:semanticRole "IDENTIFIER" .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/ceg>
    a ons:Column ;
    dct:title "ceg" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Código de Empreendimento de Geração (CEG) da ANEEL. Identificador único do empreendimento gerador no cadastro regulatório. Permite join com bases da ANEEL e outros datasets do setor."@pt ;
    skos:altLabel "CEG"@pt ;
    skos:altLabel "código ANEEL"@pt ;
    skos:altLabel "código empreendimento"@pt ;
    skos:altLabel "código de geração"@pt ;
    ons:semanticRole "IDENTIFIER" .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/din_instante>
    a ons:Column ;
    dct:title "din_instante" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data e hora do instante de medição/apuração da restrição de constrained-off, com granularidade de 30 minutos. Cada registro representa um intervalo de meia hora para a usina identificada. Cobre o período de 2023-01-01 em diante."@pt ;
    skos:altLabel "instante"@pt ;
    skos:altLabel "data hora"@pt ;
    skos:altLabel "timestamp"@pt ;
    skos:altLabel "data e hora"@pt ;
    skos:altLabel "intervalo"@pt ;
    skos:altLabel "meia hora"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/val_ventoverificado>
    a ons:Column ;
    dct:title "val_ventoverificado" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Velocidade do vento verificada (medida) na usina eólica no instante de apuração, em metros por segundo (m/s). Valores extremos (ex: 297,529 m/s) indicam dados inválidos, devendo ser filtrados pelo flag flg_dadoventoinvalido=1."@pt ;
    skos:altLabel "vento"@pt ;
    skos:altLabel "velocidade do vento"@pt ;
    skos:altLabel "vento verificado"@pt ;
    skos:altLabel "velocidade vento medida"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/m_per_s> .

<https://w3id.org/tiago-ons/data/unit/m_per_s>
    a ons:Unit ;
    skos:prefLabel "m_per_s" ;
    skos:altLabel "m/s" ;
    skos:closeMatch <http://qudt.org/vocab/unit/M-PER-SEC> .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/flg_dadoventoinvalido>
    a ons:Column ;
    dct:title "flg_dadoventoinvalido" ;
    dct:type "integer" ;
    ons:physicalType "INTEGER" ;
    dct:description "Flag binária indicando a qualidade do dado de velocidade do vento. Valor 0 indica dado de vento válido; valor 1 indica dado de vento inválido ou indisponível. Deve ser usado como filtro ao analisar val_ventoverificado."@pt ;
    skos:altLabel "flag vento inválido"@pt ;
    skos:altLabel "dado vento inválido"@pt ;
    skos:altLabel "qualidade vento"@pt ;
    skos:altLabel "flag qualidade vento"@pt ;
    ons:semanticRole "FLAG" ;
    ons:allowedValue "0.0" ;
    ons:allowedValue "1.0" .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/val_geracaoestimada>
    a ons:Column ;
    dct:title "val_geracaoestimada" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Geração eólica estimada para a usina no instante de apuração, em megawatts (MW). Representa a geração que a usina poderia ter produzido na ausência da restrição de constrained-off, calculada com base na velocidade do vento e curva de potência. Possui poucos nulos, possivelmente em períodos sem estimativa disponível."@pt ;
    skos:altLabel "geração estimada"@pt ;
    skos:altLabel "geração potencial"@pt ;
    skos:altLabel "potência estimada"@pt ;
    skos:altLabel "geração sem restrição"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/val_geracaoverificada>
    a ons:Column ;
    dct:title "val_geracaoverificada" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Geração eólica verificada (medida) da usina no instante de apuração, em megawatts (MW). Representa a geração efetivamente realizada durante o período de constrained-off. Máximo observado de 150 MW, consistente com capacidade de usinas eólicas individuais."@pt ;
    skos:altLabel "geração verificada"@pt ;
    skos:altLabel "geração realizada"@pt ;
    skos:altLabel "geração medida"@pt ;
    skos:altLabel "potência verificada"@pt ;
    skos:altLabel "geração efetiva"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/id_ons_conjuntousina>
    a ons:Column ;
    dct:title "id_ons_conjuntousina" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificador do Conjunto de Usinas no ONS (apenas para usinas com modalidade de operação Tipo II-C)"@pt ;
    skos:altLabel "id_conjunto"@pt ;
    skos:altLabel "codigo_conjunto_ons"@pt ;
    ons:semanticRole "IDENTIFIER" .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/nom_origemvento>
    a ons:Column ;
    dct:title "nom_origemvento" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Origem do dado de velocidade do vento, podendo ser do Sistema de Supervisão de Controle ou fornecido pelo Agente em Pós-Operação."@pt ;
    skos:altLabel "origem_vento"@pt ;
    skos:altLabel "fonte_vento"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "Agente" ;
    ons:allowedValue "Supervisão" .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/flg_dadoventosupervisaoinvalido>
    a ons:Column ;
    dct:title "flg_dadoventosupervisaoinvalido" ;
    dct:type "integer" ;
    ons:physicalType "INTEGER" ;
    dct:description "Indicativo do dado de vento encaminhado pelo agente pelo Sistema de Supervisão e Controle como inválido. O dado é considerado inválido (flag = 1) quando há falha na medida recebida pelo Sistema de Supervisão e Controle do ONS por mais de 6 minutos dentro da semi-hora correspondente."@pt ;
    skos:altLabel "flag_vento_supervisao_invalido"@pt ;
    ons:semanticRole "FLAG" ;
    ons:allowedValue "0" ;
    ons:allowedValue "1" .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/nom_origemgeracaoreferencia>
    a ons:Column ;
    dct:title "nom_origemgeracaoreferencia" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Origem da geração de referência, podendo ser da curva de produtividade, do histórico de geração ou da garantia física."@pt ;
    skos:altLabel "origem_referencia"@pt ;
    skos:altLabel "fonte_geracao_referencia"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "Curva" ;
    ons:allowedValue "Garantia Física" ;
    ons:allowedValue "Migrado do SAGIC" ;
    ons:allowedValue "Períodos Anteriores" ;
    ons:allowedValue "Períodos Anteriores/Garantia Física" .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/val_geracaoreferenciafinal>
    a ons:Column ;
    dct:title "val_geracaoreferenciafinal" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Geração de Referência Final, em MWmed. Considera as regras de apuração estabelecidas na RO-AO.BR.13 aplicadas na Geração de Referência do Conjunto e distribuição proporcional nas usinas. O valor é calculado apenas para os patamares em que houve restrição por indisponibilidade externa (REL), sendo encaminhado pelo ONS à CCEE para fins de obtenção da geração frustrada e cálculo dos ESS por constrained-off."@pt ;
    skos:altLabel "geracao_referencia_final"@pt ;
    skos:altLabel "referencia_final"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> .

<https://w3id.org/tiago-ons/data/column/restricao_coff_eolica_detail/flg_geracaorestrita>
    a ons:Column ;
    dct:title "flg_geracaorestrita" ;
    dct:type "integer" ;
    ons:physicalType "INTEGER" ;
    dct:description "Indicativo se houve limitação da geração do Conjunto na semi-hora."@pt ;
    skos:altLabel "flag_restricao"@pt ;
