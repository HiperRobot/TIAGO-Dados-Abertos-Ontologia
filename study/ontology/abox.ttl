<https://w3id.org/tiago-ons/data/template/interrupcao_carga/pattern_ens_total_por_subsistema_ano>
    a ons:QueryTemplate ;
    skos:prefLabel "ens_total_por_subsistema_ano" ;
    ons:sqlTemplate "SELECT id_subsistema,\n  EXTRACT(YEAR FROM TRY_CAST(din_interrupcaocarga AS TIMESTAMP)) AS ano,\n  SUM(val_energianaosuprida_mwh) AS ens_total_mwh\nFROM {source}\nWHERE val_energianaosuprida_mwh > 0\n  AND EXTRACT(YEAR FROM TRY_CAST(din_interrupcaocarga AS TIMESTAMP)) = {year}\nGROUP BY 1, 2\nORDER BY 3 DESC" ;
    ons:outputUnitLabel "MWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/interrupcao_carga/energianaosuprida_mwh> .

<https://w3id.org/tiago-ons/data/template/interrupcao_carga/pattern_cargainterrompida_mw_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "cargainterrompida_mw_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(din_interrupcaocarga AS TIMESTAMP)) AS mes,\n  id_subsistema,\n  SUM(val_cargainterrompida_mw) AS carga_interrompida_mw\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(din_interrupcaocarga AS TIMESTAMP)) = {year}\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "MW" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/interrupcao_carga/cargainterrompida_mw> .

<https://w3id.org/tiago-ons/data/template/interrupcao_carga/pattern_contagem_perturbacoes_rede_basica>
    a ons:QueryTemplate ;
    skos:prefLabel "contagem_perturbacoes_rede_basica" ;
    ons:sqlTemplate "SELECT EXTRACT(YEAR FROM TRY_CAST(din_interrupcaocarga AS TIMESTAMP)) AS ano,\n  id_subsistema,\n  COUNT(DISTINCT cod_perturbacao) AS num_perturbacoes\nFROM {source}\nWHERE flg_envolveuredebasica = 'S'\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "eventos" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/interrupcao_carga/contagem_perturbacoes> .

<https://w3id.org/tiago-ons/data/template/interrupcao_carga/pattern_duracao_media_por_agente>
    a ons:QueryTemplate ;
    skos:prefLabel "duracao_media_por_agente" ;
    ons:sqlTemplate "SELECT nom_agente,\n  AVG(val_tempomedio_minutos) AS duracao_media_min,\n  COUNT(DISTINCT cod_perturbacao) AS num_eventos\nFROM {source}\nWHERE val_tempomedio_minutos > 0\n  AND EXTRACT(YEAR FROM TRY_CAST(din_interrupcaocarga AS TIMESTAMP)) = {year}\nGROUP BY 1\nORDER BY 2 DESC" ;
    ons:outputUnitLabel "min" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/interrupcao_carga/tempomedio_minutos> .

<https://w3id.org/tiago-ons/data/template/interrupcao_carga/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT id_subsistema, nom_subsistema, EXTRACT(YEAR FROM TRY_CAST(din_interrupcaocarga AS TIMESTAMP)) AS ano, COUNT(*) AS qtd_eventos, SUM(val_cargainterrompida_mw) AS total_carga_interrompida_mw, SUM(val_energianaosuprida_mwh) AS total_ens_mwh FROM read_parquet('s3://ons-aws-prod-opendata/dataset/interrupcao_carga/*.parquet') WHERE val_energianaosuprida_mwh >= 0 AND val_cargainterrompida_mw >= 0 AND id_subsistema NOT IN ('SIN') GROUP BY id_subsistema, nom_subsistema, EXTRACT(YEAR FROM TRY_CAST(din_interrupcaocarga AS TIMESTAMP)) ORDER BY ano DESC, total_ens_mwh DESC;" ;
    ons:exampleQuestion "Qual foi a energia não suprida total por subsistema em cada ano?"@pt .

<https://w3id.org/tiago-ons/data/template/interrupcao_carga/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT nom_agente, COUNT(*) AS qtd_eventos, SUM(val_cargainterrompida_mw) AS total_carga_interrompida_mw, SUM(val_energianaosuprida_mwh) AS total_ens_mwh, AVG(val_tempomedio_minutos) AS media_duracao_minutos FROM read_parquet('s3://ons-aws-prod-opendata/dataset/interrupcao_carga/*.parquet') WHERE din_interrupcaocarga >= CURRENT_DATE - INTERVAL '5 years' AND val_cargainterrompida_mw >= 0 AND val_energianaosuprida_mwh >= 0 AND val_tempomedio_minutos >= 0 GROUP BY nom_agente ORDER BY total_ens_mwh DESC LIMIT 20;" ;
    ons:exampleQuestion "Quais agentes acumularam maior carga interrompida nos últimos 5 anos?"@pt .

<https://w3id.org/tiago-ons/data/template/interrupcao_carga/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT cod_perturbacao, din_interrupcaocarga, id_subsistema, nom_subsistema, nom_agente, val_cargainterrompida_mw, val_energianaosuprida_mwh, val_tempomedio_minutos, flg_envolveuredebasica, flg_envolveuredeoperacao FROM read_parquet('s3://ons-aws-prod-opendata/dataset/interrupcao_carga/*.parquet') WHERE din_interrupcaocarga >= '2010-01-01' AND val_cargainterrompida_mw >= 0 ORDER BY val_cargainterrompida_mw DESC LIMIT 10;" ;
    ons:exampleQuestion "Quais foram os 10 maiores eventos de interrupção de carga em MW desde 2010?"@pt .

<https://w3id.org/tiago-ons/data/dataset/linha_transmissao>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:linha-transmissao" ;
    dct:title "linha-transmissao" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/transmissao> ;
    dcat:keyword "LT"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "SIN"@pt ;
    dcat:keyword "capacidade-operativa"@pt ;
    dcat:keyword "linha de transmissão"@pt ;
    dcat:keyword "linha-de-transmissao"@pt ;
    dcat:keyword "linhas de transmissão"@pt ;
    dcat:keyword "parametros-eletricos"@pt ;
    dcat:keyword "rede básica"@pt ;
    dcat:keyword "rede complementar"@pt ;
    dcat:keyword "rede-basica"@pt ;
    dcat:keyword "rede-complementar"@pt ;
    dcat:keyword "subestacao"@pt ;
    dcat:keyword "subsistema"@pt ;
    dcat:keyword "transmissao"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Prover o cadastro de referência das linhas de transmissão do SIN para analistas de planejamento, operação e regulação do sistema elétrico brasileiro, suportando estudos de fluxo de potência, análise de contingências N-1 e N-2, gestão de ativos de transmissão, cálculo de capacidade de intercâmbio entre subsistemas, monitoramento de restrições operativas e elaboração de relatórios regulatórios para ANEEL e ONS. Utilizado como tabela-dimensão em joins com datasets operativos de restrições, intercâmbio e disponibilidade de equipamentos."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver cadastro, parâmetros elétricos ou capacidades operativas de linhas de transmissão do SIN, identificação de equipamentos por subestação terminal, subsistema ou agente proprietário, ou quando for necessária uma tabela-dimensão de linhas para join com datasets operativos de restrições, intercâmbio ou disponibilidade de equipamentos de transmissão."@pt ;
    ons:limitation "Valor máximo de 2545. Valor mínimo de 0. Aproximadamente 2."@pt ;
    dct:source <https://dados.ons.org.br/dataset/linha-transmissao> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/linha_transmissao/*.parquet" ;
    skos:altLabel "quantas linhas de transmissao existem"@pt ;
    skos:altLabel "lista de linhas de transmissao"@pt ;
    skos:altLabel "extensao das linhas"@pt ;
    skos:altLabel "comprimento das linhas"@pt ;
    skos:altLabel "quem e o dono da linha"@pt ;
    skos:altLabel "linhas por nivel de tensao"@pt ;
    skos:altLabel "linhas de 500 kv"@pt ;
    skos:altLabel "mapa das linhas"@pt ;
    skos:altLabel "cadastro de linhas"@pt ;
    skos:altLabel "linhas por empresa transmissora"@pt ;
    ons:exampleQuestion "Quais são as linhas de transmissão de 500 kV da CHESF no subsistema Nordeste?"@pt ;
    ons:exampleQuestion "Qual a capacidade operativa de longa duração das linhas de interligação entre os subsistemas SE e NE?"@pt ;
    ons:exampleQuestion "Quais linhas de transmissão ainda não possuem capacidade operativa sazonal definida?"@pt ;
    ons:exampleQuestion "Qual o comprimento total da rede básica de 500 kV por estado?"@pt ;
    ons:exampleQuestion "Quais linhas de transmissão conectam as subestações de ANGRA e ADRIANÓPOLIS?"@pt ;
    ons:exampleQuestion "Qual a resistência das LTs de 765 kV?"@pt ;
    ons:exampleQuestion "Distancia media de uma linha de transmissao no Brasil?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver cadastro, parâmetros elétricos ou capacidades operativas de linhas de transmissão do SIN, identificação de equipamentos por subestação terminal, subsistema ou agente proprietário, ou quando for necessária uma tabela-dimensão de linhas para join com datasets operativos de restrições, intercâmbio ou disponibilidade de equipamentos de transmissão. Termos relacionados: ONS, capacidade-operativa, linha de transmissão, linha-de-transmissao, parametros-eletricos."@pt ;
    ons:agentInstruction "- [val_comprimento] Valor mínimo de 0,0001 km indica registros com comprimento praticamente nulo, possivelmente representando transformadores ou conexões internas de subestação modelados como linhas de comprimento desprezível no modelo de rede.\n- [val_reatancia] Valor máximo de 2545 Ω é extremamente elevado para uma linha de transmissão convencional. Pode indicar uso de unidade em pu (por unidade) em vez de ohms absolutos, ou erro de cadastro em linhas muito longas.\n- [val_capacidadeoperveraodialonga] Nulos em boa parte das linhas indicam que quase metade das linhas não possui capacidade operativa sazonal de longa duração (verão/dia) definida. Linhas sem este campo podem estar usando apenas os limites genéricos val_capacoperlonga*.\n- [val_capacoperveradiacurta] Nulos em boa parte das linhas — taxa ligeiramente superior às capacidades de longa duração, indicando que os limites de emergência sazonais são ainda menos frequentemente cadastrados que os limites contínuos.\n- [num_barra_para] Poucos nulos em num_barra_para, ligeiramente superior ao padrão dos demais campos do terminal \"para\". Pode indicar linhas cujo terminal destino ainda não foi modelado no sistema de barras do ONS.\n- [nom_subestacao_para] Poucos nulos em nom_subestacao_para, consistente com id_subsistema_terminalpara, id_estado_terminalpara e nom_estado_para — indicando um conjunto de linhas cujo terminal destino não está completamente cadastrado.\n- [dat_entradaoperacao] Coluna de data armazenada como VARCHAR no Parquet em vez de DATE. Requer TRY_CAST para uso em filtros e ordenações temporais. Sem nulos, mas o tipo físico impede operações de data nativas.\n- [dat_desativacao] Coluna de data armazenada como VARCHAR no Parquet em vez de DATE. Requer TRY_CAST para uso em filtros temporais. As datas cadastradas de desativacao comecam em 1990-12-31 e alcancam o presente.\n- [dat_prevista] Coluna de data armazenada como VARCHAR no Parquet em vez de DATE. Requer TRY_CAST para uso em filtros e comparações temporais.\n- [val_resistencia] Valor mínimo de 0,0 Ω para resistência série pode indicar linhas modeladas como ideais (sem perdas resistivas) ou erros de cadastro. Verificar se são os mesmos registros com val_comprimento próximo de zero.\n- [cod_equipamento] cod_equipamento é a chave primária natural esperada. Verificar se existem duplicatas que possam indicar versões múltiplas do mesmo equipamento ou erros de carga.\n- [nom_tipoderede] Valores com trailing spaces detectados em 'nom_tipoderede'. Use TRIM() em filtros WHERE para evitar perda de registros."@pt ;
    dct:accrualPeriodicity "STATIC" ;
    ons:sourceExpression "read_parquet('s3://ons-aws-prod-opendata/dataset/linha_transmissao/*.parquet', union_by_name=true)" ;
    dct:license "CC-BY" ;
    dct:temporal "1959-01-24/" ;
