<https://w3id.org/tiago-ons/data/column/ind_confiarb_atls/nom_fluxo>
    a ons:Column ;
    dct:title "nom_fluxo" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nome do fluxo monitorado da rede básica (linha de transmissão ou interligação) para o qual o indicador ATLS é calculado. Funciona como dimensão espacial do dataset, identificando o elemento de rede avaliado conforme Submódulo 9.1 dos Procedimentos de Rede do ONS."@pt ;
    skos:altLabel "fluxo"@pt ;
    skos:altLabel "linha de transmissão"@pt ;
    skos:altLabel "elemento de rede"@pt ;
    skos:altLabel "fluxo monitorado"@pt ;
    skos:altLabel "nome do fluxo"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "EXP_NE" ;
    ons:allowedValue "FBA-IN" ;
    ons:allowedValue "FBTA" ;
    ons:allowedValue "FIN-BA" ;
    ons:allowedValue "FIZ-PD" ;
    ons:allowedValue "FJUSC" ;
    ons:allowedValue "FNEN" ;
    ons:allowedValue "FNESE" ;
    ons:allowedValue "FNS" ;
    ons:allowedValue "FNS+NESE" ;
    ons:allowedValue "FSECO" ;
    ons:allowedValue "GIPU" ;
    ons:allowedValue "RNE" ;
    ons:allowedValue "RSE" ;
    ons:allowedValue "RSECO" ;
    ons:allowedValue "RSUL" .

<https://w3id.org/tiago-ons/data/column/ind_confiarb_atls/id_periodicidade>
    a ons:Column ;
    dct:title "id_periodicidade" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificador da periodicidade do registro. Indica se o valor de ATLS corresponde a uma apuração mensal ou anual. A mesma tabela armazena registros de ambas as periodicidades, sendo necessário filtrar por este campo para análises consistentes."@pt ;
    skos:altLabel "periodicidade"@pt ;
    skos:altLabel "frequência de apuração"@pt ;
    skos:altLabel "tipo de período"@pt ;
    skos:altLabel "granularidade temporal"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "AN" ;
    ons:allowedValue "ME" .

<https://w3id.org/tiago-ons/data/column/ind_confiarb_atls/din_referencia>
    a ons:Column ;
    dct:title "din_referencia" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data de referência do registro, representando o mês ou ano de apuração do indicador ATLS. Para registros mensais, corresponde ao primeiro dia do mês de referência (ex: 2024-01-01 para janeiro de 2024). Para registros anuais, corresponde ao primeiro dia do ano. Cobre o período de 2017-01-01 em diante."@pt ;
    skos:altLabel "data de referência"@pt ;
    skos:altLabel "mês de referência"@pt ;
    skos:altLabel "ano de referência"@pt ;
    skos:altLabel "período"@pt ;
    skos:altLabel "competência"@pt ;
    skos:altLabel "data"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/ind_confiarb_atls/val_atls>
    a ons:Column ;
    dct:title "val_atls" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Valor do Indicador de Atendimento aos Limites Sistêmicos (ATLS) para o fluxo e período de referência. Índice normalizado entre 0 e 1, onde 1.0 representa pleno atendimento aos limites sistêmicos (sem violações) e valores menores indicam proporção de horas com atendimento. Calculado conforme Submódulo 9.1 dos Procedimentos de Rede do ONS. Valores observados: mínimo 0.8288, máximo 1.0."@pt ;
    skos:altLabel "ATLS"@pt ;
    skos:altLabel "indicador ATLS"@pt ;
    skos:altLabel "atendimento aos limites sistêmicos"@pt ;
    skos:altLabel "índice de atendimento"@pt ;
    skos:altLabel "valor do indicador"@pt ;
    skos:altLabel "desempenho do fluxo"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/indice_adimensional_0_1> .

<https://w3id.org/tiago-ons/data/unit/indice_adimensional_0_1>
    a ons:Unit ;
    skos:prefLabel "indice_adimensional_0_1" ;
    skos:altLabel "índice (adimensional, 0–1)" .

<https://w3id.org/tiago-ons/data/column/ind_confiarb_atls/num_horasviolacao>
    a ons:Column ;
    dct:title "num_horasviolacao" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Número de horas no período de referência em que o limite sistêmico do fluxo foi violado (operação fora dos limites estabelecidos). Valor zero indica pleno atendimento sem violações no período. Valores observados: mínimo 0.0 horas, máximo 230.17 horas. Complementa o val_atls fornecendo a magnitude absoluta das violações."@pt ;
    skos:altLabel "horas de violação"@pt ;
    skos:altLabel "horas violadas"@pt ;
    skos:altLabel "horas fora do limite"@pt ;
    skos:altLabel "violação sistêmica"@pt ;
    skos:altLabel "número de horas de violação"@pt ;
    skos:altLabel "horas com violação"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/h> .

<https://w3id.org/tiago-ons/data/unit/h>
    a ons:Unit ;
    skos:prefLabel "h" ;
    skos:altLabel "horas (h)" ;
    skos:closeMatch <http://qudt.org/vocab/unit/HR> ;
    skos:altLabel "horas" ;
