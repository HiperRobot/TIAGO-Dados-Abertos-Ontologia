<https://w3id.org/tiago-ons/data/column/ind_providencia_ecpa_pcpa/dsc_agregacao>
    a ons:Column ;
    dct:title "dsc_agregacao" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Nível de agregação dos indicadores ECPA e PCPA. Indica se os dados se referem ao SIN (Sistema Interligado Nacional), a um Agente específico, à Área de Atuação do Agente ou ao Gestor responsável pelas providências de manutenção."@pt ;
    skos:altLabel "agregacao"@pt ;
    skos:altLabel "nivel de agregacao"@pt ;
    skos:altLabel "tipo de agregacao"@pt ;
    skos:altLabel "escopo"@pt ;
    ons:semanticRole "DIMENSION" ;
    ons:allowedValue "Agente" ;
    ons:allowedValue "Gestor de providências" ;
    ons:allowedValue "Sistema" ;
    ons:allowedValue "Área de atuação do agente" .

<https://w3id.org/tiago-ons/data/column/ind_providencia_ecpa_pcpa/dsc_caracteristica>
    a ons:Column ;
    dct:title "dsc_caracteristica" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Identificação da entidade dentro do nível de agregação definido em dsc_agregacao. Pode conter o nome do agente, da área de atuação ou do gestor. Quando dsc_agregacao é \"SIN\", este campo representa o sistema como um todo."@pt ;
    skos:altLabel "caracteristica"@pt ;
    skos:altLabel "entidade"@pt ;
    skos:altLabel "agente"@pt ;
    skos:altLabel "gestor"@pt ;
    skos:altLabel "area de atuacao"@pt ;
    skos:altLabel "nome do agente"@pt ;
    ons:semanticRole "DIMENSION" .

<https://w3id.org/tiago-ons/data/column/ind_providencia_ecpa_pcpa/din_referencia>
    a ons:Column ;
    dct:title "din_referencia" ;
    dct:type "timestamp" ;
    ons:physicalType "TIMESTAMP" ;
    dct:description "Data de referência mensal dos indicadores ECPA e PCPA. Representa o mês de competência ao qual os valores calculados se referem. Sempre no primeiro dia do mês (ex: 2022-01-01 00:00:00)."@pt ;
    skos:altLabel "data de referencia"@pt ;
    skos:altLabel "mes de referencia"@pt ;
    skos:altLabel "competencia"@pt ;
    skos:altLabel "periodo"@pt ;
    skos:altLabel "data"@pt ;
    ons:semanticRole "TIMESTAMP" .

<https://w3id.org/tiago-ons/data/column/ind_providencia_ecpa_pcpa/num_nprc_concluidas>
    a ons:Column ;
    dct:title "num_nprc_concluidas" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Número de providências de manutenção concluídas no período de referência, independentemente de terem sido concluídas dentro ou fora do prazo programado. Corresponde ao numerador parcial do cálculo do indicador ECPA."@pt ;
    skos:altLabel "providencias concluidas"@pt ;
    skos:altLabel "nprc"@pt ;
    skos:altLabel "numero de providencias concluidas"@pt ;
    skos:altLabel "concluidas"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/unidade_contagem> .

<https://w3id.org/tiago-ons/data/unit/unidade_contagem>
    a ons:Unit ;
