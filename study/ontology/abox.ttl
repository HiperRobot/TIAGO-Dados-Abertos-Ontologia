    ons:hasColumn <https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/nom_subsistema> ;
    ons:hasColumn <https://w3id.org/tiago-ons/data/column/oferta_resposta_da_demanda/hor_inicial> ;
