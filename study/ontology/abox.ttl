<https://w3id.org/tiago-ons/data/column/uge_opera_csi/flg_sincrono>
    a ons:Column ;
    dct:title "flg_sincrono" ;
    dct:type "integer" ;
    ons:physicalType "INTEGER" ;
    dct:description "Flag indicando se a unidade geradora está operando em modo síncrono. Valores esperados: 0 (não) ou 1 (sim). A fonte renomeou esta coluna: os arquivos de 2021 a 2025 a publicam como flg_operasincrono e os de 2026 em diante como flg_sincrono, sem sobreposição. Consultar qualquer um dos dois nomes isoladamente devolve NULL na outra metade da série, e não zero — use a expressão de cast, que cobre o período inteiro."@pt ;
    ons:castExpression "COALESCE(flg_sincrono, flg_operasincrono)" ;
    skos:altLabel "flag síncrono"@pt ;
    skos:altLabel "indicador síncrono"@pt ;
    skos:altLabel "operação síncrona"@pt ;
    skos:altLabel "flg_operasincrono"@pt ;
    ons:semanticRole "FLAG" ;
    ons:allowedValue "0" ;
    ons:allowedValue "1" .

