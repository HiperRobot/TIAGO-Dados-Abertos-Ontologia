<https://w3id.org/tiago-ons/data/column/dados_hidrologicos_ho/val_vazaoafluente>
    a ons:Column ;
    dct:title "val_vazaoafluente" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Vazão afluente ao reservatório, representando o total de água que entra no reservatório por unidade de tempo. Inclui contribuições naturais e transferências de outras bacias. Valores extremos (até 840.452 m³/s) e negativos (mín = -74.007 m³/s) podem indicar erros de reporte ou outliers. Poucos nulos."@pt ;
    skos:altLabel "vazão afluente"@pt ;
    skos:altLabel "afluência"@pt ;
    skos:altLabel "vazão de entrada"@pt ;
    skos:altLabel "inflow"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/m3_per_s> .

<https://w3id.org/tiago-ons/data/column/dados_hidrologicos_ho/val_vazaodefluente>
    a ons:Column ;
    dct:title "val_vazaodefluente" ;
    dct:type "number" ;
    ons:physicalType "DOUBLE" ;
    dct:description "Vazão defluente total do reservatório, representando o total de água que sai do reservatório por unidade de tempo (turbinada + vertida + outras estruturas). Valores extremos (até 840.453 m³/s) e valor mínimo negativo (-1,0 m³/s) podem indicar erros de reporte. Poucos nulos."@pt ;
    skos:altLabel "vazão defluente"@pt ;
    skos:altLabel "defluência"@pt ;
    skos:altLabel "vazão de saída"@pt ;
    skos:altLabel "outflow"@pt ;
    skos:altLabel "vazão total"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/m3_per_s> .

