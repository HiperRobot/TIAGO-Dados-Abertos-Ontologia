<https://w3id.org/tiago-ons/data/template/ena_diario_por_ree_reservatorio_equivalente_de_energia/pattern_ena_bruta_ree_mwmed_mensal>
    a ons:QueryTemplate ;
    skos:prefLabel "ena_bruta_ree_mwmed_mensal" ;
    ons:sqlTemplate "SELECT DATE_TRUNC('month', TRY_CAST(ena_data AS DATE)) AS mes,\n  nom_reservatorioee,\n  SUM(TRY_CAST(ena_bruta_ree_mwmed AS DOUBLE) * 24.0) / 1000 AS ena_bruta_gwh\nFROM {source}\nWHERE EXTRACT(YEAR FROM TRY_CAST(ena_data AS DATE)) = 2024\nGROUP BY 1, 2\nORDER BY 1, 2" ;
    ons:outputUnitLabel "GWh" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ena_diario_por_ree_reservatorio_equivalente_de_energia/ena_bruta_ree_mwmed> .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_ree_reservatorio_equivalente_de_energia/pattern_ena_percentualmlt_abaixo_limiar>
    a ons:QueryTemplate ;
    skos:prefLabel "ena_percentualmlt_abaixo_limiar" ;
    ons:sqlTemplate "SELECT nom_reservatorioee,\n  TRY_CAST(ena_data AS DATE) AS data,\n  TRY_CAST(ena_armazenavel_ree_percentualmlt AS DOUBLE) AS percentual_mlt\nFROM {source}\nWHERE TRY_CAST(ena_armazenavel_ree_percentualmlt AS DOUBLE) < 50\n  AND TRY_CAST(ena_data AS DATE) >= CURRENT_DATE - INTERVAL '30 days'\nORDER BY data DESC" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ena_diario_por_ree_reservatorio_equivalente_de_energia/ena_armazenavel_ree_percentualmlt> .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_ree_reservatorio_equivalente_de_energia/pattern_ena_comparacao_entre_ree>
    a ons:QueryTemplate ;
    skos:prefLabel "ena_comparacao_entre_ree" ;
    ons:sqlTemplate "SELECT nom_reservatorioee,\n  AVG(TRY_CAST(ena_bruta_ree_percentualmlt AS DOUBLE)) AS media_percentual_mlt\nFROM {source}\nWHERE TRY_CAST(ena_data AS DATE) >= CURRENT_DATE - INTERVAL '30 days'\nGROUP BY nom_reservatorioee\nORDER BY media_percentual_mlt DESC" ;
    ons:outputUnitLabel "%" ;
    ons:usesMetric <https://w3id.org/tiago-ons/data/metric/ena_diario_por_ree_reservatorio_equivalente_de_energia/ena_bruta_ree_percentualmlt> .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_ree_reservatorio_equivalente_de_energia/fewshot_0>
    a ons:QueryTemplate ;
    skos:prefLabel "0" ;
    ons:sqlTemplate "SELECT nom_reservatorioee, DATE_TRUNC('month', TRY_CAST(ena_data AS DATE)) AS mes, ROUND(AVG(TRY_CAST(ena_bruta_ree_percentualmlt AS DOUBLE)), 2) AS media_percentual_mlt, ROUND(MIN(ena_bruta_ree_percentualmlt), 2) AS min_percentual_mlt, ROUND(MAX(ena_bruta_ree_percentualmlt), 2) AS max_percentual_mlt FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ena_ree_di/*.parquet') WHERE TRY_CAST(ena_data AS DATE) BETWEEN '2024-01-01' AND '2024-12-31' GROUP BY nom_reservatorioee, DATE_TRUNC('month', TRY_CAST(ena_data AS DATE)) ORDER BY nom_reservatorioee, mes" ;
    ons:exampleQuestion "Como evoluiu o percentual da MLT da ENA bruta para cada REE ao longo de 2024?"@pt .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_ree_reservatorio_equivalente_de_energia/fewshot_1>
    a ons:QueryTemplate ;
    skos:prefLabel "1" ;
    ons:sqlTemplate "SELECT nom_reservatorioee, TRY_CAST(ena_data AS DATE) AS data, ROUND(ena_armazenavel_ree_percentualmlt, 2) AS pct_mlt_armazenavel, ROUND(ena_armazenavel_ree_mwmed, 2) AS ena_armazenavel_mwmed FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ena_ree_di/*.parquet') WHERE ena_armazenavel_ree_percentualmlt < 30 ORDER BY ena_armazenavel_ree_percentualmlt ASC, TRY_CAST(ena_data AS DATE) ASC LIMIT 100" ;
    ons:exampleQuestion "Quais dias tiveram ENA armazenável abaixo de 30% da MLT para cada REE?"@pt .

<https://w3id.org/tiago-ons/data/template/ena_diario_por_ree_reservatorio_equivalente_de_energia/fewshot_2>
    a ons:QueryTemplate ;
    skos:prefLabel "2" ;
    ons:sqlTemplate "SELECT nom_reservatorioee, ROUND(AVG(TRY_CAST(ena_bruta_ree_mwmed AS DOUBLE)), 2) AS media_ena_bruta_mwmed, ROUND(AVG(TRY_CAST(ena_armazenavel_ree_mwmed AS DOUBLE)), 2) AS media_ena_armazenavel_mwmed, ROUND(AVG(ena_bruta_ree_mwmed - ena_armazenavel_ree_mwmed), 2) AS media_diferenca_mwmed, ROUND(AVG(ena_bruta_ree_percentualmlt), 2) AS media_pct_mlt_bruta, ROUND(AVG(ena_armazenavel_ree_percentualmlt), 2) AS media_pct_mlt_armazenavel FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ena_ree_di/*.parquet') WHERE TRY_CAST(ena_data AS DATE) >= ( SELECT MAX(TRY_CAST(ena_data AS DATE)) - INTERVAL '90 days' FROM read_parquet('s3://ons-aws-prod-opendata/dataset/ena_ree_di/*.parquet') ) GROUP BY nom_reservatorioee ORDER BY media_diferenca_mwmed DESC" ;
    ons:exampleQuestion "Qual a diferença média entre ENA bruta e armazenável por REE nos últimos 90 dias?"@pt .

<https://w3id.org/tiago-ons/data/dataset/ena_diario_por_reservatorio>
    a ons:Dataset ;
    dct:identifier "urn:ons-opendata:ena-diario-por-reservatorio" ;
    dct:title "ena-diario-por-reservatorio" ;
    owl:versionInfo "1.0.0" ;
    dct:publisher "ons" ;
    ons:hasStatus <https://w3id.org/tiago-ons/data/status/active> ;
    ons:inDomain <https://w3id.org/tiago-ons/data/domain/hidrologia> ;
    dcat:keyword "ENA"@pt ;
    dcat:keyword "ENA bruta reservatório"@pt ;
    dcat:keyword "ENA diária"@pt ;
    dcat:keyword "ENA diária reservatório"@pt ;
    dcat:keyword "ENA por reservatório"@pt ;
    dcat:keyword "MLT"@pt ;
    dcat:keyword "ONS"@pt ;
    dcat:keyword "REE"@pt ;
    dcat:keyword "afluência energética diária"@pt ;
    dcat:keyword "diário"@pt ;
    dcat:keyword "energia natural afluente"@pt ;
    dcat:keyword "energia natural afluente diária"@pt ;
    dcat:keyword "hidrologia"@pt ;
    dcat:keyword "média de longo termo"@pt ;
    dcat:keyword "reservatório"@pt ;
    dcat:keyword "subsistema"@pt ;
    dcat:keyword "non-pii"@pt ;
    dcat:keyword "public_data"@pt ;
    dct:description "Fornecer aos geradores hidrelétricos, comercializadores de energia, pesquisadores e ao próprio ONS a série diária de disponibilidade hídrica por reservatório, permitindo acompanhar a produtividade energética de cada aproveitamento, calcular desvios em relação à média histórica (MLT), subsidiar estudos de planejamento da operação hidrotérmica, projeção do Custo Marginal de Operação (CMO) e análise de risco hidrológico no mercado de energia elétrica brasileiro."@pt ;
    ons:usage "Recuperar este dataset quando a pergunta envolver Energia Natural Afluente (ENA) com granularidade diária e nível de detalhe por reservatório ou usina hidrelétrica individual."@pt ;
    ons:limitation "Coluna de data armazenada como VARCHAR no Parquet em vez de DATE; filtros temporais diretos podem falhar ou retornar resultados incorretos sem cast explícito. Aproximadamente 0. Aproximadamente 0."@pt ;
    dct:source <https://dados.ons.org.br/dataset/ena-diario-por-reservatorio> ;
    ons:freshness "P1D — Atualizado diariamente"@pt ;
    dcat:accessURL "s3://ons-aws-prod-opendata/dataset/ena_reservatorio_di/*.parquet" ;
    skos:altLabel "afluencia de cada usina"@pt ;
    skos:altLabel "ena por usina"@pt ;
    skos:altLabel "quanta agua chegou na represa"@pt ;
    ons:exampleQuestion "Qual foi a ENA bruta diária do reservatório de Furnas em janeiro de 2024?"@pt ;
    ons:exampleQuestion "Quais reservatórios do subsistema Sudeste apresentaram ENA abaixo de 50% da MLT nos últimos 30 dias?"@pt ;
    ons:exampleQuestion "Como evoluiu a ENA armazenável do REE Paraná Médio ao longo de 2023?"@pt ;
    ons:exampleQuestion "Qual é a participação percentual de cada reservatório na ENA total do subsistema Sul?"@pt ;
    ons:exampleQuestion "Quais reservatórios fio d'água tiveram ENA armazenável negativa em 2022?"@pt ;
    ons:retrievalContext "Recuperar este dataset quando a pergunta envolver Energia Natural Afluente (ENA) com granularidade diária e nível de detalhe por reservatório ou usina hidrelétrica individual. Também relevante para análises de desvio em relação à MLT, comparação de produtividade entre aproveitamentos, ou quando o usuário mencionar termos como ENA bruta, ENA armazenável, queda bruta, MLT por reservatório ou afluência diária de usinas específicas do SIN."@pt ;
    ons:agentInstruction "- [ena_data] Coluna de data armazenada como VARCHAR no Parquet S3 em vez de DATE. Filtros temporais e ordenações diretas podem produzir resultados incorretos sem conversão explícita. Padrão YYYY-MM-DD inferido pelo período a partir de 2021-01-01.\n\n- [ena_bruta_res_mwmed] Poucos registros apresentam valor nulo. Provavelmente corresponde a reservatórios sem operação ou sem dados consistidos em determinadas datas. Deve ser tratado antes de agregações e médias.\n\n- [ena_bruta_res_percentualmlt] Poucos registros apresentam valor nulo, coincidindo com os nulos de ena_bruta_res_mwmed. Indica ausência de dado de ENA bruta para o cálculo do percentual MLT nessas datas/reservatórios.\n\n- [ena_bruta_res_percentualmlt] Percentuais de ENA bruta em relação à MLT podem apresentar valores extremamente elevados (acima de 500%) em eventos de cheia excepcional ou valores negativos em secas severas. Recomenda-se verificar outliers para identificar possíveis erros de consistência.\n\n- [ena_armazenavel_res_mwmed] Poucos registros apresentam valor nulo. Reservatórios fio d'água podem não ter ENA armazenável definida, contribuindo para esta fração de nulos.\n\n- [ena_armazenavel_res_percentualmlt] Poucos registros apresentam valor nulo, alinhado com os nulos de ena_armazenavel_res_mwmed. Ausência do percentual MLT armazenável nas mesmas datas/reservatórios sem dado de ENA armazenável.\n\n- [ena_queda_bruta] Poucos registros apresentam valor nulo para a queda bruta. Pode indicar reservatórios sem modelagem de queda ou dados não disponíveis para o período.\n\n- [mlt_ena] Poucos registros apresentam valor nulo para a MLT da ENA. Sem a MLT, os percentuais em relação à média histórica não podem ser calculados para esses registros.\n\n- [cod_resplanejamento] A chave primária natural é (cod_resplanejamento, ena_data). Verificar se existem múltiplos registros para o mesmo reservatório na mesma data, o que indicaria duplicatas ou inconsistência de carga dos arquivos Parquet.\n\n- [tipos] As colunas `ena_armazenavel_res_mwmed`, `ena_armazenavel_res_percentualmlt`, `ena_bruta_res_mwmed`, `ena_bruta_res_percentualmlt`, `ena_queda_bruta`, `mlt_ena` mudam de tipo entre arquivos anuais (texto em uns, número em outros); cada uma traz `castExpression` no schema: use-o em toda agregação e comparação.\n"@pt ;
    dct:accrualPeriodicity "diária" ;
