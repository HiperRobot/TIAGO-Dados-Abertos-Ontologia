    a ons:QuantityKind ;
    skos:prefLabel "irradiance" ;
    skos:closeMatch <http://qudt.org/vocab/quantitykind/Irradiance> .

<https://w3id.org/tiago-ons/data/metric/restricao_coff_fotovoltaica_detail/geracaoestimada>
    a ons:Metric ;
    skos:prefLabel "Geracao Estimada (sem restricao)"@pt ;
    skos:altLabel "geracao estimada"@pt ;
    skos:altLabel "potencial de geracao"@pt ;
    skos:altLabel "geracao prevista"@pt ;
    skos:altLabel "geracao sem restricao"@pt ;
    skos:altLabel "geracao potencial solar"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/restricao_coff_fotovoltaica_detail/val_geracaoestimada> ;
    ons:expression "val_geracaoestimada" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM(GREATEST(val_geracaoestimada, 0) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(GREATEST(val_geracaoestimada, 0))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(val_geracaoestimada)\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(GREATEST(val_geracaoestimada, 0))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM(GREATEST(val_geracaoestimada, 0) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(GREATEST(val_geracaoestimada, 0))\", \"unit\": \"MWmed\"}}" .

<https://w3id.org/tiago-ons/data/metric/restricao_coff_fotovoltaica_detail/geracaoverificada>
    a ons:Metric ;
    skos:prefLabel "Geracao Verificada"@pt ;
