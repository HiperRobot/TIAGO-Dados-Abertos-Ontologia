<https://w3id.org/tiago-ons/data/metric/balanco_dessem_geral/geracao_total>
    a ons:Metric ;
    skos:prefLabel "Geracao Total"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_dessem_geral/val_geracao_renovavel> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_dessem_geral/val_geracao_hidraulica> ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_dessem_geral/val_geracao_termica> ;
    ons:expression "TRY_CAST(val_geracao_renovavel AS DOUBLE) + TRY_CAST(val_geracao_hidraulica AS DOUBLE) + TRY_CAST(val_geracao_termica AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(val_geracao_renovavel AS DOUBLE) + TRY_CAST(val_geracao_hidraulica AS DOUBLE) + TRY_CAST(val_geracao_termica AS DOUBLE)) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_geracao_renovavel AS DOUBLE) + TRY_CAST(val_geracao_hidraulica AS DOUBLE) + TRY_CAST(val_geracao_termica AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_geracao_renovavel AS DOUBLE) + TRY_CAST(val_geracao_hidraulica AS DOUBLE) + TRY_CAST(val_geracao_termica AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_geracao_renovavel AS DOUBLE) + TRY_CAST(val_geracao_hidraulica AS DOUBLE) + TRY_CAST(val_geracao_termica AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(val_geracao_renovavel AS DOUBLE) + TRY_CAST(val_geracao_hidraulica AS DOUBLE) + TRY_CAST(val_geracao_termica AS DOUBLE)) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_geracao_renovavel AS DOUBLE) + TRY_CAST(val_geracao_hidraulica AS DOUBLE) + TRY_CAST(val_geracao_termica AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

<https://w3id.org/tiago-ons/data/metric/balanco_dessem_geral/demanda>
    a ons:Metric ;
    skos:prefLabel "Demanda"@pt ;
    skos:altLabel "demanda"@pt ;
    skos:altLabel "carga programada"@pt ;
    skos:altLabel "demanda prevista"@pt ;
    skos:altLabel "carga prevista"@pt ;
    skos:altLabel "consumo"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/balanco_dessem_geral/val_demanda> ;
