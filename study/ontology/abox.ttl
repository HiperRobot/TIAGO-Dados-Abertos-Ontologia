<https://w3id.org/tiago-ons/data/column/programacao_fluxo_controlado/tip_terminal>
    a ons:Column ;
    dct:title "tip_terminal" ;
    dct:type "integer" ;
    ons:physicalType "INTEGER" ;
    dct:description "Indicador do terminal do elemento de fluxo controlado ao qual o valor de carga/fluxo se refere. Assume valor 1 para o terminal de origem (barra de envio) e valor 2 para o terminal de destino (barra de recepção). Permite distinguir o sentido do fluxo no elemento bidirecional."@pt ;
    skos:altLabel "terminal"@pt ;
    skos:altLabel "tipo_terminal"@pt ;
    skos:altLabel "sentido_fluxo"@pt ;
    skos:altLabel "origem_destino"@pt ;
    skos:altLabel "polo_terminal"@pt ;
    ons:semanticRole "FLAG" ;
    ons:allowedValue "1" ;
    ons:allowedValue "2" .

<https://w3id.org/tiago-ons/data/column/programacao_fluxo_controlado/cod_submercado>
    a ons:Column ;
    dct:title "cod_submercado" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Código do submercado elétrico (subsistema) associado ao terminal do elemento de fluxo controlado. Indica a região elétrica do SIN à qual o terminal pertence, permitindo agregações por submercado. Valores típicos: SE (Sudeste/Centro-Oeste), S (Sul), NE (Nordeste), N (Norte)."@pt ;
    skos:altLabel "submercado"@pt ;
    skos:altLabel "subsistema"@pt ;
    skos:altLabel "regiao_eletrica"@pt ;
    skos:altLabel "cod_subsistema"@pt ;
    skos:altLabel "mercado"@pt ;
    ons:semanticRole "IDENTIFIER" ;
    ons:allowedValue "N" ;
    ons:allowedValue "RR" ;
    ons:allowedValue "S" ;
    ons:allowedValue "SE" .

<https://w3id.org/tiago-ons/data/column/programacao_fluxo_controlado/val_carga>
    a ons:Column ;
    dct:title "val_carga" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Valor programado de carga/fluxo no elemento de fluxo controlado para o terminal e patamar especificados, em MW. Armazenado como VARCHAR devido ao formato de serialização. Requer TRY_CAST(val_carga AS DOUBLE) para uso em cálculos numéricos e agregações. Valores podem ser positivos (fluxo no sentido convencional) ou negativos (fluxo reverso)."@pt ;
    skos:altLabel "fluxo_programado"@pt ;
    skos:altLabel "carga_programada"@pt ;
    skos:altLabel "valor_fluxo"@pt ;
    skos:altLabel "fluxo_mw"@pt ;
    skos:altLabel "val_fluxo"@pt ;
    skos:altLabel "potencia_programada"@pt ;
    ons:semanticRole "METRIC" ;
    ons:castExpression "TRY_CAST(val_carga AS DOUBLE)" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> .

<https://w3id.org/tiago-ons/data/dimension/programacao_fluxo_controlado/subsistema>
    a ons:Dimension ;
    skos:prefLabel "subsistema" ;
    ons:onColumn <https://w3id.org/tiago-ons/data/column/programacao_fluxo_controlado/cod_submercado> ;
    ons:refersTo ons:Subsistema .

<https://w3id.org/tiago-ons/data/dimension/programacao_fluxo_controlado/patamar>
    a ons:Dimension ;
    skos:prefLabel "patamar" ;
    ons:onColumn <https://w3id.org/tiago-ons/data/column/programacao_fluxo_controlado/num_patamar> .

<https://w3id.org/tiago-ons/data/metric/programacao_fluxo_controlado/carga>
    a ons:Metric ;
    skos:prefLabel "Fluxo Programado no Elemento Controlado"@pt ;
    skos:altLabel "fluxo_programado"@pt ;
    skos:altLabel "carga_programada"@pt ;
    skos:altLabel "valor_fluxo"@pt ;
    skos:altLabel "fluxo_mw"@pt ;
    skos:altLabel "val_fluxo"@pt ;
    skos:altLabel "potencia_programada"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/programacao_fluxo_controlado/val_carga> ;
    ons:expression "TRY_CAST(val_carga AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "0.5"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(val_carga AS DOUBLE)) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_carga AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_carga AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_carga AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(val_carga AS DOUBLE)) * 0.5) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_carga AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

