<https://w3id.org/tiago-ons/data/metric/carga_energia/cargaenergiamwmed>
    a ons:Metric ;
    skos:prefLabel "Carga Verificada"@pt ;
    skos:altLabel "carga"@pt ;
    skos:altLabel "carga energia"@pt ;
    skos:altLabel "carga MWmed"@pt ;
    skos:altLabel "demanda"@pt ;
    skos:altLabel "demanda energia"@pt ;
    skos:altLabel "consumo energia"@pt ;
    skos:altLabel "val carga energia mwmed"@pt ;
    skos:altLabel "carga subsistema"@pt ;
    ons:computedFrom <https://w3id.org/tiago-ons/data/column/carga_energia/val_cargaenergiamwmed> ;
    ons:expression "TRY_CAST(val_cargaenergiamwmed AS DOUBLE)" ;
    ons:quantityKind <https://w3id.org/tiago-ons/data/quantitykind/average_power> ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mwmed> ;
    ons:defaultAggregation <https://w3id.org/tiago-ons/data/aggregation/sum> ;
    ons:timeAdditive "true"^^xsd:boolean ;
    ons:intervalHours "24.0"^^xsd:decimal ;
    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM((TRY_CAST(val_cargaenergiamwmed AS DOUBLE)) * 24.0) / 1000\", \"unit\": \"GWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_cargaenergiamwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_cargaenergiamwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"AVG(TRY_CAST(val_cargaenergiamwmed AS DOUBLE))\", \"unit\": \"MWmed\"}, \"ranking\": {\"sql\": \"SUM((TRY_CAST(val_cargaenergiamwmed AS DOUBLE)) * 24.0) / 1000\", \"unit\": \"GWh\"}, \"comparison\": {\"sql\": \"AVG(TRY_CAST(val_cargaenergiamwmed AS DOUBLE))\", \"unit\": \"MWmed\"}}" .

