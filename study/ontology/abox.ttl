    ons:aggregationSQL "{\"total_energy\": {\"sql\": \"SUM(TRY_CAST(val_evt_razaoenergetica AS DOUBLE)) * 1.0\", \"unit\": \"MWh\"}, \"average_power\": {\"sql\": \"AVG(TRY_CAST(val_evt_razaoenergetica AS DOUBLE))\", \"unit\": \"MWmed\"}, \"peak_power\": {\"sql\": \"MAX(TRY_CAST(val_evt_razaoenergetica AS DOUBLE))\", \"unit\": \"MWmed\"}, \"time_series\": {\"sql\": \"SUM(TRY_CAST(val_evt_razaoenergetica AS DOUBLE)) * 1.0\", \"unit\": \"MWh\"}, \"comparison\": {\"sql\": \"SUM(TRY_CAST(val_evt_razaoenergetica AS DOUBLE)) * 1.0\", \"unit\": \"MWh\"}}" .

<https://w3id.org/tiago-ons/data/metric/classificacao_evt/evt_razaoeletrica>
    a ons:Metric ;
    skos:prefLabel "EVT Razao Eletrica"@pt ;
    skos:altLabel "evt_razao_eletrica"@pt ;
