    skos:altLabel "limite geração"@pt ;
    skos:altLabel "curtailment"@pt ;
    skos:altLabel "corte geração"@pt ;
    skos:altLabel "potência limitada"@pt ;
    ons:semanticRole "METRIC" ;
    ons:unit <https://w3id.org/tiago-ons/data/unit/mw> .

