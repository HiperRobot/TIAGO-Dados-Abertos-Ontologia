    dct:title "ena_data" ;
    dct:type "string" ;
    ons:physicalType "VARCHAR" ;
    dct:description "Data de referência da medição de ENA, armazenada como VARCHAR no formato YYYY-MM-DD. Representa o dia ao qual os valores de energia natural afluente se referem. Requer conversão explícita para DATE em filtros temporais e ordenações cronológicas."@pt ;
    skos:altLabel "data"@pt ;
    skos:altLabel "data de referência"@pt ;
    skos:altLabel "data da ENA"@pt ;
