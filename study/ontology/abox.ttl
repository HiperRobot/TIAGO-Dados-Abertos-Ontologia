    ons:hasPerspective <https://w3id.org/tiago-ons/data/perspective/verificado> ;
    ons:inFamily <https://w3id.org/tiago-ons/data/family/cmo> ;
    skos:hiddenLabel "cmo"@pt ;
    skos:hiddenLabel "custo marginal"@pt ;
